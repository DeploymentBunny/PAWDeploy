Function Test-PAWVMHaveIP {
    <#
    .SYNOPSIS
        Tests whether a VM has at least one usable IP address.

    .DESCRIPTION
        Returns True when the VM network adapters expose at least one non-empty
        address that is not loopback, APIPA, or IPv6 link-local.

    .PARAMETER VMname
        Name of the virtual machine to test.

    .EXAMPLE
        Test-PAWVMHaveIP -VMname "PAW-01"
        Returns True when PAW-01 has a usable IP address.

    .EXAMPLE
        if (Test-PAWVMHaveIP -VMname "PAW-01") { "Network ready" }
        Uses the function in a readiness check.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [cmdletbinding()]
    [OutputType([bool])]

    Param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]
        $VMname
    )

    #Check if VM exists
    if ((Test-PAWVMExists -VMname $VMname) -eq $false) {
        Write-Warning "Could not find $VMname"
        return $false
    }

    $ipAddresses = @(Get-VMNetworkAdapter -VMName $VMname -ErrorAction SilentlyContinue |
        ForEach-Object { $_.IPAddresses } |
        Where-Object {
            -not [string]::IsNullOrWhiteSpace($_) -and
            $_ -ne '127.0.0.1' -and
            $_ -ne '::1' -and
            $_ -notlike '169.254.*' -and
            $_ -notlike 'fe80:*'
        })

    if ($ipAddresses.Count -gt 0) {
        return $true
    }
    else {
        return $false
    }
}
Function Test-PAWVMHavePSDirect {
    <#
    .SYNOPSIS
        Tests whether PowerShell Direct is available for a VM.

    .DESCRIPTION
        Attempts a simple PowerShell Direct command against the target VM using the
        provided credentials and returns True on success; otherwise False.

    .PARAMETER VMname
        Name of the virtual machine to test.

    .PARAMETER Credentials
        Credentials used to authenticate through PowerShell Direct.

    .EXAMPLE
        Test-PAWVMHavePSDirect -VMname "PAW-01" -Credentials $Cred
        Returns True when PowerShell Direct is available.

    .EXAMPLE
        if (Test-PAWVMHavePSDirect -VMname "PAW-01" -Credentials $Cred) { "Ready" }

        Uses the function in a readiness check.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [cmdletbinding()]
    [OutputType([bool])]

    Param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]
        $VMName,

        [Parameter(Mandatory = $true)]
        [ValidateNotNull()]
        [System.Management.Automation.PSCredential]
        $Credentials
    )

    #Check if VM exists
    if ((Test-PAWVMExists -VMname $VMName) -eq $false) {
        Write-Warning "Could not find $VMName"
        return $false
    }

    try {
        $session = New-PSSession -VMName $VMName -Credential $Credentials -ErrorAction Stop
        if (Test-PAWPSDirectSession -Session $session) {
            return $true
        }
        else {
            return $false
        }
    }
    catch {
        return $false
    }
    finally {
        if ($null -ne $session) {
            Remove-PSSession -Session $session -ErrorAction SilentlyContinue
        }
    }
}
