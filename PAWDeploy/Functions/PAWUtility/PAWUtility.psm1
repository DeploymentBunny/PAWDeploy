<#

.SYNOPSIS
    Builds the silent install command for an application downloaded with WinGet.

.DESCRIPTION
    Uses the install file of the application (Get-PAWApplicationInstallFile)
    and returns how the installer must be run.

    Silent switches: SilentArguments in Settings, otherwise SilentArguments in
    Installer (from the WinGet manifest or the WinGet default for the installer
    type). Installer.CustomArguments and Settings.CustomArguments are appended.
    Settings.MsiProperties are appended for msi/wix.

    Method is one of:
      Process  - run FilePath with Arguments (msi/wix through msiexec.exe)
      Msix     - provision the package with Add-AppxProvisionedPackage
      Zip      - extract the archive; NestedInstallerType tells what to do next
      Portable - copy the file to DestinationPath

.PARAMETER InstallDefinition
    Install file content from Get-PAWApplicationInstallFile.

.PARAMETER InstallerPath
    Full path to the installer file.

.PARAMETER InstallerType
    Overrides Installer.InstallerType. Used for the nested installer of a zip
    package.

.EXAMPLE
    $definition = Get-PAWApplicationInstallFile -Path $installFilePath
    Get-PAWWinGetInstallCommand -InstallDefinition $definition -InstallerPath $installerPath

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Get-PAWWinGetInstallCommand {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        $InstallDefinition,

        [Parameter(Mandatory = $true)]
        [string]$InstallerPath,

        [string]$InstallerType
    )

    $name = [string]$InstallDefinition.Name
    $settings = $InstallDefinition.Settings
    $installer = $InstallDefinition.Installer

    $type = $InstallerType
    if ([string]::IsNullOrWhiteSpace($type)) {
        $type = [string]$installer.InstallerType
    }
    $type = $type.Trim().ToLowerInvariant()
    if ([string]::IsNullOrWhiteSpace($type)) {
        throw "The install file for '$name' does not define an InstallerType. Run Invoke-PAWApplicationDownload.ps1 -Name '$name' -Force on the host."
    }

    $silentArguments = [string]$settings.SilentArguments
    $silentSource = 'install file Settings'
    if ([string]::IsNullOrWhiteSpace($silentArguments)) {
        $silentArguments = [string]$installer.SilentArguments
        $silentSource = [string]$installer.SilentSource
    }
    if ([string]::IsNullOrWhiteSpace($silentArguments)) {
        $silentSource = $null
    }
    $customArguments = (@([string]$installer.CustomArguments, [string]$settings.CustomArguments) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) }) -join ' '

    $destinationPath = [string]$settings.DestinationPath
    if ([string]::IsNullOrWhiteSpace($destinationPath)) {
        $destinationPath = Join-Path '%ProgramFiles%' $name
    }

    $method = $null
    $filePath = $null
    $arguments = @()
    switch ($type) {
        { $_ -in 'msi', 'wix' } {
            $method = 'Process'
            $filePath = 'msiexec.exe'
            $arguments = @('/i', ('"{0}"' -f $InstallerPath), $silentArguments, $customArguments) + @($settings.MsiProperties)
        }
        { $_ -in 'burn', 'inno', 'nullsoft', 'exe' } {
            if ([string]::IsNullOrWhiteSpace($silentArguments)) {
                throw "No silent install switches for '$name' (installer type '$type'). Set SilentArguments in Settings in $($InstallDefinition.Path)."
            }
            $method = 'Process'
            $filePath = $InstallerPath
            $arguments = @($silentArguments, $customArguments)
        }
        { $_ -in 'msix', 'appx' } {
            $method = 'Msix'
            $filePath = $InstallerPath
        }
        'zip' {
            $method = 'Zip'
            $filePath = $InstallerPath
        }
        'portable' {
            $method = 'Portable'
            $filePath = $InstallerPath
        }
        default {
            throw "Installer type '$type' of '$name' is not supported. Use InstallerType in Applications.json to select another installer."
        }
    }

    [PSCustomObject]@{
        Name                 = $name
        InstallerType        = $type
        Method               = $method
        FilePath             = $filePath
        Arguments            = ((@($arguments) | Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) }) -join ' ')
        SilentSource         = $silentSource
        SuccessExitCodes     = [long[]]@($installer.SuccessExitCodes)
        RebootExitCodes      = [long[]]@($installer.RebootExitCodes)
        DestinationPath      = $destinationPath
        NestedInstallerType  = [string]$installer.NestedInstallerType
        NestedInstallerFiles = @($installer.NestedInstallerFiles)
    }
}
<#

.SYNOPSIS
    Reads the install information from a manifest saved by winget download.

.DESCRIPTION
    Parses the merged YAML manifest that winget download writes next to the
    installer and returns the package identifier, version, installer type,
    scope and installer switches (Silent, SilentWithProgress, Custom, etc.),
    plus the nested installer files of zip packages, InstallerSuccessCodes and
    ExpectedReturnCodes.

    winget download writes a manifest that only contains the selected
    installer. Installer-level values take precedence over root-level values.
    Only the simple key/value lines and lists needed for installation are read;
    this is not a general YAML parser.

.PARAMETER Path
    Path to the .yaml manifest written by winget download.

.EXAMPLE
    Get-PAWWinGetManifestInfo -Path 'C:\PAWDeploy\Resources\ApplicationDownloads\WinGet\7-Zip\7-Zip_26.05_Machine_X64_wix_en-US.yaml'

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Get-PAWWinGetManifestInfo {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Path
    )

    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
        throw "WinGet manifest not found: $Path"
    }

    $unquote = {
        param([string]$Value)
        $text = $Value.Trim()
        if ($text.Length -ge 2 -and (($text.StartsWith("'") -and $text.EndsWith("'")) -or ($text.StartsWith('"') -and $text.EndsWith('"')))) {
            $text = $text.Substring(1, $text.Length - 2)
            if ($Value.Trim().StartsWith("'")) {
                $text = $text.Replace("''", "'")
            }
        }
        $text
    }

    $rootValues = @{}
    $installerValues = @{}
    $rootSwitches = [ordered]@{}
    $installerSwitches = [ordered]@{}
    $rootLists = @{}
    $installerLists = @{}
    $listKeys = @('NestedInstallerFiles', 'InstallerSuccessCodes', 'ExpectedReturnCodes')
    $inInstallers = $false
    $switchIndent = -1
    $listIndent = -1
    $listItems = $null
    $listItem = $null

    foreach ($line in (Get-Content -LiteralPath $Path -Encoding UTF8)) {
        if ($line -match '^\s*(#.*)?$') {
            continue
        }

        $indent = $line.Length - $line.TrimStart(' ', '-').Length
        $trimmed = $line.Trim()
        $isListItem = $trimmed.StartsWith('- ')
        if ($isListItem) {
            $trimmed = $trimmed.Substring(2).Trim()
        }

        if ($indent -eq 0) {
            $inInstallers = ($trimmed -eq 'Installers:')
            $switchIndent = -1
        }

        if ($switchIndent -ge 0) {
            if ($indent -gt $switchIndent -and $trimmed -match '^([A-Za-z]+):\s*(.*)$') {
                $target = if ($inInstallers) { $installerSwitches } else { $rootSwitches }
                $target[$Matches[1]] = & $unquote $Matches[2]
                continue
            }
            $switchIndent = -1
        }

        if ($listIndent -ge 0) {
            if ($indent -gt $listIndent) {
                if ($isListItem) {
                    $listItem = [ordered]@{}
                    $listItems.Add($listItem)
                }
                if ($null -ne $listItem) {
                    if ($trimmed -match '^([A-Za-z]+):\s*(.*)$') {
                        $listItem[$Matches[1]] = & $unquote $Matches[2]
                    }
                    elseif ($isListItem) {
                        $listItem['Value'] = & $unquote $trimmed
                    }
                }
                continue
            }
            $listIndent = -1
            $listItem = $null
        }

        # Root keys are at indent 0 and installer keys at indent 2; deeper keys belong to nested blocks.
        $isRootKey = ($indent -eq 0)
        $isInstallerKey = ($inInstallers -and $indent -eq 2)

        if ($trimmed -eq 'InstallerSwitches:' -and ($isRootKey -or $isInstallerKey)) {
            $switchIndent = $indent
            continue
        }

        if (($isRootKey -or $isInstallerKey) -and $trimmed -match '^([A-Za-z]+):$' -and $listKeys -contains $Matches[1]) {
            $target = if ($isInstallerKey) { $installerLists } else { $rootLists }
            $listItems = New-Object System.Collections.Generic.List[object]
            $target[$Matches[1]] = $listItems
            $listIndent = $indent
            $listItem = $null
            continue
        }

        if (($isRootKey -or $isInstallerKey) -and $trimmed -match '^(PackageIdentifier|PackageVersion|PackageName|Publisher|InstallerType|NestedInstallerType|Scope|Architecture|InstallerLocale|ProductCode):\s*(.+)$') {
            $target = if ($isInstallerKey) { $installerValues } else { $rootValues }
            if (-not $target.ContainsKey($Matches[1])) {
                $target[$Matches[1]] = & $unquote $Matches[2]
            }
        }
    }

    $getValue = {
        param([string]$Key)
        if ($installerValues.ContainsKey($Key)) { return $installerValues[$Key] }
        if ($rootValues.ContainsKey($Key)) { return $rootValues[$Key] }
        $null
    }

    $getList = {
        param([string]$Key)
        if ($installerLists.ContainsKey($Key)) { return , $installerLists[$Key].ToArray() }
        if ($rootLists.ContainsKey($Key)) { return , $rootLists[$Key].ToArray() }
        , @()
    }

    $switches = [ordered]@{}
    foreach ($key in $rootSwitches.Keys) { $switches[$key] = $rootSwitches[$key] }
    foreach ($key in $installerSwitches.Keys) { $switches[$key] = $installerSwitches[$key] }

    $nestedInstallerFiles = @((& $getList 'NestedInstallerFiles') | Where-Object { $_.Contains('RelativeFilePath') } | ForEach-Object { [string]$_['RelativeFilePath'] })
    $successCodes = @((& $getList 'InstallerSuccessCodes') | Where-Object { $_.Contains('Value') -and [string]$_['Value'] -match '^-?\d+$' } | ForEach-Object { [long]$_['Value'] })
    $expectedReturnCodes = @((& $getList 'ExpectedReturnCodes') | Where-Object { [string]$_['InstallerReturnCode'] -match '^-?\d+$' } | ForEach-Object {
            [PSCustomObject]@{
                InstallerReturnCode = [long]$_['InstallerReturnCode']
                ReturnResponse      = [string]$_['ReturnResponse']
            }
        })

    [PSCustomObject]@{
        PackageIdentifier   = & $getValue 'PackageIdentifier'
        PackageVersion      = & $getValue 'PackageVersion'
        PackageName         = & $getValue 'PackageName'
        Publisher           = & $getValue 'Publisher'
        InstallerType       = & $getValue 'InstallerType'
        NestedInstallerType = & $getValue 'NestedInstallerType'
        Scope               = & $getValue 'Scope'
        Architecture        = & $getValue 'Architecture'
        InstallerLocale     = & $getValue 'InstallerLocale'
        ProductCode         = & $getValue 'ProductCode'
        InstallerSwitches   = [PSCustomObject]$switches
        NestedInstallerFiles  = $nestedInstallerFiles
        InstallerSuccessCodes = $successCodes
        ExpectedReturnCodes   = $expectedReturnCodes
    }
}
function Import-PAWEdgeBaseline {
    <#
    .SYNOPSIS
        Imports a Microsoft Edge baseline ZIP without executing scripts.
    .PARAMETER ZipPath
        Local baseline ZIP.
    .PARAMETER OperatingSystem
        Destination OS folder name.
    .PARAMETER BaselineFolder
        Absolute SecurityBaselineFolder root. Defaults to the configured folder.
    .PARAMETER Replace
        Approves replacing this Edge baseline.
    .NOTES
        Version : 2.0.0.4
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess)]
    param(
        [Parameter(Mandatory, ValueFromPipelineByPropertyName)][Alias('FullName')][ValidateNotNullOrEmpty()][string]$ZipPath,
        [Parameter(Mandatory, ValueFromPipelineByPropertyName)][ValidateNotNullOrEmpty()][string]$OperatingSystem,
        [ValidateNotNullOrEmpty()][string]$BaselineFolder = (Get-PAWInventoryFolder -Root $script:scriptFolder -Names @('SecurityBaseLineFolder', 'SecurityBaselineFolder')),
        [switch]$Replace
    )
    process {
        if ($PSCmdlet.ShouldProcess("$BaselineFolder\$OperatingSystem\Edge", 'Import Edge baseline')) {
            Invoke-PAWBaselineImport -ZipPath $ZipPath -OperatingSystem $OperatingSystem -BaselineFolder $BaselineFolder `
                -Replace:$Replace -BaselineType Edge -Confirm:$false -ErrorAction Stop
        }
    }
}
function Import-PAWLGPO {
    <#
    .SYNOPSIS
        Imports LGPO.exe into Scripts\Tools of every imported OS/Edge baseline.
    .DESCRIPTION
        Validates the entire ZIP and destination tree. Only OS/Edge folders with
        Scripts\Baseline-LocalInstall.ps1 are targeted; empty skeletons are skipped.
        Existing executables require Replace. Each executable is published atomically.
        Independent failures are reported together with successful destinations.
        No imported executable is run.
    .PARAMETER ZipPath
        Local LGPO ZIP containing exactly one nonempty LGPO.exe.
    .PARAMETER BaselineFolder
        Absolute SecurityBaselineFolder root.
    .PARAMETER Replace
        Explicit approval to replace existing LGPO.exe files.
    .EXAMPLE
        Import-PAWLGPO -ZipPath C:\Downloads\LGPO.zip -BaselineFolder C:\PAWDeploy\Resources\SecurityBaselines -Replace
        Updates LGPO in all imported baselines.
    .NOTES
        Version : 2.0.0.2
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess)]
    param(
        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$ZipPath,
        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$BaselineFolder,
        [switch]$Replace
    )
    if ($BaselineFolder -notmatch '^(?:[A-Za-z]:[\\/]|\\\\[^\\]+\\[^\\]+(?:\\|$))') {
        throw 'BaselineFolder must be an absolute path.'
    }
    $root = [IO.Path]::GetFullPath($BaselineFolder)
    Assert-PAWBaselineDestination -Path $root -AllowContent
    if (-not (Test-Path -LiteralPath $root -PathType Container -ErrorAction Stop)) {
        throw "Baseline folder does not exist: '$root'. Import OS/Edge baselines first."
    }
    $zip = Get-Item -LiteralPath $ZipPath -ErrorAction Stop
    if ($zip.PSIsContainer -or $zip.Extension -ne '.zip') { throw 'ZipPath must be a ZIP file.' }
    Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction Stop
    Add-Type -AssemblyName System.IO.Compression -ErrorAction Stop
    $archive = [IO.Compression.ZipFile]::OpenRead($zip.FullName)
    try {
        $entries = Get-PAWBaselineArchiveEntries -Archive $archive
        $executables = @($entries | Where-Object {
            -not $_.IsDirectory -and (Split-Path -Leaf $_.Name) -eq 'LGPO.exe'
        })
        if ($executables.Count -ne 1) {
            throw "LGPO ZIP must contain exactly one LGPO.exe; found $($executables.Count)."
        }
        if ($executables[0].Entry.Length -eq 0) { throw 'LGPO.exe in the LGPO ZIP is empty.' }
        $targets = New-Object 'System.Collections.Generic.List[string]'
        foreach ($os in Get-ChildItem -LiteralPath $root -Directory -Force -ErrorAction Stop | Where-Object Name -NotLike '.*') {
            foreach ($type in @('OS', 'Edge')) {
                $baseline = Join-Path $os.FullName $type
                if (Test-Path -LiteralPath (Join-Path $baseline 'Scripts\Baseline-LocalInstall.ps1') -PathType Leaf -ErrorAction Stop) {
                    $tools = Join-Path $baseline 'Scripts\Tools'
                    Assert-PAWBaselineDestination -Path $tools -AllowContent
                    $target = Join-Path $tools 'LGPO.exe'
                    if (Test-Path -LiteralPath $target -ErrorAction Stop) {
                        $existing = Get-Item -LiteralPath $target -Force -ErrorAction Stop
                        if ($existing.PSIsContainer) { throw "LGPO destination is not a file: '$target'." }
                        if (-not $Replace) { throw "LGPO already exists at '$target'. Use -Replace to approve replacement." }
                    }
                    $targets.Add($target)
                }
            }
        }
        if ($targets.Count -eq 0) { throw "No imported OS/Edge baselines found under '$root'." }
        if (-not $PSCmdlet.ShouldProcess(($targets -join ', '), "Import LGPO from '$($zip.FullName)' (Replace=$Replace)")) { return }
        $failures = New-Object 'System.Collections.Generic.List[string]'
        $completed = New-Object 'System.Collections.Generic.List[string]'
        foreach ($target in $targets) {
            $temporary = $null
            try {
                $tools = Split-Path -Parent $target
                Assert-PAWBaselineDestination -Path $tools -AllowContent
                $null = New-Item -Path $tools -ItemType Directory -Force -ErrorAction Stop
                $temporary = Join-Path $tools ('.lgpo-' + [guid]::NewGuid().ToString('N'))
                [IO.Compression.ZipFileExtensions]::ExtractToFile($executables[0].Entry, $temporary, $false)
                Assert-PAWBaselineDestination -Path $tools -AllowContent
                if (Test-Path -LiteralPath $target -ErrorAction Stop) {
                    if (-not $Replace) { throw "LGPO appeared at '$target'; replacement is not approved." }
                    [IO.File]::Replace($temporary, $target, [System.Management.Automation.Language.NullString]::Value)
                }
                else { [IO.File]::Move($temporary, $target) }
                $temporary = $null
                $completed.Add($target)
                [pscustomobject]@{ Destination = $target; ZipPath = $zip.FullName }
            }
            catch {
                $reason = "${target}: $($_.Exception.Message)"
                $failures.Add($reason)
                Write-Warning "LGPO import failed: $reason"
            }
            finally {
                if ($temporary) {
                    try {
                        if (Test-Path -LiteralPath $temporary -ErrorAction Stop) {
                            Remove-Item -LiteralPath $temporary -Force -ErrorAction Stop
                        }
                    }
                    catch { Write-Warning "LGPO temporary file retained at '$temporary': $($_.Exception.Message)" }
                }
            }
        }
        if ($failures.Count) {
            throw "LGPO import incomplete. Updated $($completed.Count)/$($targets.Count): $($completed -join ', '). Failures: $($failures -join '; ')"
        }
    }
    finally { $archive.Dispose() }
}
