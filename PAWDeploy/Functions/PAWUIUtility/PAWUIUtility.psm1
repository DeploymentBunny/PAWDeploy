.PARAMETER OnError
    Optional callback invoked when loading settings fails.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Import-PAWEditorUiSettings {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $false)]
        [string]$SettingsFile = '',

        [Parameter(Mandatory = $false)]
        [scriptblock]$OnError = $null
    )

    if ([string]::IsNullOrWhiteSpace($SettingsFile)) {
        return $null
    }

    if (-not (Test-Path -LiteralPath $SettingsFile -PathType Leaf)) {
        return $null
    }

    try {
