<#

.SYNOPSIS
    Normalizes a DataTable or DataView input to a DataTable.

.DESCRIPTION
    Normalizes a DataTable or DataView input to a DataTable.

.PARAMETER InputObject
    DataTable or table-like object to resolve as a DataTable.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Resolve-PAWTemplateTable {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [object]$InputObject = $null
    )

    if ($null -eq $InputObject) {
        return $null
    }

    if ($InputObject -is [System.Data.DataTable]) {
        Write-Output -NoEnumerate ([System.Data.DataTable]$InputObject)
        return
    }

    if ($InputObject -is [System.Data.DataView]) {
        Write-Output -NoEnumerate ([System.Data.DataTable]$InputObject.Table)
        return
    }

    if ($InputObject -is [System.Array]) {
        foreach ($item in @($InputObject)) {
            if ($item -is [System.Data.DataTable]) {
                Write-Output -NoEnumerate ([System.Data.DataTable]$item)
                return
            }
            if ($item -is [System.Data.DataView]) {
                Write-Output -NoEnumerate ([System.Data.DataTable]$item.Table)
                return
            }
        }
    }

    return $null
}
<#

.SYNOPSIS
    Persists form size and selected state for a WinForms editor.

.DESCRIPTION
    Persists form size and selected state for a WinForms editor.

.PARAMETER Form
    Optional editor form whose window dimensions are saved.

.PARAMETER SelectedTemplateName
    Name of the currently selected template to persist.

.PARAMETER SettingsRoot
    Root folder used to create the settings file when no explicit path is supplied. Defaults to $env:TEMP.

.PARAMETER SettingsFile
    Optional explicit destination path for the settings JSON file.

.PARAMETER OnError
    Optional callback invoked when saving settings fails.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Save-PAWEditorUiSettings {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $false)]
        [System.Windows.Forms.Form]$Form = $null,

        [Parameter(Mandatory = $false)]
        [string]$SelectedTemplateName = '',

        [Parameter(Mandatory = $false)]
        [string]$SettingsRoot = $env:TEMP,

        [Parameter(Mandatory = $false)]
        [string]$SettingsFile = '',

        [Parameter(Mandatory = $false)]
        [scriptblock]$OnError = $null
    )

    try {
        $destination = $SettingsFile
        if ([string]::IsNullOrWhiteSpace($destination)) {
            if ([string]::IsNullOrWhiteSpace($SettingsRoot)) {
                $SettingsRoot = $env:TEMP
            }
            $destination = Join-Path $SettingsRoot 'PAWConfigEditorUI.settings'
        }

        $destinationFolder = Split-Path -Parent $destination
        if (-not [string]::IsNullOrWhiteSpace($destinationFolder) -and -not (Test-Path -LiteralPath $destinationFolder -PathType Container)) {
            New-Item -Path $destinationFolder -ItemType Directory -Force | Out-Null
        }

        $state = [PSCustomObject]@{
            WindowWidth = if ($null -ne $Form) { [int]$Form.Width } else { 0 }
            WindowHeight = if ($null -ne $Form) { [int]$Form.Height } else { 0 }
            LocationX = if ($null -ne $Form) { [int]$Form.Location.X } else { 0 }
            LocationY = if ($null -ne $Form) { [int]$Form.Location.Y } else { 0 }
            SelectedTemplate = [string]$SelectedTemplateName
        }

        $stateJson = $state | ConvertTo-Json -Depth 5
        Set-Content -LiteralPath $destination -Value $stateJson -Encoding UTF8
        return $true
    }
    catch {
        if ($null -ne $OnError) {
            & $OnError $_
        }
        return $false
    }
}
<#

.SYNOPSIS
    Serializes PAW UI state to a JSON settings file.

.DESCRIPTION
    Serializes PAW UI state to a JSON settings file.

.PARAMETER SettingsRoot
    Root folder used to ensure the settings destination exists.

.PARAMETER SettingsFile
    Destination path for the saved UI-state JSON file.

.PARAMETER State
    Object serialized as the UI state.

.PARAMETER Depth
    Maximum JSON serialization depth. Defaults to 4.

.PARAMETER OnError
    Optional callback invoked when saving state fails.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Save-PAWUiState {
    param(
        [Parameter(Mandatory = $true)]
        [string]$SettingsRoot,

        [Parameter(Mandatory = $true)]
        [string]$SettingsFile,

        [Parameter(Mandatory = $true)]
        [object]$State,

        [Parameter(Mandatory = $false)]
        [int]$Depth = 4,

        [Parameter(Mandatory = $false)]
        [scriptblock]$OnError
    )

    try {
        if (-not (Test-Path -LiteralPath $SettingsRoot -PathType Container)) {
            New-Item -Path $SettingsRoot -ItemType Directory -Force | Out-Null
        }

        $State | ConvertTo-Json -Depth $Depth | Set-Content -LiteralPath $SettingsFile -Encoding UTF8
        return $true
    }
    catch {
        if ($null -ne $OnError) {
            & $OnError $_
        }
        return $false
    }
}
