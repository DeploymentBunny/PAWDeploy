            $deploymentBunny.Add_Disposed({ param($sender, $eventArgs) $sender.Image.Dispose() })
            $Form.Controls.Add($deploymentBunny)
            $brandLeft = 90
        }
        $brand = New-Object System.Windows.Forms.PictureBox
        $brand.Name = 'PAWRibbonTruesec'
        $brand.SizeMode = 'Zoom'
        $brand.Size = New-Object System.Drawing.Size(180, 60)
        $brand.Location = New-Object System.Drawing.Point($brandLeft, ($Form.ClientSize.Height - 80))
        $brand.Anchor = 'Bottom, Left'
        $brand.BackColor = [System.Drawing.Color]::Transparent
        $brand.Image = Get-PAWImage -Name EditionLogo -Edition $Edition -MaximumWidth 720
        $brand.Add_Disposed({ param($sender, $eventArgs) $sender.Image.Dispose() })
        $Form.Controls.Add($brand)
    }
    else {
        $inset = 8
        $logoHeight = $ribbon.Height - 2 * $inset
        $logoWidth = [int][Math]::Ceiling($picture.Image.Width * $logoHeight / $picture.Image.Height)
        $picture.Size = New-Object System.Drawing.Size($logoWidth, $logoHeight)
        $picture.Location = New-Object System.Drawing.Point($inset, $inset)
    }
    $picture.Add_Disposed({ param($sender, $eventArgs) $sender.Image.Dispose() })
    $heading = New-Object System.Windows.Forms.Label
    $heading.Name = 'PAWRibbonTitle'
    $scriptName = [IO.Path]::GetFileNameWithoutExtension($ScriptPath)
    $heading.Text = switch ($scriptName) {
