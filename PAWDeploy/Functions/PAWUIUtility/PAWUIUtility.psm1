    if ($Form.Controls.ContainsKey('PAWRibbon') -or $Form.Controls.ContainsKey('PAWRibbonTitle')) { throw 'This window already has a PAW ribbon.' }
    $ribbon = New-Object System.Windows.Forms.Panel
    $ribbon.Name = 'PAWRibbon'
    $ribbon.Dock = 'Top'
    $ribbon.Height = if ($Menu) { 120 } else { 64 }
    $ribbon.BackColor = (Get-PAWUiPalette).Background
