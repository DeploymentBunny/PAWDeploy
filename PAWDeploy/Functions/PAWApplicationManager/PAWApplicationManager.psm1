}
<#
.SYNOPSIS
    Creates an unsaved typed draft for CLI and GUI editing; saving validates all fields.
.NOTES
    Version : 2.0.0.3
    Author  : The Fantastic PAWDeploy Team
#>
function New-PAWManagedApplication {
    [CmdletBinding()]
    param([Parameter(Mandatory)][ValidateSet('WinGet','PowerShellModule','Classic','WindowsComponent')][string]$Type,
        [Parameter(Mandatory)][string]$Name, [object]$Configuration, [bool]$RestartRequired = $false)
    $componentDraft = $Type -eq 'WindowsComponent' -and $null -eq $Configuration
    if ($null -eq $Configuration) {
        $Configuration = switch ($Type) {
            'WinGet' { @{ Id = 'Vendor.Package'; Architecture = 'NA'; Scope = 'NA'; InstallerType = 'NA' } }
            'PowerShellModule' { @{ Id = 'Example.Module'; Version = 'Latest'; Runtime = 'WindowsPowerShell'; Origin = 'PSGallery' } }
            'Classic' { @{
                FolderPath = '.'; Executable = 'Install.exe'; Arguments = ''; WorkingDirectory = '.'
                SuccessExitCodes = @(0,3010); TimeoutSeconds = 1800
                Detection = $null
            } }
            'WindowsComponent' { @{ Kind = 'Capability'; Names = @(); Source = ''; LimitAccess = $false } }
        }
    }
    $draft = [pscustomobject]@{
        SchemaVersion = 2; ApplicationId = [guid]::NewGuid().ToString('D'); Type = $Type
        Enabled = $true; RestartRequired = $RestartRequired
        Definition = @{ Name = $Name; Type = $Type; InstallEnabled = $true; Configuration = $Configuration }
        Settings = [pscustomobject]@{}
    } | ConvertTo-Json -Depth 20 | ConvertFrom-Json
    if ($componentDraft) { return $draft }
    ConvertTo-PAWManagedApplication $draft
}
<#
.SYNOPSIS
    Uses the structured WinGet PowerShell client API to discover application identities.
.NOTES
    Version : 2.0.0.5
    Author  : The Fantastic PAWDeploy Team
#>
function New-PAWWinGetApplication {
    [CmdletBinding(SupportsShouldProcess)]
    param([Parameter(Mandatory)][string]$Root, [string]$ApplicationId,
        [Parameter(Mandatory)][string]$Id, [string]$Name,
        [ValidateSet('x86','x64','arm64','NA')][string]$Architecture = 'NA',
        [ValidateSet('Machine','User','NA')][string]$Scope = 'NA',
        [string]$InstallerType = 'NA', [bool]$RestartRequired = $false)
    if ([string]::IsNullOrWhiteSpace($ApplicationId)) { $ApplicationId = [guid]::NewGuid().ToString('D') }
    Test-PAWApplicationKey $ApplicationId
    if (-not $PSCmdlet.ShouldProcess($Id, 'Look up WinGet package and create application JSON')) { return }
    $package = @(Find-PAWWinGetApplication -Id $Id)
    if ($package.Count -ne 1) { throw "Expected one exact WinGet match for '$Id', found $($package.Count)." }
    if ($package[0].Id -ne $Id) { throw "WinGet returned '$($package[0].Id)' instead of requested package '$Id'." }
    if (-not $Name) { $Name = $package[0].Name }
    $app = New-PAWManagedApplication -Type WinGet -Name $Name -RestartRequired $RestartRequired -Configuration @{
        Id = $package[0].Id; Architecture = $Architecture; Scope = $Scope; InstallerType = $InstallerType
    }
    $app.ApplicationId = $ApplicationId
    Save-PAWManagedApplication -Root $Root -Application $app -Confirm:$false
}
function Remove-PAWApplication {
    <#
    .SYNOPSIS
        Removes an application only when it is not assigned to a bundle.
    .DESCRIPTION
        Retains cached files and payloads. Removing an application never edits
        its bundles through this command.
    .PARAMETER InputObject
        Application object returned by Get-PAWApplication.
    .PARAMETER Name
        Exact application name.
    .PARAMETER ApplicationId
        Application GUID.
    .PARAMETER Root
        Resources folder; defaults to this module's installation.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High', DefaultParameterSetName = 'Input')]
    param(
        [Parameter(Mandatory, ValueFromPipeline, ParameterSetName = 'Input')][object]$InputObject,
        [Parameter(Mandatory, ParameterSetName = 'Name')][string]$Name,
        [Parameter(Mandatory, ParameterSetName = 'Id')][string]$ApplicationId,
        [string]$Root = $script:PAWApplicationResourcesRoot
    )
    process {
        $apps = @(Get-PAWApplicationCatalog -Root $Root)
        $matches = switch ($PSCmdlet.ParameterSetName) {
            'Name' { @($apps | Where-Object { $_.Definition.Name -eq $Name }) }
            'Id' { @($apps | Where-Object ApplicationId -eq $ApplicationId) }
            default {
                if ($null -eq $InputObject.PSObject.Properties['ApplicationId']) { throw 'Input object must have an ApplicationId.' }
                @($apps | Where-Object ApplicationId -eq $InputObject.ApplicationId)
            }
        }
        $matches = @($matches)
        if ($matches.Count -ne 1) { throw "Expected one application; found $($matches.Count)." }
        $app = $matches[0]
        $assigned = @(Get-PAWApplicationBundle -Root $Root | Where-Object { $_.Applications -contains $app.ApplicationId })
        if ($assigned.Count) { throw "Application '$($app.Definition.Name)' is referenced by bundles: $($assigned.Name -join ', ')." }
        if ($PSCmdlet.ShouldProcess("$($app.Definition.Name) ($($app.ApplicationId))", 'Remove application; retain cached files')) {
            Remove-PAWManagedApplication -Root $Root -ApplicationId $app.ApplicationId -BlockIfAssigned -Confirm:$false
        }
    }
}
<#
.SYNOPSIS
    Reads, writes and removes managed applications and bundles.
.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team
#>
function Remove-PAWApplicationBundle {
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High', DefaultParameterSetName = 'Id')]
    param(
        [string]$Root = $script:PAWApplicationResourcesRoot,
        [Parameter(Mandatory, ValueFromPipelineByPropertyName, ParameterSetName = 'Id')][string]$BundleId,
        [string]$ConfigPath = (Join-Path (Split-Path -Parent ([IO.Path]::GetFullPath($Root))) 'Config\Config.json'),
        [Parameter(Mandatory, ParameterSetName = 'Name')][string]$Name
    )
    process {
        $bundle = if ($PSCmdlet.ParameterSetName -eq 'Name') {
            Get-PAWApplicationBundle -Root $Root -Name $Name
        } else { Get-PAWApplicationBundle -Root $Root -BundleId $BundleId }
        $BundleId = $bundle.BundleId
        Assert-PAWBundleUnreferenced -ConfigPath $ConfigPath -BundleId $BundleId
        if ($PSCmdlet.ShouldProcess("$($bundle.Name) ($BundleId)", 'Remove application bundle')) {
            $lock = Enter-PAWBundleWriteLock -Root $Root
            try {
                $null = Get-PAWApplicationBundle -Root $Root -BundleId $BundleId
                Assert-PAWBundleUnreferenced -ConfigPath $ConfigPath -BundleId $BundleId
                Remove-Item -LiteralPath (Join-Path $Root "ApplicationBundles\$BundleId.json") -ErrorAction Stop
            }
            finally { $lock.Dispose() }
            Write-PAWApplicationManagerLog "Removed bundle '$BundleId'."
        }
    }
}
function Remove-PAWApplicationFromBundle {
    <#
    .SYNOPSIS
        Removes application assignments from a bundle without deleting applications.
    .DESCRIPTION
        All specified applications must be members. Remaining installation order
        is preserved, and an empty pipeline does not change the bundle.
    .PARAMETER InputObject
        Application object with an ApplicationId property, or an ID string.
    .PARAMETER ApplicationId
        Application ID supplied directly instead of through the pipeline.
    .PARAMETER Bundle
        Exact, unique bundle name.
    .PARAMETER BundleId
        Bundle GUID, including when names are ambiguous.
    .PARAMETER Root
        Resources folder; defaults to this module's installation.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High', DefaultParameterSetName = 'Name')]
    param(
        [Parameter(ValueFromPipeline)][AllowNull()][object]$InputObject,
        [ValidateNotNullOrEmpty()][string]$ApplicationId,
        [Parameter(Mandatory, ParameterSetName = 'Name')][ValidateNotNullOrEmpty()][string]$Bundle,
        [Parameter(Mandatory, ParameterSetName = 'Id')][ValidateNotNullOrEmpty()][string]$BundleId,
        [string]$Root = $script:PAWApplicationResourcesRoot
    )
    begin { $ids = @{} }
    process {
        $id = Get-PAWInputApplicationId -InputObject $InputObject -ApplicationId $ApplicationId `
            -HasInput $PSBoundParameters.ContainsKey('InputObject') -HasId $PSBoundParameters.ContainsKey('ApplicationId')
        $ids[$id] = $true
    }
    end {
        if ($ids.Count -eq 0) { return }
        $selector = if ($PSCmdlet.ParameterSetName -eq 'Id') { @{ BundleId = $BundleId } } else { @{ Name = $Bundle } }
        $target = Get-PAWApplicationBundle -Root $Root @selector
        foreach ($id in $ids.Keys) {
            if ($target.Applications -notcontains $id) { throw "Application '$id' is not in bundle '$($target.Name)'." }
        }
        if (-not $PSCmdlet.ShouldProcess($target.Name, "Remove $($ids.Count) application assignment(s)")) { return }
        $lock = Enter-PAWBundleWriteLock -Root $Root
        try {
            $target = Get-PAWApplicationBundle -Root $Root -BundleId $target.BundleId
            foreach ($id in $ids.Keys) {
                if ($target.Applications -notcontains $id) { throw "Application '$id' is not in bundle '$($target.Name)'." }
            }
            $target.Applications = @($target.Applications | Where-Object { -not $ids.ContainsKey($_) })
            Write-PAWManagerJson (Join-Path $Root "ApplicationBundles\$($target.BundleId).json") $target
        }
        finally { $lock.Dispose() }
        Write-PAWApplicationManagerLog "Removed $($ids.Count) application assignment(s) from bundle '$($target.BundleId)'."
        $target
    }
}
function Remove-PAWCachedApplication {
    <#
    .SYNOPSIS
        Removes a selected local cache or package folder.
    .DESCRIPTION
        Deletes the entire selected folder, including manually supplied files.
        Application definitions and bundles are retained.
    .PARAMETER InputObject
        Cache object returned by Get-PAWCachedApplication.
    .PARAMETER Name
        Name of an application with exactly one cached folder.
    .PARAMETER Path
        Exact path of a folder listed by Get-PAWCachedApplication.
    .PARAMETER Root
        Resources folder; defaults to this module's installation.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High', DefaultParameterSetName = 'Input')]
    param(
        [Parameter(Mandatory, ValueFromPipeline, ParameterSetName = 'Input')][object]$InputObject,
        [Parameter(Mandatory, ParameterSetName = 'Name')][string]$Name,
        [Parameter(Mandatory, ParameterSetName = 'Path')][string]$Path,
        [string]$Root = $script:PAWApplicationResourcesRoot
    )
    process {
        $caches = @(Get-PAWCachedApplication -Root $Root)
        $matches = switch ($PSCmdlet.ParameterSetName) {
            'Name' { @($caches | Where-Object Name -eq $Name) }
            'Path' { @($caches | Where-Object Path -eq $Path) }
            default {
                if ($null -eq $InputObject.PSObject.Properties['Path']) { throw 'Input object must have a Path from Get-PAWCachedApplication.' }
                @($caches | Where-Object Path -eq $InputObject.Path)
            }
        }
        $paths = @($matches | Select-Object -ExpandProperty Path -Unique)
        if ($paths.Count -ne 1) { throw "Expected one cached folder; found $($paths.Count)." }
        $target = [IO.Path]::GetFullPath($paths[0])
        $folder = Get-Item -LiteralPath $target -Force -ErrorAction Stop
        $ancestor = $folder
        while ($null -ne $ancestor) {
            if ($ancestor.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "Refusing removal through a reparse point: '$($ancestor.FullName)'." }
            $ancestor = $ancestor.Parent
        }
        $null = @(Get-PAWApplicationPayloadFiles -Root $target)
        if ($PSCmdlet.ShouldProcess($target, 'Remove all cached and manually supplied files in this folder')) {
            $null = @(Get-PAWApplicationPayloadFiles -Root $target)
            Remove-Item -LiteralPath $target -Recurse -Force -ErrorAction Stop
            Write-PAWApplicationManagerLog "Removed cached application folder '$target'; catalog and bundles retained."
        }
    }
}
<#
.SYNOPSIS
    Removes an application and its membership in every bundle, retaining payloads.
.NOTES
    Version : 2.0.0.4
    Author  : The Fantastic PAWDeploy Team
#>
function Remove-PAWManagedApplication {
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    param([Parameter(Mandatory)][string]$Root, [Parameter(Mandatory)][string]$ApplicationId, [switch]$BlockIfAssigned)
    Test-PAWApplicationKey $ApplicationId
    $app = @(Get-PAWApplicationCatalog -Root $Root | Where-Object ApplicationId -eq $ApplicationId)
    if ($app.Count -ne 1) { throw "Application '$ApplicationId' not found." }
    $catalogPath = Get-PAWApplicationCatalogFilePath -Root $Root -Application $app[0]
    $references = @(Get-PAWApplicationBundle -Root $Root | Where-Object { $_.Applications -contains $ApplicationId })
    if ($BlockIfAssigned -and $references.Count) { throw "Application '$ApplicationId' is referenced by bundles: $($references.Name -join ', ')." }
    if ($PSCmdlet.ShouldProcess($ApplicationId, "Remove application definition and membership in $($references.Count) bundles; retain cache and installers")) {
        $lock = Enter-PAWBundleWriteLock -Root $Root
        try {
            $references = @(Get-PAWApplicationBundle -Root $Root | Where-Object { $_.Applications -contains $ApplicationId })
            if ($BlockIfAssigned -and $references.Count) { throw "Application '$ApplicationId' is referenced by bundles: $($references.Name -join ', ')." }
            $originals = @{}
            try {
                foreach ($bundle in $references) {
                    $path = Join-Path $Root "ApplicationBundles\$($bundle.BundleId).json"
                    $originals[$path] = [IO.File]::ReadAllBytes($path)
                    $bundle.Applications = @($bundle.Applications | Where-Object { $_ -ne $ApplicationId })
                    Write-PAWManagerJson $path $bundle
                }
                Remove-Item -LiteralPath $catalogPath -ErrorAction Stop
            }
            catch {
                $failure = $_
                $rollbackErrors = New-Object 'System.Collections.Generic.List[string]'
                foreach ($path in $originals.Keys) {
                    try { [IO.File]::WriteAllBytes($path, $originals[$path]) }
                    catch { $rollbackErrors.Add("'${path}': $($_.Exception.Message)") }
                }
                if ($rollbackErrors.Count) {
                    throw "Application removal failed: $($failure.Exception.Message). Bundle rollback also failed: $($rollbackErrors -join '; ')."
                }
                throw $failure
            }
        }
        finally { $lock.Dispose() }
        Write-PAWApplicationManagerLog "Removed application '$ApplicationId' from catalog and bundles [$($references.BundleId -join ', ')]; cache retained."
    }
}
<#
.SYNOPSIS
    Reads, writes and removes managed applications and bundles.
.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team
#>
function Resolve-PAWApplicationBundle {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$Root, [Parameter(Mandatory)][string]$BundleId)
    $bundle = Get-PAWApplicationBundle -Root $Root -BundleId $BundleId
    $apps = @(Get-PAWApplicationCatalog -Root $Root)
    $settings = @{}
    $disabled = @()
    $definitions = @(foreach ($id in $bundle.Applications) {
        $app = $apps | Where-Object ApplicationId -eq $id
        if ($app.Enabled) {
            $settings[$app.Definition.Name] = $app.Settings
            ConvertTo-PAWApplicationRuntimeDefinition -Application $app
        }
        else { $disabled += $id }
    })
    [pscustomobject]@{
        BundleId = $bundle.BundleId
        Applications = $definitions
        Settings = $settings
        DisabledApplications = $disabled
    }
}
<#
.SYNOPSIS
    Reads, writes and removes managed applications and bundles.
.NOTES
    Version : 2.0.0.3
    Author  : The Fantastic PAWDeploy Team
#>
function Save-PAWApplicationBundle {
    [CmdletBinding(SupportsShouldProcess)]
    param([Parameter(Mandatory)][string]$Root, [Parameter(Mandatory)][object]$Bundle, [switch]$Replace)
    if ($Bundle -is [System.Collections.IDictionary]) { $Bundle = $Bundle | ConvertTo-Json -Depth 20 | ConvertFrom-Json }
    if ([string]::IsNullOrWhiteSpace([string]$Bundle.BundleId)) {
        if ($Replace) { throw 'BundleId is required when replacing a bundle.' }
        $Bundle = $Bundle.PSObject.Copy()
        $Bundle | Add-Member -NotePropertyName BundleId -NotePropertyValue ([guid]::NewGuid().ToString('D')) -Force
    }
    $value = ConvertTo-PAWManagedBundle $Bundle @(Get-PAWApplicationCatalog -Root $Root) -SkipDuplicates
    $path = Join-Path $Root "ApplicationBundles\$($value.BundleId).json"
    if ((Test-Path -LiteralPath $path) -and -not $Replace) { throw "Bundle '$($value.BundleId)' exists; use Replace." }
    Assert-PAWBundleNameAvailable -Root $Root -Bundle $value
    if ($PSCmdlet.ShouldProcess($path, 'Save application bundle')) {
        $lock = Enter-PAWBundleWriteLock -Root $Root
        try {
            if ((Test-Path -LiteralPath $path) -and -not $Replace) { throw "Bundle '$($value.BundleId)' exists; use Replace." }
            $value = ConvertTo-PAWManagedBundle $value @(Get-PAWApplicationCatalog -Root $Root) -SkipDuplicates
            Assert-PAWBundleNameAvailable -Root $Root -Bundle $value
            Write-PAWManagerJson $path $value
        }
        finally { $lock.Dispose() }
        Write-PAWApplicationManagerLog "Saved bundle '$($value.BundleId)' with $($value.Applications.Count) applications."
        $value
    }
}
<#
.SYNOPSIS
    Reads, writes and removes managed applications and bundles.
.NOTES
    Version : 2.0.0.6
    Author  : The Fantastic PAWDeploy Team
#>
function Save-PAWManagedApplication {
    [CmdletBinding(SupportsShouldProcess)]
    param([Parameter(Mandatory)][string]$Root, [Parameter(Mandatory)][object]$Application,
        [switch]$Replace, [string]$SourceFolder)
    if ($Application -is [System.Collections.IDictionary]) { $Application = $Application | ConvertTo-Json -Depth 20 | ConvertFrom-Json }
    if ([string]::IsNullOrWhiteSpace([string]$Application.ApplicationId)) {
        if ($Replace) { throw 'ApplicationId is required when replacing an application.' }
        $Application = $Application.PSObject.Copy()
        $Application | Add-Member -NotePropertyName ApplicationId -NotePropertyValue ([guid]::NewGuid().ToString('D')) -Force
    }
    $app = ConvertTo-PAWManagedApplication $Application
    if ($SourceFolder -and ($app.SchemaVersion -ne 2 -or -not (
        ($app.Type -eq 'WindowsComponent' -and $app.Definition.Configuration.Source -eq 'Source') -or
        ($app.Type -eq 'Classic' -and $null -ne $app.Definition.Configuration.PSObject.Properties['FolderPath'])))) {
        throw "SourceFolder requires a Classic application with FolderPath or a WindowsComponent application with Configuration.Source set to 'Source'."
    }
    $apps = @(Get-PAWApplicationCatalog -Root $Root)
    $targetFile = Get-PAWApplicationInstallFilePath -InstallRoot (Join-Path $Root 'Applications\InstallFiles') -Name $app.Definition.Name
    if (@($apps | Where-Object { $_.ApplicationId -ne $app.ApplicationId -and
        (Get-PAWApplicationInstallFilePath -InstallRoot (Join-Path $Root 'Applications\InstallFiles') -Name $_.Definition.Name) -eq $targetFile }).Count) {
        throw "Application name '$($app.Definition.Name)' is already used."
    }
    $old = $apps | Where-Object ApplicationId -eq $app.ApplicationId
    if ($old -and -not $Replace) { throw "Application '$($app.ApplicationId)' exists; use Replace." }
    if ($old -and $old.Definition.Name -ne $app.Definition.Name) {
        throw 'Application display names are immutable because cache/install filenames use them. Create a new application to use another name.'
    }
    $path = Get-PAWApplicationCatalogPath -Root $Root -Application $app
    if ($PSCmdlet.ShouldProcess($path, 'Save application definition')) {
        $existingPath = if ($old) { Get-PAWApplicationCatalogFilePath -Root $Root -Application $old } else { $path }
        $movedFromLegacy = $existingPath -ne $path
        $originalBytes = $null
        if ($movedFromLegacy) {
            $originalBytes = [IO.File]::ReadAllBytes($existingPath)
            [IO.File]::Move($existingPath, $path)
        }
        try {
            if ($SourceFolder) {
                Save-PAWApplicationSource -Root $Root -Application $app -SourceFolder $SourceFolder -CatalogPath $path
            }
            else {
                if ($app.Type -eq 'Classic' -and $null -ne $app.Definition.Configuration.Detection -and
                    $null -ne $app.Definition.Configuration.Detection.PSObject.Properties['ScriptPath']) {
                    $runtime = ConvertTo-PAWApplicationRuntimeDefinition -Application $app
                    $null = Test-PAWApplicationResources -Application $runtime -AppInstallRoot $Root
                }
                Write-PAWManagerJson $path $app
            }
        }
        catch {
            $failure = $_
            if ($movedFromLegacy) {
                try {
                    if (Test-Path -LiteralPath $path -PathType Leaf) { Remove-Item -LiteralPath $path -Force -ErrorAction Stop }
                    [IO.File]::WriteAllBytes($existingPath, $originalBytes)
                }
                catch { throw "Application save failed: $($failure.Exception.Message). Catalog filename rollback failed: $($_.Exception.Message)." }
            }
            throw $failure
        }
        Write-PAWApplicationManagerLog "Saved application '$($app.ApplicationId)'. Enabled=$($app.Enabled)."
        $app
    }
}
<#
.SYNOPSIS
    Reads, writes and removes managed applications and bundles.
.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team
#>
function Set-PAWTemplateApplicationBundle {
    [CmdletBinding(SupportsShouldProcess)]
    param([Parameter(Mandatory)][string]$Root, [Parameter(Mandatory)][string]$BundleId,
        [Parameter(Mandatory)][string]$ConfigPath, [Parameter(Mandatory)][string]$TemplateName)
    $null = Get-PAWApplicationBundle -Root $Root -BundleId $BundleId
    $templates = Get-PAWTemplateCollection -TemplateFolder (Split-Path -Parent $ConfigPath)
    $template = @($templates | Where-Object Name -eq $TemplateName)
    if ($template.Count -ne 1) { throw "Template '$TemplateName' not found or ambiguous." }
    $entry = @(Get-ChildItem -LiteralPath (Split-Path -Parent $ConfigPath) -Filter '*.json' -File |
        Where-Object Name -ne 'Config.json' | Where-Object { (Read-PAWManagerJson $_.FullName).Name -eq $TemplateName })
    if ($entry.Count -ne 1) { throw "Template file for '$TemplateName' is ambiguous." }
    $data = Read-PAWManagerJson $entry[0].FullName
    $data | Add-Member -NotePropertyName ApplicationBundle -NotePropertyValue $BundleId -Force
    if ($PSCmdlet.ShouldProcess($entry[0].FullName, "Assign application bundle '$BundleId'")) {
        $lock = Enter-PAWBundleWriteLock -Root $Root
        try {
            $null = Get-PAWApplicationBundle -Root $Root -BundleId $BundleId
            Write-PAWManagerJson $entry[0].FullName $data
        }
        finally { $lock.Dispose() }
        Write-PAWApplicationManagerLog "Assigned bundle '$BundleId' to template '$TemplateName'."
        $data
    }
}
