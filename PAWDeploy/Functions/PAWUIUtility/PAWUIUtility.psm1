<#

.SYNOPSIS
    Applies the PAWDeploy visual theme to a button control.

.DESCRIPTION
    Applies the theme, standard text-button size and one-pixel button border.
    Help, Close, Logs and small icon buttons retain their supplied dimensions.

.PARAMETER Button
    Button control whose visual theme is updated.

.PARAMETER Accent
    Apply orange accent colors with dark text for contrast.

.PARAMETER DarkText
    Use dark foreground text instead of the default light text.

.NOTES
    Version : 2.0.0.8
    Author  : The Fantastic PAWDeploy Team

#>
function Set-PAWThemedButton {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [System.Windows.Forms.Button]$Button,

        [Parameter(Mandatory = $false)]
        [switch]$Accent,

        [Parameter(Mandatory = $false)]
        [switch]$DarkText
    )

    $buttonFont = [System.Drawing.Font]::new('Segoe UI', 11, [System.Drawing.FontStyle]::Bold)
    $palette = Get-PAWUiPalette

    $Button.FlatStyle = [System.Windows.Forms.FlatStyle]::Flat
    $Button.FlatAppearance.BorderSize = 1
    $Button.FlatAppearance.BorderColor = $palette.ButtonBorder
    $Button.UseVisualStyleBackColor = $false
    $Button.FlatAppearance.MouseOverBackColor = $palette.ButtonHover
    $Button.FlatAppearance.MouseDownBackColor = $palette.ButtonPressed
    $Button.Font = $buttonFont
    $iconButton = ($null -ne $Button.Image -or $Button.Text.Length -le 2) -and $Button.Width -le 40
    if ($Button.Text -notin @('Help', 'Close', 'Logs') -and -not $iconButton) {
        $Button.AutoSize = $false
        $Button.Size = New-Object System.Drawing.Size(200, 30)
    }
    if ($Accent) {
        $Button.BackColor = $palette.Accent
        $Button.ForeColor = if ($DarkText) { $palette.Background } else { $palette.AccentText }
        $Button.FlatAppearance.MouseOverBackColor = $palette.AccentHover
        $Button.FlatAppearance.MouseDownBackColor = $palette.AccentPressed
    }
    else {
        $Button.BackColor = $palette.Panel
        $Button.ForeColor = $palette.Text
    }
}
function Set-PAWUiDarkBackground {
    <#
    .SYNOPSIS
        Applies the selected toolkit theme to a control tree.
