function Assert-PAWInstallerHash {
    <#
    .SYNOPSIS
        Verifies a cached installer against its recorded SHA256.
    .DESCRIPTION
        Throws on missing/invalid hashes, unreadable files or hash mismatch.
        Does not establish publisher trust or update the recorded hash.
    .PARAMETER Path
        Installer file to verify on the host or guest.
    .PARAMETER ExpectedHash
        SHA256 recorded at download time.
    .PARAMETER ApplicationName
        Application name used in corrective error messages.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][AllowNull()][AllowEmptyString()][string]$ExpectedHash,
        [Parameter(Mandatory)][string]$ApplicationName
    )
    $action = "Run Invoke-PAWApplicationDownload.ps1 -Name '$($ApplicationName.Replace("'", "''"))' -Force on the host, then restage the application before installing."
    if ($ExpectedHash -notmatch '\A[0-9a-fA-F]{64}\z') {
        throw "Installer hash unavailable or invalid for '$ApplicationName', file '$Path'. Expected SHA256: '$ExpectedHash'; actual: not checked. $action"
    }
    try { $actualHash = (Get-FileHash -LiteralPath $Path -Algorithm SHA256 -ErrorAction Stop).Hash }
    catch { throw "Cannot verify installer for '$ApplicationName', file '$Path'. Expected SHA256: '$ExpectedHash'; actual: unavailable. $($_.Exception.Message) $action" }
    if ($actualHash -ne $ExpectedHash) {
        throw "Installer hash mismatch for '$ApplicationName', file '$Path'. Expected SHA256: '$ExpectedHash'; actual SHA256: '$actualHash'. $action"
    }
}
Function Clear-PAWVolume {
    <#
    .SYNOPSIS
        Clears a physical disk identified by its volume label.

    .DESCRIPTION
        Clear-PAWVolume locates the physical disk that hosts the volume with the
        specified file-system label, then wipes it completely using Clear-Disk with
        the -RemoveData and -RemoveOEM switches.

        For safety and predictable behavior, the function:
            - Requires exactly one matching volume label.
            - Throws if no matching volume is found.
            - Throws if the label matches multiple volumes.
            - Supports -WhatIf and -Confirm via ShouldProcess.

        All partitions, data, and OEM partitions on the selected disk are
        permanently destroyed when the operation is confirmed.

    .PARAMETER VolumeLabel
        The file-system label of the volume whose parent disk should be cleared.
        This is the label shown in File Explorer (e.g. "USB_DRIVE", "DataDisk").

    .EXAMPLE
        Clear-PAWVolume -VolumeLabel "USB_DRIVE"

        Finds the disk hosting the volume labelled "USB_DRIVE" and wipes it,
        removing all data and OEM partitions.

    .EXAMPLE
        Clear-PAWVolume -VolumeLabel "DataDisk" -WhatIf

        Shows what disk would be cleared without making changes.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

        WARNING: This operation is irreversible.  All data on the target disk is
        permanently deleted.  Ensure the correct volume label is supplied before
        calling this function.

        Requires the Storage module (available by default on Windows 8.1 / Server
        2012 R2 and later).  Must be run with sufficient privileges to clear a disk
        (typically Administrator).

    #>

    [cmdletbinding(SupportsShouldProcess = $true, ConfirmImpact = 'High')]

    Param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$VolumeLabel
    )

    $volumes = @(Get-Volume -FileSystemLabel $VolumeLabel -ErrorAction SilentlyContinue)
    if ($volumes.Count -eq 0) {
        throw "No volume found with label '$VolumeLabel'."
    }

    if ($volumes.Count -gt 1) {
        throw "Volume label '$VolumeLabel' matches multiple volumes. Use a unique label before clearing a disk."
    }

    $disk = $volumes | Get-Partition | Get-Disk -ErrorAction Stop
    $target = "Disk #$($disk.Number) ('$($disk.FriendlyName)') for volume label '$VolumeLabel'"

    if ($PSCmdlet.ShouldProcess($target, 'Clear disk (remove data and OEM partitions)')) {
        Clear-Disk -Number $disk.Number -RemoveData -RemoveOEM -Confirm:$false -ErrorAction Stop
        Write-Verbose "Cleared $target"
    }
}
