<#
.SYNOPSIS
    Provides application/bundle Windows Forms backed exclusively by the CLI script.
.NOTES
    Version : 2.0.0.10
    Author  : The Fantastic PAWDeploy Team
#>
function Show-PAWApplicationManagerFields {
    param([Windows.Forms.Form]$Owner, [string]$Title, [System.Collections.IDictionary]$Fields,
        [hashtable]$Choices = @{}, [string]$HelpText,
        [string[]]$FolderFields = @(), [ref]$SelectedFolders, [string[]]$MultilineFields = @(),
        [hashtable]$FileFields = @{}, [string]$PayloadFolder)
    $dialog = New-Object Windows.Forms.Form
    $dialog.Text = $Title
    $dialog.Size = New-Object Drawing.Size(680, ([Math]::Min(740, 180 + $Fields.Count * 35 + ($FolderFields.Count + $FileFields.Count) * 35 + $MultilineFields.Count * 100)))
    $dialog.StartPosition = 'CenterParent'
    $panel = New-Object Windows.Forms.Panel
    $panel.Dock = 'Fill'
    $panel.AutoScroll = $true
    $dialog.Controls.Add($panel)
    $controls = @{}
    $folderSelections = @{}
    $y = 15
    if ($HelpText) {
        $helpLabel = New-Object Windows.Forms.Label
        $helpLabel.Text = $HelpText
        $helpLabel.Location = New-Object Drawing.Point(15, $y)
        $helpLabel.MaximumSize = New-Object Drawing.Size(600, 0)
        $helpLabel.AutoSize = $true
        $panel.Controls.Add($helpLabel)
        $y += $helpLabel.PreferredSize.Height + 10
    }
    foreach ($key in $Fields.Keys) {
        $label = New-Object Windows.Forms.Label
        $label.Name = "${key}Label"
        $label.Text = if ($key -eq 'RestartRequired') { 'Restart Required' } else { $key }
        $label.Location = New-Object Drawing.Point(15, $y)
        $label.Size = New-Object Drawing.Size(165, 24)
        $label.TextAlign = 'MiddleLeft'
        $textbox = if ($Choices.ContainsKey($key)) {
            $combo = New-Object Windows.Forms.ComboBox
            $combo.DropDownStyle = 'DropDownList'
            foreach ($choice in $Choices[$key]) { $null = $combo.Items.Add([string]$choice) }
            if (-not $combo.Items.Contains([string]$Fields[$key])) { $null = $combo.Items.Add([string]$Fields[$key]) }
            $combo.SelectedItem = [string]$Fields[$key]
            $combo
        } elseif ($Fields[$key] -is [bool]) {
            $checkbox = New-Object Windows.Forms.CheckBox
            $checkbox.Checked = $Fields[$key]
            $checkbox
        } else {
            $inputBox = New-Object Windows.Forms.TextBox
            if ($key -in $MultilineFields) {
                $inputBox.Multiline = $true
                $inputBox.AcceptsReturn = $true
                $inputBox.ScrollBars = 'Both'
                $inputBox.Height = 120
            }
            $inputBox.Text = [string]$Fields[$key]
            $inputBox
        }
        $textbox.Name = $key
        $textbox.Location = New-Object Drawing.Point(190, $y)
        $textbox.Width = 440
        $controls[$key] = $textbox
        $panel.Controls.AddRange(@($label, $textbox))
        if ($key -in $FolderFields -or $FileFields.ContainsKey($key)) {
            $textbox.ReadOnly = $true
            $browse = New-PAWUiButton -Text 'Browse...' -Width 85 -Height 24
            $browse.Name = "${key}Browse"
            $browse.AccessibleName = "Browse $key"
            $browse.Location = New-Object Drawing.Point(190, ($y + 30))
            $browse.Add_Click({
                if ($FileFields.ContainsKey($key)) {
                    $picker = $null
                    try {
                        $sourceText = $controls[$FileFields[$key]].Text
                        $sourceRoot = if ([IO.Path]::IsPathRooted($sourceText)) { $sourceText } else { $PayloadFolder }
                        if (-not $sourceRoot -or -not (Test-Path -LiteralPath $sourceRoot -PathType Container)) {
                            throw 'Browse to the application FolderPath before selecting a detection script.'
                        }
                        $sourceRoot = (Get-Item -LiteralPath $sourceRoot -Force -ErrorAction Stop).FullName.TrimEnd('\')
                        $picker = New-Object Windows.Forms.OpenFileDialog
                        $picker.Title = 'Select detection script inside the application folder'
                        $picker.Filter = 'PowerShell script (*.ps1)|*.ps1'
                        $picker.CheckFileExists = $true
                        $picker.InitialDirectory = $sourceRoot
                        if ($picker.ShowDialog($dialog) -eq 'OK') {
                            $file = Get-Item -LiteralPath $picker.FileName -Force -ErrorAction Stop
                            if ($file.PSIsContainer -or $file.Extension -ine '.ps1' -or
                                -not $file.FullName.StartsWith($sourceRoot + '\', [StringComparison]::OrdinalIgnoreCase)) {
                                throw 'Detection script must be a .ps1 file inside the application folder.'
                            }
                            $relative = $file.FullName.Substring($sourceRoot.Length + 1)
                            $null = Resolve-PAWApplicationPayloadPath -PackageRoot $sourceRoot -RelativePath $relative
                            $textbox.Text = '%App%\' + $relative
                        }
                    }
                    catch {
                        Show-PAWUiError -Title $Title -ErrorRecord $_ -Owner $dialog -Copyable -LogPath (Join-Path (Resolve-PAWLogFolder) 'PAWApplicationManager.log')
                    }
                    finally { if ($null -ne $picker) { $picker.Dispose() } }
                    return
                }
                $picker = New-Object Windows.Forms.FolderBrowserDialog
                $picker.Description = 'Select application source folder. Files are copied into the application package when you save.'
                $picker.ShowNewFolderButton = $false
                if ([IO.Path]::IsPathRooted($textbox.Text) -and (Test-Path -LiteralPath $textbox.Text -PathType Container)) {
                    $picker.SelectedPath = $textbox.Text
                }
                try {
                    if ($picker.ShowDialog($dialog) -eq 'OK') {
                        $textbox.Text = $picker.SelectedPath
                        $folderSelections[$key] = $picker.SelectedPath
                    }
                }
                finally { $picker.Dispose() }
            }.GetNewClosure())
            $clear = New-PAWUiButton -Text 'Clear' -Width 70 -Height 24
            $clear.Name = "${key}Clear"
            $clear.AccessibleName = "Clear $key"
            $clear.Location = New-Object Drawing.Point(400, ($y + 30))
            $clear.Add_Click({
                $textbox.Text = ''
                if ($key -in $FolderFields) { $folderSelections[$key] = '' }
            }.GetNewClosure())
            $panel.Controls.AddRange(@($browse, $clear))
        }
        $y += if ($key -in $MultilineFields) { 135 } elseif ($key -in $FolderFields -or $FileFields.ContainsKey($key)) { 70 } else { 35 }
    }
    $buttons = New-Object Windows.Forms.FlowLayoutPanel
    $buttons.Dock = 'Bottom'
    $buttons.Height = 45
    $ok = New-PAWUiButton -Text 'OK' -Width 100 -Height 30 -Accent
    $ok.DialogResult = 'OK'
    $cancel = New-PAWUiButton -Text 'Cancel' -Width 100 -Height 30
    $cancel.DialogResult = 'Cancel'
    $buttons.Controls.AddRange(@($ok, $cancel))
    $dialog.Controls.Add($buttons)
    $dialog.AcceptButton = $ok
    $dialog.CancelButton = $cancel
    try {
        Set-PAWUiTheme -Control $dialog
        if ($dialog.ShowDialog($Owner) -eq 'OK') {
            if ($null -ne $SelectedFolders) { $SelectedFolders.Value = $folderSelections }
            $values = @{}
            foreach ($key in $controls.Keys) {
                $values[$key] = if ($controls[$key] -is [Windows.Forms.CheckBox]) { $controls[$key].Checked } else { $controls[$key].Text }
            }
            return $values
        }
    }
    finally { $dialog.Dispose() }
}
<#
.SYNOPSIS
    Selects the application form without requiring WinGet discovery.
.NOTES
    Version : 2.0.0.4
    Author  : The Fantastic PAWDeploy Team
#>
function Show-PAWApplicationTypePicker {
    param([Windows.Forms.Form]$Owner, [switch]$CreateOnly)
    $dialog = New-Object Windows.Forms.Form
    $returnForm = $false
    try {
        $dialog.Text = 'New Application - select type'
        $dialog.ClientSize = New-Object Drawing.Size(460, 240)
        $dialog.StartPosition = 'CenterParent'
        $dialog.Font = [System.Drawing.Font]::new('Segoe UI', 10)
        $dialog.Add_Disposed({ param($sender, $eventArgs) $sender.Font.Dispose() })
        $dialog.Padding = New-Object Windows.Forms.Padding(12)
        $list = New-Object Windows.Forms.ListBox
        $list.Name = 'ApplicationTypes'
        $list.Dock = 'Fill'
        $list.IntegralHeight = $false
        $list.DisplayMember = 'Name'
        foreach ($type in @(
            @{ Name = 'WinGet Application'; Type = 'WinGet' }
            @{ Name = 'PowerShell Module'; Type = 'PowerShellModule' }
            @{ Name = 'Classic Application'; Type = 'Classic' }
            @{ Name = 'Windows Component'; Type = 'WindowsComponent' }
        )) { $null = $list.Items.Add([pscustomobject]$type) }
        $list.SelectedIndex = 0
        $buttons = New-Object Windows.Forms.FlowLayoutPanel
        $buttons.Dock = 'Bottom'
        $buttons.Height = 45
        $ok = New-PAWUiButton -Text 'Next' -Width 100 -Height 32 -Accent
        $ok.DialogResult = 'OK'
        $cancel = New-PAWUiButton -Text 'Cancel' -Width 100 -Height 32
        $cancel.DialogResult = 'Cancel'
        $buttons.Controls.AddRange(@($ok, $cancel))
        $dialog.Controls.AddRange(@($list, $buttons))
        $dialog.AcceptButton = $ok
        $dialog.CancelButton = $cancel
        Set-PAWUiTheme -Control $dialog
        $list.ItemHeight = [Math]::Max(32, [Windows.Forms.TextRenderer]::MeasureText('Ag', $list.Font).Height + 12)
        if ($CreateOnly) { $returnForm = $true; return $dialog }
        if ($dialog.ShowDialog($Owner) -eq 'OK') { return $list.SelectedItem.Type }
    }
    finally { if (-not $returnForm) { $dialog.Dispose() } }
}
<#
.SYNOPSIS
    Collects typed fields for CLI validation and optionally edits advanced JSON.
.NOTES
    Version : 2.0.0.4
    Author  : The Fantastic PAWDeploy Team
#>
function Show-PAWTypedApplicationEditor {
    param([Windows.Forms.Form]$Owner, [object]$Value, [ref]$SourceFolder, [string]$PayloadFolder)
    if ($null -ne $SourceFolder) { $SourceFolder.Value = $null }
    $application = $Value | ConvertTo-Json -Depth 40 | ConvertFrom-Json
    if ($application.SchemaVersion -ne 2) {
        return (Show-PAWApplicationDocumentEditor -Owner $Owner -Title 'Legacy application - edit JSON (Convert catalog upgrades with backup)' -Value $application)
    }
    $configuration = $application.Definition.Configuration
    if ($application.Type -eq 'Classic' -and $null -ne $configuration.PSObject.Properties['FilePath']) {
        return (Show-PAWApplicationDocumentEditor -Owner $Owner -Title 'Legacy Classic application - edit JSON' -Value $application)
    }
    if ($application.Type -eq 'Classic' -and $null -ne $configuration.Detection -and
        $null -ne $configuration.Detection.PSObject.Properties['Script']) {
        return (Show-PAWApplicationDocumentEditor -Owner $Owner -Title 'Classic application with inline detection - edit JSON' -Value $application)
    }
    $fields = [ordered]@{
        Name = $application.Definition.Name; Enabled = [bool]$application.Enabled
        RestartRequired = [bool]$application.RestartRequired; InstallEnabled = [bool]$application.Definition.InstallEnabled
    }
    $choices = @{}
    $folderFields = @()
    $fileFields = @{}
    $selectedFolders = @{}
    switch ($application.Type) {
        'WinGet' {
            foreach ($key in @('Id', 'Architecture', 'Scope', 'InstallerType')) { $fields[$key] = $configuration.$key }
        }
        'PowerShellModule' {
            foreach ($key in @('Id', 'Version', 'Runtime', 'Origin')) { $fields[$key] = $configuration.$key }
            $choices.Runtime = @('WindowsPowerShell', 'PowerShell7')
            $choices.Origin = @('PSGallery', 'Local')
        }
        'Classic' {
            foreach ($key in @('FolderPath', 'Executable', 'Arguments', 'WorkingDirectory', 'TimeoutSeconds')) { $fields[$key] = $configuration.$key }
            $folderFields = @('FolderPath')
            $fields.SuccessExitCodes = $configuration.SuccessExitCodes -join ', '
            $fields.DetectionScript = if ($null -ne $configuration.PSObject.Properties['Detection'] -and $null -ne $configuration.Detection) { $configuration.Detection.ScriptPath } else { '' }
            $fileFields.DetectionScript = 'FolderPath'
        }
        'WindowsComponent' {
            $fields.Kind = $configuration.Kind
            $fields.Names = $configuration.Names -join ', '
            $fields.Source = $configuration.Source
            $folderFields = @('Source')
            $fields.LimitAccess = [bool]$configuration.LimitAccess
            $choices.Kind = @('Capability', 'OptionalFeature', 'ServerFeature')
        }
        default { return (Show-PAWApplicationDocumentEditor -Owner $Owner -Title 'Application - edit JSON' -Value $application) }
    }
    $fields.AdvancedJSON = $false
    $helpText = if ($application.Type -eq 'WindowsComponent') {
        'Enter component names separated by commas. Browse selects a source folder to copy into the package on save. Clear uses online installation. AdvancedJSON opens settings before saving.'
    }
    elseif ($application.Type -eq 'Classic') {
        'Browse selects a folder to copy into Resources\Applications\Packages\<ApplicationId> on save (staged under C:\PAWFiles\AppInstall\Packages in the PAW). Use "%App%\install.msi" in Arguments. DetectionScript Browse selects an optional .ps1 file inside that folder, saved as %App%\...; it returns $true if installed, $false otherwise.'
    }
    else { "Payload paths are relative to Resources\Applications\Packages\<ApplicationId> ($($application.ApplicationId)) and are staged under C:\PAWFiles\AppInstall\Packages. Enter lists separated by commas. AdvancedJSON opens settings and complex fields before saving." }
    $values = Show-PAWApplicationManagerFields -Owner $Owner -Title "$($application.Type) application" -Fields $fields -Choices $choices -FolderFields $folderFields -SelectedFolders ([ref]$selectedFolders) -FileFields $fileFields -PayloadFolder $PayloadFolder -HelpText $helpText
    if ($null -eq $values) { return }
    $application.Definition.Name = $values.Name
    $application.Enabled = $values.Enabled
    $application.RestartRequired = $values.RestartRequired
    $application.Definition.InstallEnabled = $values.InstallEnabled
    switch ($application.Type) {
        'WinGet' {
            foreach ($key in @('Id', 'Architecture', 'Scope', 'InstallerType')) { $configuration.$key = $values[$key] }
        }
        'PowerShellModule' {
            foreach ($key in @('Id', 'Version', 'Runtime', 'Origin')) { $configuration.$key = $values[$key] }
        }
        'Classic' {
            foreach ($key in @('Executable', 'Arguments', 'WorkingDirectory')) { $configuration.$key = $values[$key] }
            $configuration.FolderPath = if ($selectedFolders.FolderPath) { '.' } else { $values.FolderPath }
            $configuration.TimeoutSeconds = [int]$values.TimeoutSeconds
            $configuration.SuccessExitCodes = @($values.SuccessExitCodes -split ',' | Where-Object { $_.Trim() } | ForEach-Object { [int]$_.Trim() })
            $detection = if ([string]::IsNullOrWhiteSpace($values.DetectionScript)) { $null } else {
                [pscustomobject]@{ Kind = 'PowerShell'; ScriptPath = $values.DetectionScript }
            }
            $configuration | Add-Member -NotePropertyName Detection -NotePropertyValue $detection -Force
        }
        'WindowsComponent' {
            $configuration.Kind = $values.Kind
            $configuration.Names = @($values.Names -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })
            $configuration.Source = if ($selectedFolders.Source) { 'Source' } else { $values.Source }
            $configuration.LimitAccess = $values.LimitAccess
        }
    }
    if ($values.AdvancedJSON) {
        $application = Show-PAWApplicationDocumentEditor -Owner $Owner -Title 'Application - advanced JSON and settings' -Value $application
        if ($null -eq $application) { return }
    }
    $selectedFolder = if ($application.Type -eq 'Classic') { $selectedFolders.FolderPath } else { $selectedFolders.Source }
    if ($selectedFolder) {
        if ($null -eq $SourceFolder) { throw 'A SourceFolder output reference is required to save the selected source folder.' }
        $SourceFolder.Value = $selectedFolder
    }
    return $application
}
<#
.SYNOPSIS
    Provides application/bundle Windows Forms backed exclusively by the CLI script.
.NOTES
    Version : 2.0.0.5
    Author  : The Fantastic PAWDeploy Team
#>
function Update-PAWApplicationManagerUI {
    param([hashtable]$State)
    $assignments = & $State.CommandPath -ConfigPath $State.ConfigPath -Action ListAssignments -ErrorAction Stop
    foreach ($kind in @('Applications', 'Bundles')) {
        $action = if ($kind -eq 'Applications') { 'ListApplications' } else { 'ListBundles' }
        $objects = @(& $State.CommandPath -ConfigPath $State.ConfigPath -Action $action -ErrorAction Stop)
        $list = $State.Lists[$kind]
        $list.Items.Clear()
        foreach ($value in $objects) {
            $name = if ($kind -eq 'Applications') { $value.Definition.Name } else { $value.Name }
            $status = if ($kind -eq 'Applications') {
                $id = if ($value.SchemaVersion -eq 2) { $value.Definition.Configuration.Id } else { $value.Definition.Id }
                "Enabled=$($value.Enabled); $id"
            } else { "$($value.Applications.Count) applications" }
            $item = New-Object Windows.Forms.ListViewItem([string]$name)
            if ($kind -eq 'Applications') { $null = $item.SubItems.Add((Get-PAWApplicationUIType -Application $value)) }
            $null = $item.SubItems.Add([string]$status)
            $assigned = if ($kind -eq 'Applications') { @($assignments.Applications[$value.ApplicationId]) } else { @($assignments.Bundles[$value.BundleId]) }
            $assignedText = if ($assigned.Count) { $assigned -join ', ' } else { 'Not assigned' }
            $null = $item.SubItems.Add($assignedText)
            if ($kind -eq 'Applications') { $null = $item.SubItems.Add([string]$value.RestartRequired) }
            $item.Tag = $value
            $null = $list.Items.Add($item)
        }
    }
}

