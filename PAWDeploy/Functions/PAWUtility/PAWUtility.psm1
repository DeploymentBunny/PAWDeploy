function Get-PAWWDACPolicy {
    <#
    .SYNOPSIS
        Validates WDAC XML using the installed Windows Code Integrity schema.
    .DESCRIPTION
        Without parameters, lists XML files without validating them. With Path or
        XmlContent, validates using the Windows schema and prohibits DTD/external
        XML resolution, returning identity and Audit/Enforced mode.
    .PARAMETER Root
        PAWDeploy installation root used for listing.
    .PARAMETER Path
        Existing regular policy XML file.
    .PARAMETER XmlContent
        Policy XML sent to a deployment guest.
    .NOTES
        Version : 2.0.0.2
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(DefaultParameterSetName = 'List')]
    param(
        [Parameter(ParameterSetName = 'List')][string]$Root = $script:scriptFolder,
        [Parameter(Mandatory, ParameterSetName = 'File')][string]$Path,
        [Parameter(Mandatory, ParameterSetName = 'Content')][string]$XmlContent
    )
    if ($PSCmdlet.ParameterSetName -eq 'List') {
        $folder = Join-Path $Root 'Resources\WDACPolicies'
        if (-not (Test-Path -LiteralPath $folder -PathType Container)) { throw "WDAC policies folder not found: $folder" }
        Get-ChildItem -LiteralPath $folder -Filter '*.xml' -File -ErrorAction Stop | Sort-Object Name
        return
    }
    $source = $null
    if ($PSCmdlet.ParameterSetName -eq 'File') {
        $file = Get-Item -LiteralPath $Path -Force -ErrorAction Stop
        if ($file.PSIsContainer -or $file.Extension -ne '.xml' -or ($file.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
            throw "WDAC policy must be a regular .xml file: '$Path'."
        }
        $source = $file.FullName
        $XmlContent = Get-Content -LiteralPath $source -Raw -ErrorAction Stop
    }
    $schema = Join-Path $env:windir 'schemas\CodeIntegrity\cipolicy.xsd'
    if (-not (Test-Path -LiteralPath $schema -PathType Leaf -ErrorAction Stop)) {
        throw "Windows WDAC validation schema is missing: '$schema'. Import on a Windows system with Code Integrity tooling."
    }
    $settings = New-Object Xml.XmlReaderSettings
    $settings.DtdProcessing = [Xml.DtdProcessing]::Prohibit
    $settings.XmlResolver = $null
    $settings.ValidationType = [Xml.ValidationType]::Schema
    $null = $settings.Schemas.Add('urn:schemas-microsoft-com:sipolicy', $schema)
    $text = New-Object IO.StringReader($XmlContent)
    $reader = $null
    try {
        $reader = [Xml.XmlReader]::Create($text, $settings)
        $document = New-Object Xml.XmlDocument
        $document.XmlResolver = $null
        $document.Load($reader)
    }
    finally { if ($null -ne $reader) { $reader.Dispose() }; $text.Dispose() }
    $namespace = New-Object Xml.XmlNamespaceManager($document.NameTable)
    $namespace.AddNamespace('ci', 'urn:schemas-microsoft-com:sipolicy')
    if ($document.DocumentElement.LocalName -ne 'SiPolicy' -or $document.DocumentElement.NamespaceURI -ne 'urn:schemas-microsoft-com:sipolicy') {
        throw 'WDAC XML must contain SiPolicy in the Microsoft policy namespace.'
    }
    $options = @($document.SelectNodes('/ci:SiPolicy/ci:Rules/ci:Rule/ci:Option', $namespace) | ForEach-Object { $_.InnerText })
    $id = $document.SelectSingleNode('/ci:SiPolicy/ci:PolicyID', $namespace)
    $baseId = $document.SelectSingleNode('/ci:SiPolicy/ci:BasePolicyID', $namespace)
    [pscustomobject]@{
        Source = $source
        Xml = $XmlContent
        PolicyId = if ($id) { ([guid]$id.InnerText).ToString('B').ToUpperInvariant() } else { $null }
        BasePolicyId = if ($baseId) { ([guid]$baseId.InnerText).ToString('B').ToUpperInvariant() } else { $null }
        Mode = if ($options -contains 'Enabled:Audit Mode') { 'Audit' } else { 'Enforced' }
        Unsigned = $options -contains 'Enabled:Unsigned System Integrity Policy'
    }
}
