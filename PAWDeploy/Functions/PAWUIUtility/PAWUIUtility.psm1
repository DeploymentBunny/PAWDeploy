<#
.SYNOPSIS
    Provides application/bundle Windows Forms backed exclusively by the CLI script.
.NOTES
    Version : 2.0.0.17
    Author  : The Fantastic PAWDeploy Team
#>
function Show-PAWApplicationManager {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$CommandPath, [Parameter(Mandatory)][string]$ConfigPath,
        [string]$Title = 'PAW Application Manager', [string]$Edition = 'Enterprise',
        [int]$WindowX, [int]$WindowY, [switch]$CreateOnly)
    Add-Type -AssemblyName System.Windows.Forms
    if (-not (Test-Path -LiteralPath $CommandPath -PathType Leaf)) { throw "Application Manager CLI not found: $CommandPath" }
    $form = New-Object Windows.Forms.Form
    $form.Font = [System.Drawing.Font]::new('Segoe UI', 10)
    $form.Add_Disposed({ param($sender, $eventArgs) $sender.Font.Dispose() })
    $form.Text = $Title
    $form.Size = New-Object Drawing.Size(1344, 756)
    $form.MinimumSize = $form.Size
    $form.StartPosition = 'CenterScreen'
    if ($PSBoundParameters.ContainsKey('WindowX') -and $PSBoundParameters.ContainsKey('WindowY')) {
        $form.StartPosition = 'Manual'
        $form.Location = New-Object Drawing.Point($WindowX, $WindowY)
    }
    $form.Icon = Get-PAWWindowIcon
    $tabs = New-Object Windows.Forms.TabControl
    $tabs.Dock = 'Fill'
    $form.Controls.Add($tabs)
    $state = @{ CommandPath = $CommandPath; ConfigPath = $ConfigPath; Form = $form; Lists = @{}; Tabs = $tabs }
    $bars = @()
    foreach ($kind in @('Applications', 'Bundles')) {
        $page = New-Object Windows.Forms.TabPage
        $page.Text = $kind
        $list = New-Object Windows.Forms.ListView
        $list.Name = $kind
        $list.Font = $form.Font
        $list.View = 'Details'
        $list.FullRowSelect = $true
        $list.MultiSelect = $false
        $list.Dock = 'Fill'
        $columns = if ($kind -eq 'Applications') { @('Name', 'Type', 'Status / Members', 'Assigned', 'Restart Required') } else { @('Name', 'Status / Members', 'Assigned Templates') }
        foreach ($column in $columns) { $null = $list.Columns.Add($column, $(if ($column -eq 'Type') { 160 } else { 260 })) }
        $bar = New-Object Windows.Forms.FlowLayoutPanel
        $bar.Dock = 'Top'
        $bar.Height = 76
        $bar.MinimumSize = New-Object Drawing.Size(0, 76)
        $bar.AutoSize = $true
        $bar.AutoSizeMode = 'GrowAndShrink'
        $bars += $bar
        $actions = if ($kind -eq 'Applications') {
            @('New', 'Refresh', 'Edit', 'Enable', 'Disable', 'Import', 'Export', 'Delete', 'Assign')
        } else { @('New bundle', 'Refresh', 'Edit', 'Import', 'Export', 'Delete', 'Assign') }
        foreach ($action in $actions) {
            $button = New-PAWUiButton -Text $action -Accent:($action -in 'New','New bundle')
            $button.Tag = @{ Action = $(if ($action -eq 'New') { 'New Application' } else { $action }); Kind = $kind; State = $state }
            $button.Add_Click({
                param($sender, $eventArgs)
                try { Invoke-PAWApplicationManagerUIAction -State $sender.Tag.State -Kind $sender.Tag.Kind -Action $sender.Tag.Action }
                catch {
                    Show-PAWUiError -Title 'Application Manager' -ErrorRecord $_ -Copyable -Owner $sender.Tag.State.Form `
                        -LogPath (Join-Path (Resolve-PAWLogFolder) 'PAWApplicationManager.log')
                }
            })
            $bar.Controls.Add($button)
        }
        $page.Controls.Add($list)
        $page.Controls.Add($bar)
        $state.Lists[$kind] = $list
        $null = $tabs.TabPages.Add($page)
    }
    $returnForm = $false
    $close = New-PAWUiButton -Text 'Close'
    $close.Tag = $form
    $close.Add_Click({ param($sender, $eventArgs) $sender.Tag.Close() })
    try {
        Add-PAWUiRibbon -Form $form -ScriptPath (Join-Path (Split-Path -Parent $CommandPath) 'PAWApplicationManagerUI.ps1') -CloseButton $close
        # The shared ribbon theme applies standard button sizes before this toolbar-specific layout.
        foreach ($bar in $bars) {
            foreach ($button in $bar.Controls) {
                $button.Size = New-Object Drawing.Size(125, 30)
            }
        }
        Update-PAWApplicationManagerUI -State $state
        if ($CreateOnly) { $returnForm = $true; return $form }
        $null = $form.ShowDialog()
    }
    finally {
        if (-not $returnForm) { $form.Icon.Dispose(); $form.Dispose() }
    }
}
function Show-PAWFileImportDialog {
    <#
    .SYNOPSIS
        Selects and imports Run Scripts, WDAC policies, or VHDX files.
    .NOTES
        Version : 2.0.0.2
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param(
        [System.Windows.Forms.Form]$Owner,
        [Parameter(Mandatory)][string]$RootFolder,
        [Parameter(Mandatory)][ValidateSet('RunScript', 'WDAC', 'VHDX')][string]$ImportType,
        [string]$ConfigPath
    )
    $picker = New-Object System.Windows.Forms.OpenFileDialog
    $picker.Title = "Select $ImportType files to import"
    $picker.Filter = switch ($ImportType) {
        'WDAC' { 'WDAC policies (*.xml)|*.xml' }
        'VHDX' { 'Virtual hard disks (*.vhdx)|*.vhdx' }
        default { 'PowerShell scripts (*.ps1)|*.ps1' }
    }
    $picker.Multiselect = $true
    $previousWaitCursor = if ($null -ne $Owner) { $Owner.UseWaitCursor } else { $false }
    try {
        if ($picker.ShowDialog($Owner) -ne [System.Windows.Forms.DialogResult]::OK) { return }
        $answer = [System.Windows.Forms.MessageBox]::Show($Owner,
            "Allow replacement of existing $ImportType files with matching filenames? No refuses the entire import if any name exists; Cancel aborts.",
            'Confirm file replacement', 'YesNoCancel', 'Warning')
        if ($answer -eq [System.Windows.Forms.DialogResult]::Cancel) { return }
        $toolName = switch ($ImportType) {
            'WDAC' { 'Import-PAWWDACPolicy.ps1' }
            'VHDX' { 'Import-PAWVHDX.ps1' }
            default { 'Import-PAWRunScript.ps1' }
        }
        $parameters = @{
            Path = $picker.FileNames
            Replace = ($answer -eq [System.Windows.Forms.DialogResult]::Yes)
            Confirm = $false
            ErrorAction = 'Stop'
        }
        if ($ImportType -eq 'VHDX' -and -not [string]::IsNullOrWhiteSpace($ConfigPath)) {
            $parameters.ConfigPath = $ConfigPath
        }
        if ($null -ne $Owner) { $Owner.UseWaitCursor = $true }
        $tool = Join-Path $RootFolder "Tools\$toolName"
        $result = if ($ImportType -eq 'VHDX') {
            @(Invoke-PAWVHDXImportWithProgress -Owner $Owner -ToolPath $tool -Parameters $parameters)
        }
        else { @(& $tool @parameters) }
        if ($null -ne $Owner) { $Owner.UseWaitCursor = $previousWaitCursor }
        [void][System.Windows.Forms.MessageBox]::Show($Owner,
            "Imported $ImportType files:`n$($result.Destination -join "`n")", 'Import complete', 'OK', 'Information')
    }
    catch {
        [void][System.Windows.Forms.MessageBox]::Show($Owner, $_.Exception.Message, 'File import failed', 'OK', 'Error')
    }
    finally {
        if ($null -ne $Owner) { $Owner.UseWaitCursor = $previousWaitCursor }
        $picker.Dispose()
    }
}
<#

.SYNOPSIS
    Logs an error and displays its details in the UI.

.DESCRIPTION
    Logs an error and displays its details in the UI.

.PARAMETER Title
    Title or context label displayed with the error.

.PARAMETER ErrorRecord
    Error record whose message and stack details are shown and logged.

.PARAMETER LogPath
    Optional destination path for the error log.

.PARAMETER WindowX
    Together with WindowY, anchors the error dialog to the launcher's screen.

.PARAMETER WindowY
    Vertical launcher coordinate, including zero or negative screen coordinates.

.PARAMETER Copyable
    Displays selectable read-only text with standard Ctrl+C and Ctrl+A shortcuts.

.PARAMETER Owner
    Existing form that owns the error dialog and determines its screen.

.NOTES
    Version : 2.0.0.7
    Author  : The Fantastic PAWDeploy Team

#>
function Show-PAWUiError {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Title,

        [Parameter(Mandatory = $true)]
        [System.Management.Automation.ErrorRecord]$ErrorRecord,

        [Parameter(Mandatory = $false)]
        [string]$LogPath,

        [int]$WindowX,

        [int]$WindowY,

        [switch]$Copyable,

        [System.Windows.Forms.Form]$Owner
    )

    $scriptStack = ''
    if (-not [string]::IsNullOrWhiteSpace($ErrorRecord.ScriptStackTrace)) {
        $scriptStack = $ErrorRecord.ScriptStackTrace
    }

    if (Get-Command -Name Write-PAWLog -ErrorAction SilentlyContinue) {
        try {
            $logParameters = @{}
            if (-not [string]::IsNullOrWhiteSpace($LogPath)) { $logParameters.LogPath = $LogPath }
            Write-PAWLog -Level 'ERROR' -Message ("{0}: {1}" -f $Title, $ErrorRecord.Exception.Message) -Exception $ErrorRecord.Exception @logParameters -ErrorAction Stop
            if (-not [string]::IsNullOrWhiteSpace($scriptStack)) {
                Write-PAWLog -Level 'ERROR' -Message ("$Title ScriptStack:`r`n" + $scriptStack) @logParameters -ErrorAction Stop
            }
        }
        catch { Write-Warning "UI error logging failed: $($_.Exception.Message). Original error: $($ErrorRecord.Exception.Message)" }
    }

    $logHint = ''
    if (-not [string]::IsNullOrWhiteSpace($LogPath)) {
        $logHint = "`r`n`r`nSee log: $LogPath"
    }

    if ($Copyable) {
        $dialog = New-Object System.Windows.Forms.Form
        try {
            $dialog.Text = $Title
            $dialog.ClientSize = New-Object System.Drawing.Size(660, 260)
            $dialog.MinimumSize = $dialog.Size
            $dialog.StartPosition = 'CenterScreen'
            $dialog.MinimizeBox = $false
            $dialog.MaximizeBox = $false
            if ($null -ne $Owner) {
                $dialog.StartPosition = 'CenterParent'
            }
            elseif ($PSBoundParameters.ContainsKey('WindowX') -and $PSBoundParameters.ContainsKey('WindowY')) {
                $area = [System.Windows.Forms.Screen]::FromPoint((New-Object System.Drawing.Point($WindowX, $WindowY))).WorkingArea
                $dialog.StartPosition = 'Manual'
                $dialog.Location = New-Object System.Drawing.Point(
                    ($area.Left + [int](($area.Width - $dialog.Width) / 2)),
                    ($area.Top + [int](($area.Height - $dialog.Height) / 2)))
            }
            $buttons = New-Object System.Windows.Forms.FlowLayoutPanel
            $buttons.Dock = 'Bottom'
            $buttons.Height = 45
            $buttons.FlowDirection = 'RightToLeft'
            $ok = New-Object System.Windows.Forms.Button
            $ok.Text = 'OK'
            $ok.DialogResult = 'OK'
            $buttons.Controls.Add($ok)
            $text = New-Object System.Windows.Forms.TextBox
            $text.Name = 'ErrorText'
            $text.Multiline = $true
            $text.ReadOnly = $true
            $text.ShortcutsEnabled = $true
            $text.ScrollBars = 'Vertical'
            $text.Dock = 'Fill'
            $text.Text = "$($ErrorRecord.Exception.Message)$logHint"
            $dialog.Controls.Add($text)
            $dialog.Controls.Add($buttons)
            $dialog.AcceptButton = $ok
            $dialog.CancelButton = $ok
            $dialog.ActiveControl = $text
            Set-PAWUiTheme -Control $dialog
            if ($null -ne $Owner) { $null = $dialog.ShowDialog($Owner) }
            else { $null = $dialog.ShowDialog() }
        }
        finally { $dialog.Dispose() }
        return
    }

    $temporaryOwner = $null
    try {
        if ($null -ne $Owner) {
            [System.Windows.Forms.MessageBox]::Show(
                $Owner, "$($ErrorRecord.Exception.Message)$logHint", $Title, 'OK', 'Error'
            ) | Out-Null
        }
        elseif ($PSBoundParameters.ContainsKey('WindowX') -and $PSBoundParameters.ContainsKey('WindowY')) {
            $temporaryOwner = New-Object System.Windows.Forms.Form
            $temporaryOwner.StartPosition = 'Manual'
            $screen = [System.Windows.Forms.Screen]::FromPoint((New-Object System.Drawing.Point($WindowX, $WindowY)))
            $temporaryOwner.Bounds = $screen.WorkingArea
            $temporaryOwner.ShowInTaskbar = $false
            $temporaryOwner.Opacity = 0
            $temporaryOwner.Show()
            [System.Windows.Forms.MessageBox]::Show(
                $temporaryOwner, "$($ErrorRecord.Exception.Message)$logHint", $Title, 'OK', 'Error'
            ) | Out-Null
        }
        else {
            [System.Windows.Forms.MessageBox]::Show(
                "$($ErrorRecord.Exception.Message)$logHint", $Title, 'OK', 'Error'
            ) | Out-Null
        }
    }
    finally {
        if ($null -ne $temporaryOwner) { $temporaryOwner.Dispose() }
    }
}
function Start-PAWElevatedPowerShell {
    <#
    .SYNOPSIS
        Opens an elevated interactive console using the current PowerShell installation.
    .PARAMETER RootFolder
        PAWDeploy installation root containing Functions\PAWUtility.
    .PARAMETER Version
        Menu version displayed in the green toolkit banner.
    .PARAMETER X
        Console left edge in screen pixels.
    .PARAMETER Y
        Console top edge in screen pixels.
    .PARAMETER Width
        Console width in pixels.
    .PARAMETER Height
        Console height in pixels.
    .NOTES
        Version : 2.0.0.3
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [ValidateNotNullOrEmpty()]
        [string]$RootFolder,
        [Parameter(Mandatory)]
        [version]$Version,
        [Parameter(Mandatory)][int]$X,
        [Parameter(Mandatory)][int]$Y,
        [Parameter(Mandatory)][ValidateRange(1, 32767)][int]$Width,
        [Parameter(Mandatory)][ValidateRange(1, 32767)][int]$Height
    )

    $root = Get-Item -LiteralPath $RootFolder -ErrorAction Stop
    if (-not $root.PSIsContainer) { throw "PAWDeploy root is not a directory: '$RootFolder'." }
    $manifest = Join-Path $root.FullName 'Functions\PAWUtility\PAWUtility.psd1'
    if (-not (Test-Path -LiteralPath $manifest -PathType Leaf -ErrorAction Stop)) {
        throw "Required module not found: '$manifest'."
    }
    $uiManifest = Join-Path $root.FullName 'Functions\PAWUIUtility\PAWUIUtility.psd1'
    if (-not (Test-Path -LiteralPath $uiManifest -PathType Leaf -ErrorAction Stop)) {
        throw "Required module not found: '$uiManifest'."
    }
    $managerManifest = Join-Path $root.FullName 'Functions\PAWApplicationManager\PAWApplicationManager.psd1'
    if (-not (Test-Path -LiteralPath $managerManifest -PathType Leaf -ErrorAction Stop)) {
        throw "Required module not found: '$managerManifest'."
    }
    $rootLiteral = $root.FullName.Replace("'", "''")
    $command = @"
try {
    Set-Location -LiteralPath '$rootLiteral' -ErrorAction Stop
    Import-Module -Name (Join-Path '$rootLiteral' 'Functions\PAWUIUtility\PAWUIUtility.psd1') -Force -ErrorAction Stop
    Set-PAWConsoleWindow -X $X -Y $Y -Width $Width -Height $Height
    Import-Module -Name (Join-Path '$rootLiteral' 'Functions\PAWUtility\PAWUtility.psd1') -Force -ErrorAction Stop
    Import-Module -Name (Join-Path '$rootLiteral' 'Functions\PAWApplicationManager\PAWApplicationManager.psd1') -ErrorAction Stop
    `$Host.UI.RawUI.WindowTitle = 'PAWDeploy Toolkit - $Version'
    Write-Host 'PAWDeploy Toolkit - $Version' -ForegroundColor Green
    Write-Host 'PAWUtility module loaded.' -ForegroundColor Green
    Write-Host 'PAWApplicationManager module loaded.' -ForegroundColor Green
}
catch {
    Write-Error -ErrorRecord `$_ -ErrorAction Continue
}
"@
    $encodedCommand = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command))
    $executable = Get-PAWCurrentShellPath
    $consoleHost = Join-Path $env:SystemRoot 'System32\conhost.exe'
    Start-Process -FilePath $consoleHost -Verb RunAs -WorkingDirectory $root.FullName `
        -ArgumentList "`"$executable`" -NoProfile -NoExit -EncodedCommand $encodedCommand" -ErrorAction Stop
}
function Start-PAWUiTool {
    <#
    .SYNOPSIS
        Starts a menu tool and reports its progress until its window opens.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][System.Windows.Forms.Form]$Form,
        [Parameter(Mandatory)][System.Windows.Forms.Label]$StatusLabel,
        [Parameter(Mandatory)][string]$RootFolder,
        [Parameter(Mandatory)][string]$ScriptName,
        [Parameter(Mandatory)][string]$LogPath
    )

    $scriptPath = Join-Path $RootFolder "Tools\$ScriptName.ps1"
    if ($StatusLabel.Tag -and $StatusLabel.Tag.Process) { return }

    if (-not $StatusLabel.Tag) {
        $state = [pscustomobject]@{
            Process = $null
            Name    = ''
            Clock   = [Diagnostics.Stopwatch]::new()
            Timer   = [System.Windows.Forms.Timer]::new()
        }
        $StatusLabel.Tag = $state
        $state.Timer.Interval = 200
        $writeLog = Get-Command Write-PAWLog -ErrorAction Stop
        $state.Timer.Add_Tick({
            $tool = $state.Process
            $elapsed = [math]::Round($state.Clock.Elapsed.TotalSeconds, 2)
            $finished = $true
            try {
                $tool.Refresh()
                if ($tool.HasExited) { throw "Process exited with code $($tool.ExitCode) before its window was detected." }
                if ($tool.MainWindowHandle -eq [IntPtr]::Zero) {
                    if ($elapsed -ge 10) { $StatusLabel.Text = "Still opening $($state.Name)..." }
                    $finished = $false
                    return
                }
                $StatusLabel.Text = ''
                & $writeLog -Message "Tool window detected: $($state.Name) after ${elapsed}s." -LogPath $LogPath
            }
            catch {
                $StatusLabel.Text = "Unable to open $($state.Name). See the PAW Menu log."
                & $writeLog -Level 'ERROR' -Message "Failed to open '$($state.Name)' after ${elapsed}s." -Exception $_.Exception -LogPath $LogPath
            }
            finally {
                if ($finished) {
                    $state.Timer.Stop()
                    $state.Process = $null
                    $tool.Dispose()
                }
            }
        }.GetNewClosure())
        $Form.Add_Disposed({
            $state.Timer.Dispose()
            if ($state.Process) { $state.Process.Dispose() }
        }.GetNewClosure())
    }

    $state = $StatusLabel.Tag
    $state.Name = $ScriptName
    $state.Clock.Restart()
    $StatusLabel.Text = "Opening $ScriptName..."
    $StatusLabel.Update()
    try {
        Write-PAWLog -Message "Opening tool: $ScriptName." -LogPath $LogPath
        if (-not (Test-Path -LiteralPath $scriptPath -PathType Leaf)) {
            throw "Tool script not found: $scriptPath"
        }
        $executable = Get-PAWCurrentShellPath
        $state.Process = Start-Process -FilePath $executable -ArgumentList "-NoProfile -STA -WindowStyle Hidden -File `"$scriptPath`" -WindowX $($Form.Left) -WindowY $($Form.Top)" -WorkingDirectory $RootFolder -WindowStyle Hidden -PassThru -ErrorAction Stop
        $state.Timer.Start()
    }
    catch {
        if ($state.Process) { $state.Process.Dispose(); $state.Process = $null }
        $StatusLabel.Text = "Unable to open $ScriptName. See the PAW Menu log."
        Write-PAWLog -Level 'ERROR' -Message "Failed to launch tool '$ScriptName'." -Exception $_.Exception -LogPath $LogPath
    }
}
<#

.SYNOPSIS
    Resolves dropdown source paths from configured text values.

.DESCRIPTION
    Resolves dropdown source paths from configured text values.

.PARAMETER ConfigPath
    Configuration file path used to resolve dropdown source folders.

.PARAMETER VhdFolderText
    Text value for the VHD source-folder field.

.PARAMETER SecurityBaselineFolderText
    Text value for the security-baseline source-folder field.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Update-PAWResolvedDropdownSourcePaths {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $false)]
        [string]$ConfigPath = '',

        [Parameter(Mandatory = $false)]
        [string]$VhdFolderText = '',

        [Parameter(Mandatory = $false)]
        [string]$SecurityBaselineFolderText = ''
    )

    $configFolder = $null
    if (-not [string]::IsNullOrWhiteSpace($ConfigPath)) {
        $configFolder = Split-Path -Parent $ConfigPath
    }

    $resolvedVhdFolder = $null
    if (-not [string]::IsNullOrWhiteSpace($VhdFolderText)) {
        $expandedVhdPath = [Environment]::ExpandEnvironmentVariables($VhdFolderText.Trim())
        if (-not [System.IO.Path]::IsPathRooted($expandedVhdPath)) {
            if (-not [string]::IsNullOrWhiteSpace($configFolder)) {
                $expandedVhdPath = Join-Path $configFolder $expandedVhdPath
            }
        }
        $resolvedVhdFolder = $expandedVhdPath
    }

    $resolvedSecurityBaselineFolder = $null
    if (-not [string]::IsNullOrWhiteSpace($SecurityBaselineFolderText)) {
        $expandedBaselinePath = [Environment]::ExpandEnvironmentVariables($SecurityBaselineFolderText.Trim())
        if (-not [System.IO.Path]::IsPathRooted($expandedBaselinePath)) {
            if (-not [string]::IsNullOrWhiteSpace($configFolder)) {
                $expandedBaselinePath = Join-Path $configFolder $expandedBaselinePath
            }
        }
        $resolvedSecurityBaselineFolder = $expandedBaselinePath
    }

    $resolvedCustomScriptsFolder = if ($configFolder) {
        Join-Path (Split-Path -Parent $configFolder) 'Resources\CustomScripts'
    }

    return [PSCustomObject]@{
        VhdFolder = $resolvedVhdFolder
        SecurityBaselineFolder = $resolvedSecurityBaselineFolder
        CustomScriptsFolder = $resolvedCustomScriptsFolder
    }
}

<#
.SYNOPSIS
    Gets a display type for typed or legacy application documents.
.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team
#>
function Get-PAWApplicationUIType {
    param([object]$Application)
    if ($Application.Type) { return [string]$Application.Type }
    switch ($Application.Definition.Source) {
        'WinGet' { return 'WinGet' }
        'PSGallery' { return 'PowerShellModule' }
        'Local' { return 'Classic' }
        default { return [string]$Application.Definition.Source }
    }
}
function Get-PAWCurrentShellPath {
    $name = if ($PSVersionTable.PSEdition -eq 'Core') { 'pwsh.exe' } else { 'powershell.exe' }
    $path = Join-Path $PSHOME $name
    if (-not (Test-Path -LiteralPath $path -PathType Leaf)) {
        throw "Unable to locate the current PowerShell executable: $path"
    }
    return $path
}
<#
.SYNOPSIS
    Provides application/bundle Windows Forms backed exclusively by the CLI script.
.NOTES
    Version : 2.0.0.14
    Author  : The Fantastic PAWDeploy Team
#>
function Invoke-PAWApplicationManagerUIAction {
    param([hashtable]$State, [string]$Kind, [string]$Action)
    $parameters = @{ ConfigPath = $State.ConfigPath; ErrorAction = 'Stop'; Confirm = $false }
    $selection = $State.Lists[$Kind].SelectedItems
    $value = if ($selection.Count) { $selection[0].Tag } else { $null }
    if ($Action -in 'Edit','Enable','Disable','Export','Delete','Assign' -and $null -eq $value) {
        throw 'Select an item first.'
    }
    if ($Action -eq 'New Application') {
        $type = Show-PAWApplicationTypePicker -Owner $State.Form
        if (-not $type) { return }
        if ($type -eq 'WinGet') { $Action = 'New WinGet' }
        else {
            $seed = & $State.CommandPath @parameters -Action NewApplication -Type $type -Name 'New Application'
            $sourceFolder = $null
            $edited = Show-PAWTypedApplicationEditor -Owner $State.Form -Value $seed -SourceFolder ([ref]$sourceFolder)
            if ($null -eq $edited) { return }
            $null = & $State.CommandPath @parameters -Action SaveApplication -InputObject $edited -SourceFolder $sourceFolder
            Update-PAWApplicationManagerUI $State
            return
        }
    }
    switch ($Action) {
        'Refresh' { Update-PAWApplicationManagerUI $State; return }
        'Convert catalog' {
            if ([Windows.Forms.MessageBox]::Show($State.Form, 'Convert legacy WinGet and PSGallery applications to typed schema version 2? The CLI verifies a backup before conversion. Legacy Local applications remain unchanged and require manual Classic command and detection configuration.', 'Confirm catalog conversion and backup', 'YesNo', 'Warning') -ne 'Yes') { return }
            $result = & $State.CommandPath @parameters -Action ConvertCatalog
            $message = "Converted: $($result.Converted)`r`nBackup: $($result.BackupPath)"
            if (@($result.RequiresManualConversion).Count) { $message += "`r`nRequires manual conversion: $($result.RequiresManualConversion -join ', ')" }
            [void][Windows.Forms.MessageBox]::Show($State.Form, $message, 'Catalog conversion result', 'OK', 'Information')
            Update-PAWApplicationManagerUI $State
            return
        }
        'New WinGet' {
            $null = & $State.CommandPath @parameters -Action TestPrerequisites
            $inputValues = Show-PAWApplicationManagerFields -Owner $State.Form -Title 'Search WinGet (requires Microsoft.WinGet.Client)' -Fields ([ordered]@{ Query = '' })
            if ($null -eq $inputValues) { return }
            $packages = @(& $State.CommandPath @parameters -Action Search -Query $inputValues.Query)
            if (-not $packages.Count) { throw 'No WinGet packages matched.' }
            $picker = New-Object Windows.Forms.Form
            $picker.Text = 'Select WinGet package'
            $picker.Size = New-Object Drawing.Size(700, 450)
            $list = New-Object Windows.Forms.ListBox
            $list.Dock = 'Fill'
            foreach ($package in $packages) { $null = $list.Items.Add("$($package.Id) - $($package.Name)") }
            $list.SelectedIndex = 0
            $ok = New-PAWUiButton -Text 'Select' -Width 100 -Height 35
            $ok.DialogResult = 'OK'
            $buttons = New-Object Windows.Forms.FlowLayoutPanel
            $buttons.Dock = 'Bottom'
            $buttons.Height = 40
            $buttons.FlowDirection = 'RightToLeft'
            $buttons.Controls.Add($ok)
            $picker.Controls.Add($list); $picker.Controls.Add($buttons)
            try {
                Set-PAWUiTheme -Control $picker
                if ($picker.ShowDialog($State.Form) -ne 'OK') { return }
                $package = $packages[$list.SelectedIndex]
            }
            finally { $picker.Dispose() }
            $fields = Show-PAWApplicationManagerFields -Owner $State.Form -Title 'New WinGet application' -Fields ([ordered]@{
                Name = $package.Name; Architecture = 'x64'; Scope = 'Machine'; InstallerType = 'NA'; RestartRequired = $false
            })
            if ($null -eq $fields) { return }
            $parameters.Action = 'NewWinGet'; $parameters.Id = $package.Id
            foreach ($key in $fields.Keys) { $parameters[$key] = $fields[$key] }
        }
        { $_ -in 'New bundle','Edit' } {
            $isApplication = $Kind -eq 'Applications'
            if ($Action -ne 'Edit') {
                $value = [pscustomobject]@{ SchemaVersion = 1; Name = 'New bundle'; Applications = @() }
            }
            $sourceFolder = $null
            $edited = if ($isApplication) {
                $payloadFolder = if ($value.Type -eq 'Classic' -and
                    $null -ne $value.Definition.Configuration.PSObject.Properties['FolderPath']) {
                    & $State.CommandPath @parameters -Action GetApplicationFolder -ApplicationId $value.ApplicationId
                } else { $null }
                Show-PAWTypedApplicationEditor -Owner $State.Form -Value $value -SourceFolder ([ref]$sourceFolder) -PayloadFolder $payloadFolder
            }
            else {
                $catalog = @(& $State.CommandPath @parameters -Action ListApplications)
                Show-PAWApplicationBundleEditor -Owner $State.Form -Bundle $value -Catalog $catalog
            }
            if ($null -eq $edited) { return }
            if ($Action -eq 'Edit' -and (($isApplication -and $edited.ApplicationId -ne $value.ApplicationId) -or
                (-not $isApplication -and $edited.BundleId -ne $value.BundleId))) { throw 'IDs cannot be changed while editing.' }
            $parameters.Action = if ($isApplication) { 'SaveApplication' } else { 'SaveBundle' }
            $parameters.InputObject = $edited; $parameters.Replace = $Action -eq 'Edit'
            if ($sourceFolder) { $parameters.SourceFolder = $sourceFolder }
        }

        { $_ -in 'Enable','Disable' } { $parameters.Action = $Action; $parameters.ApplicationId = $value.ApplicationId }
        'Delete' {
            $message = if ($Kind -eq 'Applications') {
                'Delete the selected application and remove it from all bundles? Cached installers are retained.'
            } else { 'Delete the selected bundle? Cached installers are retained.' }
            if ([Windows.Forms.MessageBox]::Show($State.Form, $message, 'Confirm deletion', 'YesNo', 'Warning') -ne 'Yes') { return }
            $parameters.Action = if ($Kind -eq 'Applications') { 'RemoveApplication' } else { 'RemoveBundle' }
            if ($Kind -eq 'Applications') { $parameters.ApplicationId = $value.ApplicationId } else { $parameters.BundleId = $value.BundleId }
        }
        { $_ -in 'Import','Export' } {
            $dialog = if ($Action -eq 'Import') { New-Object Windows.Forms.OpenFileDialog } else { New-Object Windows.Forms.SaveFileDialog }
            $dialog.Filter = 'Application package (*.json)|*.json'
            try {
                if ($dialog.ShowDialog($State.Form) -ne 'OK') { return }
                $parameters.Path = $dialog.FileName
            }
            finally { $dialog.Dispose() }
            $parameters.Action = if ($Action -eq 'Import') { 'Import' } elseif ($Kind -eq 'Applications') { 'ExportApplication' } else { 'ExportBundle' }
            if ($Action -eq 'Export') {
                if ($Kind -eq 'Applications') { $parameters.ApplicationId = $value.ApplicationId } else { $parameters.BundleId = $value.BundleId }
                $parameters.Replace = $true
            }
            else {
                $answer = [Windows.Forms.MessageBox]::Show($State.Form, 'Allow replacement of matching existing IDs? No imports only new definitions.', 'Import conflicts', 'YesNoCancel', 'Question')
                if ($answer -eq 'Cancel') { return }
                $parameters.Replace = $answer -eq 'Yes'
            }
        }
        'Assign' {
            if ($Kind -eq 'Applications') {
                $bundles = @(& $State.CommandPath @parameters -Action ListBundles)
                $bundle = Show-PAWApplicationAssignmentPicker -Owner $State.Form -Items $bundles -ListName Bundles -Prompt "Select a bundle for application: $($value.Definition.Name)"
                if ($null -eq $bundle) { return }
                if ($bundle.Applications -contains $value.ApplicationId) {
                    Show-PAWApplicationAssignmentNotice -Owner $State.Form -Application $value -Bundle $bundle
                    return
                }
                $bundle.Applications = @($bundle.Applications) + @($value.ApplicationId)
                $parameters.Action = 'SaveBundle'; $parameters.InputObject = $bundle; $parameters.Replace = $true
            }
            else {
                $templates = @(& $State.CommandPath @parameters -Action ListTemplates)
                $template = Show-PAWApplicationAssignmentPicker -Owner $State.Form -Items $templates -Prompt "Select a template for bundle: $($value.Name)"
                if ($null -eq $template) { return }
                $parameters.Action = 'AssignBundle'; $parameters.TemplateName = $template.Name; $parameters.BundleId = $value.BundleId
            }
        }
    }
    $null = & $State.CommandPath @parameters
    Update-PAWApplicationManagerUI $State
}

function Show-PAWApplicationAssignmentNotice {
    param([Windows.Forms.Form]$Owner, [object]$Application, [object]$Bundle)
    $message = "Application '$($Application.Definition.Name)' is already in bundle '$($Bundle.Name)'."
    [void][Windows.Forms.MessageBox]::Show($Owner, $message, 'Application already assigned', 'OK', 'Information')
}
function Invoke-PAWVHDXImportWithProgress {
    <#
    .SYNOPSIS
        Imports VHDX files while displaying a responsive progress window.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param(
        [System.Windows.Forms.Form]$Owner,
        [Parameter(Mandatory)][string]$ToolPath,
        [Parameter(Mandatory)][hashtable]$Parameters
    )

    $dialog = New-Object System.Windows.Forms.Form
    $dialog.Text = 'Import VHDX'
    $dialog.ClientSize = New-Object System.Drawing.Size(520, 135)
    $dialog.FormBorderStyle = 'FixedDialog'
    $dialog.StartPosition = if ($null -ne $Owner) { 'CenterParent' } else { 'CenterScreen' }
    $dialog.ControlBox = $false
    $dialog.ShowInTaskbar = $false
    $label = New-Object System.Windows.Forms.Label
    $label.Name = 'ImportStatus'
    $label.Text = 'Importing VHDX files. This may take a while; please wait.'
    $label.Location = New-Object System.Drawing.Point(20, 20)
    $label.Size = New-Object System.Drawing.Size(480, 38)
    $progress = New-Object System.Windows.Forms.ProgressBar
    $progress.Name = 'ImportProgress'
    $progress.Location = New-Object System.Drawing.Point(20, 75)
    $progress.Size = New-Object System.Drawing.Size(480, 25)
    $progress.Style = 'Marquee'
    $progress.MarqueeAnimationSpeed = 30
    $dialog.Controls.AddRange(@($label, $progress))
    Set-PAWUiTheme -Control $dialog

    $runspace = [System.Management.Automation.Runspaces.RunspaceFactory]::CreateRunspace($Host)
    $worker = [PowerShell]::Create()
    $timer = New-Object System.Windows.Forms.Timer
    $state = @{ Async = $null; Completed = $false; Result = $null; Error = $null }
    try {
        $runspace.Open()
        $worker.Runspace = $runspace
        [void]$worker.AddScript('param($tool, $parameters) & $tool @parameters').AddArgument($ToolPath).AddArgument($Parameters)
        $timer.Interval = 100
        $timer.Add_Tick({
            if ($null -eq $state.Async -or -not $state.Async.IsCompleted) { return }
            $timer.Stop()
            try {
                $state.Result = @($worker.EndInvoke($state.Async))
                if ($worker.HadErrors) { throw $worker.Streams.Error[0] }
            }
            catch { $state.Error = $_ }
            finally {
                $state.Completed = $true
                $dialog.Close()
            }
        }.GetNewClosure())
        $dialog.Add_FormClosing({
            param($sender, $eventArgs)
            if (-not $state.Completed) { $eventArgs.Cancel = $true }
        }.GetNewClosure())
        $dialog.Add_Shown({
            try {
                $state.Async = $worker.BeginInvoke()
                $timer.Start()
            }
            catch {
                $state.Error = $_
                $state.Completed = $true
                $dialog.Close()
            }
        }.GetNewClosure())
        [void]$dialog.ShowDialog($Owner)
        if ($null -ne $state.Error) { throw $state.Error }
        return $state.Result
    }
    finally {
        $timer.Dispose()
        if ($null -ne $state.Async -and -not $state.Async.IsCompleted) { $worker.Stop() }
        $worker.Dispose()
        $runspace.Dispose()
        $dialog.Dispose()
    }
}
function New-PAWUiCheckedListBox {
    <#
    .SYNOPSIS
        Creates a native checked list with a themeable draw event.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param()
    # CheckedListBox suppresses the inherited DrawItem event, so expose it again.
    if (-not ('PAWDeploy.UI.CheckedListBox' -as [type])) {
        $assemblies = @('System.Windows.Forms')
        if ($PSVersionTable.PSEdition -eq 'Core') {
            $assemblies += [System.ComponentModel.Component].Assembly.Location
            $assemblies += [System.Windows.Forms.DrawItemEventArgs].Assembly.Location
            $assemblies += [System.Windows.Forms.DrawItemEventHandler].Assembly.Location
            $assemblies = @($assemblies | Select-Object -Unique)
        }
        Add-Type -ReferencedAssemblies $assemblies -TypeDefinition @'
namespace PAWDeploy.UI
{
    public class CheckedListBox : System.Windows.Forms.CheckedListBox
    {
        public new event System.Windows.Forms.DrawItemEventHandler DrawItem;
        protected override void OnDrawItem(System.Windows.Forms.DrawItemEventArgs e)
        {
            var handler = DrawItem;
            if (handler == null) base.OnDrawItem(e);
            else handler(this, e);
        }
    }
}
'@ -ErrorAction Stop
    }
    New-Object PAWDeploy.UI.CheckedListBox
}
function Register-PAWUiChromeTheme {
    <#
    .SYNOPSIS
        Paints unused native tab and list-header areas with the selected theme.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    param(
        [Parameter(Mandatory)][System.Windows.Forms.Control]$Control,
        [Parameter(Mandatory)][System.Drawing.Color]$Color
    )
    if (-not ('PAWDeploy.UI.ChromeTheme' -as [type])) {
        $assemblies = @('System.Windows.Forms', 'System.Drawing')
        if ($PSVersionTable.PSEdition -eq 'Core') {
            $assemblies += [System.Drawing.Color].Assembly.Location
            $assemblies += [System.Drawing.Graphics].Assembly.Location
            $assemblies += [System.Windows.Forms.Message].Assembly.Location
            $assemblies += [System.ComponentModel.Component].Assembly.Location
            # Graphics implements additional interfaces in newer .NET versions.
            $assemblies += [System.Drawing.Graphics].GetInterfaces() |
                Where-Object { $_.Assembly -ne [object].Assembly } |
                ForEach-Object { $_.Assembly.Location }
            $assemblies = @($assemblies | Select-Object -Unique)
        }
        Add-Type -ReferencedAssemblies $assemblies -TypeDefinition @'
using System;
using System.Drawing;
using System.Runtime.InteropServices;
using System.Runtime.CompilerServices;
using System.Windows.Forms;

namespace PAWDeploy.UI {
    public sealed class ChromeTheme : NativeWindow {
        private static readonly ConditionalWeakTable<Control, ChromeTheme> Themes =
            new ConditionalWeakTable<Control, ChromeTheme>();
        private readonly Control control;
        private Color color;
        [StructLayout(LayoutKind.Sequential)]
        private struct Rect { public int Left, Top, Right, Bottom; }
        [DllImport("user32.dll")]
        private static extern IntPtr SendMessage(IntPtr hwnd, int msg, IntPtr wparam, IntPtr lparam);
        [DllImport("user32.dll", EntryPoint = "SendMessage")]
        private static extern IntPtr GetItemRect(IntPtr hwnd, int msg, IntPtr index, ref Rect rect);
        [DllImport("user32.dll")]
        private static extern bool GetClientRect(IntPtr hwnd, out Rect rect);

        private ChromeTheme(Control owner) {
            control = owner;
            owner.HandleCreated += (s, e) => Attach();
            owner.HandleDestroyed += (s, e) => ReleaseHandle();
            owner.Disposed += (s, e) => ReleaseHandle();
            if (owner.IsHandleCreated) Attach();
        }
        private void Attach() {
            IntPtr target = control is ListView
                ? SendMessage(control.Handle, 0x101F, IntPtr.Zero, IntPtr.Zero) : control.Handle;
            if (target != IntPtr.Zero && target != Handle) {
                ReleaseHandle();
                AssignHandle(target);
            }
        }
        public static void Register(Control owner, Color background) {
            ChromeTheme theme = Themes.GetValue(owner, key => new ChromeTheme(key));
            theme.color = background;
            owner.Invalidate(true);
        }
        protected override void WndProc(ref Message message) {
            base.WndProc(ref message);
            if (message.Msg != 0x000F && message.Msg != 0x0317 && message.Msg != 0x0318) return;
            Rect client;
            if (!GetClientRect(Handle, out client)) return;
            Rectangle unused = Rectangle.FromLTRB(0, 0, client.Right, client.Bottom);
            TabControl tabs = control as TabControl;
            if (tabs != null) {
                if (tabs.Alignment != TabAlignment.Top || tabs.Multiline || tabs.TabCount == 0) return;
                Rectangle last = tabs.GetTabRect(tabs.TabCount - 1);
                unused = Rectangle.FromLTRB(last.Right, 0, client.Right, last.Bottom);
            } else {
                ListView list = (ListView)control;
                int right = 0;
                for (int i = 0; i < list.Columns.Count; i++) {
                    Rect column = new Rect();
                    GetItemRect(Handle, 0x1207, (IntPtr)i, ref column);
                    right = Math.Max(right, column.Right);
                }
                unused.X = Math.Max(0, right);
                unused.Width = client.Right - unused.X;
            }
            if (unused.Width <= 0 || unused.Height <= 0) return;
            using (Graphics graphics = message.Msg == 0x000F
                ? Graphics.FromHwnd(Handle) : Graphics.FromHdc(message.WParam))
            using (SolidBrush brush = new SolidBrush(color)) {
                graphics.FillRectangle(brush, unused);
            }
        }
    }
}
'@ -ErrorAction Stop
    }
    [PAWDeploy.UI.ChromeTheme]::Register($Control, $Color)
}
function Register-PAWUiInputTheme {
    <#
    .SYNOPSIS
        Registers shared input borders and owner-drawn orange selections once.
    .NOTES
        Version : 2.0.0.3
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][System.Windows.Forms.Control]$Control)

    if (-not (Get-Variable -Name PAWInputThemes -Scope Script -ErrorAction SilentlyContinue)) {
        $script:PAWInputThemes = New-Object 'System.Runtime.CompilerServices.ConditionalWeakTable[System.Windows.Forms.Control,System.Object]'
    }
    $registered = $null
    if ($script:PAWInputThemes.TryGetValue($Control, [ref]$registered)) { return }
    $script:PAWInputThemes.Add($Control, $true)
    $palette = Get-PAWUiPalette

    if ($Control -is [System.Windows.Forms.CheckBox] -or $Control -is [System.Windows.Forms.RadioButton]) {
        $Control.Add_Paint({
            param($sender, $eventArgs)
            if ($sender.Appearance -eq [System.Windows.Forms.Appearance]::Button) { return }
            $colors = $palette
            $size = [int][Math]::Round(13 * $eventArgs.Graphics.DpiX / 96)
            $alignment = $sender.CheckAlign.ToString()
            $x = if ($alignment.EndsWith('Right')) { $sender.ClientSize.Width - $size }
                elseif ($alignment.EndsWith('Center')) { [int](($sender.ClientSize.Width - $size) / 2) } else { 0 }
            $y = if ($alignment.StartsWith('Bottom')) { $sender.ClientSize.Height - $size }
                elseif ($alignment.StartsWith('Middle')) { [int](($sender.ClientSize.Height - $size) / 2) } else { 0 }
            $bounds = New-Object System.Drawing.Rectangle($x, $y, ($size - 1), ($size - 1))
            $surface = [System.Drawing.SolidBrush]::new($sender.BackColor)
            $fillColor = if ($sender.Checked) { $colors.Accent } else { $colors.Field }
            $fill = [System.Drawing.SolidBrush]::new($fillColor)
            $borderColor = if ($sender.Focused -or $sender.Checked) { $colors.Accent } else { $colors.Border }
            $border = [System.Drawing.Pen]::new($borderColor)
            $mark = [System.Drawing.Pen]::new($colors.AccentText, 2)
            try {
                $eventArgs.Graphics.FillRectangle($surface, $x, $y, $size, $size)
                if ($sender -is [System.Windows.Forms.RadioButton]) {
                    $eventArgs.Graphics.FillEllipse($fill, $bounds)
                    $eventArgs.Graphics.DrawEllipse($border, $bounds)
                    if ($sender.Checked) {
                        $dot = [System.Drawing.SolidBrush]::new($colors.AccentText)
                        try { $eventArgs.Graphics.FillEllipse($dot, ($x + 4), ($y + 4), ($size - 8), ($size - 8)) }
                        finally { $dot.Dispose() }
                    }
                }
                else {
                    $eventArgs.Graphics.FillRectangle($fill, $bounds)
                    $eventArgs.Graphics.DrawRectangle($border, $bounds)
                    if ($sender.CheckState -eq [System.Windows.Forms.CheckState]::Indeterminate) {
                        $eventArgs.Graphics.DrawLine($mark, ($x + 3), ($y + 6), ($x + $size - 4), ($y + 6))
                    }
                    elseif ($sender.Checked) {
                        $eventArgs.Graphics.DrawLine($mark, ($x + 2), ($y + 6), ($x + 5), ($y + 9))
                        $eventArgs.Graphics.DrawLine($mark, ($x + 5), ($y + 9), ($x + $size - 3), ($y + 3))
                    }
                }
            }
            finally { $surface.Dispose(); $fill.Dispose(); $border.Dispose(); $mark.Dispose() }
        }.GetNewClosure())
        return
    }

    if ($Control -is [System.Windows.Forms.TextBoxBase] -or
        $Control -is [System.Windows.Forms.ListBox] -or
        $Control -is [System.Windows.Forms.ListView] -or
        $Control -is [System.Windows.Forms.NumericUpDown] -or
        $Control -is [System.Windows.Forms.DataGridView]) {
        $Control.BorderStyle = 'None'
    }
    $invalidate = {
        param($sender, $eventArgs)
        if ($null -ne $sender.Parent) { $sender.Parent.Invalidate() }
    }
    $Control.Add_Enter($invalidate)
    $Control.Add_Leave($invalidate)
    $Control.Add_VisibleChanged($invalidate)
    $Control.Add_LocationChanged($invalidate)
    $Control.Add_SizeChanged($invalidate)
    $Control.Add_BackColorChanged({
        param($sender, $eventArgs)
        $colors = $palette
        $sender.ForeColor = if ($sender.BackColor.ToArgb() -eq $colors.Accent.ToArgb()) {
            $colors.AccentText
        } else { $colors.Text }
    }.GetNewClosure())
    $Control.Add_EnabledChanged({
        param($sender, $eventArgs)
        $colors = $palette
        if ($sender.BackColor.ToArgb() -ne $colors.Accent.ToArgb()) {
            $sender.BackColor = if (-not $sender.Enabled -or
                ($sender -is [System.Windows.Forms.TextBoxBase] -and $sender.ReadOnly)) {
                $colors.ReadOnly
            } else { $colors.Field }
        }
        if ($null -ne $sender.Parent) { $sender.Parent.Invalidate() }
    }.GetNewClosure())

    if ($Control -is [System.Windows.Forms.ComboBox] -or $Control -is [System.Windows.Forms.ListBox]) {
        if ($Control -isnot [System.Windows.Forms.CheckedListBox]) { $Control.DrawMode = 'OwnerDrawFixed' }
        $Control.Add_DrawItem({
            param($sender, $eventArgs)
            if ($eventArgs.Index -lt 0) { return }
            $colors = $palette
            $selected = ($eventArgs.State -band [System.Windows.Forms.DrawItemState]::Selected) -ne 0
            $background = if ($selected) { $colors.Selection } else { $sender.BackColor }
            $foreground = if (-not $sender.Enabled) { $colors.MutedText }
                elseif ($selected) { $colors.SelectionText } else { $colors.Text }
            $brush = [System.Drawing.SolidBrush]::new($background)
            try {
                $eventArgs.Graphics.FillRectangle($brush, $eventArgs.Bounds)
                $textBounds = $eventArgs.Bounds
                if ($sender -is [System.Windows.Forms.CheckedListBox]) {
                    $glyph = [int][Math]::Round(13 * $eventArgs.Graphics.DpiX / 96)
                    $x = $textBounds.Left + 2
                    $y = $textBounds.Top + [int](($textBounds.Height - $glyph) / 2)
                    $checked = $sender.GetItemCheckState($eventArgs.Index) -ne [System.Windows.Forms.CheckState]::Unchecked
                    $fillColor = if ($checked) { $colors.Accent } else { $colors.Field }
                    $fill = [System.Drawing.SolidBrush]::new($fillColor)
                    $border = [System.Drawing.Pen]::new($colors.Border)
                    $mark = [System.Drawing.Pen]::new($colors.AccentText, 2)
                    try {
                        $eventArgs.Graphics.FillRectangle($fill, $x, $y, $glyph, $glyph)
                        $eventArgs.Graphics.DrawRectangle($border, $x, $y, ($glyph - 1), ($glyph - 1))
                        if ($checked) {
                            if ($sender.GetItemCheckState($eventArgs.Index) -eq [System.Windows.Forms.CheckState]::Indeterminate) {
                                $eventArgs.Graphics.DrawLine($mark, ($x + 3), ($y + 6), ($x + $glyph - 4), ($y + 6))
                            }
                            else {
                                $eventArgs.Graphics.DrawLine($mark, ($x + 2), ($y + 6), ($x + 5), ($y + 9))
                                $eventArgs.Graphics.DrawLine($mark, ($x + 5), ($y + 9), ($x + $glyph - 3), ($y + 3))
                            }
                        }
                    }
                    finally { $fill.Dispose(); $border.Dispose(); $mark.Dispose() }
                    $textBounds.X += $glyph + 6
                    $textBounds.Width -= $glyph + 6
                }
                [System.Windows.Forms.TextRenderer]::DrawText($eventArgs.Graphics,
                    $sender.GetItemText($sender.Items[$eventArgs.Index]), $sender.Font,
                    $textBounds, $foreground, $background,
                    ([System.Windows.Forms.TextFormatFlags]::Left -bor
                     [System.Windows.Forms.TextFormatFlags]::VerticalCenter -bor
                     [System.Windows.Forms.TextFormatFlags]::EndEllipsis))
            }
            finally { $brush.Dispose() }
        }.GetNewClosure())
    }
    if ($null -ne $Control.Parent) {
        $parent = $Control.Parent
        $registered = $null
        if (-not $script:PAWInputThemes.TryGetValue($parent, [ref]$registered)) {
            $script:PAWInputThemes.Add($parent, $true)
            $paintState = [pscustomobject]@{ IsPainting = $false }
            $parent.Add_Paint({
                param($sender, $eventArgs)
                if ($paintState.IsPainting) { return }
                $paintState.IsPainting = $true
                try {
                    $colors = $palette
                    foreach ($field in $sender.Controls) {
                        if (-not $field.Visible -or
                            -not ($field -is [System.Windows.Forms.TextBoxBase] -or
                                  $field -is [System.Windows.Forms.ListControl] -or
                                  $field -is [System.Windows.Forms.ListView] -or
                                  $field -is [System.Windows.Forms.DataGridView] -or
                                  $field -is [System.Windows.Forms.NumericUpDown])) { continue }
                        $color = if ($field.ContainsFocus) { $colors.Accent } else { $colors.Border }
                        $pen = [System.Drawing.Pen]::new($color)
                        try {
                            $bounds = $field.Bounds
                            $bounds.Inflate(1, 1)
                            $eventArgs.Graphics.DrawRectangle($pen, $bounds.X, $bounds.Y,
                                ($bounds.Width - 1), ($bounds.Height - 1))
                        }
                        finally { $pen.Dispose() }
                    }
                }
                finally { $paintState.IsPainting = $false }
            }.GetNewClosure())
        }
    }
}
<#
.SYNOPSIS
    Resolves installed images, or repository branding images before installation.
.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team
#>
function Resolve-PAWImagePath {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$FileName)

    $moduleBase = $ExecutionContext.SessionState.Module.ModuleBase
    $root = Split-Path -Parent (Split-Path -Parent $moduleBase)
    foreach ($folder in @(
        (Join-Path $root 'Assets\img'),
        (Join-Path (Split-Path -Parent $root) 'Assets\img'),
        (Join-Path (Split-Path -Parent $root) 'Resources')
    )) {
        $path = Join-Path $folder $FileName
        if (Test-Path -LiteralPath $path -PathType Leaf) { return $path }
    }
    throw "PAWDeploy image '$FileName' not found in '$root\Assets\img' or repository Resources."
}
<#
.SYNOPSIS
    Resolves the configured toolkit theme and the Windows appearance preference.
.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team
#>
function Resolve-PAWUiThemeName {
    [CmdletBinding()]
    param([string]$Theme)

    if ([string]::IsNullOrWhiteSpace($Theme)) {
        $configPath = Join-Path $script:scriptFolder 'Config\Config.json'
        if (Test-Path -LiteralPath $configPath -PathType Leaf) {
            $config = Get-Content -LiteralPath $configPath -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
            $configuration = $config.Settings.Configuration
            if ($null -ne $configuration -and $null -ne $configuration.PSObject.Properties['UITheme']) {
                $Theme = [string]$configuration.UITheme
                if ([string]::IsNullOrWhiteSpace($Theme)) {
                    throw "Config.json has an invalid Settings.Configuration.UITheme value: $configPath"
                }
            }
        }
    }
    if ([string]::IsNullOrWhiteSpace($Theme)) {
        $settingsPath = Join-Path $script:scriptFolder 'Settings\UITheme.json'
        if (Test-Path -LiteralPath $settingsPath -PathType Leaf) {
            $settings = Get-Content -LiteralPath $settingsPath -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
            if ($null -eq $settings.PSObject.Properties['Theme'] -or
                [string]::IsNullOrWhiteSpace([string]$settings.Theme)) {
                throw "Theme settings file has no valid Theme value: $settingsPath"
            }
            $Theme = [string]$settings.Theme
        }
        else {
            $Theme = 'System'
        }
    }

    if ([string]::Equals($Theme, 'System', [System.StringComparison]::OrdinalIgnoreCase)) {
        $key = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey(
            'Software\Microsoft\Windows\CurrentVersion\Themes\Personalize')
        if ($null -eq $key) {
            return 'Dark'
        }
        try {
            $useLightTheme = $key.GetValue('AppsUseLightTheme', $null)
        }
        finally {
            $key.Dispose()
        }
        if ($null -eq $useLightTheme) {
            return 'Dark'
        }
        return $(if ([int]$useLightTheme -eq 0) { 'Dark' } else { 'Light' })
    }

    if ($Theme -notmatch '^[A-Za-z0-9][A-Za-z0-9_-]*$') {
        throw "Invalid PAWDeploy theme name '$Theme'. Use a theme filename without its .json extension."
    }
    return $Theme
}
<#
.SYNOPSIS
    Selects a template or bundle for assignment without accessing storage.
.NOTES
    Version : 2.0.0.6
    Author  : The Fantastic PAWDeploy Team
#>
function Show-PAWApplicationAssignmentPicker {
    param([Windows.Forms.Form]$Owner, [object[]]$Items, [string]$Prompt,
        [ValidateSet('Templates','Bundles')][string]$ListName = 'Templates', [switch]$CreateOnly)
    if (-not $Items.Count) {
        if ($ListName -eq 'Bundles') { throw 'No bundles are available. Create a bundle before assigning an application.' }
        throw 'No templates are available. Create a template before assigning a bundle.'
    }
    $dialog = New-Object Windows.Forms.Form
    $returnForm = $false
    try {
        $dialog.Text = 'Assign'
        $dialog.ClientSize = New-Object Drawing.Size(620, 380)
        $dialog.StartPosition = 'CenterParent'
        $dialog.Font = [Drawing.Font]::new('Segoe UI', 10)
        $dialog.Add_Disposed({ param($sender, $eventArgs) $sender.Font.Dispose() })
        $dialog.Padding = New-Object Windows.Forms.Padding(12)
        $label = New-Object Windows.Forms.Label
        $label.Text = $Prompt
        $label.Dock = 'Top'
        $label.Height = 40
        $list = New-Object Windows.Forms.ListBox
        $list.Name = $ListName
        $list.Dock = 'Fill'
        $list.IntegralHeight = $false
        $list.DisplayMember = 'Name'
        foreach ($item in $Items) { $null = $list.Items.Add($item) }
        $list.SelectedIndex = 0
        $buttons = New-Object Windows.Forms.FlowLayoutPanel
        $buttons.Dock = 'Bottom'
        $buttons.Height = 45
        $assign = New-PAWUiButton -Text 'Assign' -Width 140 -Height 32 -Accent
        $assign.DialogResult = 'OK'
        $cancel = New-PAWUiButton -Text 'Cancel' -Width 100 -Height 32
        $cancel.DialogResult = 'Cancel'
        $buttons.Controls.AddRange(@($assign, $cancel))
        $dialog.Controls.AddRange(@($list, $label, $buttons))
        $dialog.AcceptButton = $assign
        $dialog.CancelButton = $cancel
        Set-PAWUiTheme -Control $dialog
        $list.ItemHeight = [Math]::Max(32, [Windows.Forms.TextRenderer]::MeasureText('Ag', $list.Font).Height + 12)
        if ($CreateOnly) { $returnForm = $true; return $dialog }
        if ($dialog.ShowDialog($Owner) -eq 'OK') { return $list.SelectedItem }
    }
    finally { if (-not $returnForm) { $dialog.Dispose() } }
}
function Show-PAWApplicationBundleEditor {
    <#
    .SYNOPSIS
        Edits bundle membership and installation order without accessing the application store.
    .NOTES
        Version : 2.0.0.7
        Author  : The Fantastic PAWDeploy Team
    #>
    param([Windows.Forms.Form]$Owner, [psobject]$Bundle, [object[]]$Catalog, [switch]$CreateOnly)
    $form = New-Object Windows.Forms.Form
    $returnForm = $false
    try {
        $form.Text = 'Application Bundle - installation order'
        $form.ClientSize = New-Object Drawing.Size(980, 600)
        $form.StartPosition = 'CenterParent'
        $form.FormBorderStyle = 'FixedDialog'
        $form.MaximizeBox = $false
        $form.MinimizeBox = $false
        $form.Font = [Drawing.Font]::new('Segoe UI', 10)
        $form.Add_Disposed({ param($sender, $eventArgs) $sender.Font.Dispose() })

        $idLabel = New-Object Windows.Forms.Label
        $idLabel.Text = 'Bundle ID'; $idLabel.AutoSize = $true; $idLabel.Location = New-Object Drawing.Point(15, 18)
        $id = New-Object Windows.Forms.TextBox
        $id.Text = $Bundle.BundleId; $id.Location = New-Object Drawing.Point(190, 15); $id.Width = 775; $id.ReadOnly = $true
        $nameLabel = New-Object Windows.Forms.Label
        $nameLabel.Text = 'Display name'; $nameLabel.AutoSize = $true; $nameLabel.Location = New-Object Drawing.Point(15, 53)
        $name = New-Object Windows.Forms.TextBox
        $name.Text = $Bundle.Name; $name.Location = New-Object Drawing.Point(190, 50); $name.Width = 775

        $availableLabel = New-Object Windows.Forms.Label
        $availableLabel.Text = 'Available applications'; $availableLabel.AutoSize = $true
        $availableLabel.Location = New-Object Drawing.Point(15, 95)
        $orderLabel = New-Object Windows.Forms.Label
        $orderLabel.Text = 'Installation order (installed from top to bottom)'; $orderLabel.AutoSize = $true
        $orderLabel.Location = New-Object Drawing.Point(585, 95)
        $available = New-Object Windows.Forms.ListBox
        $available.Name = 'Available'
        $available.Location = New-Object Drawing.Point(15, 120); $available.Size = New-Object Drawing.Size(340, 400)
        $available.IntegralHeight = $false; $available.HorizontalScrollbar = $true
        $order = New-Object Windows.Forms.ListBox
        $order.Name = 'InstallOrder'
        $order.Location = New-Object Drawing.Point(585, 120); $order.Size = New-Object Drawing.Size(380, 400)
        $order.IntegralHeight = $false; $order.HorizontalScrollbar = $true

        $labels = @{}
        foreach ($app in @($Catalog)) {
            $label = "$($app.Definition.Name) ($(Get-PAWApplicationUIType -Application $app))"
            if (-not $app.Enabled) { $label += ' [DISABLED]' }
            $labels[[string]$app.ApplicationId] = $label
        }
        $state = @{
            Order = New-Object 'System.Collections.Generic.List[string]'
            Available = New-Object 'System.Collections.Generic.List[string]'
            Labels = $labels; OrderList = $order; AvailableList = $available; Name = $name; Id = $id; Result = $null
        }
        foreach ($key in @($Bundle.Applications)) {
            $key = [string]$key
            if (-not $labels.ContainsKey($key)) { $labels[$key] = "Missing application ($key)" }
            if (-not $state.Order.Contains($key)) { $state.Order.Add($key) }
        }
        foreach ($key in @($labels.Keys | Where-Object { -not $state.Order.Contains($_) } | Sort-Object { $labels[$_] })) {
            $state.Available.Add($key)
        }
        $state.Refresh = {
            param($s, [int]$OrderIndex, [int]$AvailableIndex)
            $s.OrderList.BeginUpdate()
            $s.OrderList.Items.Clear()
            for ($i = 0; $i -lt $s.Order.Count; $i++) { $null = $s.OrderList.Items.Add(('{0}. {1}' -f ($i + 1), $s.Labels[$s.Order[$i]])) }
            $s.OrderList.SelectedIndex = [Math]::Min($OrderIndex, $s.Order.Count - 1)
            $s.OrderList.EndUpdate()
            $s.AvailableList.BeginUpdate()
            $s.AvailableList.Items.Clear()
            foreach ($key in $s.Available) { $null = $s.AvailableList.Items.Add($s.Labels[$key]) }
            $s.AvailableList.SelectedIndex = [Math]::Min($AvailableIndex, $s.Available.Count - 1)
            $s.AvailableList.EndUpdate()
        }
        $state.Apply = {
            param($s, [string]$Action)
            $orderIndex = $s.OrderList.SelectedIndex
            $availableIndex = $s.AvailableList.SelectedIndex
            switch ($Action) {
                'Add' {
                    if ($availableIndex -lt 0) { return }
                    $key = $s.Available[$availableIndex]
                    $s.Available.RemoveAt($availableIndex)
                    $s.Order.Add($key)
                    & $s.Refresh $s ($s.Order.Count - 1) $availableIndex
                }
                'Remove' {
                    if ($orderIndex -lt 0) { return }
                    $key = $s.Order[$orderIndex]
                    $s.Order.RemoveAt($orderIndex)
                    $newAvailableIndex = $availableIndex
                    if (-not $s.Labels[$key].StartsWith('Missing application (')) {
                        $sorted = @(@($s.Available) + $key | Sort-Object { $s.Labels[$_] })
                        $s.Available.Clear()
                        foreach ($item in $sorted) { $s.Available.Add($item) }
                        $newAvailableIndex = $s.Available.IndexOf($key)
                    }
                    & $s.Refresh $s $orderIndex $newAvailableIndex
                }
                { $_ -in 'Up', 'Down' } {
                    $target = $orderIndex + $(if ($Action -eq 'Up') { -1 } else { 1 })
                    if ($orderIndex -lt 0 -or $target -lt 0 -or $target -ge $s.Order.Count) { return }
                    $key = $s.Order[$orderIndex]
                    $s.Order.RemoveAt($orderIndex)
                    $s.Order.Insert($target, $key)
                    & $s.Refresh $s $target $availableIndex
                }
            }
        }

        $buttonSpecs = @(
            @{ Text = 'Add >'; Name = 'Add'; Y = 150 }
            @{ Text = '< Remove'; Name = 'Remove'; Y = 190 }
            @{ Text = 'Move up'; Name = 'Up'; Y = 260 }
            @{ Text = 'Move down'; Name = 'Down'; Y = 300 }
        )
        $actionButtons = foreach ($spec in $buttonSpecs) {
            $button = New-PAWUiButton -Text $spec.Text -X 370 -Y $spec.Y -Width 200 -Height 30
            $button.Name = $spec.Name
            $button.Tag = @{ State = $state; Action = $spec.Name }
            $button.Add_Click({
                param($sender, $eventArgs)
                & $sender.Tag.State.Apply $sender.Tag.State $sender.Tag.Action
            })
            $button
        }
        $available.Tag = $state
        $available.Add_DoubleClick({ param($sender, $eventArgs) & $sender.Tag.Apply $sender.Tag 'Add' })
        $order.Tag = $state
        $order.Add_DoubleClick({ param($sender, $eventArgs) & $sender.Tag.Apply $sender.Tag 'Remove' })

        $save = New-PAWUiButton -Text 'Save bundle' -X 555 -Y 550 -Width 200 -Height 30 -Accent
        $save.Name = 'Save'
        $save.DialogResult = 'OK'
        $save.Tag = $state
        $save.Add_Click({
            param($sender, $eventArgs)
            $s = $sender.Tag
            $s.Result = [pscustomobject]@{
                SchemaVersion = 1; BundleId = $s.Id.Text; Name = $s.Name.Text; Applications = [string[]]@($s.Order)
            }
        })
        $cancel = New-PAWUiButton -Text 'Cancel' -X 765 -Y 550 -Width 200 -Height 30
        $cancel.DialogResult = 'Cancel'
        $form.Controls.AddRange(@($idLabel, $id, $nameLabel, $name, $availableLabel, $orderLabel, $available, $order, $save, $cancel))
        $form.Controls.AddRange(@($actionButtons))
        $form.AcceptButton = $save
        $form.CancelButton = $cancel
        $form.Tag = $state
        Set-PAWUiTheme -Control $form
        foreach ($list in @($available, $order)) {
            $list.ItemHeight = [Math]::Max(32, [Windows.Forms.TextRenderer]::MeasureText('Ag', $list.Font).Height + 12)
        }
        & $state.Refresh $state 0 0
        if ($CreateOnly) { $returnForm = $true; return $form }
        if ($form.ShowDialog($Owner) -eq 'OK') { return $state.Result }
    }
    finally { if (-not $returnForm) { $form.Dispose() } }
}
<#
.SYNOPSIS
    Provides application/bundle Windows Forms backed exclusively by the CLI script.
.NOTES
    Version : 2.0.0.4
    Author  : The Fantastic PAWDeploy Team
#>
function Show-PAWApplicationDocumentEditor {
    param([Windows.Forms.Form]$Owner, [string]$Title, [object]$Value)
