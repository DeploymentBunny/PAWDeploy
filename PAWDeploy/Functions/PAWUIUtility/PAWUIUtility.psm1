function Get-PAWUiPalette {
    <#
    .SYNOPSIS
        Loads the selected toolkit theme palette.
    .PARAMETER Theme
        Optional theme name. System follows the Windows app appearance preference.
    .EXAMPLE
        $textBox.BackColor = (Get-PAWUiPalette).Field
    .NOTES
        Version : 2.0.0.7
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param([string]$Theme)

    if (-not $PSBoundParameters.ContainsKey('Theme') -and
        -not [string]::IsNullOrWhiteSpace([string]$script:PAWUiThemeOverride)) {
        $Theme = [string]$script:PAWUiThemeOverride
    }
    $themeName = Resolve-PAWUiThemeName -Theme $Theme
    $themePath = Join-Path $script:scriptFolder "Assets\Themes\$themeName.json"
    if (-not (Test-Path -LiteralPath $themePath -PathType Leaf)) {
        throw "PAWDeploy theme '$themeName' was not found: $themePath"
    }
    $themeData = Get-Content -LiteralPath $themePath -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
    $colorNames = @(
        'Background', 'Panel', 'Field', 'Border', 'ReadOnly', 'Selection',
        'SelectionText', 'Text', 'MutedText', 'Heading', 'Accent', 'AccentText'
    )
    $palette = @{}
    foreach ($colorName in $colorNames) {
        $property = $themeData.PSObject.Properties[$colorName]
        if ($null -eq $property -or [string]$property.Value -notmatch '^#[0-9A-Fa-f]{6}$') {
            throw "PAWDeploy theme '$themeName' has a missing or invalid '$colorName' color."
        }
        $palette[$colorName] = [System.Drawing.ColorTranslator]::FromHtml([string]$property.Value)
    }
    foreach ($entry in @{
        ButtonHover = 'Field'; ButtonPressed = 'Border'
        AccentHover = 'Accent'; AccentPressed = 'Accent'
        MenuRibbon = 'Background'
        ButtonBorder = 'Text'
    }.GetEnumerator()) {
        $property = $themeData.PSObject.Properties[$entry.Key]
        if ($null -eq $property) {
            $palette[$entry.Key] = $palette[$entry.Value]
            continue
        }
        if ([string]$property.Value -notmatch '^#[0-9A-Fa-f]{6}$') {
            throw "PAWDeploy theme '$themeName' has an invalid '$($entry.Key)' color."
        }
        $palette[$entry.Key] = [System.Drawing.ColorTranslator]::FromHtml([string]$property.Value)
    }
    $palette.Theme = $themeName
    $backgroundImageProperty = $themeData.PSObject.Properties['BackgroundImage']
    $palette.BackgroundImage = if ($null -ne $backgroundImageProperty) {
        [string]$backgroundImageProperty.Value
    } else { '' }
    return $palette
}
