function Export-PAWTemplate {
    <#
    .SYNOPSIS
        Exports saved templates as separate portable JSON files.
    .DESCRIPTION
        Selects templates by name and excludes Config.json. Checks JSON structure,
        but retains saved setting values, including legacy values. Strict setting
        validation belongs to import. Local resources are not required.
    .PARAMETER Name
        One or more saved template names.
    .PARAMETER ConfigPath
        Existing configuration file whose parent stores templates.
    .PARAMETER DestinationFolder
        Folder receiving one JSON file per template, keeping source filenames.
    .PARAMETER Replace
        Explicit permission to replace existing export files.
    .NOTES
        Version : 2.0.0.6
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess)]
    param(
        [Parameter(Mandatory, ValueFromPipelineByPropertyName)][ValidateNotNullOrEmpty()][string[]]$Name,
        [string]$ConfigPath = (Join-Path $script:scriptFolder 'Config\Config.json'),
        [Parameter(Mandatory)][string]$DestinationFolder,
        [switch]$Replace
    )
    begin { $selectedNames = New-Object 'System.Collections.Generic.List[string]' }
    process { foreach ($templateName in $Name) { $selectedNames.Add($templateName) } }
    end {
    if ($selectedNames.Count -eq 0) { return }
    $Name = $selectedNames.ToArray()
    $folder = Split-Path -Parent (Get-Item -LiteralPath $ConfigPath -ErrorAction Stop).FullName
    $destinationRoot = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($DestinationFolder)
    Assert-PAWBaselineDestination -Path $destinationRoot -DirectoriesOnly
    $existing = Get-PAWTemplateFileCollection -TemplateFolder $folder
    $names = @{}
    $items = @(
        foreach ($templateName in $Name) {
            if ($names.ContainsKey($templateName)) { throw "Duplicate export template name: '$templateName'." }
            $names[$templateName] = $true
            $matchingTemplates = @($existing | Where-Object Name -eq $templateName)
            if ($matchingTemplates.Count -ne 1) { throw "Expected exactly one saved template named '$templateName'." }
            $source = Get-Item -LiteralPath $matchingTemplates[0].FullPath -Force -ErrorAction Stop
            if ($source.Attributes -band [IO.FileAttributes]::ReparsePoint) {
                throw "Cannot export a linked template file: '$($source.FullName)'."
            }
            $json = Get-Content -LiteralPath $source.FullName -Raw -ErrorAction Stop
            $data = ConvertFrom-Json -InputObject $json -ErrorAction Stop
            if (-not $json.TrimStart().StartsWith('{') -or $data -isnot [pscustomobject] -or
                $data.PSObject.Properties['Settings'] -or $data.PSObject.Properties['Solution']) {
                throw "Not a deployment template JSON object: '$($source.FullName)'."
            }
            $template = [pscustomobject]@{ Name = $templateName; Source = $source.FullName; Data = $data }
            $destination = Join-Path $destinationRoot $matchingTemplates[0].FileName
            if ($destination -eq $template.Source) { throw "Cannot export over installed template: '$destination'." }
            if (Test-Path -LiteralPath $destination -ErrorAction Stop) {
                $existingTarget = Get-Item -LiteralPath $destination -Force -ErrorAction Stop
                if ($existingTarget.PSIsContainer) { throw "Export target is a directory: '$destination'." }
                if ($existingTarget.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "Export target is a reparse point: '$destination'." }
                if (-not $Replace) { throw "Export exists; use -Replace: '$destination'." }
            }
            [pscustomobject]@{ Name = $template.Name; Source = $template.Source; Data = $template.Data; Destination = $destination }
        }
    )
    if ($PSCmdlet.ShouldProcess($destinationRoot, "Export $($items.Count) saved template(s) (Replace=$Replace)")) {
        Write-PAWTemplateTransfer -Items $items -Replace:$Replace -DirectoriesOnly | ForEach-Object {
            $_ | Add-Member -NotePropertyName FullName -NotePropertyValue $_.Destination -PassThru
        }
    }
    }
}
