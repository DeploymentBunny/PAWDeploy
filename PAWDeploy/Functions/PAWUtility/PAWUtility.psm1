<#

.SYNOPSIS
    Orders template settings by the standard PAW setting sequence while retaining other properties.

.DESCRIPTION
    Returns an ordered dictionary with the template settings in the standard
    order from Get-PAWTemplateSettingOrder, followed by any additional (custom)
    settings in their original order. Accepts a PSCustomObject (for example
    from ConvertFrom-Json) or a dictionary.

.PARAMETER Template
    The template object or dictionary.

.EXAMPLE
    $template = Get-Content 'C:\PAWDeploy\Config\PAW.json' -Raw | ConvertFrom-Json
    ConvertTo-PAWOrderedTemplate -Template $template | ConvertTo-Json -Depth 20

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function ConvertTo-PAWOrderedTemplate {
    [CmdletBinding()]
    [OutputType([System.Collections.Specialized.OrderedDictionary])]
    param(
        [Parameter(Mandatory = $true)]
        [object]$Template
    )

    $settingOrder = Get-PAWTemplateSettingOrder
    $ordered = [ordered]@{}
    $properties = @()
    if ($Template -is [System.Collections.IDictionary]) {
        foreach ($key in $Template.Keys) {
            $properties += [PSCustomObject]@{ Name = [string]$key; Value = $Template[$key] }
        }
    }
    else {
        $properties = @($Template.PSObject.Properties | ForEach-Object { [PSCustomObject]@{ Name = $_.Name; Value = $_.Value } })
    }

    foreach ($settingName in $settingOrder) {
        $property = $properties | Where-Object { $_.Name -eq $settingName } | Select-Object -First 1
        if ($null -ne $property) {
            $ordered[$settingName] = $property.Value
        }
    }
    foreach ($property in $properties) {
        if ($settingOrder -notcontains $property.Name) {
            $ordered[$property.Name] = $property.Value
        }
    }

    return $ordered
}
<#

.SYNOPSIS
    Validates and normalizes a value according to its PAW template setting name.

.DESCRIPTION
    Validates a value for a standard template setting and returns it in the
    canonical form stored in template JSON files (trimmed, canonical casing,
    numbers as strings). Throws a descriptive error when the value is invalid.

    Settings without specific rules are returned trimmed.

.PARAMETER SettingName
    The template setting name, for example UILanguage or Memory.

.PARAMETER Value
    The value to validate.

.EXAMPLE
    ConvertTo-PAWTemplateValue -SettingName 'TimeZoneName' -Value 'w. europe standard time'
    Returns 'W. Europe Standard Time'.

.NOTES
    Version : 2.0.0.6
    Author  : The Fantastic PAWDeploy Team

#>
function ConvertTo-PAWTemplateValue {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory = $true)]
        [string]$SettingName,

        [Parameter(Mandatory = $false)]
        [AllowNull()]
        [object]$Value
    )

    $booleanSettings = @('DynamicMem', 'Shielded', 'BitLocker', 'ASR', 'Application', 'ApplySecurityBaseline')
    $cultureSettings = @('SystemLocale', 'UILanguage', 'UserLocale')
    $requiredValueSettings = @('VMGen', 'NoCPU', 'Memory', 'DiskMode', 'VHDFile', 'TimeZoneName', 'InputLocale', 'SystemLocale', 'UILanguage', 'UserLocale', 'DomainOrWorkGroup', 'VLanID', 'VMSwitch') + $booleanSettings

    $text = ''
    if ($null -ne $Value) {
        $text = ([string]$Value).Trim()
    }

    if ($requiredValueSettings -contains $SettingName -and [string]::IsNullOrEmpty($text)) {
        throw "$SettingName cannot be empty."
    }

    switch ($SettingName) {
        'ApplicationBundle' {
            if ($text -eq 'NA') {
                $text = 'NA'
                break
            }
            $bundleGuid = [guid]::Empty
            if (-not [guid]::TryParseExact($text, 'D', [ref]$bundleGuid) -or $bundleGuid -eq [guid]::Empty) {
                throw 'ApplicationBundle must be NA or a non-empty bundle GUID in standard hyphenated format.'
            }
            $text = $bundleGuid.ToString('D')
        }
        'WDACPolicyFile' {
            if ($text -and $text -ne 'NA' -and
                ([IO.Path]::GetFileName($text) -ne $text -or [IO.Path]::GetExtension($text) -ne '.xml' -or
                $text.IndexOfAny([IO.Path]::GetInvalidFileNameChars()) -ge 0)) {
                throw 'WDACPolicyFile must be an XML filename in WDACPolicy, or NA/empty to skip.'
            }
        }
        'VMGen' {
            if ($text -ne '2') {
                throw "VMGen '$text' is not supported. PAW templates require generation 2."
            }
        }
        { @('NoCPU', 'Memory', 'VLanID') -contains $_ } {
            $limits = @{ NoCPU = @(1, 240); Memory = @(2048, 1048576); VLanID = @(0, 4094) }[$SettingName]
            $number = 0
            if (-not [int]::TryParse($text, [ref]$number) -or $number -lt $limits[0] -or $number -gt $limits[1]) {
                throw "$SettingName '$text' must be a whole number between $($limits[0]) and $($limits[1])."
            }
            $text = [string]$number
        }
        { $booleanSettings -contains $_ } {
            $match = @('True', 'False') | Where-Object { $_ -eq $text } | Select-Object -First 1
            if ($null -eq $match) {
                throw "$SettingName '$text' must be True or False."
            }
            $text = $match
        }
        'DiskMode' {
            $match = @('Diff', 'Copy') | Where-Object { $_ -eq $text } | Select-Object -First 1
            if ($null -eq $match) {
                throw "DiskMode '$text' must be Diff or Copy."
            }
            $text = $match
        }
        'DomainOrWorkGroup' {
            if (@('DOMAIN', 'WORKGROUP') -notcontains $text) {
                throw "DomainOrWorkGroup '$text' must be DOMAIN or WORKGROUP."
            }
            $text = $text.ToUpperInvariant()
        }
        'TimeZoneName' {
            $timeZone = @(Get-PAWTimeZoneOptions) | Where-Object { $_ -eq $text } | Select-Object -First 1
            if ($null -eq $timeZone) {
                throw "TimeZoneName '$text' is not a valid Windows time zone ID. Use Get-TimeZone -ListAvailable to list valid IDs."
            }
            $text = $timeZone
        }
        { $cultureSettings -contains $_ } {
            $cultureName = Resolve-PAWCultureName -Name $text
            if ([string]::IsNullOrEmpty($cultureName)) {
                throw "$SettingName '$text' is not a valid culture name, for example en-US or sv-SE."
            }
            $text = $cultureName
        }
        'InputLocale' {
            if ($text -notmatch '^[0-9A-Fa-f]{4}:[0-9A-Fa-f]{8}$') {
                $cultureName = Resolve-PAWCultureName -Name $text
                if ([string]::IsNullOrEmpty($cultureName)) {
                    throw "InputLocale '$text' is not a valid culture name (for example sv-SE) or keyboard identifier (for example 041d:0000041d)."
                }
                $text = $cultureName
            }
        }
        { @('NamePrefix', 'NameSuffix') -contains $_ } {
            if ($text -notmatch '^[A-Za-z0-9-]*$') {
                throw "$SettingName '$text' may only contain letters, digits, and hyphens."
            }
        }
        'ProductKey' {
            if (-not [string]::IsNullOrEmpty($text)) {
                if ($text -notmatch '^([A-Za-z0-9]{5}-){4}[A-Za-z0-9]{5}$') {
                    throw 'ProductKey must be empty or use the format XXXXX-XXXXX-XXXXX-XXXXX-XXXXX.'
                }
                $text = $text.ToUpperInvariant()
            }
        }
    }

    return $text
}
<#
.SYNOPSIS
    Validates type-specific application definitions without accessing the target OS.
.NOTES
    Version : 2.0.0.4
    Author  : The Fantastic PAWDeploy Team
#>
function ConvertTo-PAWTypedApplicationDefinition {
    [CmdletBinding()]
    param([Parameter(Mandatory)][object]$Definition)
    $value = $Definition | ConvertTo-Json -Depth 20 | ConvertFrom-Json -ErrorAction Stop
    foreach ($key in @('Name','Type','InstallEnabled','Configuration')) {
        if ($null -eq $value.PSObject.Properties[$key]) { throw "Typed application definition is missing '$key'." }
    }
    foreach ($key in $value.PSObject.Properties.Name) {
        if ($key -notin 'Name','Type','InstallEnabled','Configuration') { throw "Unknown typed application property '$key'." }
    }
    if ($value.Name -isnot [string] -or [string]::IsNullOrWhiteSpace($value.Name) -or $value.Name -match '[\x00-\x1f]' -or $value.Name.StartsWith('-')) { throw 'Application Name must be non-empty text.' }
    if ($value.InstallEnabled -isnot [bool]) { throw 'InstallEnabled must be a JSON boolean.' }
    if ($value.Type -notin 'WinGet','PowerShellModule','Classic','WindowsComponent') { throw "Unknown application Type '$($value.Type)'." }
    $config = $value.Configuration
    if ($config -isnot [pscustomobject]) { throw 'Configuration must be a JSON object.' }
    $required = switch ($value.Type) {
        'WinGet' { @('Id','Architecture','Scope','InstallerType') }
        'PowerShellModule' { @('Id','Version','Runtime','Origin') }
        'Classic' {
            if ($null -ne $config.PSObject.Properties['FilePath']) {
                @('FilePath','Arguments','WorkingDirectory','SuccessExitCodes','TimeoutSeconds','Detection')
            }
            else { @('FolderPath','Executable','Arguments','WorkingDirectory','SuccessExitCodes','TimeoutSeconds') }
        }
        'WindowsComponent' { @('Kind','Names','Source','LimitAccess') }
    }
    foreach ($key in $required) {
        if ($null -eq $config.PSObject.Properties[$key]) { throw "$($value.Type) Configuration is missing '$key'." }
    }
    foreach ($key in $config.PSObject.Properties.Name) {
        if ($key -notin $required -and -not ($value.Type -eq 'Classic' -and $key -eq 'Detection')) { throw "Unknown $($value.Type) Configuration property '$key'." }
    }
    $checkText = {
        param($Text, $Label, [bool]$AllowEmpty = $false)
        if ($Text -isnot [string] -or (-not $AllowEmpty -and [string]::IsNullOrWhiteSpace($Text)) -or $Text -match '[\x00-\x08\x0b\x0c\x0e-\x1f]') {
            throw "$Label must be $(if ($AllowEmpty) { 'text' } else { 'non-empty text' })."
        }
    }
    switch ($value.Type) {
        'WinGet' {
            & $checkText $config.Id 'WinGet Id'
            if ($config.Id.StartsWith('-') -or $config.Id -eq 'NA') { throw 'WinGet Id must be a package identifier.' }
            $null = ConvertTo-PAWApplicationDefinition -Application @{
                Name = $value.Name; Source = 'WinGet'; Id = $config.Id; InstallEnabled = $value.InstallEnabled
                Architecture = $config.Architecture; Scope = $config.Scope; InstallerType = $config.InstallerType
            }
        }
        'PowerShellModule' {
            & $checkText $config.Id 'Module Id'
            if ($config.Id -notmatch '^[a-zA-Z0-9][a-zA-Z0-9._-]*$') { throw 'Module Id must be a module name, not a path or wildcard.' }
            if ($config.Version -ne 'Latest' -and ($config.Version -isnot [string] -or -not ($config.Version -as [version]))) { throw 'Module Version must be Latest or a numeric version.' }
            if ($config.Runtime -notin 'WindowsPowerShell','PowerShell7') { throw 'Module Runtime must be WindowsPowerShell or PowerShell7.' }
            if ($config.Origin -notin 'PSGallery','Local') { throw 'Module Origin must be PSGallery or Local.' }
        }
        'Classic' {
            & $checkText $config.Arguments 'Arguments' $true
            & $checkText $config.WorkingDirectory 'WorkingDirectory'
            $legacy = $null -ne $config.PSObject.Properties['FilePath']
            if ($legacy) {
                & $checkText $config.FilePath 'FilePath'
                $null = Resolve-PAWApplicationPayloadPath -PackageRoot $env:TEMP -RelativePath $config.FilePath
            }
            else {
                & $checkText $config.FolderPath 'FolderPath'
                $null = Resolve-PAWApplicationPayloadPath -PackageRoot $env:TEMP -RelativePath $config.FolderPath
                & $checkText $config.Executable 'Executable'
                if ($config.Executable -match '["\r\n]') { throw 'Executable must be a command or path without arguments or quotes.' }
                if (-not [IO.Path]::IsPathRooted($config.Executable) -and $config.Executable -notmatch '%[^%]+%') {
                    $null = Resolve-PAWApplicationPayloadPath -PackageRoot $env:TEMP -RelativePath $config.Executable
                }
            }
            $null = Resolve-PAWApplicationPayloadPath -PackageRoot $env:TEMP -RelativePath $config.WorkingDirectory
            if ($config.TimeoutSeconds -isnot [int] -or $config.TimeoutSeconds -lt 1 -or $config.TimeoutSeconds -gt 86400) { throw 'TimeoutSeconds must be an integer from 1 to 86400.' }
            if ($config.SuccessExitCodes -isnot [array] -or -not $config.SuccessExitCodes.Count) { throw 'SuccessExitCodes must be a non-empty integer array.' }
            foreach ($code in $config.SuccessExitCodes) { if ($code -isnot [int]) { throw 'SuccessExitCodes must contain integers.' } }
            if ($legacy) {
                if ($config.Detection -isnot [pscustomobject] -or $config.Detection.Kind -ne 'Path' -or
                    @($config.Detection.PSObject.Properties.Name | Where-Object { $_ -notin 'Kind','Path' }).Count) { throw 'Detection must contain Kind=Path and Path.' }
                & $checkText $config.Detection.Path 'Detection Path'
                if ($config.Detection.Path -match '[*?]') { throw 'Detection Path cannot contain wildcards.' }
            }
            elseif ($null -ne $config.PSObject.Properties['Detection'] -and $null -ne $config.Detection) {
                if ($config.Detection -isnot [pscustomobject] -or $config.Detection.Kind -ne 'PowerShell' -or
                    @($config.Detection.PSObject.Properties.Name | Where-Object { $_ -notin 'Kind','Script','ScriptPath' }).Count -or
                    ($null -ne $config.Detection.PSObject.Properties['Script']) -eq ($null -ne $config.Detection.PSObject.Properties['ScriptPath'])) {
                    throw 'Detection must be null or contain Kind=PowerShell and exactly one of ScriptPath or legacy Script.'
                }
                if ($null -ne $config.Detection.PSObject.Properties['ScriptPath']) {
                    & $checkText $config.Detection.ScriptPath 'Detection ScriptPath'
                    if (-not $config.Detection.ScriptPath.StartsWith('%App%\', [StringComparison]::OrdinalIgnoreCase) -or
                        [IO.Path]::GetExtension($config.Detection.ScriptPath) -ine '.ps1') {
                        throw 'Detection ScriptPath must be a .ps1 file relative to %App%\.'
                    }
                    $null = Resolve-PAWApplicationPayloadPath -PackageRoot $env:TEMP -RelativePath $config.Detection.ScriptPath.Substring(6)
                }
                else {
                    & $checkText $config.Detection.Script 'Detection Script'
                    $tokens = $null
                    $parseErrors = $null
                    $null = [System.Management.Automation.Language.Parser]::ParseInput($config.Detection.Script, [ref]$tokens, [ref]$parseErrors)
                    if ($parseErrors.Count) { throw "Invalid Detection Script: $($parseErrors[0].Message)" }
                }
            }
        }
        'WindowsComponent' {
            if ($config.Kind -notin 'Capability','OptionalFeature','ServerFeature') { throw 'Component Kind must be Capability, OptionalFeature or ServerFeature.' }
            if ($config.Names -isnot [array] -or -not $config.Names.Count) { throw 'Component Names must be a non-empty array.' }
            $namePattern = if ($config.Kind -eq 'Capability') { '^[a-zA-Z0-9*?][a-zA-Z0-9._~ *?-]*$' } else { '^[a-zA-Z0-9][a-zA-Z0-9._~ -]*$' }
            foreach ($name in $config.Names) {
                & $checkText $name 'Component Name'
                if ($name -notmatch $namePattern) { throw "Invalid component name '$name'." }
            }
            if (@($config.Names | Select-Object -Unique).Count -ne $config.Names.Count) { throw 'Component Names must be unique.' }
            & $checkText $config.Source 'Component Source' $true
            if ($config.Source) { $null = Resolve-PAWApplicationPayloadPath -PackageRoot $env:TEMP -RelativePath $config.Source }
            if ($config.LimitAccess -isnot [bool]) { throw 'LimitAccess must be a JSON boolean.' }
            if ($config.LimitAccess -and -not $config.Source) { throw 'LimitAccess requires a local component Source.' }
            if ($config.Kind -eq 'ServerFeature' -and $config.LimitAccess) { throw 'ServerFeature does not support LimitAccess; use a configured local Source without LimitAccess.' }
        }
    }
    [pscustomobject][ordered]@{
        Name = $value.Name.Trim(); Type = $value.Type; InstallEnabled = $value.InstallEnabled; Configuration = $config
    }
}
function Copy-PAWDirectory {
    <#
    .SYNOPSIS
        Copies directory contents with long-path support and checked exit status.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess)]
    param(
        [Parameter(Mandatory)][string]$Source,
        [Parameter(Mandatory)][string]$Destination,
        [string[]]$ExcludeDirectory = @(),
        [string]$LogPath
    )
    $sourceDirectory = Get-Item -LiteralPath $Source -ErrorAction Stop
    if (-not $sourceDirectory.PSIsContainer) { throw "Copy source is not a directory: $Source" }
    $destinationPath = [IO.Path]::GetFullPath($Destination)
    if (-not $PSCmdlet.ShouldProcess($destinationPath, "Copy directory contents from '$($sourceDirectory.FullName)'")) { return }
    $arguments = @($sourceDirectory.FullName, $destinationPath, '/E', '/COPY:DAT', '/DCOPY:DAT', '/R:1', '/W:1', '/XJ', '/NP', '/NFL', '/NDL')
    if ($ExcludeDirectory.Count) { $arguments += @('/XD') + $ExcludeDirectory }
    $output = @(& robocopy.exe @arguments 2>&1 | ForEach-Object { [string]$_ })
    $exitCode = $LASTEXITCODE
    $details = $output -join [Environment]::NewLine
    if ($LogPath) {
        $level = if ($exitCode -lt 0 -or $exitCode -ge 8) { 'ERROR' } else { 'INFO' }
        Write-PAWLog -Level $level -Message "Directory copy '$Source' -> '$destinationPath'; robocopy exit code ${exitCode}.`n$details" -LogPath $LogPath
    }
    if ($exitCode -lt 0 -or $exitCode -ge 8) {
        throw "Directory copy failed '$Source' -> '$destinationPath' (robocopy exit code $exitCode).`n$details"
    }
    Write-Verbose "Directory contents copied to $destinationPath (robocopy exit code $exitCode)."
}
Function Copy-PAWVMFile {
    <#
    .SYNOPSIS
        Copies files from a host folder into one or more running Hyper-V VMs.

    .DESCRIPTION
        Copy-PAWVMFile enumerates all files in the specified source folder
        (recursively) and copies each file into the target VM(s) using
        Copy-VMFile over the Hyper-V data-exchange channel.

        The destination path inside the VM mirrors the full source path on the
        host (e.g. C:\Source\scripts\setup.ps1 is written to
        C:\Source\scripts\setup.ps1 inside the VM).  The -CreateFullPath flag
        ensures any missing directory tree is created automatically.

        Before copying, the function verifies that each VM exists and is
        currently running.  VMs that fail either check are skipped with a
        warning; remaining VMs in the list continue to be processed.

        Requires the Hyper-V PowerShell module and Hyper-V Guest Services
        (Integration Services) to be enabled on the target VM.

    .PARAMETER VMName
        One or more Hyper-V virtual machine names to copy files into.
        Accepts an array of strings.

    .PARAMETER SourceFolder
        Path to the host-side folder whose contents (files, recursively) are
        copied into the VM.  The folder itself is not created inside the VM;
        only its contents are transferred, preserving their relative paths.

    .EXAMPLE
        Copy-PAWVMFile -VMName "PAW-001" -SourceFolder "C:\Scripts"

        Copies all files under C:\Scripts recursively into the VM named PAW-001,
        recreating the same directory structure inside the VM.

    .EXAMPLE
        Copy-PAWVMFile -VMName "PAW-001","PAW-002" -SourceFolder "C:\Payload"

        Copies all files under C:\Payload into both PAW-001 and PAW-002.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

        The VM must be running and have Hyper-V Guest Services enabled for
        Copy-VMFile to succeed.

    #>

    [cmdletbinding()]
    Param(
        [string[]]$VMName,
        [string]$SourceFolder
    )
    Foreach ($VM in $VMName) {
        # Check if VM exists
        if ((Test-PAWVMExists -VMname $VM) -eq $false) {
            Write-Warning "Could not find $VM"
            continue
        }
        if ((Test-PAWVMIsRunning -VMname $VM) -eq $false) {
            Write-Warning "$VM is not running"
            continue
        }
        $VMobj = Get-VM -VMName $VM

        # Copy all files from the source folder into the VM, preserving paths
        $Contents = Get-ChildItem -Path $SourceFolder -Recurse -File
        foreach ($Item in $Contents) {
            Copy-VMFile -VM $VMobj -SourcePath $Item.FullName -DestinationPath $Item.FullName -FileSource Host -CreateFullPath -Force
        }
    }
}
Function Dismount-PAWVHDInFolder {
   <#
    .SYNOPSIS
        Dismounts a VHD/VHDX and removes its temporary mount folder.

    .DESCRIPTION
        Dismount-PAWVHDInFolder detaches a virtual disk from the host and then removes
        the folder used as the offline mount point.

        The function is idempotent:
        - If the VHD path does not exist, it throws.
        - If the VHD exists but is already detached, dismount is skipped.
        - If the mount folder does not exist, folder cleanup is skipped.

        Supports -WhatIf and -Confirm.

    .PARAMETER VHDfile
        Full path to the VHD/VHDX file to dismount.

    .PARAMETER MountFolder
        Path to the temporary folder used as mount location. If present, it is removed
        recursively after the VHD is dismounted.

    .EXAMPLE
        Dismount-PAWVHDInFolder -VHDfile "C:\VMs\PAW01\Virtual Hard Disks\PAW01.vhdx" -MountFolder "C:\Temp\PAWDeploy\Mount"

        Dismounts the VHDX if attached, then removes the mount folder.

    .EXAMPLE
        Dismount-PAWVHDInFolder -VHDfile "C:\VMs\PAW01\Virtual Hard Disks\PAW01.vhdx" -MountFolder "C:\Temp\PAWDeploy\Mount" -WhatIf

        Shows what would be dismounted and removed without making changes.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>

   [cmdletbinding(SupportsShouldProcess = $true, ConfirmImpact = 'Medium')]

   Param(
      [Parameter(Mandatory = $true)]
      [ValidateNotNullOrEmpty()]
      [string]$VHDfile,

      [Parameter(Mandatory = $true)]
      [ValidateNotNullOrEmpty()]
      [string]$MountFolder
   )

   if (-not (Test-Path -Path $VHDfile -PathType Leaf)) {
      throw "VHD file not found: $VHDfile"
   }

   $vhd = Get-VHD -Path $VHDfile -ErrorAction Stop
   if ($vhd.Attached) {
      if ($PSCmdlet.ShouldProcess($VHDfile, 'Dismount VHD')) {
         Dismount-VHD -Path $VHDfile -ErrorAction Stop
         Write-Verbose "Dismounted VHD: $VHDfile"
      }
   }
   else {
      Write-Verbose "VHD is already dismounted: $VHDfile"
   }

   if (Test-Path -Path $MountFolder) {
      if ($PSCmdlet.ShouldProcess($MountFolder, 'Remove mount folder')) {
         Remove-Item -Path $MountFolder -Recurse -Force -ErrorAction Stop
         Write-Verbose "Removed mount folder: $MountFolder"
      }
   }
   else {
      Write-Verbose "Mount folder does not exist: $MountFolder"
   }
}
function Enable-PAWASR {
    <#
    .SYNOPSIS
        Configures and verifies applicable ASR rules inside a guest.
    .DESCRIPTION
        Adds individual rules without clearing other Defender settings. Every
        applicable rule is attempted even if another fails. Returns per-rule
        status; unsupported OS rules are explicitly marked NotApplicable.
    .PARAMETER Rules
        Catalog from Get-PAWASRRule, supplied by the deployment host.
    .NOTES
        Version : 2.0.0.3
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess)]
    param([Parameter(Mandatory)][object[]]$Rules)
    $os = Get-CimInstance -ClassName Win32_OperatingSystem -ErrorAction Stop
    $status = Get-MpComputerStatus -ErrorAction Stop
    if (-not $status.AntivirusEnabled -or -not $status.RealTimeProtectionEnabled -or $status.AMRunningMode -ne 'Normal') {
        throw 'ASR requires active Microsoft Defender Antivirus with real-time protection. Check passive mode, third-party antivirus and Defender policy.'
    }
    foreach ($rule in $Rules) {
        $minimum = if ($os.ProductType -eq 1) { $rule.ClientMinBuild } else { $rule.ServerMinBuild }
        if (-not $minimum -or [int]$os.BuildNumber -lt $minimum) {
            [pscustomobject]@{ Id = $rule.Id; Name = $rule.Name; Status = 'NotApplicable'; Reason = "Not supported on OS build $($os.BuildNumber), product type $($os.ProductType)." }
            continue
        }
        $action = switch ($rule.Mode) {
            'Block' { @{ Name = 'Enabled'; Value = 1; Mode = 'Block' } }
            'Audit' { @{ Name = 'AuditMode'; Value = 2; Mode = 'Audit' } }
            'Disabled' { @{ Name = 'Disabled'; Value = 0; Mode = 'Disabled' } }
            default { $null }
        }
        if ($null -eq $action) {
            [pscustomobject]@{ Id = $rule.Id; Name = $rule.Name; Status = 'Failed'; Reason = "Invalid ASR mode '$($rule.Mode)'; expected Block, Audit or Disabled." }
            continue
        }
        if (-not $PSCmdlet.ShouldProcess($rule.Name, "Configure ASR rule in $($action.Mode) mode")) { continue }
        try {
            $ruleWarnings = New-Object 'System.Collections.Generic.List[string]'
            Add-MpPreference -AttackSurfaceReductionRules_Ids $rule.Id -AttackSurfaceReductionRules_Actions $action.Name -ErrorAction Stop -WarningAction Continue 3>&1 |
                ForEach-Object { if ($_ -is [Management.Automation.WarningRecord]) { $ruleWarnings.Add($_.Message) } }
            $preferences = Get-MpPreference -ErrorAction Stop
            $ids = @($preferences.AttackSurfaceReductionRules_Ids)
            $actions = @($preferences.AttackSurfaceReductionRules_Actions)
            $index = -1
            for ($i = 0; $i -lt $ids.Count; $i++) {
                if ($ids[$i] -eq $rule.Id) { $index = $i; break }
            }
            if ($index -lt 0 -or $index -ge $actions.Count -or $null -eq $actions[$index] -or [int]$actions[$index] -ne $action.Value) {
                throw "Defender did not retain $($action.Mode) mode. Check tamper protection, GPO/MDM policy and Defender platform support."
            }
            if ($ruleWarnings.Count) { throw "Defender reported: $(($ruleWarnings -join ' ' -replace '\s+', ' ').Trim()). Rule read-back is $($action.Mode), but review these warnings." }
            if ($action.Mode -ne 'Disabled' -and $rule.RequiresCloudProtection -and [int]$preferences.MAPSReporting -eq 0) {
                throw 'Rule configured, but cloud-delivered protection is disabled. Enable Defender cloud protection for this rule to work fully.'
            }
            $resultStatus = if ($action.Mode -eq 'Block') { 'Enabled' } else { 'Configured' }
            [pscustomobject]@{ Id = $rule.Id; Name = $rule.Name; Status = $resultStatus; Reason = "Verified $($action.Mode) mode." }
        }
        catch {
            [pscustomobject]@{ Id = $rule.Id; Name = $rule.Name; Status = 'Failed'; Reason = $_.Exception.Message }
        }
    }
}
Function Enable-PAWNestedHyperV {
   <#
    .SYNOPSIS
        Configures a Hyper-V VM for nested virtualization.

    .DESCRIPTION
        Enable-PAWNestedHyperV validates a target VM and applies the settings required
        to run Hyper-V workloads inside that guest:
        - Disables checkpoints
        - Disables dynamic memory
        - Ensures at least 4 GB startup memory
        - Enables MAC address spoofing
        - Enables CPU virtualization extensions exposure

        The VM must exist and be in the Off state with no parent snapshot.
        Supports -WhatIf and -Confirm.

    .PARAMETER VMName
        Name of the Hyper-V VM to configure.

    .EXAMPLE
        Enable-PAWNestedHyperV -VMName "PAW-LAB-01"

        Validates and configures PAW-LAB-01 for nested Hyper-V.

    .EXAMPLE
        Enable-PAWNestedHyperV -VMName "PAW-LAB-01" -WhatIf

        Shows the changes that would be made without applying them.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
   [cmdletbinding(SupportsShouldProcess = $true, ConfirmImpact = 'Medium')]

   Param(
      [Parameter(Mandatory = $true)]
      [ValidateNotNullOrEmpty()]
      [string]$VMName
   )

   #Check if VM exists
   if ((Test-PAWVMExists -VMname $VMName) -eq $false) {
      throw "Could not find VM '$VMName'."
   }

   $VM = Get-VM -Name $VMName -ErrorAction Stop
   $VMNic = Get-VMNetworkAdapter -VM $VM
   $VMCPU = Get-VMProcessor -VM $VM

   #Check if VM is saved
   if ($VM.State -eq 'Saved') {
      throw "VM '$VMName' is in Saved state and must be Off before enabling nested Hyper-V."
   }

   #Check if VM has Snapshots
   if ($null -ne $VM.ParentSnapshotName) {
      throw "VM '$VMName' has a parent snapshot. Remove snapshots/checkpoints before continuing."
   }

   #Check if VM is off
   if ($VM.State -ne 'Off') {
      throw "VM '$VMName' is not Off. Shut it down before enabling nested Hyper-V."
   }

   #Check VM Configuration Version
   if ([version]$VM.Version -lt [version]'7.0') {
      throw "VM '$VMName' configuration version is $($VM.Version). Upgrade to 7.0 or later."
   }

   #Check if VM allows Snapshot
   if ($VM.CheckpointType -ne 'Disabled') {
      if ($PSCmdlet.ShouldProcess($VMName, 'Disable VM checkpoints')) {
         Set-VM -VM $VM -CheckpointType Disabled -ErrorAction Stop
      }
   }

   #Check if VM has Dynamic Memory Enabled
   if ($VM.DynamicMemoryEnabled -eq $true) {
      if ($PSCmdlet.ShouldProcess($VMName, 'Disable dynamic memory')) {
         Set-VMMemory -VM $VM -DynamicMemoryEnabled $false -ErrorAction Stop
      }
   }

   #Check if VM has more then 4GB of RAM
   if ($VM.MemoryStartup -lt 4GB) {
      if ($PSCmdlet.ShouldProcess($VMName, 'Set startup memory to 4 GB')) {
         Set-VMMemory -VM $VM -StartupBytes 4GB -ErrorAction Stop
      }
   }

   #Check if VM has Mac Spoofing Enabled
   if (($VMNic).MacAddressSpoofing -contains 'Off') {
      if ($PSCmdlet.ShouldProcess($VMName, 'Enable MAC address spoofing on VM network adapters')) {
         Set-VMNetworkAdapter -VM $VM -MacAddressSpoofing On -ErrorAction Stop
      }
   }

   #Check if VM has Expose Virtualization Extensions Enabled
   if (($VMCPU).ExposeVirtualizationExtensions -ne $true) {
      if ($PSCmdlet.ShouldProcess($VMName, 'Enable ExposeVirtualizationExtensions')) {
         Set-VMProcessor -VM $VM -ExposeVirtualizationExtensions $true -ErrorAction Stop
      }
   }

   Write-Verbose "Nested Hyper-V prerequisites verified and applied for '$VMName'."
}
Function Enable-PAWVMDeviceNaming {
    <#
    .SYNOPSIS
        Enables Hyper-V virtual NIC device naming on one or more VMs.

    .DESCRIPTION
        Enable-PAWVMDeviceNaming enables the DeviceNaming setting on all network
        adapters attached to the specified VM(s). Device naming helps the guest OS
        identify Hyper-V virtual adapters by friendly names.

        Supports -WhatIf and -Confirm.

    .PARAMETER VMName
        One or more Hyper-V virtual machine names.
        Accepts pipeline input.

    .EXAMPLE
        Enable-PAWVMDeviceNaming -VMName "PAW-01"

        Enables DeviceNaming on all virtual NICs connected to PAW-01.

    .EXAMPLE
        Enable-PAWVMDeviceNaming -VMName "PAW-01","PAW-02" -WhatIf

        Shows which VMs would be updated without changing configuration.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>

    [CmdletBinding(SupportsShouldProcess = $true, ConfirmImpact = 'Low')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true, ValueFromPipelineByPropertyName = $true)]
        [Alias('Name')]
        [ValidateNotNullOrEmpty()]
        [string[]]$VMName
    )

    process {
        foreach ($vm in $VMName) {
            if ((Test-PAWVMExists -VMname $vm) -eq $false) {
                Write-Error "Could not find VM '$vm'."
                continue
            }

            if ($PSCmdlet.ShouldProcess($vm, 'Enable DeviceNaming on VM network adapters')) {
                Get-VMNetworkAdapter -VMName $vm -ErrorAction Stop |
                    Set-VMNetworkAdapter -DeviceNaming On -ErrorAction Stop
                Write-Verbose "Enabled DeviceNaming for '$vm'."
            }
        }
    }
}
