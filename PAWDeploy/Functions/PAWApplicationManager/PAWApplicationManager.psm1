<#
.SYNOPSIS
    Validates and serializes package-owned files for portable JSON transfer.
.NOTES
    Version : 2.0.0.4
    Author  : The Fantastic PAWDeploy Team
#>
function Test-PAWApplicationHasPayload {
    param([object]$Application)
    if ($Application.SchemaVersion -ne 2) { return $false }
    $config = $Application.Definition.Configuration
    $Application.Type -eq 'Classic' -or
        ($Application.Type -eq 'PowerShellModule' -and $config.Origin -eq 'Local') -or
        ($Application.Type -eq 'WindowsComponent' -and [bool]$config.Source)
}

function Get-PAWApplicationPayloadFiles {
    param([string]$Root)
    $queue = New-Object 'System.Collections.Generic.Queue[string]'
    $queue.Enqueue($Root)
    while ($queue.Count) {
        $directory = $queue.Dequeue()
        $null = Resolve-PAWApplicationPayloadPath -PackageRoot $directory -RelativePath '.'
        foreach ($item in @(Get-ChildItem -LiteralPath $directory -Force -ErrorAction Stop)) {
            if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "Package cannot contain reparse points: '$($item.FullName)'." }
            if ($item.PSIsContainer) { $queue.Enqueue($item.FullName) }
            else { $item }
        }
    }
}

function Get-PAWApplicationPayloadHash {
    param([byte[]]$Bytes)
    $sha = [Security.Cryptography.SHA256]::Create()
    try { ([BitConverter]::ToString($sha.ComputeHash($Bytes))).Replace('-','') }
    finally { $sha.Dispose() }
}

function Save-PAWApplicationSource {
    param([string]$Root, [object]$Application, [string]$SourceFolder, [string]$CatalogPath)
    $source = (Get-Item -LiteralPath $SourceFolder -Force -ErrorAction Stop).FullName.TrimEnd('\')
    if (-not (Test-Path -LiteralPath $source -PathType Container)) { throw "Source must be a folder: '$source'." }
    $rootPath = [IO.Path]::GetFullPath($Root).TrimEnd('\')
    $relativeFolder = if ($Application.Type -eq 'Classic') { $Application.Definition.Configuration.FolderPath } else { 'Source' }
    $packageRoot = Resolve-PAWApplicationPayloadPath -PackageRoot $Root -RelativePath "Applications\Packages\$($Application.ApplicationId)"
    $destination = Resolve-PAWApplicationPayloadPath -PackageRoot $packageRoot -RelativePath $relativeFolder
    if ($rootPath -eq $source -or $rootPath.StartsWith($source + '\', [StringComparison]::OrdinalIgnoreCase) -or
        $source -eq $destination -or $source.StartsWith($destination + '\', [StringComparison]::OrdinalIgnoreCase) -or
        $destination.StartsWith($source + '\', [StringComparison]::OrdinalIgnoreCase)) {
        throw 'Source folder must not overlap the application destination or contain the application store.'
    }
    $files = @(Get-PAWApplicationPayloadFiles $source)
    if (-not $files.Count) { throw "Source folder is empty: '$source'." }
    $scratch = Join-Path $rootPath ('.source-' + [guid]::NewGuid().ToString('N'))
    $stage = Join-Path $scratch 'New'
    $backup = Join-Path $scratch 'Old'
    $swapped = $false
    $retainRecovery = $false
    try {
        foreach ($file in $files) {
            $relative = $file.FullName.Substring($source.Length).TrimStart('\')
            $target = Resolve-PAWApplicationPayloadPath -PackageRoot $stage -RelativePath $relative
            $null = New-Item -Path (Split-Path -Parent $target) -ItemType Directory -Force -ErrorAction Stop
            Copy-Item -LiteralPath $file.FullName -Destination $target -Force -ErrorAction Stop
            if ((Get-FileHash -LiteralPath $file.FullName -ErrorAction Stop).Hash -ne
                (Get-FileHash -LiteralPath $target -ErrorAction Stop).Hash) {
                throw "Source copy verification failed: '$relative'."
            }
        }
        if ($Application.Type -eq 'Classic' -and $null -ne $Application.Definition.Configuration.Detection -and
            $null -ne $Application.Definition.Configuration.Detection.PSObject.Properties['ScriptPath']) {
            $scriptPath = Resolve-PAWApplicationPayloadPath -PackageRoot $stage -RelativePath $Application.Definition.Configuration.Detection.ScriptPath.Substring(6)
            if (-not (Test-Path -LiteralPath $scriptPath -PathType Leaf)) { throw "Detection script was not found in the selected folder: '$scriptPath'." }
        }
        if (Test-Path -LiteralPath $destination) {
            $null = @(Get-PAWApplicationPayloadFiles $destination)
            Move-Item -LiteralPath $destination -Destination $backup -ErrorAction Stop
        }
        $swapped = $true
        $null = New-Item -Path (Split-Path -Parent $destination) -ItemType Directory -Force -ErrorAction Stop
        Move-Item -LiteralPath $stage -Destination $destination -ErrorAction Stop
        Write-PAWManagerJson $CatalogPath $Application
    }
    catch {
        $failure = $_
        if ($swapped) {
            try {
                if (Test-Path -LiteralPath $destination) { Remove-Item -LiteralPath $destination -Recurse -Force -ErrorAction Stop }
                if (Test-Path -LiteralPath $backup) { Move-Item -LiteralPath $backup -Destination $destination -ErrorAction Stop }
            }
            catch {
                $retainRecovery = $true
                throw "Source save failed: $($failure.Exception.Message). Rollback failed: $($_.Exception.Message). Recovery files retained at '$scratch'."
            }
        }
        throw $failure
    }
    finally {
        if (-not $retainRecovery -and (Test-Path -LiteralPath $scratch)) { Remove-Item -LiteralPath $scratch -Recurse -Force -ErrorAction Stop }
    }
}

function Export-PAWApplicationPayload {
    param([string]$Root, [object[]]$Applications)
    foreach ($app in $Applications) {
        if (-not (Test-PAWApplicationHasPayload $app)) { continue }
        $folder = Resolve-PAWApplicationPayloadPath -PackageRoot $Root -RelativePath "Applications\Packages\$($app.ApplicationId)"
        if (-not (Test-Path -LiteralPath $folder -PathType Container)) { throw "Application payload missing: '$folder'." }
        $files = @(foreach ($file in @(Get-PAWApplicationPayloadFiles $folder)) {
            $bytes = [IO.File]::ReadAllBytes($file.FullName)
            [pscustomobject]@{
                Path = $file.FullName.Substring($folder.Length).TrimStart('\')
                Content = [Convert]::ToBase64String($bytes)
                Sha256 = Get-PAWApplicationPayloadHash $bytes
            }
        })
        if (-not $files.Count) { throw "Application payload is empty: '$folder'." }
        [pscustomobject]@{ ApplicationId = $app.ApplicationId; Files = $files }
    }
}

function ConvertTo-PAWImportedPayload {
    param([object[]]$Payloads, [object[]]$Applications, [string]$Root)
    $seen = @{}
    foreach ($payload in $Payloads) {
        Test-PAWApplicationKey ([string]$payload.ApplicationId)
        $app = @($Applications | Where-Object ApplicationId -eq $payload.ApplicationId)
        if ($app.Count -ne 1 -or -not (Test-PAWApplicationHasPayload $app[0]) -or $seen.ContainsKey($payload.ApplicationId)) {
            throw "Unexpected or duplicate application payload '$($payload.ApplicationId)'."
        }
        $seen[$payload.ApplicationId] = $true
        if ($payload.Files -isnot [array] -or -not $payload.Files.Count) { throw 'Payload Files must be a non-empty array.' }
        $folder = Resolve-PAWApplicationPayloadPath -PackageRoot $Root -RelativePath "Applications\Packages\$($payload.ApplicationId)"
        $paths = @{}
        foreach ($file in $payload.Files) {
            $path = Resolve-PAWApplicationPayloadPath -PackageRoot $folder -RelativePath ([string]$file.Path)
            if ($path -eq [IO.Path]::GetFullPath($folder) -or $paths.ContainsKey($path)) { throw "Duplicate/invalid payload file '$($file.Path)'." }
            $paths[$path] = $true
            try { $bytes = [Convert]::FromBase64String([string]$file.Content) }
            catch { throw "Invalid base64 payload '$($file.Path)': $($_.Exception.Message)" }
            if ((Get-PAWApplicationPayloadHash $bytes) -ne $file.Sha256) { throw "Payload hash mismatch for '$($file.Path)'." }
            [pscustomobject]@{ ApplicationId = $payload.ApplicationId; RelativePath = [string]$file.Path; Bytes = $bytes }
        }
    }
    foreach ($app in $Applications) {
        if ((Test-PAWApplicationHasPayload $app) -and -not $seen.ContainsKey($app.ApplicationId)) { throw "Package is missing required payload '$($app.ApplicationId)'." }
    }
}
<#
.SYNOPSIS
    Validates and persists application manager documents.
.NOTES
    Version : 2.0.0.7
    Author  : The Fantastic PAWDeploy Team
#>
function Test-PAWApplicationKey {
    param([string]$Value)
    $guid = [guid]::Empty
    if (-not [guid]::TryParseExact($Value, 'D', [ref]$guid) -or $guid -eq [guid]::Empty) {
        throw "Invalid application/bundle ID '$Value'. A non-empty GUID in xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx format is required."
    }
}

function Get-PAWInputApplicationId {
    param([object]$InputObject, [string]$ApplicationId, [bool]$HasInput, [bool]$HasId)
    if ($HasInput) {
        if ($HasId) { throw 'Specify either InputObject or ApplicationId, not both.' }
        if ($InputObject -is [string]) { $id = $InputObject }
        elseif ($null -ne $InputObject -and $null -ne $InputObject.PSObject.Properties['ApplicationId']) {
            $id = [string]$InputObject.ApplicationId
        }
        else { throw 'Each pipeline object must have an ApplicationId property or be an ID string.' }
    }
    elseif ($HasId) { $id = $ApplicationId }
    else { throw 'Provide an application object or ApplicationId.' }
    Test-PAWApplicationKey $id
    $id
}

function Read-PAWManagerJson {
    param([string]$Path)
    try { Get-Content -LiteralPath $Path -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop }
    catch { throw "Cannot read application manager JSON '$Path': $($_.Exception.Message)" }
}

function Write-PAWManagerJson {
    param([string]$Path, [object]$Value)
    $parent = Split-Path -Parent $Path
    $null = New-Item -Path $parent -ItemType Directory -Force -ErrorAction Stop
    $temporary = Join-Path $parent ('.' + [guid]::NewGuid().ToString('N') + '.tmp')
    try {
        [IO.File]::WriteAllText($temporary, (($Value | ConvertTo-Json -Depth 20) + [Environment]::NewLine), (New-Object Text.UTF8Encoding($false)))
        if (Test-Path -LiteralPath $Path -PathType Leaf) { [IO.File]::Replace($temporary, $Path, [System.Management.Automation.Language.NullString]::Value) }
        else { [IO.File]::Move($temporary, $Path) }
    }
    finally {
        if (Test-Path -LiteralPath $temporary -PathType Leaf) { Remove-Item -LiteralPath $temporary -Force -ErrorAction Stop }
    }
}

function Get-PAWApplicationCatalogPath {
    param([string]$Root, [object]$Application)
    $catalogFolder = Join-Path $Root 'ApplicationCatalog'
    $safeNamePath = Get-PAWApplicationInstallFilePath -InstallRoot $catalogFolder -Name $Application.Definition.Name
    $safeName = [IO.Path]::GetFileNameWithoutExtension($safeNamePath)
    Join-Path $catalogFolder ($safeName + '--' + $Application.ApplicationId + '.json')
}

function Get-PAWApplicationCatalogFilePath {
    param([string]$Root, [object]$Application)
    $namedPath = Get-PAWApplicationCatalogPath -Root $Root -Application $Application
    $legacyPath = Join-Path $Root "ApplicationCatalog\$($Application.ApplicationId).json"
    $namedExists = Test-Path -LiteralPath $namedPath -PathType Leaf
    $legacyExists = Test-Path -LiteralPath $legacyPath -PathType Leaf
    if ($namedExists -and $legacyExists) {
        throw "Application '$($Application.ApplicationId)' has both legacy and named catalog files."
    }
    if ($namedExists) { return $namedPath }
    if ($legacyExists) { return $legacyPath }
    $namedPath
}

function Assert-PAWBundleNameAvailable {
    param([string]$Root, [object]$Bundle)
    $folder = Join-Path $Root 'ApplicationBundles'
    if (-not (Test-Path -LiteralPath $folder -PathType Container)) { return }
    foreach ($file in @(Get-ChildItem -LiteralPath $folder -Filter '*.json' -File -ErrorAction Stop)) {
        $existing = Read-PAWManagerJson $file.FullName
        Test-PAWApplicationKey ([string]$existing.BundleId)
        if ($file.BaseName -ne $existing.BundleId) { throw "Bundle ID must match filename: $($file.FullName)" }
        if ([string]::IsNullOrWhiteSpace([string]$existing.Name)) { throw "Bundle Name is required: $($file.FullName)" }
        if ($existing.BundleId -ne $Bundle.BundleId -and ([string]$existing.Name).Trim() -eq $Bundle.Name) {
            throw "Bundle name '$($Bundle.Name)' is already used by bundle '$($existing.BundleId)'. Choose another name or edit the existing bundle."
        }
    }
}

function Enter-PAWBundleWriteLock {
    param([string]$Root)
    $path = Join-Path $Root '.bundle-write.lock'
    try {
        [IO.File]::Open($path, [IO.FileMode]::OpenOrCreate, [IO.FileAccess]::ReadWrite, [IO.FileShare]::None)
    }
    catch {
        throw "Cannot acquire bundle write lock '$path'. Another bundle operation may be in progress; retry. $($_.Exception.Message)"
    }
}

function Assert-PAWBundleUnreferenced {
    param([string]$ConfigPath, [string]$BundleId)
    $null = Get-Item -LiteralPath $ConfigPath -ErrorAction Stop
    foreach ($file in @(Get-ChildItem -LiteralPath (Split-Path -Parent $ConfigPath) -Filter '*.json' -File -ErrorAction Stop |
        Where-Object Name -ne 'Config.json')) {
        $template = Read-PAWManagerJson $file.FullName
        if ($null -eq $template -or $template -isnot [pscustomobject]) {
            throw "Cannot check bundle references because template '$($file.FullName)' is invalid."
        }
        if ($template.ApplicationBundle -eq $BundleId) {
            throw "Bundle '$BundleId' is assigned to templates: $($file.BaseName)."
        }
    }
}

function ConvertTo-PAWManagedApplication {
    param([object]$Application)
    if ($Application -is [System.Collections.IDictionary]) { $Application = $Application | ConvertTo-Json -Depth 20 | ConvertFrom-Json }
    foreach ($property in $Application.PSObject.Properties) {
        if ($property.Name -notin @('SchemaVersion','ApplicationId','Enabled','RestartRequired','Type','Definition','Settings')) { throw "Unknown application property '$($property.Name)'." }
    }
    if ($Application.SchemaVersion -notin 1,2) { throw 'Application SchemaVersion must be 1 or 2.' }
    if ($Application.SchemaVersion -eq 1 -and $null -ne $Application.PSObject.Properties['Type']) { throw 'Typed applications require SchemaVersion 2.' }
    Test-PAWApplicationKey ([string]$Application.ApplicationId)
    if ($Application.Enabled -isnot [bool]) { throw 'Application Enabled must be a JSON boolean.' }
    $restartRequired = $false
    if ($null -ne $Application.PSObject.Properties['RestartRequired']) {
        if ($Application.RestartRequired -isnot [bool]) { throw 'Application RestartRequired must be a JSON boolean.' }
        $restartRequired = $Application.RestartRequired
    }
    if ($Application.SchemaVersion -eq 2) {
        $definition = ConvertTo-PAWTypedApplicationDefinition -Definition $Application.Definition
        if ($Application.Type -ne $definition.Type) { throw 'Application Type must match Definition.Type.' }
    }
    else {
        if ($null -ne $Application.Definition.PSObject.Properties['Type'] -or $Application.Definition.Source -notin 'WinGet','PSGallery','Local') {
            throw 'Schema 1 only supports legacy WinGet, PSGallery and Local Source definitions. Use SchemaVersion 2 for typed applications.'
        }
        $definition = ConvertTo-PAWApplicationDefinition -Application $Application.Definition
    }
    foreach ($name in @($definition.Name, $definition.Id)) {
        if ($null -eq $name) { continue }
        if ($name.StartsWith('-') -or $name -match '[\x00-\x1f]') { throw "Invalid application name or package identifier '$name'." }
    }
    $null = Get-PAWApplicationInstallFilePath -InstallRoot $env:TEMP -Name $definition.Name
    $settings = $Application.Settings
    if ($null -eq $settings) { $settings = [pscustomobject]@{} }
    if ($settings -isnot [pscustomobject]) { throw 'Application Settings must be a JSON object.' }
    $allowed = @('InstallCheckPaths', 'SilentArguments', 'CustomArguments', 'MsiProperties', 'PostInstallKillProcess', 'DestinationPath')
    foreach ($property in $settings.PSObject.Properties) {
        if ($property.Name -notin $allowed) { throw "Unknown application install setting '$($property.Name)'." }
        foreach ($value in @($property.Value)) {
            if ($value -isnot [string]) { throw "Install setting '$($property.Name)' must contain strings." }
        }
    }
    $result = [ordered]@{
        SchemaVersion = $Application.SchemaVersion
        ApplicationId = [string]$Application.ApplicationId
        Enabled = $Application.Enabled
        RestartRequired = $restartRequired
        Definition = $definition
        Settings = $settings
    }
    if ($Application.SchemaVersion -eq 2) { $result.Type = $definition.Type }
    [pscustomobject]$result
}

function ConvertTo-PAWManagedBundle {
    param([object]$Bundle, [object[]]$Applications, [switch]$SkipDuplicates)
    if ($Bundle -is [System.Collections.IDictionary]) { $Bundle = $Bundle | ConvertTo-Json -Depth 20 | ConvertFrom-Json }
    foreach ($property in $Bundle.PSObject.Properties) {
        if ($property.Name -notin @('SchemaVersion','BundleId','Name','Applications')) { throw "Unknown bundle property '$($property.Name)'." }
    }
    if ($Bundle.SchemaVersion -ne 1) { throw 'Bundle SchemaVersion must be 1.' }
    Test-PAWApplicationKey ([string]$Bundle.BundleId)
    if ([string]::IsNullOrWhiteSpace([string]$Bundle.Name)) { throw 'Bundle Name is required.' }
    if ($null -eq $Bundle.PSObject.Properties['Applications']) { throw 'Bundle Applications array is required.' }
    if ($Bundle.Applications -isnot [array]) { throw 'Bundle Applications must be a JSON array.' }
    $seen = @{}
    $members = New-Object 'System.Collections.Generic.List[string]'
    $duplicates = New-Object 'System.Collections.Generic.List[string]'
    foreach ($id in @($Bundle.Applications)) {
        Test-PAWApplicationKey ([string]$id)
        if ($seen.ContainsKey([string]$id)) {
            if (-not $SkipDuplicates) { throw "Duplicate application '$id' in bundle '$($Bundle.BundleId)'." }
            $duplicates.Add([string]$id)
            continue
        }
        if (@($Applications | Where-Object ApplicationId -eq $id).Count -ne 1) { throw "Application '$id' referenced by bundle '$($Bundle.BundleId)' does not exist." }
        $seen[[string]$id] = $true
        $members.Add([string]$id)
    }
    foreach ($id in $duplicates) {
        Write-Warning "Application '$id' is already in bundle '$($Bundle.Name)' ($($Bundle.BundleId)); skipping duplicate."
    }
    [pscustomobject][ordered]@{
        SchemaVersion = 1
        BundleId = [string]$Bundle.BundleId
        Name = ([string]$Bundle.Name).Trim()
        Applications = @($members.ToArray())
    }
}

function Write-PAWApplicationManagerLog {
    param([string]$Message)
    Write-PAWLog -Message $Message -LogPath (Join-Path (Resolve-PAWLogFolder) 'PAWApplicationManager.log')
}
function Invoke-PAWApplicationExport {
    <#
    .SYNOPSIS
        Exports a selected application or bundle using the portable package format.
    .NOTES
        Version : 2.0.0.2
        Author  : The Fantastic PAWDeploy Team
    #>
    param([string]$Type, [object]$Selection, [string]$Root, [string]$DestinationFolder,
        [switch]$Replace, [System.Management.Automation.PSCmdlet]$Caller)
    if ($Type -eq 'Application') {
        $items = @(Get-PAWApplication -Root $Root)
        $idProperty = 'ApplicationId'
    }
    else {
        $items = @(Get-PAWApplicationBundle -Root $Root)
        $idProperty = 'BundleId'
    }
    if ($Selection -is [string]) {
        $matches = @($items | Where-Object { $_.Name -eq $Selection -or $_.$idProperty -eq $Selection })
    }
    elseif ($null -ne $Selection -and $null -ne $Selection.PSObject.Properties[$idProperty]) {
        $matches = @($items | Where-Object { $_.$idProperty -eq $Selection.$idProperty })
    }
    else { throw "Select a $Type by name or pipe an object returned by its Get command." }
    if ($matches.Count -ne 1) { throw "Expected one $Type matching '$Selection'; found $($matches.Count)." }
    $id = [string]$matches[0].$idProperty
    Test-PAWApplicationKey $id
    $folder = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($DestinationFolder)
    Assert-PAWCachePath -Path $folder
    foreach ($storeName in 'ApplicationCatalog', 'ApplicationBundles') {
        $store = [IO.Path]::GetFullPath((Join-Path $Root $storeName)).TrimEnd('\')
        if ($folder -eq $store -or $folder.StartsWith($store + '\', [StringComparison]::OrdinalIgnoreCase)) {
            throw "Export destination cannot be inside the application store: '$folder'."
        }
    }
    if ($Type -eq 'Application') {
        $namePath = Get-PAWApplicationInstallFilePath -InstallRoot $folder -Name $matches[0].Name
        $safeName = [IO.Path]::GetFileNameWithoutExtension($namePath)
        $filename = "$safeName--$id.json"
    }
    else { $filename = "$Type-$id.json" }
    $path = Join-Path $folder $filename
    if (Test-Path -LiteralPath $path) {
        $existing = Get-Item -LiteralPath $path -Force -ErrorAction Stop
        if ($existing.PSIsContainer -or ($existing.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
            throw "Export target must be a regular file: '$path'."
        }
        if (-not $Replace) { throw "Export exists; use -Replace: '$path'." }
    }
    if (-not $Caller.ShouldProcess($path, "Export $Type package (Replace=$Replace)")) { return }
    $null = New-Item -ItemType Directory -Path $folder -Force -ErrorAction Stop
    $selector = if ($Type -eq 'Application') { @{ ApplicationId = $id } } else { @{ BundleId = $id } }
    Export-PAWApplicationPackage -Root $Root -Path $path @selector -Replace:$Replace -Confirm:$false
}
function Assert-PAWCachePath {
    <#
    .SYNOPSIS
        Rejects paths through existing links.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    param([string]$Path)
    $current = [IO.Path]::GetFullPath($Path)
    while ($current) {
        if (Test-Path -LiteralPath $current -ErrorAction Stop) {
            $item = Get-Item -LiteralPath $current -Force -ErrorAction Stop
            if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "Path contains a reparse point: '$current'." }
        }
        $parent = Split-Path -Parent $current
        if ($parent -eq $current) { break }
        $current = $parent
    }
}

function Get-PAWCacheLocation {
    param([string]$Root, [string]$Type)
    switch ($Type) {
        'WinGet' { Join-Path $Root 'ApplicationDownloads\WinGet' }
        'Local' { Join-Path $Root 'ApplicationDownloads\Local' }
        'Module' { Join-Path $Root 'ApplicationDownloads\Modules' }
        'Package' { Join-Path $Root 'Applications\Packages' }
        default { throw "Invalid cache type '$Type'." }
    }
}

