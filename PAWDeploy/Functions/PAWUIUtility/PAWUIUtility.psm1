                    Start-Process -FilePath $executable -ArgumentList "-NoProfile -STA -WindowStyle Hidden -File `"$reader`" -Document `"$($data.Document)`" -WindowX $($data.Form.Left) -WindowY $($data.Form.Top)" -WorkingDirectory $data.Root -WindowStyle Hidden -ErrorAction Stop
                }
                catch { Show-PAWUiError -Title 'Help failed' -ErrorRecord $_ -Owner $sender.Tag.Form -Copyable }
            })
        }
        $ribbon.Controls.AddRange(@($help, $CloseButton))
    }
    if ($Menu) {
        $Form.Controls.AddRange(@($picture, $heading))
        $picture.BackColor = [System.Drawing.Color]::Transparent
        $heading.BackColor = [System.Drawing.Color]::Transparent
        $ribbon.Dispose()
    }
    else { $Form.Controls.Add($ribbon) }
    Set-PAWUiTheme -Control $Form
}
<#

.SYNOPSIS
    Estimates a text width in pixels using a character count and font.

.DESCRIPTION
    Estimates a text width in pixels using a character count and font.

.PARAMETER CharacterCount
    Approximate character count used to calculate a pixel width.

.PARAMETER Font
    Font used to measure the sample text.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Convert-PAWCharacterWidthToPixels {
    param(
        [Parameter(Mandatory = $true)]
        [int]$CharacterCount,
        [Parameter(Mandatory = $true)]
        [System.Drawing.Font]$Font
    )

    $safeCount = [Math]::Max(1, $CharacterCount)
    $sampleText = 'W' * $safeCount
    $measured = [System.Windows.Forms.TextRenderer]::MeasureText($sampleText, $Font)
    return [Math]::Max(40, ($measured.Width + 8))
}

<#

.SYNOPSIS
    Sanitizes a name so it can be used as a safe file name.

.DESCRIPTION
    Sanitizes a name so it can be used as a safe file name.

.PARAMETER Name
    Template name to trim and convert into a safe file-name component.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function ConvertTo-PAWSafeTemplateFileName {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $false)]
        [string]$Name
    )

    $value = ([string]$Name).Trim()
    if ([string]::IsNullOrWhiteSpace($value)) {
        $value = 'Template'
    }

    $invalidChars = [System.IO.Path]::GetInvalidFileNameChars()
    foreach ($ch in $invalidChars) {
        $value = $value.Replace([string]$ch, '_')
    }

    return $value
}
function Get-PAWImage {
    <#
    .SYNOPSIS
        Returns a PAWDeploy image from Assets as a System.Drawing.Image.

    .DESCRIPTION
        Loads an installed image, or a repository resource before installation,
        and returns an independent bitmap at its original dimensions unless
        MaximumWidth is specified. The caller owns the bitmap and should dispose it.

    .PARAMETER Name
        Image to return: Logo, LogoWhite, EditionLogo, DeploymentBunnyLogo,
        Background, VhdIcon, InfoIcon, ToolkitFullLogo, ToolkitHorizontalLogo,
        ToolkitAppIcon or ToolkitColorLogo.

    .PARAMETER Edition
        PAWDeploy edition for edition-specific images. Accepted values: Community,
        CommunityEdition, Enterprise, EnterpriseEdition. Defaults to Community.

    .PARAMETER MaximumWidth
        Optionally scales wider images down while preserving their aspect ratio.

    .EXAMPLE
        $PictureBox.Image = Get-PAWImage -Name Logo -Edition Enterprise

    .EXAMPLE
        $Form.BackgroundImage = Get-PAWImage -Name Background

    .OUTPUTS
        System.Drawing.Image

    .NOTES
        Version : 2.0.0.8
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    [OutputType([System.Drawing.Image])]
    param(
        [Parameter(Mandatory = $true, Position = 0)]
        [ValidateSet('Logo', 'LogoWhite', 'EditionLogo', 'DeploymentBunnyLogo', 'Background', 'VhdIcon', 'InfoIcon',
            'ToolkitFullLogo', 'ToolkitHorizontalLogo', 'ToolkitAppIcon', 'ToolkitColorLogo')]
        [string]$Name,

        [Parameter(Position = 1)]
        [ValidateSet('Community', 'CommunityEdition', 'Enterprise', 'EnterpriseEdition')]
        [string]$Edition = 'Community',

        [ValidateRange(1, 2147483647)][int]$MaximumWidth
    )

    $imageFileNameMap = @{
        Logo       = 'Logo.png'
        LogoWhite  = 'LogoWhite.png'
        DeploymentBunnyLogo = 'DeploymentBunnyLogo.png'
        Background = 'pawbg02.jpg'
        VhdIcon    = 'vhd.png'
        InfoIcon   = 'info.png'
        ToolkitFullLogo = 'PAW-Deployment-Toolkit-Full-Logo.png'
        ToolkitHorizontalLogo = 'PAW-Deployment-Toolkit-Horizontal-Logo.png'
        ToolkitAppIcon = 'PAW-Deployment-Toolkit-App-Icon.png'
        ToolkitColorLogo = 'PAW-Deployment-Toolkit-Logo-Color.png'
    }

    $fileName = if ($Name -eq 'EditionLogo') {
        if ($Edition -like 'Community*') { 'Truesec-Logo-Small-White-Community-Editidion.png' }
        else { 'Truesec-Logo-Small-White-Enterprise-Editidion.png' }
    }
    else { $imageFileNameMap[$Name] }
    $imagePath = Resolve-PAWImagePath -FileName $fileName
    $source = [System.Drawing.Image]::FromFile($imagePath)

    try {
        if ($PSBoundParameters.ContainsKey('MaximumWidth') -and $source.Width -gt $MaximumWidth) {
            $height = [int][Math]::Max(1, [Math]::Round($source.Height * ([double]$MaximumWidth / $source.Width)))
            [System.Drawing.Bitmap]::new($source, $MaximumWidth, $height)
        }
        else { New-Object System.Drawing.Bitmap($source) }
    }
    finally {
        $source.Dispose()
    }
}
<#

.SYNOPSIS
