function Get-PAWASRRule {
    <#
    .SYNOPSIS
        Loads and validates the ASR master list.
    .PARAMETER Path
        Path to the master list. Defaults to Resources\ASR\MasterList.json.
    .PARAMETER InputObject
        Master list object to validate without reading a file.
    .NOTES
        Version : 2.0.0.3
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(DefaultParameterSetName = 'Path')]
    param(
        [Parameter(ParameterSetName = 'Path')]
        [string]$Path = (Join-Path $script:scriptFolder 'Resources\ASR\MasterList.json'),
        [Parameter(Mandatory, ParameterSetName = 'InputObject')]
        [object]$InputObject
    )

    if ($PSCmdlet.ParameterSetName -eq 'InputObject') {
        $document = $InputObject
        $Path = '<input>'
    }
    else { $document = Get-Content -LiteralPath $Path -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop }
    if ($null -eq $document -or $document.SchemaVersion -ne 1 -or
        $document.Version -isnot [string] -or $document.Version -notmatch '^\d+\.\d+\.\d+$' -or
        $document.Rules -isnot [array] -or $document.Rules.Count -eq 0) {
        throw "Invalid ASR master list '$Path': expected schema version 1, a version and a non-empty Rules array."
    }

    $seen = @{}
    $rules = @(foreach ($entry in $document.Rules) {
        $id = [guid]::Empty
        if ($entry.Id -isnot [string] -or -not [guid]::TryParseExact($entry.Id, 'D', [ref]$id) -or $id -eq [guid]::Empty -or
            $entry.Name -isnot [string] -or [string]::IsNullOrWhiteSpace($entry.Name) -or
            $entry.Mode -isnot [string] -or $entry.Mode -notin @('Block', 'Audit', 'Disabled') -or
            $entry.RequiresCloudProtection -isnot [bool]) {
            throw "Invalid ASR rule in '$Path': each rule requires a GUID, name, Block/Audit/Disabled mode and RequiresCloudProtection boolean."
        }
        foreach ($field in @('ClientMinBuild', 'ServerMinBuild')) {
            $value = $entry.$field
            if (($value -isnot [int] -and $value -isnot [long]) -or $value -lt 0 -or $value -gt [int]::MaxValue) {
                throw "Invalid ASR rule '$id' in '$Path': $field must be a non-negative integer."
            }
        }
        $key = $id.ToString('D')
        if ($seen.ContainsKey($key)) { throw "Duplicate ASR rule '$key' in '$Path'." }
        $seen[$key] = $true
        [pscustomobject]@{
            Id                      = $key
            Name                    = $entry.Name
            Mode                    = switch ($entry.Mode) {
                'Block' { 'Block' }
                'Audit' { 'Audit' }
                'Disabled' { 'Disabled' }
            }
            ClientMinBuild          = [int]$entry.ClientMinBuild
            ServerMinBuild          = [int]$entry.ServerMinBuild
            RequiresCloudProtection = $entry.RequiresCloudProtection
            ProfileVersion          = $document.Version
        }
    })
    $rules
}
<#

.SYNOPSIS
    Resolves a configured folder setting from JSON relative to its configuration file.

.DESCRIPTION
    Resolves a configured folder setting from JSON relative to its configuration file.

.PARAMETER ConfigJson
    Configuration JSON object containing the folder setting.

.PARAMETER ConfigPath
    Path to the configuration file, used to resolve relative folder values.

.PARAMETER NodeName
    Name of the configuration property containing the folder path.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Get-PAWConfiguredFolderPath {
    param(
        [Parameter(Mandatory = $true)]
        [object]$ConfigJson,
        [Parameter(Mandatory = $true)]
        [string]$ConfigPath,
        [Parameter(Mandatory = $true)]
        [string]$NodeName
    )

    $configurationNode = $ConfigJson.Settings.Configuration
    $locationValue = if ($null -ne $configurationNode -and $null -ne $configurationNode.$NodeName) { [string]$configurationNode.$NodeName } else { '' }

    if ([string]::IsNullOrWhiteSpace($locationValue)) {
        return $null
    }

    if ([System.IO.Path]::IsPathRooted($locationValue)) {
        return $locationValue
    }

    $configFolder = Split-Path -Parent $ConfigPath
    if ([string]::IsNullOrWhiteSpace($configFolder)) {
        return $locationValue
    }

    return (Join-Path $configFolder $locationValue)
}

