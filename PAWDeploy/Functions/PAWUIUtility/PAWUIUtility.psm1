function Get-PAWTemplateRowCount {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [object]$InputObject = $null
    )

    if ($null -eq $InputObject) {
        return 0
    }

    $table = Resolve-PAWTemplateTable -InputObject $InputObject
    if ($null -eq $table) {
        return 0
