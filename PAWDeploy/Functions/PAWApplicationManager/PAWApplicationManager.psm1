function Add-PAWApplicationToBundle {
    <#
    .SYNOPSIS
        Adds applications from the pipeline in installation order.
    .DESCRIPTION
        Duplicate IDs are skipped. Replace rebuilds the entire order from the
        pipeline; an empty pipeline never changes the bundle.
    .PARAMETER InputObject
        Application object with an ApplicationId property, or an ID string.
    .PARAMETER ApplicationId
        Application ID supplied directly instead of through the pipeline.
    .PARAMETER Bundle
        Exact, unique bundle name.
    .PARAMETER BundleId
        Bundle GUID, for selecting an otherwise ambiguous name.
    .PARAMETER Root
        Resources folder. Defaults to this module's installation.
    .PARAMETER Replace
        Replace the complete application list with the pipeline order.
    .NOTES
        Version : 2.0.0.2
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess, DefaultParameterSetName = 'Name')]
    param(
        [Parameter(ValueFromPipeline)][AllowNull()][object]$InputObject,
        [ValidateNotNullOrEmpty()][string]$ApplicationId,
        [Parameter(Mandatory, ParameterSetName = 'Name')][ValidateNotNullOrEmpty()][string]$Bundle,
        [Parameter(Mandatory, ParameterSetName = 'Id')][ValidateNotNullOrEmpty()][string]$BundleId,
        [string]$Root = $script:PAWApplicationResourcesRoot,
        [switch]$Replace
    )
    begin { $ids = New-Object 'System.Collections.Generic.List[string]' }
    process {
        $id = Get-PAWInputApplicationId -InputObject $InputObject -ApplicationId $ApplicationId `
            -HasInput $PSBoundParameters.ContainsKey('InputObject') -HasId $PSBoundParameters.ContainsKey('ApplicationId')
        $ids.Add($id)
    }
    end {
        if ($ids.Count -eq 0) { return }
        $selector = if ($PSCmdlet.ParameterSetName -eq 'Id') { @{ BundleId = $BundleId } } else { @{ Name = $Bundle } }
        $target = Get-PAWApplicationBundle -Root $Root @selector
        $catalog = @(Get-PAWApplicationCatalog -Root $Root)
        foreach ($id in $ids) {
            if (@($catalog | Where-Object ApplicationId -eq $id).Count -ne 1) { throw "Application '$id' does not exist in the catalog." }
        }
        if (-not $PSCmdlet.ShouldProcess($target.Name, $(if ($Replace) { 'Replace bundle application order' } else { 'Add applications to bundle' }))) { return }
        $lock = Enter-PAWBundleWriteLock -Root $Root
        try {
            $target = Get-PAWApplicationBundle -Root $Root -BundleId $target.BundleId
            $catalog = @(Get-PAWApplicationCatalog -Root $Root)
            $members = @()
            if (-not $Replace) { $members = @($target.Applications) }
            $draft = [pscustomobject]@{
                SchemaVersion = 1; BundleId = $target.BundleId; Name = $target.Name
                Applications = @($members) + @($ids.ToArray())
            }
            $value = ConvertTo-PAWManagedBundle $draft $catalog -SkipDuplicates
            Write-PAWManagerJson (Join-Path $Root "ApplicationBundles\$($value.BundleId).json") $value
        }
        finally { $lock.Dispose() }
        Write-PAWApplicationManagerLog "Saved bundle '$($value.BundleId)' with $($value.Applications.Count) applications."
        $value
    }
}
<#
.SYNOPSIS
    Converts catalog definitions and migrates legacy GUID-only filenames.
.DESCRIPTION
    Converts WinGet and PSGallery definitions to schema 2 and renames catalog
    files to a readable application-name plus GUID format. A verified backup
    is created before changes and restored if conversion fails.
    Legacy Local installers remain readable but need an operator-authored
    Classic command and detection; no installation command is guessed.
.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team
#>
function Convert-PAWApplicationCatalog {
    [CmdletBinding(SupportsShouldProcess)]
    param([Parameter(Mandatory)][string]$Root)
    $folder = Join-Path $Root 'ApplicationCatalog'
    if (-not (Test-Path -LiteralPath $folder -PathType Container)) { throw "Application catalog not found: $folder" }
    $writes = [ordered]@{}
    $sourceByTarget = @{}
    $renameSources = New-Object 'System.Collections.Generic.List[string]'
    $manual = @()
    $seenIds = @{}
    $seenNames = @{}
    $seenFiles = @{}
    $convertedCount = 0
    $cleanedCount = 0
    $renamedCount = 0

    foreach ($file in @(Get-ChildItem -LiteralPath $folder -Filter '*.json' -File -ErrorAction Stop | Sort-Object Name)) {
        $inputValue = Read-PAWManagerJson $file.FullName
        $hadDownloadFlag = $false
        if ($inputValue.SchemaVersion -eq 1) {
            $hadDownloadFlag = $null -ne $inputValue.Definition.PSObject.Properties['DownloadEnabled']
            $inputValue.Definition.PSObject.Properties.Remove('DownloadEnabled')
        }
        $app = ConvertTo-PAWManagedApplication $inputValue
        $target = Get-PAWApplicationCatalogPath -Root $Root -Application $app
        $legacyBaseName = $app.ApplicationId
        $namedBaseName = [IO.Path]::GetFileNameWithoutExtension($target)
        if ($file.BaseName -ine $legacyBaseName -and $file.BaseName -ine $namedBaseName) {
            throw "Application catalog filename must be '<safe name>--<ApplicationId>.json' or the legacy '<ApplicationId>.json': $($file.FullName)"
        }
        $installFile = Get-PAWApplicationInstallFilePath -InstallRoot (Join-Path $Root 'Applications\InstallFiles') -Name $app.Definition.Name
        if ($seenIds.ContainsKey($app.ApplicationId) -or $seenNames.ContainsKey($app.Definition.Name) -or $seenFiles.ContainsKey($installFile)) {
            throw "Duplicate application ID/name or cache filename: $($app.ApplicationId) / $($app.Definition.Name)"
        }
        if ($writes.Contains($target)) { throw "Multiple definitions map to the same catalog filename: '$target'." }
        $seenIds[$app.ApplicationId] = $true
        $seenNames[$app.Definition.Name] = $true
        $seenFiles[$installFile] = $true
        $needsRename = -not [string]::Equals($file.FullName, $target, [StringComparison]::OrdinalIgnoreCase)

        if ($app.SchemaVersion -eq 1 -and $app.Definition.Source -eq 'Local') {
            $manual += $app.Definition.Name
            if ($hadDownloadFlag) {
                $writes[$target] = $app
                $sourceByTarget[$target] = $file.FullName
                $cleanedCount++
            }
            elseif ($needsRename) {
                $writes[$target] = $app
                $sourceByTarget[$target] = $file.FullName
            }
            if ($needsRename) {
                $renameSources.Add($file.FullName)
                $renamedCount++
            }
            continue
        }

        if ($app.SchemaVersion -eq 2) {
            if ($needsRename) {
                $writes[$target] = $app
                $sourceByTarget[$target] = $file.FullName
            }
            if ($needsRename) {
                $renameSources.Add($file.FullName)
                $renamedCount++
            }
            continue
        }

        $type = if ($app.Definition.Source -eq 'WinGet') { 'WinGet' } else { 'PowerShellModule' }
        $config = if ($type -eq 'WinGet') {
            @{ Id = $app.Definition.Id; Architecture = $app.Definition.Architecture; Scope = $app.Definition.Scope; InstallerType = $app.Definition.InstallerType }
        }
        else { @{ Id = $app.Definition.Id; Version = 'Latest'; Runtime = 'WindowsPowerShell'; Origin = 'PSGallery' } }
        $converted = New-PAWManagedApplication -Type $type -Name $app.Definition.Name -Configuration $config -RestartRequired $app.RestartRequired
        $converted.ApplicationId = $app.ApplicationId
        $converted.Enabled = $app.Enabled
        $converted.Definition.InstallEnabled = $app.Definition.InstallEnabled
        $converted.Settings = $app.Settings
        $writes[$target] = $converted
        $sourceByTarget[$target] = $file.FullName
        $convertedCount++
        if ($needsRename) {
            $renameSources.Add($file.FullName)
            $renamedCount++
        }
    }

    if ($manual.Count) { Write-Warning "Legacy Local definitions require a Classic command, detection and package files before manual conversion: $($manual -join ', ')." }
    $backup = $null
    if ($writes.Count -and $PSCmdlet.ShouldProcess($folder, "Back up catalog, convert $convertedCount definitions to schema 2, clean $cleanedCount legacy Local definitions and rename $renamedCount catalog files")) {
        $backupId = [guid]::NewGuid().ToString('N').Substring(0, 12)
        $backup = Join-Path (Join-Path $Root 'Applications\Backups') ('Schema2-' + (Get-Date -Format 'yyyyMMdd-HHmmss') + '-' + $backupId)
        $null = New-Item -Path $backup -ItemType Directory -Force -ErrorAction Stop
        $catalogBackup = Join-Path $backup 'ApplicationCatalog'
        $null = New-Item -Path $catalogBackup -ItemType Directory -Force -ErrorAction Stop
        foreach ($entry in @(Get-ChildItem -LiteralPath $folder -File -Force -ErrorAction Stop)) {
            [IO.File]::Copy($entry.FullName, (Join-Path $catalogBackup $entry.Name), $true)
        }
        if (Test-Path -LiteralPath (Join-Path $Root 'ApplicationBundles')) {
            $bundleBackup = Join-Path $backup 'ApplicationBundles'
            $null = New-Item -Path $bundleBackup -ItemType Directory -Force -ErrorAction Stop
            foreach ($entry in @(Get-ChildItem -LiteralPath (Join-Path $Root 'ApplicationBundles') -File -Force -ErrorAction Stop)) {
                [IO.File]::Copy($entry.FullName, (Join-Path $bundleBackup $entry.Name), $true)
            }
        }
        foreach ($target in $writes.Keys) {
            $source = $sourceByTarget[$target]
            $copy = Join-Path (Join-Path $backup 'ApplicationCatalog') ([IO.Path]::GetFileName($source))
            if ((Get-FileHash -LiteralPath $source).Hash -ne (Get-FileHash -LiteralPath $copy).Hash) { throw "Backup verification failed: $source" }
        }

        $originals = @{}
        $touched = New-Object 'System.Collections.Generic.List[string]'
        foreach ($path in @($writes.Keys) + @($renameSources)) {
            if (-not $originals.ContainsKey($path)) {
                $originals[$path] = if (Test-Path -LiteralPath $path -PathType Leaf) { [IO.File]::ReadAllBytes($path) } else { $null }
            }
        }
        try {
            foreach ($target in $writes.Keys) {
                $touched.Add($target)
                Write-PAWManagerJson $target $writes[$target]
            }
            foreach ($source in $renameSources) {
                $touched.Add($source)
                Remove-Item -LiteralPath $source -ErrorAction Stop
            }
            $null = @(Get-PAWApplicationCatalog -Root $Root)
        }
        catch {
            $failure = $_
            $rollbackErrors = New-Object 'System.Collections.Generic.List[string]'
            for ($index = $touched.Count - 1; $index -ge 0; $index--) {
                $path = $touched[$index]
                try {
                    if ($null -ne $originals[$path]) { [IO.File]::WriteAllBytes($path, $originals[$path]) }
                    elseif (Test-Path -LiteralPath $path -PathType Leaf) { Remove-Item -LiteralPath $path -ErrorAction Stop }
                }
                catch { $rollbackErrors.Add("'$path': $($_.Exception.Message)") }
            }
            if ($rollbackErrors.Count) {
                throw "Catalog conversion failed: $($failure.Exception.Message). Rollback also failed: $($rollbackErrors -join '; '). Backup retained at '$backup'."
            }
            throw $failure
        }
        Write-PAWApplicationManagerLog "Converted $convertedCount application definitions, cleaned $cleanedCount legacy Local definitions and renamed $renamedCount catalog files. Backup: '$backup'."
    }
    [pscustomobject]@{
        Converted = $(if ($backup) { $convertedCount } else { 0 })
        CleanedLegacy = $(if ($backup) { $cleanedCount } else { 0 })
        Renamed = $(if ($backup) { $renamedCount } else { 0 })
        BackupPath = $backup
        RequiresManualConversion = $manual
    }
}
