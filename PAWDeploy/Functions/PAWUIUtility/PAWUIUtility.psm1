<#

.SYNOPSIS
    Shows a simple list selection dialog for WinForms editors.

.DESCRIPTION
    Shows a simple list selection dialog for WinForms editors.

.PARAMETER Table
    DataTable of templates displayed in the selection dialog.

.PARAMETER Owner
    Optional owner form for the dialog.

.PARAMETER Title
    Dialog window title. Defaults to 'Select Template'.

.PARAMETER NameColumn
    Table column containing the template names displayed in the list. Defaults to 'Name'.

.NOTES
    Version : 2.0.0.5
    Author  : The Fantastic PAWDeploy Team

#>
function Select-PAWTemplateDialog {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [System.Data.DataTable]$Table,

        [Parameter(Mandatory = $false)]
        [System.Windows.Forms.Form]$Owner = $null,

        [Parameter(Mandatory = $false)]
        [string]$Title = 'Select Template',

        [Parameter(Mandatory = $false)]
        [string]$NameColumn = 'Name'
    )

    if ($null -eq $Table -or $Table.Rows.Count -eq 0) {
        return -1
    }

    $dialog = New-Object System.Windows.Forms.Form
    $dialog.Text = $Title
    $dialog.StartPosition = 'CenterParent'
    $dialog.Size = New-Object System.Drawing.Size(500, 420)
    $dialog.MinimizeBox = $false
    $dialog.MaximizeBox = $false
    $dialog.Font = [System.Drawing.Font]::new('Segoe UI', 10, [System.Drawing.FontStyle]::Bold)
    $dialog.BackColor = (Get-PAWUiPalette).Background

    $list = New-Object System.Windows.Forms.ListBox
    $list.Location = New-Object System.Drawing.Point(12, 12)
    $list.Size = New-Object System.Drawing.Size(460, 320)
    $list.Font = [System.Drawing.Font]::new('Segoe UI', 10)

    foreach ($row in @($Table.Rows)) {
        [void]$list.Items.Add([string]$row[$NameColumn])
    }

    if ($list.Items.Count -gt 0) {
        $list.SelectedIndex = 0
    }

    $dialog.Controls.Add($list)

    $btnOk = New-Object System.Windows.Forms.Button
    $btnOk.Text = 'OK'
    $btnOk.Location = New-Object System.Drawing.Point(62, 346)
    $btnOk.Size = New-Object System.Drawing.Size(75, 28)
    $btnOk.DialogResult = [System.Windows.Forms.DialogResult]::OK
    $dialog.Controls.Add($btnOk)

    $btnCancel = New-Object System.Windows.Forms.Button
    $btnCancel.Text = 'Cancel'
    $btnCancel.Location = New-Object System.Drawing.Point(272, 346)
    $btnCancel.Size = New-Object System.Drawing.Size(75, 28)
    $btnCancel.DialogResult = [System.Windows.Forms.DialogResult]::Cancel
    $dialog.Controls.Add($btnCancel)

    $dialog.AcceptButton = $btnOk
    $dialog.CancelButton = $btnCancel

    Set-PAWUiTheme -Control $dialog
    $result = $dialog.ShowDialog($Owner)
    if ($result -ne [System.Windows.Forms.DialogResult]::OK -or $list.SelectedIndex -lt 0) {
        return -1
    }

    return $list.SelectedIndex
}
<#
.SYNOPSIS
    Positions the current classic console window using screen pixel coordinates.
.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team
#>
function Set-PAWConsoleWindow {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)][int]$X,
        [Parameter(Mandatory = $true)][int]$Y,
        [Parameter(Mandatory = $true)][ValidateRange(1, 32767)][int]$Width,
        [Parameter(Mandatory = $true)][ValidateRange(1, 32767)][int]$Height
    )

    if (-not ('PAWDeploy.ConsoleWindow' -as [type])) {
        Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
namespace PAWDeploy {
    public static class ConsoleWindow {
        [DllImport("kernel32.dll")]
        public static extern IntPtr GetConsoleWindow();
        [DllImport("user32.dll", SetLastError = true)]
        [return: MarshalAs(UnmanagedType.Bool)]
        public static extern bool SetWindowPos(IntPtr window, IntPtr insertAfter,
            int x, int y, int width, int height, uint flags);
    }
}
'@ -ErrorAction Stop
    }
    $handle = [PAWDeploy.ConsoleWindow]::GetConsoleWindow()
    if ($handle -eq [IntPtr]::Zero) {
        throw 'A classic console window is required to position the deployment output.'
    }
    # Keep the console visible without making it permanently topmost.
    if (-not [PAWDeploy.ConsoleWindow]::SetWindowPos($handle, [IntPtr]::Zero, $X, $Y, $Width, $Height, 0x0040)) {
        throw (New-Object System.ComponentModel.Win32Exception([Runtime.InteropServices.Marshal]::GetLastWin32Error()))
    }
}
