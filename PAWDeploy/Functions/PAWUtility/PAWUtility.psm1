<#

.SYNOPSIS
    Returns and caches available unattended-setup locale names.

.DESCRIPTION
    Returns and caches available unattended-setup locale names.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Get-PAWUnattendLocaleOptions {
    $localeCacheVar = Get-Variable -Scope Script -Name LocaleOptionsCache -ErrorAction SilentlyContinue
    if ($null -ne $localeCacheVar -and $null -ne $localeCacheVar.Value) {
        return $localeCacheVar.Value
    }

    $options = New-Object System.Collections.Generic.List[string]
    try {
        foreach ($culture in @([System.Globalization.CultureInfo]::GetCultures([System.Globalization.CultureTypes]::SpecificCultures) | Sort-Object Name -Unique)) {
            if (-not [string]::IsNullOrWhiteSpace($culture.Name)) {
                [void]$options.Add([string]$culture.Name)
            }
        }
    }
    catch {
        return @()
    }

    $script:LocaleOptionsCache = $options.ToArray()
    return $script:LocaleOptionsCache
}

<#

.SYNOPSIS
    Creates an unused JSON file path for a template name in a folder.

.DESCRIPTION
    Returns a file path for a new template file in a template folder. The file
    name is the template name with invalid file name characters replaced by _,
    followed by .json. When the file already exists, " (2)", " (3)", and so on
    is added until the name is unique.

.PARAMETER TemplateFolder
    The template folder.

.PARAMETER TemplateName
    The template name.

.EXAMPLE
    Get-PAWUniqueTemplateFilePath -TemplateFolder 'C:\PAWDeploy\Config' -TemplateName 'Windows 11 PAW'

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Get-PAWUniqueTemplateFilePath {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory = $true)]
        [Alias('Folder')]
        [string]$TemplateFolder,

        [Parameter(Mandatory = $true)]
        [string]$TemplateName
    )

    $safeName = $TemplateName.Trim()
    foreach ($invalidChar in [System.IO.Path]::GetInvalidFileNameChars()) {
        $safeName = $safeName.Replace([string]$invalidChar, '_')
    }

    $candidate = Join-Path $TemplateFolder ("{0}.json" -f $safeName)
    $suffix = 2
    while ([System.IO.Path]::GetFileName($candidate) -eq 'Config.json' -or (Test-Path -LiteralPath $candidate)) {
        $candidate = Join-Path $TemplateFolder ("{0} ({1}).json" -f $safeName, $suffix)
        $suffix++
    }

    return $candidate
}
function Get-PAWValidatedTemplate {
    <#
    .SYNOPSIS
        Reads and validates a portable deployment template JSON file.
    .DESCRIPTION
        Requires a single JSON object, Name and the deployment settings that
        require values. Invalid scalar values are retained and reported as
        warnings with correction guidance; structural errors still terminate.
    .PARAMETER Path
        Existing template JSON file; Config.json is never a template.
    .NOTES
        Version : 2.0.0.3
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$Path)
    $file = Get-Item -LiteralPath $Path -Force -ErrorAction Stop
    if ($file.PSIsContainer -or $file.Extension -ne '.json' -or $file.Name -eq 'Config.json' -or
        ($file.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
        throw "Template must be a regular .json file other than Config.json: '$Path'."
    }
    $json = Get-Content -LiteralPath $file.FullName -Raw -ErrorAction Stop
    if (-not $json.TrimStart().StartsWith('{')) { throw "Template must be a single JSON object: '$Path'." }
    $data = ConvertFrom-Json -InputObject $json -ErrorAction Stop
    if ($data -isnot [pscustomobject] -or $data.PSObject.Properties['Settings'] -or $data.PSObject.Properties['Solution']) {
        throw "Not a deployment template object: '$Path'."
    }
    $required = @('Name', 'VMGen', 'NoCPU', 'Memory', 'DynamicMem', 'DiskMode',
        'Shielded', 'BitLocker', 'Application', 'ApplySecurityBaseline', 'VHDFile',
        'TimeZoneName', 'InputLocale', 'SystemLocale', 'UILanguage', 'UserLocale',
        'DomainOrWorkGroup', 'VLanID', 'VMSwitch')
    foreach ($setting in $required) {
        $property = $data.PSObject.Properties[$setting]
        if ($null -eq $property) {
            throw "Template '$Path': required setting '$setting' is missing."
        }
    }
    if ([string]::IsNullOrWhiteSpace([string]$data.Name)) { throw "Template '$Path': Name cannot be empty." }
    $warnings = New-Object 'System.Collections.Generic.List[string]'
    foreach ($property in $data.PSObject.Properties) {
        $value = $property.Value
        if ($null -ne $value -and $value -isnot [string] -and $value -isnot [bool] -and $value -isnot [ValueType]) {
            throw "Template '$Path': '$($property.Name)' must be a scalar value, not an object or array."
        }
        if ($property.Name -eq 'Name' -and $value -isnot [string]) { throw "Template Name must be a string: '$Path'." }
        try { $property.Value = ConvertTo-PAWTemplateValue -SettingName $property.Name -Value $value }
        catch {
            $warnings.Add("Template '$Path', setting '$($property.Name)': $($_.Exception.Message) Correct this setting in the Template Editor and save. Original value retained.")
        }
        if ($property.Name -eq 'RunScript' -and $property.Value -and $property.Value -ne 'NA') {
            $scriptName = [string]$property.Value
            if ([IO.Path]::GetFileName($scriptName) -ne $scriptName -or
                [IO.Path]::GetExtension($scriptName) -ne '.ps1' -or
                $scriptName.IndexOfAny([IO.Path]::GetInvalidFileNameChars()) -ge 0) {
                $warnings.Add("Template '$Path', setting 'RunScript': use only a .ps1 filename, e.g. Sample1.ps1, or NA to skip. Remove directory prefixes in the Template Editor and save. Original value retained.")
            }
        }
    }
    foreach ($warning in $warnings) { Write-Warning $warning }
    [pscustomobject]@{ Name = [string]$data.Name; Source = $file.FullName; Data = $data; Warnings = $warnings.ToArray() }
}
