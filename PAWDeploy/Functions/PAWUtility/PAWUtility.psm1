<#

.SYNOPSIS
    Converts an existing Applications.json to the standardized format.

.DESCRIPTION
    Applications.json is standardized (see Get-PAWApplicationDefinitions):
    every application has exactly Name, Source, Id,
    InstallEnabled, Architecture, Scope and InstallerType, with NA for values
    that do not apply. Files created by earlier versions of PAWDeploy left out
    properties and could contain properties that are no longer supported (for
    example Locale or install settings). Install-PAWDeploy.ps1 keeps an
    existing Applications.json on upgrade and runs this function to convert it.

    For every application:

      - Existing values are kept, in the standard order and casing
        (machine becomes Machine, X64 becomes x64).
      - A missing InstallEnabled is added as true, which
        was the earlier default.
      - A missing Architecture, Scope or InstallerType is added as NA, which
        means the same as leaving it out did before. A missing Id is added as
        NA for a Local application.
      - Architecture, Scope and InstallerType are set to NA for a PSGallery
        module, where they were ignored before.
      - Other properties are removed. Install settings belong in the install
        file (Resources\Applications\InstallFiles\<Name>.json).

    Values that cannot be converted (for example an invalid Source) are left
    unchanged so that Get-PAWApplicationDefinitions reports them.

    When the file changes, the original is saved next to it as
    Applications.json.<yyyyMMdd-HHmmss>.bak. The file is written only when its
    content changes. Returns an object with Path, Status (Converted or
    Unchanged), BackupPath and Changes (one line per change).

.PARAMETER Path
    Path to Applications.json.

.EXAMPLE
    Update-PAWApplicationDefinitionsFile -Path 'C:\PAWDeploy\Resources\Applications\Applications.json'

.EXAMPLE
    Update-PAWApplicationDefinitionsFile -Path 'C:\PAWDeploy\Resources\Applications\Applications.json' -WhatIf
    Shows the changes without writing the file.

.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team

#>
function Update-PAWApplicationDefinitionsFile {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Path
    )

    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
        throw "Applications file not found: $Path"
    }

    $originalText = [System.IO.File]::ReadAllText($Path)
    try {
        $applicationsJson = $originalText | ConvertFrom-Json -ErrorAction Stop
    }
    catch {
        throw "Applications file '$Path' is not valid JSON. $($_.Exception.Message)"
    }
    if ($null -eq $applicationsJson -or $null -eq $applicationsJson.PSObject.Properties['Applications']) {
        throw "Applications file '$Path' does not contain an 'Applications' array."
    }

    $propertyNames = @('Name', 'Source', 'Id', 'InstallEnabled', 'Architecture', 'Scope', 'InstallerType')
    $allowedValues = @{
        Source        = @('WinGet', 'PSGallery', 'Local')
        Architecture  = @('x86', 'x64', 'arm64', 'NA')
        Scope         = @('Machine', 'User', 'NA')
        InstallerType = @('msi', 'wix', 'msix', 'appx', 'exe', 'burn', 'inno', 'nullsoft', 'zip', 'portable', 'NA')
    }

    $changes = New-Object System.Collections.Generic.List[string]
    $convertedApplications = New-Object System.Collections.Generic.List[object]
    $index = 0
    foreach ($application in @($applicationsJson.Applications)) {
        $index++
        if ($null -eq $application -or $application -isnot [System.Management.Automation.PSCustomObject]) {
            $convertedApplications.Add($application)
            continue
        }

        $properties = $application.PSObject.Properties
        $nameProperty = $properties['Name']
        $label = if ($null -ne $nameProperty -and -not [string]::IsNullOrWhiteSpace([string]$nameProperty.Value)) { [string]$nameProperty.Value } else { "Application #$index" }
        $sourceProperty = $properties['Source']
        $source = if ($null -ne $sourceProperty) { ([string]$sourceProperty.Value).Trim() } else { '' }

        $entry = [ordered]@{}
        foreach ($propertyName in $propertyNames) {
            $property = $properties[$propertyName]
            $hasValue = $null -ne $property -and -not ($property.Value -isnot [bool] -and [string]::IsNullOrWhiteSpace([string]$property.Value))

            if (-not $hasValue) {
                $defaultValue = $null
                switch ($propertyName) {
                    'InstallEnabled' { $defaultValue = $true }
                    { $_ -in 'Architecture', 'Scope', 'InstallerType' } { $defaultValue = 'NA' }
                    'Id' { if ($source -eq 'Local') { $defaultValue = 'NA' } }
                }
                if ($null -ne $defaultValue) {
                    $entry[$propertyName] = $defaultValue
                    $changes.Add("$label`: added $propertyName = $(if ($defaultValue -is [bool]) { $defaultValue.ToString().ToLowerInvariant() } else { $defaultValue })")
                }
                elseif ($null -ne $property) {
                    $entry[$propertyName] = $property.Value
                }
                continue
            }

            $value = $property.Value
            if ($value -isnot [bool]) {
                $value = ([string]$value).Trim()
                if ($propertyName -eq 'InstallEnabled' -and $value -in 'true', 'false') {
                    $value = $value -eq 'true'
                }
                elseif ($allowedValues.ContainsKey($propertyName)) {
                    $match = $allowedValues[$propertyName] | Where-Object { $_ -eq $value } | Select-Object -First 1
                    if ($null -ne $match) { $value = $match }
                }
                elseif ($propertyName -eq 'Id' -and $value -eq 'NA') {
                    $value = 'NA'
                }
            }
            if ($source -eq 'PSGallery' -and $propertyName -in 'Architecture', 'Scope', 'InstallerType' -and $value -ne 'NA') {
                $changes.Add("$label`: set $propertyName = NA (was $value; not used for PSGallery modules)")
                $value = 'NA'
            }
            $entry[$propertyName] = $value
        }

        foreach ($property in $properties) {
            if ($propertyNames -notcontains $property.Name) {
                $changes.Add("$label`: removed $($property.Name) (not part of the standard; install settings belong in the install file)")
            }
        }

        $convertedApplications.Add($entry)
    }

    $json = (ConvertTo-PAWIndentedJson -InputObject ([ordered]@{ Applications = $convertedApplications.ToArray() })) + "`r`n"
    $status = if ($originalText.Trim() -eq $json.Trim()) { 'Unchanged' } else { 'Converted' }
    $backupPath = $null

    if ($status -eq 'Converted' -and $PSCmdlet.ShouldProcess($Path, 'Convert Applications.json to the standard format')) {
        $backupPath = '{0}.{1}.bak' -f $Path, (Get-Date).ToString('yyyyMMdd-HHmmss')
        Copy-Item -LiteralPath $Path -Destination $backupPath -Force
        [System.IO.File]::WriteAllText($Path, $json, (New-Object System.Text.UTF8Encoding($false)))
    }

    [PSCustomObject]@{
        Path       = $Path
        Status     = $status
        BackupPath = $backupPath
        Changes    = $changes.ToArray()
    }
}
<#

.SYNOPSIS
    Creates or updates the install file of a WinGet or Local application.

.DESCRIPTION
    The install file (Resources\Applications\InstallFiles\<Name>.json) holds the
    install information of one application, so that Applications.json only
    lists which applications are wanted. It has two sections:

      Settings  - optional settings that cannot be read from the WinGet
                  manifest: InstallCheckPaths, SilentArguments,
                  CustomArguments, MsiProperties, PostInstallKillProcess and
                  DestinationPath. They can be edited and are kept when the
                  file is updated.
      Installer - written on every download run from the WinGet manifest (or,
                  for a Local application, from the installer file): version,
                  installer type and file, product code, silent switches,
                  custom switches and the success and reboot exit codes.

    Silent switches come from InstallerSwitches.Silent in the manifest, or the
    WinGet default for the installer type (msi/wix/burn: /quiet /norestart,
    inno: /SP- /VERYSILENT /SUPPRESSMSGBOXES /NORESTART, nullsoft: /S). For a
    zip with a nested installer, the nested installer type is used.

    Success exit codes are 0, InstallerSuccessCodes and the ExpectedReturnCodes
    that mean success (alreadyInstalled, rebootRequiredToFinish,
    rebootInitiated). msi/wix/burn also accept 1641 and 3010.

    The file is written only when its content changes. Returns an object with
    Path and Status (Created, Updated or Unchanged).

.PARAMETER Path
    Path of the install file (see Get-PAWApplicationInstallFilePath).

.PARAMETER Application
    Application definition from Get-PAWApplicationDefinitions.

.PARAMETER ManifestInfo
    Manifest information from Get-PAWWinGetManifestInfo. For a Local application,
    an object with PackageVersion and InstallerType (the other values are empty).

.PARAMETER InstallerFile
    File name of the installer in the cache folder (WinGet) or Local folder.

.PARAMETER ManifestFile
    File name of the downloaded WinGet manifest in the cache folder. Empty for a
    Local application.

.PARAMETER ManagedSettings
    Optional authoritative catalog Settings. When provided, resets generated
    Settings to defaults plus these overrides rather than inheriting cache edits.

.EXAMPLE
    Update-PAWApplicationInstallFile -Path $installFilePath -Application $application -ManifestInfo $manifest -InstallerFile '7-Zip.msi' -ManifestFile '7-Zip.yaml'

.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team

#>
function Update-PAWApplicationInstallFile {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Path,

        [Parameter(Mandatory = $true)]
        $Application,

        [Parameter(Mandatory = $true)]
        $ManifestInfo,

        [Parameter(Mandatory = $true)]
        [string]$InstallerFile,

        [AllowEmptyString()]
        [string]$ManifestFile = '',

        [psobject]$ManagedSettings
    )

    $installerType = ([string]$ManifestInfo.InstallerType).Trim().ToLowerInvariant()
    $nestedInstallerType = ([string]$ManifestInfo.NestedInstallerType).Trim().ToLowerInvariant()
    $effectiveType = $installerType
    if ($installerType -eq 'zip' -and -not [string]::IsNullOrWhiteSpace($nestedInstallerType) -and $nestedInstallerType -ne 'portable') {
        $effectiveType = $nestedInstallerType
    }

    $defaultSilentSwitches = @{
        msi      = '/quiet /norestart'
        wix      = '/quiet /norestart'
        burn     = '/quiet /norestart'
        inno     = '/SP- /VERYSILENT /SUPPRESSMSGBOXES /NORESTART'
        nullsoft = '/S'
    }
    $silentArguments = ([string]$ManifestInfo.InstallerSwitches.Silent).Trim()
    $silentSource = 'WinGet manifest'
    if ([string]::IsNullOrWhiteSpace($silentArguments)) {
        $silentArguments = ''
        $silentSource = ''
        if ($defaultSilentSwitches.ContainsKey($effectiveType)) {
            $silentArguments = $defaultSilentSwitches[$effectiveType]
            $silentSource = "WinGet default for $effectiveType"
        }
    }

    $successCodes = New-Object System.Collections.Generic.List[long]
    $rebootCodes = New-Object System.Collections.Generic.List[long]
    $addCode = {
        param($List, [long]$Code)
        if (-not $List.Contains($Code)) { $List.Add($Code) }
        # Manifests store HRESULT-style codes unsigned; processes report them signed.
        if ($Code -gt [int]::MaxValue -and $Code -le [uint32]::MaxValue) {
            $signedCode = $Code - 4294967296
            if (-not $List.Contains($signedCode)) { $List.Add($signedCode) }
        }
    }
    & $addCode $successCodes 0
    foreach ($code in @($ManifestInfo.InstallerSuccessCodes)) {
        if ($null -ne $code) { & $addCode $successCodes $code }
    }
    foreach ($returnCode in @($ManifestInfo.ExpectedReturnCodes)) {
        if ($null -eq $returnCode) { continue }
        if ($returnCode.ReturnResponse -in 'alreadyInstalled', 'rebootRequiredToFinish', 'rebootInitiated') {
            & $addCode $successCodes $returnCode.InstallerReturnCode
        }
        if ($returnCode.ReturnResponse -in 'rebootRequiredToFinish', 'rebootInitiated') {
            & $addCode $rebootCodes $returnCode.InstallerReturnCode
        }
    }
    if ($effectiveType -in 'msi', 'wix', 'burn') {
        foreach ($code in 1641, 3010) {
            & $addCode $successCodes $code
            & $addCode $rebootCodes $code
        }
    }

    $installer = [ordered]@{
        Version              = [string]$ManifestInfo.PackageVersion
        InstallerType        = $installerType
        NestedInstallerType  = $nestedInstallerType
        NestedInstallerFiles = @($ManifestInfo.NestedInstallerFiles | Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) } | ForEach-Object { [string]$_ })
        InstallerFile        = $InstallerFile
        ManifestFile         = $ManifestFile
        ProductCode          = [string]$ManifestInfo.ProductCode
        SilentArguments      = $silentArguments
        SilentSource         = $silentSource
        CustomArguments      = ([string]$ManifestInfo.InstallerSwitches.Custom).Trim()
        SuccessExitCodes     = $successCodes.ToArray()
        RebootExitCodes      = $rebootCodes.ToArray()
    }

    $settings = [ordered]@{
        InstallCheckPaths      = @()
        SilentArguments        = ''
        CustomArguments        = ''
        MsiProperties          = @()
        PostInstallKillProcess = @()
        DestinationPath        = ''
    }

    $existingText = $null
    if (Test-Path -LiteralPath $Path -PathType Leaf) {
        $existingText = [System.IO.File]::ReadAllText($Path)
        try {
            $existing = $existingText | ConvertFrom-Json -ErrorAction Stop
        }
        catch {
            throw "Install file '$Path' is not valid JSON. Fix or delete it. $($_.Exception.Message)"
        }
        if ($null -ne $existing.Settings -and -not $PSBoundParameters.ContainsKey('ManagedSettings')) {
            foreach ($property in $existing.Settings.PSObject.Properties) {
                $settings[$property.Name] = $property.Value
            }
        }
    }

    if ($PSBoundParameters.ContainsKey('ManagedSettings')) {
        foreach ($property in $ManagedSettings.PSObject.Properties) {
            if (-not $settings.Contains($property.Name)) { throw "Unknown managed install setting '$($property.Name)'." }
            $settings[$property.Name] = $property.Value
        }
    }

    $content = [ordered]@{
        Name      = [string]$Application.Name
        Source    = [string]$Application.Source
        Id        = [string]$Application.Id
        Settings  = $settings
        Installer = $installer
    }
    $json = (ConvertTo-PAWIndentedJson -InputObject $content) + "`r`n"

    $status = 'Created'
    if ($null -ne $existingText) {
        $status = if ($existingText.Trim() -eq $json.Trim()) { 'Unchanged' } else { 'Updated' }
    }

    if ($status -ne 'Unchanged' -and $PSCmdlet.ShouldProcess($Path, "$status install file")) {
        $folder = Split-Path -Parent $Path
        if (-not (Test-Path -LiteralPath $folder)) {
            New-Item -Path $folder -ItemType Directory -Force | Out-Null
        }
        [System.IO.File]::WriteAllText($Path, $json, (New-Object System.Text.UTF8Encoding($false)))
    }

    [PSCustomObject]@{
        Path   = $Path
        Status = $status
    }
}
Function Update-PAWLog {
    <#
    .SYNOPSIS
        Writes a PAW log entry to file and console.

    .DESCRIPTION
        Appends a structured log line to the target log file and writes a colored
        host message based on severity class.

    .PARAMETER Data
        Message text to write to the log.

    .PARAMETER Solution
        Solution/component name included in the log entry.
        Defaults to 'PAWUtility'.

    .PARAMETER Class
        Severity class for the entry. Accepted values are Information, Warning, Error.
        Defaults to 'Information'.

    .PARAMETER LogPath
        Full path to the log file. When omitted, the function uses a script-scoped
        variable named LogPath if present.

    .EXAMPLE
        Write-PAWLog -Message "Starting deployment" -Level "Information" -LogPath "C:\Temp\PAWDeploy.log"
        Writes an information message to file.

    .EXAMPLE
        Write-PAWLog -Message "VM not found" -Level "Error" -LogPath "C:\Temp\PAWDeploy.log"
        Writes an error message to file.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [CmdletBinding()]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true, Position = 0)]
        [ValidateNotNullOrEmpty()]
        [string]$Data,

        [Parameter(Mandatory = $false)]
        [ValidateNotNullOrEmpty()]
        [string]$Solution = 'PAWUtility',

        [Parameter(Mandatory = $false)]
        [ValidateSet('Information', 'Warning', 'Error')]
        [string]$Class = 'Information',

        [Parameter(Mandatory = $false)]
        [string]$LogPath
    )

    Write-Verbose 'Update-PAWLog is deprecated. Use Write-PAWLog instead.'
    Write-PAWLog -Message ("$Solution, $Data") -Level $Class -LogPath $LogPath
}
function Wait-PAWCondition {
    <#
    .SYNOPSIS
        Polls a boolean condition immediately and until a monotonic timeout.
    .DESCRIPTION
        Tests immediately, then sleeps only up to the remaining timeout.
        The test must return exactly one Boolean. Test errors propagate.
        Synchronous tests cannot be interrupted; they must bound their own
        operations. A test that finishes after the deadline cannot succeed.
    .PARAMETER Test
        Script block returning exactly one Boolean.
    .PARAMETER TimeoutSeconds
        Maximum elapsed time, in seconds.
    .PARAMETER PollIntervalSeconds
        Delay between unsuccessful tests, capped to the remaining timeout.
    .PARAMETER WaitingMessage
        Optional verbose message for unsuccessful tests.
    .PARAMETER TimeoutMessage
        Terminating timeout error text.
    .EXAMPLE
        Wait-PAWCondition -Test { Test-PAWVMIsRunning -VMname 'PAW-01' } -TimeoutSeconds 300 -PollIntervalSeconds 5
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [ValidateNotNull()]
        [scriptblock]$Test,
        [ValidateRange(0.001, 86400)]
        [double]$TimeoutSeconds = 300,
        [ValidateRange(0.001, 3600)]
        [double]$PollIntervalSeconds = 5,
        [string]$WaitingMessage,
        [string]$TimeoutMessage = 'Timed out waiting for the condition.'
    )

    $ErrorActionPreference = 'Stop'
    $timer = [System.Diagnostics.Stopwatch]::StartNew()
    try {
        while ($true) {
            if ($timer.Elapsed.TotalSeconds -ge $TimeoutSeconds) {
                throw [System.TimeoutException]::new($TimeoutMessage)
            }
            $result = @(& $Test 2>&1)
            foreach ($item in $result) {
                if ($item -is [System.Management.Automation.ErrorRecord]) { throw $item }
            }
            if ($result.Count -ne 1 -or $result[0] -isnot [bool]) {
                throw 'Condition test must return exactly one Boolean.'
            }
            if ($timer.Elapsed.TotalSeconds -ge $TimeoutSeconds) {
                throw [System.TimeoutException]::new($TimeoutMessage)
            }
            if ($result[0]) { return }
            if ($WaitingMessage) { Write-Verbose $WaitingMessage }
            $remaining = $TimeoutSeconds - $timer.Elapsed.TotalSeconds
            if ($remaining -le 0) { throw [System.TimeoutException]::new($TimeoutMessage) }
            $milliseconds = [Math]::Max(1, [Math]::Floor(1000 * [Math]::Min($PollIntervalSeconds, $remaining)))
            Start-Sleep -Milliseconds ([int]$milliseconds)
        }
    }
    finally { $timer.Stop() }
}
Function Wait-PAWServiceToRun {
    <#
    .SYNOPSIS
        Waits for a Windows service to reach the Running state inside a VM.

    .DESCRIPTION
        Uses PowerShell Direct to poll a service in the target VM until the service
        status becomes Running or a timeout is reached.

    .PARAMETER ServiceName
        Name of the Windows service to wait for.
        Default value is LanmanWorkstation.

    .PARAMETER VMname
        Name of the target virtual machine.

    .PARAMETER Credentials
        Credentials used for PowerShell Direct in the guest VM.

    .PARAMETER TimeoutSeconds
        Maximum number of seconds to wait before failing.
        Default is 300 seconds.

    .PARAMETER PollIntervalSeconds
        Number of seconds between each poll.
        Default is 5 seconds.

    .EXAMPLE
        Wait-PAWServiceToRun -VMname "PAW-01" -Credentials $Cred
        Waits until LanmanWorkstation is running in PAW-01.

    .EXAMPLE
        Wait-PAWServiceToRun -ServiceName "WinRM" -VMname "PAW-01" -Credentials $Cred -TimeoutSeconds 600
        Waits up to 10 minutes for WinRM to be running in PAW-01.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [cmdletbinding()]

    Param(
        [ValidateNotNullOrEmpty()]
        [string]
        $ServiceName = 'LanmanWorkstation',

        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]
        $VMname,

        [Parameter(Mandatory = $true)]
        [ValidateNotNull()]
        [System.Management.Automation.PSCredential]
        $Credentials,

        [ValidateRange(1, 86400)]
        [int]
        $TimeoutSeconds = 300,

        [ValidateRange(1, 3600)]
        [int]
        $PollIntervalSeconds = 5
    )

    Write-Verbose "Waiting for $ServiceName to start on $VMname"

    $deadline = (Get-Date).AddSeconds($TimeoutSeconds)

    Invoke-PAWPSDirect -VMName $VMname -Credential $Credentials -RetryCommand -ScriptBlock {
        Param(
            $ServiceName,
            $PollIntervalSeconds,
            $Deadline
        )

        do {
            Write-Verbose "Waiting for $ServiceName to start"

            $service = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
            if ($null -eq $service) {
                Write-Verbose "Service $ServiceName not found yet"
            }
            elseif ($service.Status -eq 'Running') {
                break
            }

            if ((Get-Date) -ge $Deadline) {
                throw "Timeout waiting for service '$ServiceName' to start."
            }

            Start-Sleep -Seconds $PollIntervalSeconds
        } while ($true)
    } -ArgumentList $ServiceName, $PollIntervalSeconds, $deadline

    Write-Verbose "$ServiceName is running on $VMname"
}
Function Wait-PAWVMCompleteOOBE {
    <#
    .SYNOPSIS
        Waits until a virtual machine completes the Windows out-of-box experience (OOBE).

    .DESCRIPTION
        Polls the virtual machine's Windows ImageState registry value every 10 seconds
        until it is IMAGE_STATE_COMPLETE or the timeout is reached. Temporary polling
        errors, such as those caused by a guest reboot, are ignored. Throws a terminating
        error if OOBE does not complete before the timeout.

    .PARAMETER VMname
        Name of the virtual machine whose OOBE completion is being checked.

    .PARAMETER Credentials
        Credentials used to authenticate the PowerShell Direct session.

    .PARAMETER TimeoutMinutes
        Maximum number of minutes to wait for OOBE to complete. Defaults to 20.

    .EXAMPLE
        Wait-PAWVMCompleteOOBE -VMname "PAW-01"
        Waits up to 20 minutes for PAW-01 to complete OOBE.

    .EXAMPLE
        Wait-PAWVMCompleteOOBE -VMname "PAW-01" -TimeoutMinutes 30
        Waits up to 30 minutes for PAW-01 to complete OOBE.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [cmdletbinding()]
    Param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]
        $VMname,

        [Parameter(Mandatory = $true)]
        [System.Management.Automation.PSCredential]
        $Credentials,

        [Parameter()]
        [ValidateRange(1, 1440)]
        [int]
        $TimeoutMinutes = 20
    )
    $state = @{ ImageState = $null }
    try {
        Wait-PAWCondition -TimeoutSeconds ($TimeoutMinutes * 60) -PollIntervalSeconds 10 -Test {
            $state.ImageState = $null
            try {
                $state.ImageState = Invoke-PAWPSDirect -VMName $VMName -Credential $Credentials -ScriptBlock {
                    (Get-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\State' -Name ImageState -ErrorAction SilentlyContinue).ImageState
                }
            }
            catch {
                # OOBE may reboot the guest while we poll.
                Write-Verbose "OOBE poll failed: $($_.Exception.Message)"
            }
            return [bool]($state.ImageState -eq 'IMAGE_STATE_COMPLETE')
        }
    }
    catch [System.TimeoutException] {
        throw "OOBE did not complete in $VMName within $TimeoutMinutes minutes (ImageState: $($state.ImageState))"
    }

    Write-Verbose "OOBE is now complete"
}
Function Wait-PAWVMDeployment {
   <#
    .SYNOPSIS
        Waits until VM deployment signals completion through Hyper-V KVP data.

    .DESCRIPTION
        Polls Test-PAWVMDeployment until the target VM exposes OSDeployment=Done
        in Key-Value Pair (KVP) data, or until timeout is reached.

    .PARAMETER VMname
        Name of the virtual machine to monitor.

    .PARAMETER TimeoutSeconds
        Maximum number of seconds to wait before failing.
        Default is 1800 seconds (30 minutes).

    .PARAMETER PollIntervalSeconds
        Number of seconds between checks.
        Default is 10 seconds.

    .EXAMPLE
        Wait-PAWVMDeployment -VMname "PAW-01"

        Waits for deployment completion on PAW-01.

    .EXAMPLE
        Wait-PAWVMDeployment -VMname "PAW-01" -TimeoutSeconds 3600 -PollIntervalSeconds 15

        Waits up to 1 hour, checking every 15 seconds.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
   [cmdletbinding()]
   Param(
      [Parameter(Mandatory = $true)]
      [ValidateNotNullOrEmpty()]
      [string]
      $VMName,

      [ValidateRange(1, 86400)]
      [int]
      $TimeoutSeconds = 1800,

      [ValidateRange(1, 3600)]
      [int]
      $PollIntervalSeconds = 10
   )
   #Check if VM exists
   if ((Test-PAWVMExists -VMname $VMName) -eq $false) {
      throw "Could not find $VMName"
   }

   Wait-PAWCondition -Test { Test-PAWVMDeployment -VMname $VMName } -TimeoutSeconds $TimeoutSeconds -PollIntervalSeconds $PollIntervalSeconds -WaitingMessage "Waiting for $VMName to write ""Done"" in the KVP registry" -TimeoutMessage "Timeout waiting for $VMName deployment marker OSDeployment=Done"
   Write-Verbose "$VMName has written done in the KVP Registry"
}
