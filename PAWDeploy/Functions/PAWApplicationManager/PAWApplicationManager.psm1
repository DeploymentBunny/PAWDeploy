<#
.SYNOPSIS
    Imports definitions and validated Classic/offline payloads with rollback.
.PARAMETER ExpectedType
    Restricts the package to an application-only or bundle package when specified.
.NOTES
    Version : 2.0.0.4
    Author  : The Fantastic PAWDeploy Team
#>
function Import-PAWApplicationPackage {
    [CmdletBinding(SupportsShouldProcess)]
    param([string]$Root = $script:PAWApplicationResourcesRoot,
        [Parameter(Mandatory, ValueFromPipelineByPropertyName)][Alias('FullName')][string]$Path, [switch]$Replace,
        [ValidateSet('Any', 'Application', 'Bundle')][string]$ExpectedType = 'Any')
    process {
        $document = Read-PAWManagerJson $Path
        if ($ExpectedType -eq 'Application' -and $null -ne $document.Bundle) { throw 'This package contains a bundle; use Import-PAWApplicationBundle.' }
        if ($ExpectedType -eq 'Bundle' -and $null -eq $document.Bundle) { throw 'This package does not contain a bundle; use Import-PAWApplication.' }
        if ($document.SchemaVersion -notin 1,2 -or $document.Applications -isnot [array]) { throw 'Invalid application package schema.' }
        $incoming = @($document.Applications | ForEach-Object { ConvertTo-PAWManagedApplication $_ })
        if (-not $incoming.Count -and $null -eq $document.Bundle) { throw 'Application package is empty.' }
        $payloads = @()
        if ($document.SchemaVersion -eq 2) {
            if ($document.Payloads -isnot [array]) { throw 'Package Payloads must be an array.' }
            $payloads = @($document.Payloads)
        }
        $payloadFiles = @(ConvertTo-PAWImportedPayload -Payloads $payloads -Applications $incoming -Root $Root)
        foreach ($payload in $payloads) {
            if ((Test-Path -LiteralPath (Join-Path $Root "Applications\Packages\$($payload.ApplicationId)")) -and -not $Replace) {
                throw "Application payload '$($payload.ApplicationId)' exists; use Replace."
            }
        }
        $existing = @(Get-PAWApplicationCatalog -Root $Root)
        $ids = @{}
        $names = @{}
        foreach ($app in $incoming) {
            if ($ids.ContainsKey($app.ApplicationId) -or $names.ContainsKey($app.Definition.Name)) { throw 'Application package has duplicate IDs or names.' }
            $ids[$app.ApplicationId] = $true
            $names[$app.Definition.Name] = $true
            $old = $existing | Where-Object ApplicationId -eq $app.ApplicationId
            if ($old -and -not $Replace) { throw "Application '$($app.ApplicationId)' exists; use Replace." }
            if ($old -and $old.Definition.Name -ne $app.Definition.Name) { throw "Existing application '$($app.ApplicationId)' cannot be renamed during import." }
        }
        $combined = @($existing | Where-Object { -not $ids.ContainsKey($_.ApplicationId) }) + $incoming
        if (@($combined | Group-Object { $_.Definition.Name } | Where-Object Count -gt 1).Count) { throw 'Import would create duplicate application names.' }
        if (@($combined | Group-Object { Get-PAWApplicationInstallFilePath -InstallRoot (Join-Path $Root 'Applications\InstallFiles') -Name $_.Definition.Name } | Where-Object Count -gt 1).Count) {
            throw 'Import would create duplicate application cache filenames.'
        }
        $writes = [ordered]@{}
        $legacyCatalogPaths = New-Object 'System.Collections.Generic.List[string]'
        foreach ($app in $incoming) {
            $catalogPath = Get-PAWApplicationCatalogPath -Root $Root -Application $app
            $writes[$catalogPath] = $app
            $existingApp = $existing | Where-Object ApplicationId -eq $app.ApplicationId
            if ($existingApp) {
                $existingPath = Get-PAWApplicationCatalogFilePath -Root $Root -Application $existingApp
                if ($existingPath -ne $catalogPath) { $legacyCatalogPaths.Add($existingPath) }
            }
        }
        if ($null -ne $document.Bundle) {
            $bundle = ConvertTo-PAWManagedBundle $document.Bundle $combined
            $bundlePath = Join-Path $Root "ApplicationBundles\$($bundle.BundleId).json"
            if ((Test-Path -LiteralPath $bundlePath) -and -not $Replace) { throw "Bundle '$($bundle.BundleId)' exists; use Replace." }
            Assert-PAWBundleNameAvailable -Root $Root -Bundle $bundle
            $writes[$bundlePath] = $bundle
        }
        if ($PSCmdlet.ShouldProcess($Root, "Import $($incoming.Count) application definitions and optional bundle")) {
            $originals = @{}
            $touched = New-Object 'System.Collections.Generic.List[string]'
            $swapped = New-Object 'System.Collections.Generic.List[string]'
            $scratch = Join-Path $Root ('.import-' + [guid]::NewGuid().ToString('N'))
            $retainRecovery = $false
            $bundleLock = $null
            try {
                if ($null -ne $document.Bundle) {
                    $bundleLock = Enter-PAWBundleWriteLock -Root $Root
                    if ((Test-Path -LiteralPath $bundlePath) -and -not $Replace) { throw "Bundle '$($bundle.BundleId)' exists; use Replace." }
                    $current = @(Get-PAWApplicationCatalog -Root $Root)
                    $combined = @($current | Where-Object { -not $ids.ContainsKey($_.ApplicationId) }) + $incoming
                    $bundle = ConvertTo-PAWManagedBundle $document.Bundle $combined
                    $writes[$bundlePath] = $bundle
                    Assert-PAWBundleNameAvailable -Root $Root -Bundle $bundle
                }
                foreach ($payload in $payloads) {
                    $stage = Join-Path $scratch "New\$($payload.ApplicationId)"
                    foreach ($file in @($payloadFiles | Where-Object ApplicationId -eq $payload.ApplicationId)) {
                        $target = Resolve-PAWApplicationPayloadPath -PackageRoot $stage -RelativePath $file.RelativePath
                        $null = New-Item -Path (Split-Path -Parent $target) -ItemType Directory -Force -ErrorAction Stop
                        [IO.File]::WriteAllBytes($target, $file.Bytes)
                    }
                    $destination = Join-Path $Root "Applications\Packages\$($payload.ApplicationId)"
                    if (Test-Path -LiteralPath $destination) {
                        $null = @(Get-PAWApplicationPayloadFiles $destination)
                        $old = Join-Path $scratch "Old\$($payload.ApplicationId)"
                        $null = New-Item -Path (Split-Path -Parent $old) -ItemType Directory -Force -ErrorAction Stop
                        Move-Item -LiteralPath $destination -Destination $old -ErrorAction Stop
                    }
                    $swapped.Add($payload.ApplicationId)
                    $null = New-Item -Path (Join-Path $Root 'Applications\Packages') -ItemType Directory -Force -ErrorAction Stop
                    Move-Item -LiteralPath $stage -Destination $destination -ErrorAction Stop
                }
                foreach ($target in (@($writes.Keys) + @($legacyCatalogPaths))) {
                    if (-not $originals.ContainsKey($target)) {
                        $originals[$target] = if (Test-Path -LiteralPath $target -PathType Leaf) { [IO.File]::ReadAllBytes($target) } else { $null }
                    }
                }
                foreach ($target in $writes.Keys) {
                    $touched.Add($target)
                    Write-PAWManagerJson $target $writes[$target]
                }
                foreach ($legacyPath in $legacyCatalogPaths) {
                    $touched.Add($legacyPath)
                    Remove-Item -LiteralPath $legacyPath -ErrorAction Stop
                }
            }
            catch {
                $failure = $_
                $rollbackErrors = New-Object 'System.Collections.Generic.List[string]'
                for ($index = $touched.Count - 1; $index -ge 0; $index--) {
                    $target = $touched[$index]
                    try {
                        if ($null -ne $originals[$target]) { [IO.File]::WriteAllBytes($target, $originals[$target]) }
                        elseif (Test-Path -LiteralPath $target -PathType Leaf) { Remove-Item -LiteralPath $target -ErrorAction Stop }
                    }
                    catch { $rollbackErrors.Add("'$target': $($_.Exception.Message)") }
                }
                foreach ($id in $swapped) {
                    try {
                        $target = Join-Path $Root "Applications\Packages\$id"
                        if (Test-Path -LiteralPath $target) { Remove-Item -LiteralPath $target -Recurse -Force -ErrorAction Stop }
                        $old = Join-Path $scratch "Old\$id"
                        if (Test-Path -LiteralPath $old) { Move-Item -LiteralPath $old -Destination $target -ErrorAction Stop }
                    }
                    catch { $rollbackErrors.Add("Payload '$id': $($_.Exception.Message)") }
                }
                if ($rollbackErrors.Count) {
                    $retainRecovery = $true
                    throw "Application import failed: $($failure.Exception.Message). Rollback also failed: $($rollbackErrors -join '; '). Recovery files retained at '$scratch'."
                }
                throw $failure
            }
            finally {
                if ($null -ne $bundleLock) { $bundleLock.Dispose() }
                if (-not $retainRecovery -and (Test-Path -LiteralPath $scratch)) { Remove-Item -LiteralPath $scratch -Recurse -Force -ErrorAction Stop }
            }
            Write-PAWApplicationManagerLog "Imported application package '$Path'."
            $incoming
        }
    }
}
function Import-PAWCachedApplication {
    <#
    .SYNOPSIS
        Restores a cache folder exported by Export-PAWCachedApplication.
    .DESCRIPTION
        Restores the entire folder, including manual files. Existing folders
        require Replace. Does not create application definitions or bundles.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess)]
    param(
        [Parameter(Mandatory, ValueFromPipelineByPropertyName)][Alias('FullName')][string]$Path,
        [string]$Root = $script:PAWApplicationResourcesRoot,
        [switch]$Replace
    )
    process {
        $file = Get-Item -LiteralPath $Path -Force -ErrorAction Stop
        if ($file.PSIsContainer -or $file.Extension -ne '.zip') { throw "Cache source must be a ZIP file: '$Path'." }
        Assert-PAWCachePath $file.FullName
        Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction Stop
        Add-Type -AssemblyName System.IO.Compression -ErrorAction Stop
        $zip = [IO.Compression.ZipFile]::OpenRead($file.FullName)
        try {
            $metadata = @($zip.Entries | Where-Object FullName -CEQ 'PAWCache.json')
            if ($metadata.Count -ne 1 -or $metadata[0].Length -gt 16384) { throw 'Cache ZIP must contain one small PAWCache.json manifest.' }
            $reader = New-Object IO.StreamReader($metadata[0].Open())
            try { $manifest = $reader.ReadToEnd() | ConvertFrom-Json -ErrorAction Stop }
            finally { $reader.Dispose() }
            if ($manifest.SchemaVersion -ne 1 -or $manifest.CacheType -notin 'WinGet', 'Local', 'Module', 'Package') {
                throw 'Invalid cache ZIP manifest.'
            }
            $name = [string]$manifest.FolderName
            if ([string]::IsNullOrWhiteSpace($name) -or $name -in '.', '..' -or
                $name -like '.staging-*' -or $name -match '[\\/]') {
                throw 'Invalid cache folder name.'
            }
            $parent = Get-PAWCacheLocation -Root $Root -Type $manifest.CacheType
            $target = Resolve-PAWApplicationPayloadPath -PackageRoot $parent -RelativePath $name
            Assert-PAWCachePath $target
            if ($file.FullName.StartsWith($target.TrimEnd('\') + '\', [StringComparison]::OrdinalIgnoreCase)) {
                throw 'Cache ZIP cannot be inside the folder it would replace.'
            }
            $names = @{}
            $records = New-Object 'System.Collections.Generic.List[object]'
            foreach ($entry in $zip.Entries) {
                if (($entry.ExternalAttributes -band 0xF0000000L) -eq 0xA0000000L -or
                    ($entry.ExternalAttributes -band [int][IO.FileAttributes]::ReparsePoint)) {
                    throw "Cache ZIP links are not supported: '$($entry.FullName)'."
                }
                if ($entry.FullName -ceq 'PAWCache.json') { continue }
                if (-not $entry.FullName.StartsWith('Files/', [StringComparison]::Ordinal)) { throw "Unexpected cache ZIP entry: '$($entry.FullName)'." }
                $relative = $entry.FullName.Substring(6).Replace('/', '\')
                $isDirectory = $relative.EndsWith('\')
                $relative = $relative.TrimEnd('\')
                if (-not $relative -or @($relative -split '\\' | Where-Object { $_ -in '.', '..' }).Count) {
                    throw "Invalid cache ZIP entry: '$($entry.FullName)'."
                }
                $resolved = Resolve-PAWApplicationPayloadPath -PackageRoot $target -RelativePath $relative
                if ($names.ContainsKey($resolved)) { throw "Duplicate cache ZIP entry: '$($entry.FullName)'." }
                $names[$resolved] = $isDirectory
                $records.Add([pscustomobject]@{ Entry = $entry; RelativePath = $relative; Path = $resolved; IsDirectory = $isDirectory })
            }
            if (-not @($records | Where-Object { -not $_.IsDirectory }).Count) { throw 'Cache ZIP contains no files.' }
            foreach ($record in $records) {
                $ancestor = Split-Path -Parent $record.Path
                while ($ancestor -and $ancestor -ne $target) {
                    if ($names.ContainsKey($ancestor) -and -not $names[$ancestor]) { throw "Cache ZIP file/directory conflict: '$ancestor'." }
                    $ancestor = Split-Path -Parent $ancestor
                }
            }
            if (Test-Path -LiteralPath $target) {
                $existing = Get-Item -LiteralPath $target -Force -ErrorAction Stop
                if (-not $existing.PSIsContainer) { throw "Cache destination is not a folder: '$target'." }
                $null = @(Get-PAWApplicationPayloadFiles -Root $target)
                if (-not $Replace) { throw "Cache folder exists; use -Replace: '$target'." }
            }
            if (-not $PSCmdlet.ShouldProcess($target, "Restore entire cache folder (Replace=$Replace)")) { return }
            Assert-PAWCachePath $target
            $null = New-Item -ItemType Directory -Path $parent -Force -ErrorAction Stop
            $stage = Join-Path $parent ('.staging-' + [guid]::NewGuid().ToString('N'))
            $backup = Join-Path $parent ('.backup-' + [guid]::NewGuid().ToString('N'))
            $backedUp = $false
            $published = $false
            try {
                $null = New-Item -ItemType Directory -Path $stage -ErrorAction Stop
                foreach ($record in $records) {
                    $destination = Resolve-PAWApplicationPayloadPath -PackageRoot $stage -RelativePath $record.RelativePath
                    if ($record.IsDirectory) { $null = New-Item -ItemType Directory -Path $destination -Force -ErrorAction Stop }
                    else {
                        $null = New-Item -ItemType Directory -Path (Split-Path -Parent $destination) -Force -ErrorAction Stop
                        [IO.Compression.ZipFileExtensions]::ExtractToFile($record.Entry, $destination, $false)
                    }
                }
                Assert-PAWCachePath $target
                if (Test-Path -LiteralPath $target) {
                    if (-not $Replace) { throw "Cache folder appeared at '$target'; replacement is not approved." }
                    $null = @(Get-PAWApplicationPayloadFiles -Root $target)
                    [IO.Directory]::Move($target, $backup)
                    $backedUp = $true
                }
                try { [IO.Directory]::Move($stage, $target); $published = $true }
                catch {
                    $failure = $_
                    if ($backedUp) {
                        try { [IO.Directory]::Move($backup, $target); $backedUp = $false }
                        catch { throw "Cache restore failed: $($failure.Exception.Message). Previous cache retained at '$backup': $($_.Exception.Message)" }
                    }
                    throw $failure
                }
                Get-Item -LiteralPath $target
            }
            finally {
                if (Test-Path -LiteralPath $stage) { Remove-Item -LiteralPath $stage -Recurse -Force -ErrorAction Stop }
                if ($published -and $backedUp) { Remove-Item -LiteralPath $backup -Recurse -Force -ErrorAction Stop }
            }
        }
        finally { $zip.Dispose() }
    }
}
function New-PAWApplicationBundle {
    <#
    .SYNOPSIS
        Creates an empty application bundle.
    .PARAMETER Name
        Unique bundle name.
    .PARAMETER Root
        Resources folder. Defaults to this module's installation.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
