Function ConvertTo-PAWAppInstallBoolean {
    <#
    .SYNOPSIS
        Converts a manifest value to boolean.

    .DESCRIPTION
        Supports true/false, 1/0, yes/no, enabled/disabled.

    .PARAMETER Value
        Value to convert. Null, blank, and unrecognized values use Default.

    .PARAMETER Default
        Boolean fallback when input is absent or cannot be interpreted. Defaults to $true.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [CmdletBinding()]
    [OutputType([bool])]
    Param(
        $Value,

        [bool]
        $Default = $true
    )

    if ($null -eq $Value -or [string]::IsNullOrWhiteSpace([string]$Value)) {
        return $Default
    }

    if ($Value -is [bool]) {
        return $Value
    }

    switch -Regex (([string]$Value).Trim().ToLowerInvariant()) {
        '^(true|1|yes|enabled)$' { return $true }
        '^(false|0|no|disabled)$' { return $false }
        default { throw "Invalid boolean value '$Value'. Use true or false." }
    }
}
Function ConvertTo-PAWAppInstallStringArray {
    <#
    .SYNOPSIS
        Normalizes manifest values into a string array.

    .DESCRIPTION
        Handles null, scalar strings, arrays, and enumerable values.

    .PARAMETER Value
        Value to normalize.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [CmdletBinding()]
    [OutputType([string[]])]
    Param(
        $Value
    )

    if ($null -eq $Value) {
        return @()
    }

    if ($Value -is [System.Array]) {
        return @($Value | Where-Object { $null -ne $_ -and -not [string]::IsNullOrWhiteSpace([string]$_) } | ForEach-Object { [string]$_ })
    }

    if ($Value -is [System.Collections.IEnumerable] -and $Value -isnot [string]) {
        return @($Value | Where-Object { $null -ne $_ -and -not [string]::IsNullOrWhiteSpace([string]$_) } | ForEach-Object { [string]$_ })
    }

    if ([string]::IsNullOrWhiteSpace([string]$Value)) {
        return @()
    }

    return @([string]$Value)
}
<#

.SYNOPSIS
    Validates one application from Applications.json and returns it normalized.

.DESCRIPTION
    Validates one application against the Applications.json standard and
    returns an object with exactly Name, Source, Id,
    InstallEnabled, Architecture, Scope and InstallerType, in that order.
    Values are returned in their standard casing (Machine, x64, wix, NA) and
    InstallEnabled is returned as a boolean.
    Schema 2 catalog definitions delegate to the type-specific validator.
    Frozen runtime definitions may additionally contain ApplicationId and Options;
    Classic and WindowsComponent runtime sources require these typed options.

    The rules (see Get-PAWApplicationDefinitions):

      - Every property is required and may not be empty; use NA when a value
        is not needed. Other properties are not allowed.
      - Source is WinGet, PSGallery or Local.
      - InstallEnabled is true or false.
      - Architecture is x86, x64, arm64 or NA; Scope is Machine, User or NA;
        InstallerType is msi, wix, msix, appx, exe, burn, inno, nullsoft, zip,
        portable or NA.
      - WinGet needs the WinGet package identifier as Id.
      - PSGallery needs the module name as Id, and NA for Architecture, Scope
        and InstallerType.
      - Local needs NA as Id and an InstallerType.

    Shared by Get-PAWApplicationDefinitions and
    Invoke-PAWApplicationSettings.ps1, so that the file and the editor use the
    same rules. Uniqueness of names is checked by the caller.

.PARAMETER Application
    The application, as an object (from ConvertFrom-Json) or a dictionary.

.PARAMETER Index
    Position of the application in the list, used in error messages when the
    application has no name.

.PARAMETER Context
    Text added after the application in error messages, for example
    "in 'C:\PAWFiles\AppInstall\Applications.json'".

.EXAMPLE
    ConvertTo-PAWApplicationDefinition -Application @{ Name = '7-Zip'; Source = 'winget'; Id = '7zip.7zip'; InstallEnabled = $true; Architecture = 'X64'; Scope = 'machine'; InstallerType = 'na' }

    Returns 7-Zip with Source WinGet, Architecture x64, Scope Machine and InstallerType NA.

.NOTES
    Version : 2.0.0.4
    Author  : The Fantastic PAWDeploy Team

#>
function ConvertTo-PAWApplicationDefinition {
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory = $true)]
        [AllowNull()]
        [object]$Application,

        [Parameter(Mandatory = $false)]
        [int]$Index = 0,

        [Parameter(Mandatory = $false)]
        [AllowEmptyString()]
        [string]$Context = ''
    )

    if ($Application -is [System.Collections.IDictionary]) {
        $Application = $Application | ConvertTo-Json -Depth 20 | ConvertFrom-Json
    }
    if ($null -ne $Application -and $null -ne $Application.PSObject.Properties['Type']) {
        return (ConvertTo-PAWTypedApplicationDefinition -Definition $Application)
    }
    $runtimeOptions = $null
    $runtimeId = $null
    if ($null -ne $Application -and $null -ne $Application.PSObject.Properties['Options']) {
        $runtimeOptions = $Application.Options
        $runtimeId = [string]$Application.ApplicationId
        $guid = [guid]::Empty
        if (-not [guid]::TryParseExact($runtimeId, 'D', [ref]$guid) -or $guid -eq [guid]::Empty) { throw 'Runtime ApplicationId must be a non-empty GUID.' }
        $type = switch ($Application.Source) {
            'WinGet' { 'WinGet' }
            'PSGallery' { 'PowerShellModule' }
            'Classic' { 'Classic' }
            'WindowsComponent' { 'WindowsComponent' }
            default { throw "Unsupported typed runtime Source '$($Application.Source)'." }
        }
        $null = ConvertTo-PAWTypedApplicationDefinition -Definition @{
            Name = $Application.Name; Type = $type; InstallEnabled = $Application.InstallEnabled; Configuration = $runtimeOptions
        }
        if ($type -in 'WinGet','PowerShellModule' -and $Application.Id -ne $runtimeOptions.Id) { throw 'Runtime Id does not match Configuration.' }
        $Application = $Application.PSObject.Copy()
        $Application.PSObject.Properties.Remove('Options')
        $Application.PSObject.Properties.Remove('ApplicationId')
    }
    $propertyNames = @('Name', 'Source', 'Id', 'InstallEnabled', 'Architecture', 'Scope', 'InstallerType')
    $allowedValues = [ordered]@{
        Source        = @('WinGet', 'PSGallery', 'Local', 'Classic', 'WindowsComponent')
        Architecture  = @('x86', 'x64', 'arm64', 'NA')
        Scope         = @('Machine', 'User', 'NA')
        InstallerType = @('msi', 'wix', 'msix', 'appx', 'exe', 'burn', 'inno', 'nullsoft', 'zip', 'portable', 'NA')
    }

    $present = [ordered]@{}
    if ($Application -is [System.Collections.IDictionary]) {
        foreach ($key in $Application.Keys) {
            $present[[string]$key] = $Application[$key]
        }
    }
    elseif ($null -ne $Application) {
        foreach ($property in $Application.PSObject.Properties) {
            $present[$property.Name] = $property.Value
        }
    }

    $name = ([string]$present['Name']).Trim()
    $label = if ([string]::IsNullOrWhiteSpace($name)) { "Application #$Index" } else { "Application '$name'" }
    if (-not [string]::IsNullOrWhiteSpace($Context)) {
        $label = "$label $Context"
    }

    $presentNames = @($present.Keys)
    $missing = @($propertyNames | Where-Object { $presentNames -notcontains $_ })
    if ($missing.Count -gt 0) {
        throw "$label is missing: $($missing -join ', '). Every application must have $($propertyNames -join ', '). Use NA when a value is not needed."
    }
    $unknown = @($presentNames | Where-Object { $propertyNames -notcontains $_ })
    if ($unknown.Count -gt 0) {
        throw "$label has unknown properties: $($unknown -join ', '). Application definitions may only contain $($propertyNames -join ', '). Manage install settings separately in catalog Settings using Application Manager."
    }

    $values = @{}
    foreach ($propertyName in $propertyNames) {
        $value = $present[$propertyName]
        if ($value -is [bool]) {
            $values[$propertyName] = $value
            continue
        }
        $text = ([string]$value).Trim()
        if ([string]::IsNullOrWhiteSpace($text)) {
            throw "$label has an empty $propertyName. Use NA when a value is not needed."
        }
        $values[$propertyName] = $text
    }

    foreach ($propertyName in $allowedValues.Keys) {
        $match = $allowedValues[$propertyName] | Where-Object { $_ -eq $values[$propertyName] } | Select-Object -First 1
        if ($null -eq $match) {
            throw "$label has an invalid $propertyName '$($values[$propertyName])'. Valid values: $($allowedValues[$propertyName] -join ', ')."
        }
        $values[$propertyName] = $match
    }

    foreach ($propertyName in 'InstallEnabled') {
        $value = $values[$propertyName]
        if ($value -isnot [bool]) {
            if ($value -eq 'true') { $value = $true }
            elseif ($value -eq 'false') { $value = $false }
            else { throw "$label has an invalid $propertyName '$value'. Valid values: true, false." }
        }
        $values[$propertyName] = $value
    }

    $id = $values['Id']
    # Normalize na/Na to NA.
    if ($id -eq 'NA') { $id = 'NA' }
    switch ($values['Source']) {
        { $_ -in 'Classic','WindowsComponent' } {
            if ($null -eq $runtimeOptions) { throw "$label requires typed Configuration and ApplicationId." }
        }
        'PSGallery' {
            if ($id -eq 'NA') { throw "$label needs the PSGallery module name as Id." }
            foreach ($propertyName in 'Architecture', 'Scope', 'InstallerType') {
                if ($values[$propertyName] -ne 'NA') {
                    throw "$label`: $propertyName must be NA for a PSGallery module."
                }
            }
        }
        'WinGet' {
            if ($id -eq 'NA') { throw "$label needs the WinGet package identifier as Id (find it with 'winget search')." }
        }
        'Local' {
            if ($id -ne 'NA') { throw "$label`: Id must be NA for a Local application." }
            if ($values['InstallerType'] -eq 'NA') {
                throw "$label`: a Local application must set InstallerType (msi, wix, msix, appx, exe, burn, inno, nullsoft, zip or portable)."
            }
        }
    }

    $result = [PSCustomObject]@{
        Name            = $name
        Source          = $values['Source']
        Id              = $id
        InstallEnabled  = $values['InstallEnabled']
        Architecture    = $values['Architecture']
        Scope           = $values['Scope']
        InstallerType   = $values['InstallerType']
    }
    if ($null -ne $runtimeOptions) {
        $result | Add-Member -NotePropertyName ApplicationId -NotePropertyValue $runtimeId
        $result | Add-Member -NotePropertyName Options -NotePropertyValue $runtimeOptions
    }
    $result
}
<#
.SYNOPSIS
    Projects a catalog application into a frozen guest/runtime definition.
.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team
#>
function ConvertTo-PAWApplicationRuntimeDefinition {
    [CmdletBinding()]
    param([Parameter(Mandatory)][object]$Application)
    if ($Application.SchemaVersion -eq 1) { return (ConvertTo-PAWApplicationDefinition -Application $Application.Definition) }
    $definition = ConvertTo-PAWTypedApplicationDefinition -Definition $Application.Definition
    $config = $definition.Configuration
    $source = switch ($definition.Type) {
        'WinGet' { 'WinGet' }
        'PowerShellModule' { 'PSGallery' }
        default { $definition.Type }
    }
    $result = [ordered]@{
        Name = $definition.Name; Source = $source; Id = 'NA'; InstallEnabled = $definition.InstallEnabled
        Architecture = 'NA'; Scope = 'NA'; InstallerType = 'NA'
        ApplicationId = $Application.ApplicationId; Options = $config
    }
    if ($source -in 'WinGet','PSGallery') { $result.Id = $config.Id }
    if ($source -eq 'WinGet') {
        foreach ($key in 'Architecture','Scope','InstallerType') { $result[$key] = $config.$key }
    }
    [pscustomobject]$result
}
