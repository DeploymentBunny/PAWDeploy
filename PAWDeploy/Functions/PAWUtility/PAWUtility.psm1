Function Wait-PAWVMHavePSDirect {
    <#
    .SYNOPSIS
        Waits until PowerShell Direct is available in a virtual machine.

    .DESCRIPTION
        Polls Test-PAWVMHavePSDirect at regular intervals until a PowerShell Direct
        session can be established in the specified VM, or the timeout is reached.
        Throws a terminating error if the VM does not exist or the timeout expires.

    .PARAMETER VMname
        Name of the virtual machine to wait for.

    .PARAMETER Credentials
        Credentials used to authenticate the PowerShell Direct session.

    .PARAMETER TimeoutSeconds
        Maximum number of seconds to wait. Defaults to 300 (5 minutes).

    .PARAMETER PollIntervalSeconds
        Seconds to wait between polls. Defaults to 10.

    .EXAMPLE
        Wait-PAWVMHavePSDirect -VMname "PAW-01" -Credentials $cred
        Waits up to 5 minutes for PowerShell Direct to become available in PAW-01.

    .EXAMPLE
        Wait-PAWVMHavePSDirect -VMname "PAW-01" -Credentials $cred -TimeoutSeconds 600
        Waits up to 10 minutes for PowerShell Direct to become available.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [cmdletbinding()]
    Param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]
        $VMname,

        [Parameter(Mandatory = $true)]
        [System.Management.Automation.PSCredential]
        $Credentials,

        [Parameter()]
        [ValidateRange(1, 86400)]
        [int]
        $TimeoutSeconds = 300,

        [Parameter()]
        [ValidateRange(1, 3600)]
        [int]
        $PollIntervalSeconds = 10
    )

    if ((Test-PAWVMExists -VMname $VMname) -eq $false) {
        throw "Could not find VM '$VMname'."
    }

    Wait-PAWCondition -Test { Test-PAWVMHavePSDirect -VMname $VMname -Credentials $Credentials } -TimeoutSeconds $TimeoutSeconds -PollIntervalSeconds $PollIntervalSeconds -WaitingMessage "Waiting for '$VMname' to have PowerShell Direct available..." -TimeoutMessage "Timed out after $TimeoutSeconds seconds waiting for PowerShell Direct to become available in '$VMname'."

    Write-Verbose "'$VMname' has PowerShell Direct available."
}
Function Wait-PAWVMIsRunning {
    <#
    .SYNOPSIS
        Waits until a virtual machine is in the Running state.

    .DESCRIPTION
        Polls Test-PAWVMIsRunning at regular intervals until the specified VM reaches
        the Running state, or the timeout is reached. Throws a terminating error if
        the VM does not exist or the timeout expires.

    .PARAMETER VMname
        Name of the virtual machine to wait for.

    .PARAMETER TimeoutSeconds
        Maximum number of seconds to wait. Defaults to 300 (5 minutes).

    .PARAMETER PollIntervalSeconds
        Seconds to wait between polls. Defaults to 5.

    .EXAMPLE
        Wait-PAWVMIsRunning -VMname "PAW-01"
        Waits up to 5 minutes for PAW-01 to reach the Running state.

    .EXAMPLE
        Wait-PAWVMIsRunning -VMname "PAW-01" -TimeoutSeconds 120
        Waits up to 2 minutes for PAW-01 to reach the Running state.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [cmdletbinding()]
    Param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]
        $VMname,

        [Parameter()]
        [ValidateRange(1, 86400)]
        [int]
        $TimeoutSeconds = 300,

        [Parameter()]
        [ValidateRange(1, 3600)]
        [int]
        $PollIntervalSeconds = 5
    )

    if ((Test-PAWVMExists -VMname $VMname) -eq $false) {
        throw "Could not find VM '$VMname'."
    }

    Wait-PAWCondition -Test { Test-PAWVMIsRunning -VMname $VMname } -TimeoutSeconds $TimeoutSeconds -PollIntervalSeconds $PollIntervalSeconds -WaitingMessage "Waiting for '$VMname' to be Running..." -TimeoutMessage "Timed out after $TimeoutSeconds seconds waiting for '$VMname' to reach the Running state."

    Write-Verbose "'$VMname' is Running."
}
Function Wait-PAWVMStart {
    <#
    .SYNOPSIS
        Starts a virtual machine and waits until it is fully ready.

    .DESCRIPTION
        Starts the specified Hyper-V VM and then waits, in order, for the VM to reach
        Running state, for integration components to become healthy, for a usable IP
        address to be assigned, and for PowerShell Direct to become available.

    .PARAMETER VMname
        Name of the virtual machine to start.

    .PARAMETER Credentials
        Credentials used to authenticate the PowerShell Direct readiness check.

    .EXAMPLE
        Wait-PAWVMStart -VMname "PAW-01" -Credentials $cred
        Starts PAW-01 and waits until it is fully ready for management.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [CmdletBinding()]
    Param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]
        $VMname,

        [Parameter(Mandatory = $true)]
        [System.Management.Automation.PSCredential]
        $Credentials
    )

    if ((Test-PAWVMExists -VMname $VMname) -eq $false) {
        throw "Could not find VM '$VMname'."
    }

    Start-VM -Name $VMname
    Wait-PAWVMIsRunning -VMname $VMname
    Wait-PAWVMHaveICLoaded -VMname $VMname
    Wait-PAWVMHaveIP -VMname $VMname
    Wait-PAWVMHavePSDirect -VMname $VMname -Credentials $Credentials
}
function Write-PAWConsoleLog {
    <#

    .SYNOPSIS
        Writes a timestamped, colorized log message to the console.

    .DESCRIPTION
        Writes timestamped, colorized messages to the console.

    .PARAMETER Message
        The message to write.

    .PARAMETER Type
        The type of log message. Determines the color. Defaults to 'Info'. Accepted values: Info, Wait, Change, Success, Warning, Error, Verbose.

    .PARAMETER Value
        Optional string values inserted at matching numbered placeholders, such as {0} and {1}. A single value is appended when no placeholder is present.

    .PARAMETER NoNewline
        Do not append a newline after the message.

    .EXAMPLE
        Write-PAWConsoleLog -Message "Creating OU structure" -Type Change

    .EXAMPLE
        Write-PAWConsoleLog -Message "Created file: {0}" -Value 'C:\Logs\output.txt' -Type Success

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [CmdletBinding()]
    param (
        [Parameter(Mandatory, Position = 0, ValueFromPipeline)]
        [AllowEmptyString()]
        [string]$Message,

        [Parameter(Position = 1)]
        [ValidateSet('Info', 'Wait', 'Change', 'Success', 'Warning', 'Error', 'Verbose')]
        [string]$Type = 'Info',

        [Parameter(Position = 2)]
        [AllowEmptyString()]
        [string[]]$Value,

        [switch]$NoNewline
    )

    begin {
        $colorMap = @{
            Info    = 'Gray'
            Wait    = 'Magenta'
            Change  = 'Cyan'
            Success = 'Green'
            Warning = 'DarkYellow'
            Error   = 'Red'
            Verbose = 'DarkGray'
        }
        $valueColorMap = @{
            Info    = 'Yellow'
            Wait    = 'Yellow'
            Change  = 'Yellow'
            Success = 'Yellow'
            Warning = 'Yellow'
            Error   = 'Yellow'
            Verbose = 'Yellow'
        }
    }

    process {
        $timestamp = Get-Date -Format 'HH:mm:ss'
        Write-Host "[$timestamp] " -NoNewline -ForegroundColor DarkGray
        if ($PSBoundParameters.ContainsKey('Value')) {
            $placeholderMatches = [System.Text.RegularExpressions.Regex]::Matches($Message, '\{(\d+)\}')
            if ($placeholderMatches.Count -gt 0) {
                $messageIndex = 0
                foreach ($match in $placeholderMatches) {
                    if ($match.Index -gt $messageIndex) {
                        Write-Host $Message.Substring($messageIndex, $match.Index - $messageIndex) -NoNewline -ForegroundColor $colorMap[$Type]
                    }

                    $valueIndex = [int]$match.Groups[1].Value
                    if ($valueIndex -lt $Value.Count) {
                        Write-Host $Value[$valueIndex] -NoNewline -ForegroundColor $valueColorMap[$Type]
                    }
                    else {
                        Write-Host $match.Value -NoNewline -ForegroundColor $colorMap[$Type]
                    }
                    $messageIndex = $match.Index + $match.Length
                }
                Write-Host $Message.Substring($messageIndex) -ForegroundColor $colorMap[$Type] -NoNewline:$NoNewline
            }
            else {
                if ($Value.Count -gt 1) {
                    throw 'Message must contain numbered placeholders when multiple values are provided.'
                }
                Write-Host "$Message " -NoNewline -ForegroundColor $colorMap[$Type]
                Write-Host $Value[0] -ForegroundColor $valueColorMap[$Type] -NoNewline:$NoNewline
            }
        }
        else {
            Write-Host $Message -ForegroundColor $colorMap[$Type] -NoNewline:$NoNewline
        }
    }
}
<#

.SYNOPSIS
    Writes a timestamped log entry to the selected log file or configured location.

.DESCRIPTION
    Writes a timestamped log entry to the selected log file or configured location.

.PARAMETER Message
    Log message text.

.PARAMETER Level
    Text label identifying the log severity. Defaults to 'INFO'.

.PARAMETER Exception
    Optional exception whose details are included in the log.

.PARAMETER LogPath
    Optional destination path for the log file.

.PARAMETER OutputMode
    None (default) writes only to file. Console uses colored host output;
    Warning and Verbose retain their corresponding PowerShell streams.

.PARAMETER ConsoleType
    Color category for Console output, independent of the file severity.

.PARAMETER ConsoleMessage
    Optional console text when it differs from the file message.

.PARAMETER Value
    Values for numbered placeholders in Console output, passed to Write-PAWConsoleLog.

.PARAMETER NoNewline
    Suppresses the newline for Console output.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Write-PAWLog {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Message,
        [string]$Level = 'INFO',
        [System.Exception]$Exception = $null,
        [string]$LogPath,
        [ValidateSet('None', 'Console', 'Warning', 'Verbose')]
        [string]$OutputMode = 'None',
        [ValidateSet('Info', 'Wait', 'Change', 'Success', 'Warning', 'Error', 'Verbose', 'Warn')]
        [string]$ConsoleType = 'Info',
        [string]$ConsoleMessage,
        [string[]]$Value,
        [switch]$NoNewline
    )

    if ([string]::IsNullOrWhiteSpace($LogPath)) {
        $scriptLogPathVar = Get-Variable -Name 'LogPath' -Scope Script -ErrorAction SilentlyContinue
        if ($null -ne $scriptLogPathVar -and -not [string]::IsNullOrWhiteSpace([string]$scriptLogPathVar.Value)) {
            $LogPath = [string]$scriptLogPathVar.Value
        }
        else {
            throw 'LogPath is required when script:LogPath is not set.'
        }
    }

    $logDirectory = Split-Path -Path $LogPath -Parent
    if (-not [string]::IsNullOrWhiteSpace($logDirectory) -and -not (Test-Path -Path $logDirectory)) {
        New-Item -Path $logDirectory -ItemType Directory -Force | Out-Null
    }

    $timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss.fff'
    $line = "[$timestamp] [$Level] $Message"

    if (-not $PSBoundParameters.ContainsKey('ConsoleMessage')) {
        $ConsoleMessage = $Message
    }
    switch ($OutputMode) {
        'Console' {
            $consoleParameters = @{ Message = $ConsoleMessage; Type = $ConsoleType; NoNewline = $NoNewline }
            if ($ConsoleType -eq 'Warn') { $consoleParameters.Type = 'Warning' }
            if ($PSBoundParameters.ContainsKey('Value')) { $consoleParameters.Value = $Value }
            Write-PAWConsoleLog @consoleParameters
        }
        'Warning' { Write-Warning $ConsoleMessage }
        'Verbose' { Write-Verbose $ConsoleMessage }
    }

    try {
        Add-Content -LiteralPath $LogPath -Value $line -Encoding UTF8 -ErrorAction Stop

        if ($null -ne $Exception) {
            Add-Content -LiteralPath $LogPath -Value ("[$timestamp] [ERROR] ExceptionType: " + $Exception.GetType().FullName) -Encoding UTF8 -ErrorAction Stop
            Add-Content -LiteralPath $LogPath -Value ("[$timestamp] [ERROR] ExceptionMessage: " + $Exception.Message) -Encoding UTF8 -ErrorAction Stop
            if (-not [string]::IsNullOrWhiteSpace($Exception.StackTrace)) {
                Add-Content -LiteralPath $LogPath -Value ("[$timestamp] [ERROR] ExceptionStack:`r`n" + $Exception.StackTrace) -Encoding UTF8 -ErrorAction Stop
            }
        }
    }
    catch [System.IO.IOException] {
        Write-Warning "Unable to write log '$LogPath': $($_.Exception.Message)"
    }
    catch {
        Write-Warning "Unable to write log '$LogPath': $($_.Exception.Message)"
    }
}

<#
.SYNOPSIS
    Shared baseline import validation helper.
.NOTES
    Version : 2.0.0.3
    Author  : The Fantastic PAWDeploy Team
#>
function Assert-PAWBaselineDestination {
    param([string]$Path, [switch]$AllowContent, [switch]$Replace, [switch]$DirectoriesOnly)
    $current = $Path
    while (-not [string]::IsNullOrEmpty($current)) {
        if (Test-Path -LiteralPath $current -ErrorAction Stop) {
            $item = Get-Item -LiteralPath $current -Force -ErrorAction Stop
            if (-not $item.PSIsContainer -or
                ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
                throw "Baseline destination must be a directory without reparse points: '$current'."
            }
        }
        $current = Split-Path -Parent $current
    }
    if (-not $DirectoriesOnly -and (Test-Path -LiteralPath $Path -ErrorAction Stop)) {
        $pending = New-Object 'System.Collections.Generic.Stack[string]'
        $pending.Push($Path)
        while ($pending.Count) {
            foreach ($child in Get-ChildItem -LiteralPath $pending.Pop() -Force -ErrorAction Stop) {
                if ($child.Attributes -band [IO.FileAttributes]::ReparsePoint) {
                    throw "Baseline destination contains a reparse point: '$($child.FullName)'."
                }
                if ($child.PSIsContainer) { $pending.Push($child.FullName) }
            }
        }
        $content = @(Get-ChildItem -LiteralPath $Path -Force -ErrorAction Stop |
            Where-Object { $_.PSIsContainer -or $_.Name -ne '.gitkeep' })
        if ($content.Count -gt 0 -and -not $Replace -and -not $AllowContent) {
            throw "Baseline destination '$Path' contains content. Use -Replace to explicitly approve replacement."
        }
    }
}
<#
.SYNOPSIS
    Shared baseline import validation helper.
.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team
#>
function Assert-PAWBaselineDirectoryName {
    param([string]$Name)
    if ([string]::IsNullOrWhiteSpace($Name) -or
        $Name.IndexOfAny([IO.Path]::GetInvalidFileNameChars()) -ge 0 -or
        $Name -in @('.', '..') -or $Name -match '[. ]$' -or
        $Name -match '^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\.|$)') {
        throw "Invalid directory or ZIP path component: '$Name'."
    }
}
<#

.SYNOPSIS
    Converts an object to JSON indented with two spaces.

.DESCRIPTION
    Windows PowerShell 5.1 ConvertTo-Json output is hard to read and edit. This
    writes JSON with two-space indentation, one property per line, and arrays of
    simple values on one line. Supports hashtables (ordered or not),
    PSCustomObject, arrays, strings, numbers, booleans and null.

.PARAMETER InputObject
    Object to convert.

.PARAMETER Depth
    Current indentation level. Used when called recursively.

.EXAMPLE
    ConvertTo-PAWIndentedJson -InputObject ([ordered]@{ Name = '7-Zip'; Codes = @(0, 3010) })

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function ConvertTo-PAWIndentedJson {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory = $true)]
        [AllowNull()]
        $InputObject,

        [int]$Depth = 0
    )

    $isScalar = {
        param($Value)
        ($null -eq $Value) -or ($Value -is [string]) -or ($Value -is [char]) -or ($Value -is [bool]) -or ($Value -is [ValueType])
    }

    if ($null -eq $InputObject) {
        return 'null'
    }
    if ($InputObject -is [bool]) {
        return $(if ($InputObject) { 'true' } else { 'false' })
    }
    if ($InputObject -is [string] -or $InputObject -is [char] -or $InputObject -is [enum] -or $InputObject -is [datetime] -or $InputObject -is [guid]) {
        $builder = New-Object System.Text.StringBuilder
        [void]$builder.Append('"')
        foreach ($character in ([string]$InputObject).ToCharArray()) {
            switch ($character) {
                '"' { [void]$builder.Append('\"') }
                '\' { [void]$builder.Append('\\') }
                "`n" { [void]$builder.Append('\n') }
                "`r" { [void]$builder.Append('\r') }
                "`t" { [void]$builder.Append('\t') }
                default {
                    if ([int]$character -lt 32) {
                        [void]$builder.AppendFormat('\u{0:x4}', [int]$character)
                    }
                    else {
                        [void]$builder.Append($character)
                    }
                }
            }
        }
        [void]$builder.Append('"')
        return $builder.ToString()
    }
    if ($InputObject -is [ValueType]) {
        return ([System.IFormattable]$InputObject).ToString($null, [System.Globalization.CultureInfo]::InvariantCulture)
    }

    $indent = '  ' * $Depth
    $innerIndent = '  ' * ($Depth + 1)

    $properties = $null
    if ($InputObject -is [System.Collections.IDictionary]) {
        $properties = @($InputObject.Keys | ForEach-Object { [PSCustomObject]@{ Name = [string]$_; Value = $InputObject[$_] } })
    }
    elseif ($InputObject -is [System.Management.Automation.PSCustomObject]) {
        $properties = @($InputObject.PSObject.Properties | ForEach-Object { [PSCustomObject]@{ Name = $_.Name; Value = $_.Value } })
    }

    if ($null -ne $properties) {
        if ($properties.Count -eq 0) {
            return '{}'
        }
        $lines = foreach ($property in $properties) {
            '{0}{1}: {2}' -f $innerIndent, (ConvertTo-PAWIndentedJson -InputObject $property.Name), (ConvertTo-PAWIndentedJson -InputObject $property.Value -Depth ($Depth + 1))
        }
        return "{`r`n" + ($lines -join ",`r`n") + "`r`n$indent}"
    }

    if ($InputObject -is [System.Collections.IEnumerable]) {
        $items = @($InputObject)
        if ($items.Count -eq 0) {
            return '[]'
        }
        $allScalar = $true
        foreach ($item in $items) {
            if (-not (& $isScalar $item)) { $allScalar = $false; break }
        }
        if ($allScalar) {
            return '[ ' + (($items | ForEach-Object { ConvertTo-PAWIndentedJson -InputObject $_ }) -join ', ') + ' ]'
        }
        $lines = foreach ($item in $items) {
            $innerIndent + (ConvertTo-PAWIndentedJson -InputObject $item -Depth ($Depth + 1))
        }
        return "[`r`n" + ($lines -join ",`r`n") + "`r`n$indent]"
    }

    ConvertTo-PAWIndentedJson -InputObject ([string]$InputObject)
}
<#

.SYNOPSIS
    Converts a name to a valid file or folder name.

.DESCRIPTION
    Replaces characters that are not valid in a file name with an underscore and
    trims trailing dots and spaces. Throws if nothing is left.

.PARAMETER Name
    Name to convert, for example an application name from Applications.json.

.EXAMPLE
    ConvertTo-PAWSafeFileName -Name 'Notepad++'

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function ConvertTo-PAWSafeFileName {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory = $true)]
        [AllowEmptyString()]
        [string]$Name
    )

    $safeName = $Name
    foreach ($invalidChar in [System.IO.Path]::GetInvalidFileNameChars()) {
        $safeName = $safeName.Replace([string]$invalidChar, '_')
    }
    $safeName = $safeName.Trim().TrimEnd('.').Trim()
    if ([string]::IsNullOrWhiteSpace($safeName)) {
        throw "Application name '$Name' cannot be used as a file or folder name."
    }

    $safeName
}
<#
.SYNOPSIS
    Shared baseline import validation helper.
.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team
#>
function Get-PAWBaselineArchiveEntries {
    param([IO.Compression.ZipArchive]$Archive)
    $entries = New-Object 'System.Collections.Generic.List[object]'
    $names = @{}
    foreach ($entry in $Archive.Entries) {
        $name = $entry.FullName.Replace('/', '\')
        $parts = @($name.TrimEnd('\') -split '\\')
        if ([IO.Path]::IsPathRooted($name) -or $parts.Count -eq 0) {
            throw "Unsafe ZIP entry: '$($entry.FullName)'."
        }
        foreach ($part in $parts) { Assert-PAWBaselineDirectoryName -Name $part }
        if (($entry.ExternalAttributes -band 0xF0000000L) -eq 0xA0000000L -or
            ($entry.ExternalAttributes -band [int][IO.FileAttributes]::ReparsePoint)) {
            throw "ZIP links are not supported: '$($entry.FullName)'."
        }
        $normalized = $name.TrimEnd('\')
        if ($names.ContainsKey($normalized)) { throw "Duplicate ZIP entry: '$($entry.FullName)'." }
        $isDirectory = $name.EndsWith('\')
        $names[$normalized] = $isDirectory
        $entries.Add([pscustomobject]@{ Entry = $entry; Name = $normalized; IsDirectory = $isDirectory })
    }
    foreach ($record in $entries) {
        $parent = Split-Path -Parent $record.Name
        while ($parent) {
            if ($names.ContainsKey($parent) -and -not $names[$parent]) {
                throw "ZIP file/directory conflict: '$parent'."
            }
            $parent = Split-Path -Parent $parent
        }
    }
    return ,$entries
}
function Get-PAWImportSource {
    <#
    .SYNOPSIS
        Resolves a pipeline file object or path string for batch imports.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    param([object]$InputObject)
    if ($InputObject -is [string]) { return $InputObject }
    if ($null -ne $InputObject -and $null -ne $InputObject.PSObject.Properties['FullName']) {
        return [string]$InputObject.FullName
    }
    throw 'Each pipeline input must be a file path or a file object with FullName.'
}
function Get-PAWInventoryFolder {
    <#
    .SYNOPSIS
        Resolves a configured inventory folder relative to Config.json.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    param([string]$Root, [string[]]$Names)

    $configPath = Join-Path $Root 'Config\Config.json'
    $config = Get-Content -LiteralPath $configPath -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
    foreach ($name in $Names) {
        $value = [string]$config.Settings.Configuration.$name
        if ([string]::IsNullOrWhiteSpace($value)) { continue }
        $value = [Environment]::ExpandEnvironmentVariables($value.Trim())
        if (-not [IO.Path]::IsPathRooted($value)) {
            $value = Join-Path (Split-Path -Parent $configPath) $value
        }
        return [IO.Path]::GetFullPath($value)
    }
    throw "Settings.Configuration.$($Names -join ' or ') is missing or empty in '$configPath'."
}

function Get-PAWBaselineInventory {
    param([string]$Root, [string]$Type)
    $folder = Get-PAWInventoryFolder -Root $Root -Names @('SecurityBaseLineFolder', 'SecurityBaselineFolder')
    if (-not (Test-Path -LiteralPath $folder -PathType Container)) {
        throw "Security baseline folder not found: $folder"
    }
    foreach ($os in @(Get-ChildItem -LiteralPath $folder -Directory -ErrorAction Stop | Sort-Object Name)) {
        $path = Join-Path $os.FullName $Type
        if (Test-Path -LiteralPath $path -PathType Container) {
            [pscustomobject]@{ Name = $os.Name; Type = $Type; Path = $path }
        }
    }
}
function Invoke-PAWBaselineImport {
    <#
    .SYNOPSIS
        Imports one baseline ZIP into an OS-specific OS or Edge directory.
    .DESCRIPTION
        Validates ZIP paths, extracts into a unique staging directory and locates
        exactly one Scripts\Baseline-LocalInstall.ps1. Removes only the package
        wrapper above that Scripts directory. Never executes imported scripts.
        Existing content requires Replace. A failed publish restores the previous
        baseline; failed restoration retains its backup and reports the path.
    .PARAMETER ZipPath
        Local Microsoft baseline ZIP file.
    .PARAMETER OperatingSystem
        Single destination directory name, for example Windows11_26H2.
    .PARAMETER BaselineType
        OS or Edge. Only this type is replaced; the sibling is left unchanged.
    .PARAMETER BaselineFolder
        Absolute SecurityBaselineFolder root below the installation directory.
    .PARAMETER Replace
        Explicit approval to replace existing content. Without this switch only
        missing, empty or .gitkeep-only destinations are allowed.
    .EXAMPLE
        Invoke-PAWBaselineImport -ZipPath C:\Downloads\Baseline.zip -OperatingSystem Windows11_26H2 -BaselineType OS -BaselineFolder C:\PAWDeploy\Resources\SecurityBaselines
        Imports an OS baseline without executing its scripts.
    .NOTES
        Version : 2.0.0.2
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)]
        [ValidateNotNullOrEmpty()]
        [string]$ZipPath,
        [Parameter(Mandatory)]
        [ValidateNotNullOrEmpty()]
        [string]$OperatingSystem,
        [Parameter(Mandatory)]
        [ValidateSet('OS', 'Edge')]
        [string]$BaselineType,
        [Parameter(Mandatory)]
        [ValidateNotNullOrEmpty()]
        [string]$BaselineFolder,
        [switch]$Replace
    )

    Assert-PAWBaselineDirectoryName -Name $OperatingSystem
    if ($BaselineFolder -notmatch '^(?:[A-Za-z]:[\\/]|\\\\[^\\]+\\[^\\]+(?:\\|$))') {
        throw 'BaselineFolder must be an absolute path.'
    }
    $root = [IO.Path]::GetFullPath($BaselineFolder)
    $osFolder = Join-Path $root $OperatingSystem
    $target = Join-Path $osFolder $BaselineType
    Assert-PAWBaselineDestination -Path $target -Replace:$Replace
    $zip = Get-Item -LiteralPath $ZipPath -ErrorAction Stop
    if ($zip.PSIsContainer -or $zip.Extension -ne '.zip') { throw 'ZipPath must be a ZIP file.' }
    Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction Stop
    Add-Type -AssemblyName System.IO.Compression -ErrorAction Stop
    $archive = $null
    $staging = $null
    $backup = $null
    $published = $false
    try {
        $archive = [IO.Compression.ZipFile]::OpenRead($zip.FullName)
        $entries = Get-PAWBaselineArchiveEntries -Archive $archive
        $scripts = @($entries | Where-Object {
            -not $_.IsDirectory -and $_.Name -match '(^|\\)Scripts\\Baseline-LocalInstall\.ps1$'
        })
        if ($scripts.Count -ne 1) {
            throw "ZIP must contain exactly one Scripts\Baseline-LocalInstall.ps1; found $($scripts.Count)."
        }
        $packageRoot = Split-Path -Parent (Split-Path -Parent $scripts[0].Name)
        if (-not $PSCmdlet.ShouldProcess($target, "Import baseline from '$($zip.FullName)' (Replace=$Replace)")) { return }
        $null = New-Item -Path $root -ItemType Directory -Force -ErrorAction Stop
        $staging = Join-Path $root ('.import-' + [guid]::NewGuid().ToString('N'))
        $null = New-Item -Path $staging -ItemType Directory -ErrorAction Stop
        foreach ($record in $entries) {
            $path = Join-Path $staging $record.Name
            if ($record.IsDirectory) {
                $null = New-Item -Path $path -ItemType Directory -Force -ErrorAction Stop
            }
            else {
                $null = New-Item -Path (Split-Path -Parent $path) -ItemType Directory -Force -ErrorAction Stop
                [IO.Compression.ZipFileExtensions]::ExtractToFile($record.Entry, $path, $false)
            }
        }
        $source = $staging
        if ($packageRoot) { $source = Join-Path $staging $packageRoot }
        Assert-PAWBaselineDestination -Path $target -Replace:$Replace
        $null = New-Item -Path $osFolder -ItemType Directory -Force -ErrorAction Stop
        if (Test-Path -LiteralPath $target -ErrorAction Stop) {
            $backup = Join-Path $osFolder ('.backup-' + [guid]::NewGuid().ToString('N'))
            [IO.Directory]::Move($target, $backup)
        }
        try {
            [IO.Directory]::Move($source, $target)
            $published = $true
        }
        catch {
            $publishError = $_
            if ($null -ne $backup) {
                try {
                    [IO.Directory]::Move($backup, $target)
                    $backup = $null
                }
                catch { Write-Warning "Baseline restoration failed. Previous baseline retained at '$backup': $($_.Exception.Message)" }
            }
            throw $publishError
        }
        [pscustomobject]@{
            OperatingSystem = $OperatingSystem
            BaselineType = $BaselineType
            Destination = $target
            ZipPath = $zip.FullName
        }
    }
    finally {
        if ($null -ne $archive) { $archive.Dispose() }
        foreach ($folder in @($staging, $(if ($published) { $backup }))) {
            if ($folder -and (Test-Path -LiteralPath $folder)) {
                try { Remove-PAWDeploymentDirectory -Path $folder -Confirm:$false -ErrorAction Stop }
                catch { Write-Warning "Baseline temporary directory retained at '$folder': $($_.Exception.Message)" }
            }
        }
    }
}
function Invoke-PAWInventoryExport {
    <#
    .SYNOPSIS
        Exports a selected inventory file or baseline archive.
    .NOTES
        Version : 2.0.0.3
        Author  : The Fantastic PAWDeploy Team
    #>
    param([string]$Type, [object]$Selection, [string]$Root, [string]$DestinationFolder,
        [switch]$Replace, [System.Management.Automation.PSCmdlet]$Caller)

    $items = @(switch ($Type) {
        'VHDXImage' { Get-PAWVHDXImage -Root $Root }
        'OSBaselinePolicy' { Get-PAWOSBaselinePolicy -Root $Root }
        'EdgeBaselinePolicy' { Get-PAWEdgeBaselinePolicy -Root $Root }
        'RunScript' { Get-PAWRunScript -Root $Root }
        'WDACPolicy' { Get-PAWWDACPolicy -Root $Root }
        default { throw "Unsupported resource type '$Type'." }
    })
    $isBaseline = $Type -in 'OSBaselinePolicy', 'EdgeBaselinePolicy'
    $property = if ($isBaseline) { 'Path' } else { 'FullName' }
    if ($Selection -is [string]) {
        $matches = @($items | Where-Object { $_.Name -eq $Selection -or $_.$property -eq $Selection })
    }
    elseif ($null -ne $Selection -and $null -ne $Selection.PSObject.Properties[$property]) {
        $matches = @($items | Where-Object { $_.$property -eq $Selection.$property })
    }
    else { throw "Select a $Type by name or pipe an object returned by its Get command." }
    if ($matches.Count -ne 1) { throw "Expected one $Type matching '$Selection'; found $($matches.Count)." }
    $inventoryName = [string]$matches[0].Name

    $source = Get-Item -LiteralPath $matches[0].$property -Force -ErrorAction Stop
    $ancestor = if ($source.PSIsContainer) { $source } else { $source.Directory }
    if ($Type -ne 'VHDXImage' -and ($source.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
        throw "Cannot export a reparse point: '$($source.FullName)'."
    }
    while ($null -ne $ancestor) {
        if ($ancestor.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "Cannot export through a reparse point: '$($ancestor.FullName)'." }
        $ancestor = $ancestor.Parent
    }
    $folder = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($DestinationFolder)
    Assert-PAWBaselineDestination -Path $folder -DirectoriesOnly
    $filename = if ($isBaseline) { "$($matches[0].Name)-$($matches[0].Type).zip" } else { $source.Name }
    Assert-PAWBaselineDirectoryName -Name $filename
    $target = Join-Path $folder $filename
    if ($source.FullName -eq $target -or ($isBaseline -and $target.StartsWith($source.FullName.TrimEnd('\') + '\', [StringComparison]::OrdinalIgnoreCase))) {
        throw "Export destination overlaps source: '$target'."
    }
    if (Test-Path -LiteralPath $target) {
        $existingTarget = Get-Item -LiteralPath $target -Force -ErrorAction Stop
        if ($existingTarget.PSIsContainer) { throw "Export target is a directory: '$target'." }
        if ($existingTarget.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "Export target is a reparse point: '$target'." }
        if (-not $Replace) { throw "Export exists; use -Replace: '$target'." }
    }
    if ($isBaseline) {
        Assert-PAWBaselineDestination -Path $source.FullName -AllowContent
        if (-not (Test-Path -LiteralPath (Join-Path $source.FullName 'Scripts\Baseline-LocalInstall.ps1') -PathType Leaf)) {
            throw "Baseline cannot be reimported: Scripts\Baseline-LocalInstall.ps1 is missing from '$($source.FullName)'."
        }
    }
    if (-not $Caller.ShouldProcess($target, "Export $Type (Replace=$Replace)")) { return }
    $null = New-Item -ItemType Directory -Path $folder -Force -ErrorAction Stop
    $temporary = Join-Path $folder ('.export-' + [guid]::NewGuid().ToString('N') + '.tmp')
    try {
        if ($isBaseline) {
            Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction Stop
            [IO.Compression.ZipFile]::CreateFromDirectory($source.FullName, $temporary)
            $archive = [IO.Compression.ZipFile]::OpenRead($temporary)
            try {
                $entries = Get-PAWBaselineArchiveEntries -Archive $archive
                $scripts = @($entries | Where-Object { -not $_.IsDirectory -and $_.Name -match '(^|\\)Scripts\\Baseline-LocalInstall\.ps1$' })
                if ($scripts.Count -ne 1) { throw "Baseline archive must contain exactly one Baseline-LocalInstall.ps1; found $($scripts.Count)." }
            }
            finally { $archive.Dispose() }
        }
        elseif ($Type -eq 'VHDXImage' -and ($source.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
            $inputStream = [IO.File]::Open($source.FullName, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::Read)
            try {
                $outputStream = [IO.File]::Open($temporary, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
                try { $inputStream.CopyTo($outputStream) }
                finally { $outputStream.Dispose() }
            }
            finally { $inputStream.Dispose() }
        }
        else { Copy-Item -LiteralPath $source.FullName -Destination $temporary -ErrorAction Stop }
        Assert-PAWBaselineDestination -Path $folder -DirectoriesOnly
        if (Test-Path -LiteralPath $target) {
            if (-not $Replace) { throw "Export appeared at '$target'; replacement is not approved." }
            $existingTarget = Get-Item -LiteralPath $target -Force -ErrorAction Stop
            if ($existingTarget.PSIsContainer -or ($existingTarget.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
                throw "Export target must be a regular file: '$target'."
            }
            [IO.File]::Replace($temporary, $target, [Management.Automation.Language.NullString]::Value)
        }
        else { [IO.File]::Move($temporary, $target) }
        $result = Get-Item -LiteralPath $target
        if ($isBaseline) { $result | Add-Member -NotePropertyName OperatingSystem -NotePropertyValue $inventoryName }
        $result
    }
    finally {
        if (Test-Path -LiteralPath $temporary) { Remove-Item -LiteralPath $temporary -Force -ErrorAction Stop }
    }
}
function Invoke-PAWInventoryRemoval {
    <#
    .SYNOPSIS
        Removes one selected inventory resource after checking template references.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    param([string]$Type, [object]$Selection, [string]$Root, [System.Management.Automation.PSCmdlet]$Caller)

    $items = @(switch ($Type) {
        'VHDXImage' { Get-PAWVHDXImage -Root $Root }
        'Template' { Get-PAWTemplate -Root $Root }
        'OSBaselinePolicy' { Get-PAWOSBaselinePolicy -Root $Root }
        'EdgeBaselinePolicy' { Get-PAWEdgeBaselinePolicy -Root $Root }
        'RunScript' { Get-PAWRunScript -Root $Root }
        'WDACPolicy' { Get-PAWWDACPolicy -Root $Root }
        default { throw "Unsupported resource type '$Type'." }
    })
    $pathProperty = switch ($Type) {
        'Template' { 'FullPath' }
        { $_ -in 'OSBaselinePolicy', 'EdgeBaselinePolicy' } { 'Path' }
        default { 'FullName' }
    }
    if ($Selection -is [string]) {
        $selected = @($items | Where-Object { $_.Name -eq $Selection -or $_.$pathProperty -eq $Selection })
    }
    elseif ($null -ne $Selection -and $null -ne $Selection.PSObject.Properties[$pathProperty]) {
        $path = [string]$Selection.$pathProperty
        $selected = @($items | Where-Object { $_.$pathProperty -eq $path })
    }
    else { throw "Select a $Type by name or pipe an object returned by its Get command." }
    if ($selected.Count -ne 1) { throw "Expected one $Type matching '$Selection'; found $($selected.Count)." }
    $path = [IO.Path]::GetFullPath([string]$selected[0].$pathProperty)

    if ($Type -ne 'Template') { Assert-PAWInventoryUnreferenced -Type $Type -Path $path -Root $Root }
    $item = Get-Item -LiteralPath $path -Force -ErrorAction Stop
    $ancestor = if ($item.PSIsContainer) { $item } else { $item.Directory }
    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "Refusing to remove a reparse point: '$path'." }
    while ($null -ne $ancestor) {
        if ($ancestor.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "Refusing removal through a reparse point: '$($ancestor.FullName)'." }
        $ancestor = $ancestor.Parent
    }
    if (-not $Caller.ShouldProcess($path, "Remove $Type")) { return }
    if ($Type -ne 'Template') { Assert-PAWInventoryUnreferenced -Type $Type -Path $path -Root $Root }
    if ($item.PSIsContainer) {
        Remove-PAWDeploymentDirectory -Path $path -Confirm:$false -ErrorAction Stop
    }
    else {
        Remove-Item -LiteralPath $path -ErrorAction Stop
    }
    Write-PAWLog -Message "Removed $Type '$path'." -LogPath (Join-Path (Resolve-PAWLogFolder) 'PAWResourceManagement.log')
}

function Assert-PAWInventoryUnreferenced {
    param([string]$Type, [string]$Path, [string]$Root)
    $config = Join-Path $Root 'Config\Config.json'
    $null = Get-Content -LiteralPath $config -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
    $templates = @(Read-PAWTemplateFile -TemplateFolder (Split-Path -Parent $config))
    foreach ($template in $templates) {
        if ($template.ParseState -ne 'OK' -or $null -eq $template.Data -or $template.Data -isnot [pscustomobject]) {
            throw "Cannot check resource references because template '$($template.FullPath)' is invalid."
        }
        $value = switch ($Type) {
            'VHDXImage' { [string]$template.Data.VHDFile }
            'RunScript' { [string]$template.Data.RunScript }
            'WDACPolicy' { [string]$template.Data.WDACPolicyFile }
            default { [string]$template.Data.SecurityBaselineLocation }
        }
        if ([string]::IsNullOrWhiteSpace($value) -or $value.Trim() -eq 'NA') { continue }
        $value = [Environment]::ExpandEnvironmentVariables($value.Trim())
        $referenced = switch ($Type) {
            'VHDXImage' { Resolve-PAWVHDFilePath -ConfigPath $config -VHDFileValue $value }
            'RunScript' {
                if ([IO.Path]::IsPathRooted($value)) { $value }
                elseif ($value -match '[\\/]') { Join-Path (Join-Path $Root 'Resources') $value }
                else { Join-Path (Join-Path $Root 'Resources\CustomScripts') $value }
            }
            'WDACPolicy' {
                if ([IO.Path]::IsPathRooted($value)) { $value }
                else { Join-Path (Join-Path $Root 'Resources\WDACPolicies') $value }
            }
            default { Resolve-PAWSecurityBaselinePath -ConfigPath $config -SecurityBaselineLocationValue $value }
        }
        if ([string]::IsNullOrWhiteSpace([string]$referenced)) { throw "Cannot resolve $Type reference in '$($template.FullPath)'." }
        $resolved = [IO.Path]::GetFullPath($referenced).TrimEnd('\')
        $target = [IO.Path]::GetFullPath($Path).TrimEnd('\')
        $used = $resolved -ieq $target
        if ($Type -in 'OSBaselinePolicy', 'EdgeBaselinePolicy') {
            $used = $used -or $target.StartsWith($resolved + '\', [StringComparison]::OrdinalIgnoreCase) -or
                $resolved.StartsWith($target + '\', [StringComparison]::OrdinalIgnoreCase)
        }
        if ($used) { throw "$Type '$Path' is referenced by template '$($template.Name)' ($($template.FullPath))." }
    }
}
function Read-PAWTemplateFile {
    <#
    .SYNOPSIS
        Reads template files once, retaining metadata and parse failures.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$TemplateFolder)

    if (-not (Test-Path -LiteralPath $TemplateFolder -PathType Container)) { return }
    foreach ($file in Get-ChildItem -LiteralPath $TemplateFolder -Filter '*.json' -File -ErrorAction Stop |
        Where-Object Name -ne 'Config.json' | Sort-Object Name) {
        $data = $null
        $failure = $null
        $name = $file.BaseName
        try {
            $data = Get-Content -LiteralPath $file.FullName -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
            if (-not [string]::IsNullOrWhiteSpace([string]$data.Name)) { $name = [string]$data.Name }
        }
        catch { $failure = $_ }
        [pscustomobject]@{
            Name = $name
            FileName = $file.Name
            FullPath = $file.FullName
            Data = $data
            ParseState = if ($null -eq $failure) { 'OK' } else { 'InvalidJson' }
            ErrorRecord = $failure
        }
    }
}
<#
.SYNOPSIS
    Removes an owned deployment directory without following mount points or links.
.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team
#>
function Remove-PAWDeploymentDirectory {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$Path
    )

    $fullPath = [System.IO.Path]::GetFullPath($Path).TrimEnd('\')
    if (-not [System.IO.Path]::IsPathRooted($Path) -or
        $fullPath -eq [System.IO.Path]::GetPathRoot($fullPath).TrimEnd('\')) {
        throw "Refusing to remove a root or relative directory: $Path"
    }
    if (-not (Test-Path -LiteralPath $fullPath -ErrorAction Stop)) { return }

    $ancestor = Get-Item -LiteralPath $fullPath -Force -ErrorAction Stop
    while ($null -ne $ancestor) {
        if ($ancestor.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {
            throw "Refusing directory cleanup through a reparse point: $($ancestor.FullName)"
        }
        $ancestor = $ancestor.Parent
    }
    $pending = New-Object 'System.Collections.Generic.Stack[string]'
    $pending.Push($fullPath)
    while ($pending.Count -gt 0) {
        foreach ($item in @(Get-ChildItem -LiteralPath $pending.Pop() -Force -ErrorAction Stop)) {
            if ($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {
                throw "Refusing directory cleanup containing a reparse point: $($item.FullName)"
            }
            if ($item.PSIsContainer) { $pending.Push($item.FullName) }
        }
    }
    if ($PSCmdlet.ShouldProcess($fullPath, 'Remove owned deployment directory')) {
        Remove-Item -LiteralPath $fullPath -Recurse -Force -ErrorAction Stop
        if (Test-Path -LiteralPath $fullPath -ErrorAction Stop) {
            throw "Deployment directory remains: $fullPath"
        }
    }
}
<#
.SYNOPSIS
    Removes and verifies temporary deployment settings inside the guest.
.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team
#>
function Remove-PAWGuestDeploymentArtifact {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param([bool]$SkipGuestFolderCleanup = $false)

    if (-not $PSCmdlet.ShouldProcess('Guest Windows installation', 'Remove autologon and deployment artifacts')) {
        return
    }
    $winlogon = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon'
    $names = @('AutoAdminLogon', 'DefaultPassword', 'DefaultUsername',
        'DefaultDomainName', 'AutoLogonCount', 'ForceAutoLogon')
    if (Test-Path -LiteralPath $winlogon -ErrorAction Stop) {
        foreach ($name in $names) {
            $key = Get-Item -LiteralPath $winlogon -ErrorAction Stop
            if ($key.GetValueNames() -contains $name) {
                Remove-ItemProperty -LiteralPath $winlogon -Name $name -Force -ErrorAction Stop
            }
        }
        $remaining = (Get-Item -LiteralPath $winlogon -ErrorAction Stop).GetValueNames()
        if (@($names | Where-Object { $remaining -contains $_ }).Count -gt 0) {
            throw 'Autologon registry cleanup could not be verified.'
        }
    }

    $files = @('C:\Windows\Panther\Unattend.xml',
        'C:\Windows\Panther\Unattend\Unattend.xml',
        'C:\Windows\Setup\Scripts\SetupComplete.cmd')
    foreach ($path in $files) {
        if (Test-Path -LiteralPath $path -ErrorAction Stop) {
            Remove-Item -LiteralPath $path -Force -ErrorAction Stop
            if (Test-Path -LiteralPath $path -ErrorAction Stop) {
                throw "Guest deployment file remains: $path"
            }
        }
    }

    if (-not $SkipGuestFolderCleanup) {
        foreach ($path in @('C:\SECBL', 'C:\PAWFiles')) {
            if (Test-Path -LiteralPath $path -ErrorAction Stop) {
                Remove-Item -LiteralPath $path -Recurse -Force -ErrorAction Stop
                if (Test-Path -LiteralPath $path -ErrorAction Stop) {
                    throw "Guest staging folder remains: $path"
                }
            }
        }
    }
    [pscustomobject]@{ AutologonRemoved = $true; DeploymentFilesRemoved = $true }
}
<#

.SYNOPSIS
    Tests PowerShell Direct connectivity by running a simple command in the guest.

.DESCRIPTION
    Tests PowerShell Direct connectivity by running a simple command in the guest.

.PARAMETER Session
    PowerShell remoting session to test by invoking a simple command.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
Function Test-PAWPSDirectSession {
    [CmdletBinding()]
    [OutputType([bool])]

    Param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNull()]
        [System.Management.Automation.Runspaces.PSSession]
        $Session
    )

    try {
        $null = Invoke-Command -Session $Session -ScriptBlock { 1 } -ErrorAction Stop
        return $true
    }
    catch {
        return $false
    }
}
function Write-PAWTemplateTransfer {
    <#
    .SYNOPSIS
        Atomically publishes validated template transfers and reports partial failures.
    .NOTES
        Version : 2.0.0.3
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][object[]]$Items, [switch]$Replace, [switch]$DirectoriesOnly)
    $published = New-Object 'System.Collections.Generic.List[string]'
    foreach ($item in $Items) {
        $folder = Split-Path -Parent $item.Destination
        $temporary = Join-Path $folder ('.template-' + [guid]::NewGuid().ToString('N'))
        try {
            Assert-PAWBaselineDestination -Path $folder -AllowContent -DirectoriesOnly:$DirectoriesOnly
            $null = New-Item -Path $folder -ItemType Directory -Force -ErrorAction Stop
            $json = ConvertTo-PAWOrderedTemplate -Template $item.Data | ConvertTo-Json -Depth 20
            [IO.File]::WriteAllText($temporary, $json, (New-Object Text.UTF8Encoding($true)))
            Assert-PAWBaselineDestination -Path $folder -AllowContent -DirectoriesOnly:$DirectoriesOnly
            if (Test-Path -LiteralPath $item.Destination -ErrorAction Stop) {
                if (-not $Replace) { throw "Template exists; use -Replace: '$($item.Destination)'." }
                if ($DirectoriesOnly) {
                    $existingTarget = Get-Item -LiteralPath $item.Destination -Force -ErrorAction Stop
                    if ($existingTarget.PSIsContainer -or ($existingTarget.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
                        throw "Export target must be a regular file: '$($item.Destination)'."
                    }
                }
                [IO.File]::Replace($temporary, $item.Destination, [Management.Automation.Language.NullString]::Value)
            }
            else { [IO.File]::Move($temporary, $item.Destination) }
            $published.Add($item.Destination)
            [pscustomobject]@{ Name = $item.Name; Source = $item.Source; Destination = $item.Destination }
        }
        catch {
            throw "Template transfer failed for '$($item.Name)': $($_.Exception.Message). Already transferred (not rolled back): $($published -join ', ')."
        }
        finally {
            try {
                if (Test-Path -LiteralPath $temporary -ErrorAction Stop) {
                    Remove-Item -LiteralPath $temporary -Force -ErrorAction Stop
                }
            }
            catch { Write-Warning "Template temporary file cleanup failed at '$temporary': $($_.Exception.Message)" }
        }
    }
}

