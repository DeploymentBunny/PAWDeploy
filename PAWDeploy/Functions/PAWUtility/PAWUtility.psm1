<#
.SYNOPSIS
    Resolves a package-relative path without allowing traversal or reparse points.
.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team
#>
function Resolve-PAWApplicationPayloadPath {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$PackageRoot, [Parameter(Mandatory)][string]$RelativePath)
    if ([string]::IsNullOrWhiteSpace($RelativePath) -or [IO.Path]::IsPathRooted($RelativePath) -or
        $RelativePath -match '(^|[\\/])\.\.([\\/]|$)|[:*?"<>|\x00-\x1f]') {
        throw "Invalid package-relative path '$RelativePath'."
    }
    foreach ($segment in $RelativePath -split '[\\/]') {
        if ($segment -ne '.' -and ($segment -match '[. ]$|^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(\.|$)' -or -not $segment)) {
            throw "Invalid package path segment '$segment'."
        }
    }
    $root = [IO.Path]::GetFullPath($PackageRoot).TrimEnd('\')
    $target = [IO.Path]::GetFullPath((Join-Path $root $RelativePath))
    if ($target -ne $root -and -not $target.StartsWith($root + '\', [StringComparison]::OrdinalIgnoreCase)) {
        throw "Package path escapes its root: '$RelativePath'."
    }
    $current = $target
    while ($current) {
        if (Test-Path -LiteralPath $current) {
            $item = Get-Item -LiteralPath $current -Force -ErrorAction Stop
            if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "Package paths cannot contain reparse points: '$current'." }
        }
        if ($current -eq $root) { break }
        $parent = Split-Path -Parent $current
        if ($parent -eq $current) { break }
        $current = $parent
    }
    $target
}
<#

.SYNOPSIS
    Returns a matching unattended locale name or null when it is not available.

.DESCRIPTION
    Returns the canonical culture name (for example sv-SE) for a case-insensitive
    culture name, using the same list as the editor UI (Get-PAWUnattendLocaleOptions).
    Returns $null when the name is not a supported specific culture.

.PARAMETER Name
    The culture name to resolve.

.EXAMPLE
    Resolve-PAWCultureName -Name 'SV-se'

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Resolve-PAWCultureName {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory = $true)]
        [Alias('Value')]
        [AllowEmptyString()]
        [string]$Name
    )

    if ([string]::IsNullOrWhiteSpace($Name)) {
        return $null
    }

    return (@(Get-PAWUnattendLocaleOptions) | Where-Object { $_ -eq $Name.Trim() } | Select-Object -First 1)
}
function Resolve-PAWCustomScriptsFolder {
    <#
    .SYNOPSIS
        Resolves CustomScripts under the installation's Resources folder.
    .PARAMETER InstallFolderPath
        PAWDeploy installation root containing Config\Config.json.
    .NOTES
        Version : 2.0.0.3
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$InstallFolderPath)
    $configPath = (Get-Item -LiteralPath (Join-Path $InstallFolderPath 'Config\Config.json') -ErrorAction Stop).FullName
    $config = Get-Content -LiteralPath $configPath -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
    $settings = $config.PSObject.Properties['Settings']
    $configuration = if ($null -ne $settings) { $settings.Value.PSObject.Properties['Configuration'] }
    if ($null -eq $configuration) { throw "Configuration settings missing: '$configPath'." }
    Join-Path (Split-Path -Parent (Split-Path -Parent $configPath)) 'Resources\CustomScripts'
}
function Resolve-PAWDeploymentApplications {
    <#
    .SYNOPSIS
        Resolves the template bundle or explicit override into a deployment snapshot.
    .PARAMETER ConfigPath
        Installation configuration.
    .PARAMETER TemplateData
        Deployment template containing ApplicationBundle.
    .PARAMETER Overrides
        Command-line or UI overrides; SkipApplication always wins. ApplicationBundle NA
        means no applications and returns nothing. An override may use a unique bundle
        name or its ID.
    .NOTES
        Version : 2.0.0.5
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$ConfigPath, [Parameter(Mandatory)][psobject]$TemplateData,
        [System.Collections.IDictionary]$Overrides = @{})
    if ($Overrides['SkipApplication'] -or $TemplateData.Application -eq 'False') { return $null }
    $bundleId = [string]$TemplateData.ApplicationBundle
    if ($Overrides.Contains('ApplicationBundle')) { $bundleId = [string]$Overrides['ApplicationBundle'] }
    if ($bundleId.Trim() -eq 'NA') { return $null }
    if ([string]::IsNullOrWhiteSpace($bundleId)) { throw 'ApplicationBundle is required when applications are enabled. Assign a bundle to the template or specify -ApplicationBundle.' }
    $resources = Join-Path (Split-Path -Parent (Split-Path -Parent $ConfigPath)) 'Resources'
    # Avoid a nested PAWUtility -> PAWApplicationManager -> PAWUtility module cycle in Windows PowerShell.
    Import-Module -Global (Join-Path $ExecutionContext.SessionState.Module.ModuleBase '..\PAWApplicationManager\PAWApplicationManager.psd1') -ErrorAction Stop
    $parsedId = [guid]::Empty
    if ($Overrides.Contains('ApplicationBundle') -and -not [guid]::TryParse($bundleId.Trim(), [ref]$parsedId)) {
        $matches = @(Get-PAWApplicationBundle -Root $resources | Where-Object { $_.Name -eq $bundleId.Trim() })
        if ($matches.Count -eq 0) { throw "Application bundle '$bundleId' not found." }
        if ($matches.Count -gt 1) {
            throw "Application bundle name '$bundleId' is ambiguous. Specify a BundleId: $($matches.BundleId -join ', ')."
        }
        $bundleId = $matches[0].BundleId
    }
    Resolve-PAWApplicationBundle -Root $resources -BundleId $bundleId
}
function Resolve-PAWLogFolder {
    <#
    .SYNOPSIS
        Returns the fixed PAWDeploy log folder and creates it if needed.
    .DESCRIPTION
        Logs always use TEMP\PAWDeploy, independent of configuration.
    .NOTES
        Version : 2.0.0.2
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param()

    if ([string]::IsNullOrWhiteSpace($env:TEMP)) {
        throw 'TEMP is not set; unable to resolve the PAWDeploy log folder.'
    }
    $logFolder = Join-Path $env:TEMP 'PAWDeploy'
    if (-not (Test-Path -LiteralPath $logFolder -PathType Container)) {
        New-Item -Path $logFolder -ItemType Directory -Force -ErrorAction Stop | Out-Null
    }
    return $logFolder
}
<#

.SYNOPSIS
    Resolves a configured security-baseline location to a path.

.DESCRIPTION
    Resolves a template's SecurityBaselineLocation value to a full path.
    Rooted values are returned as-is; other values are resolved against the
    configured SecurityBaseLineFolder (or its legacy alias) in Config.json,
    falling back to the Config.json folder itself.

.PARAMETER ConfigPath
    Path to the configuration file, used to resolve relative paths.

.PARAMETER SecurityBaselineLocationValue
    Configured security-baseline folder path or location value.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Resolve-PAWSecurityBaselinePath {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$ConfigPath,

        [Parameter(Mandatory = $true)]
        [string]$SecurityBaselineLocationValue
    )

    $rawValue = [string]$SecurityBaselineLocationValue
    if ([string]::IsNullOrWhiteSpace($rawValue)) {
        return $null
    }

    $expandedValue = [Environment]::ExpandEnvironmentVariables($rawValue.Trim())
    if ([System.IO.Path]::IsPathRooted($expandedValue)) {
        return $expandedValue
    }

    $configFolder = Split-Path -Parent $ConfigPath
    $baselineRoot = $null

    if (Test-Path -LiteralPath $ConfigPath -PathType Leaf) {
        try {
            $baselineConfig = Get-Content -LiteralPath $ConfigPath -Raw | ConvertFrom-Json
            foreach ($nodeName in @('SecurityBaseLineFolder', 'SecurityBaselineFolder')) {
                $candidateRoot = [string]$baselineConfig.Settings.Configuration.$nodeName
                if ([string]::IsNullOrWhiteSpace($candidateRoot)) {
                    continue
                }

                $candidateRoot = [Environment]::ExpandEnvironmentVariables($candidateRoot.Trim())
                if (-not [System.IO.Path]::IsPathRooted($candidateRoot)) {
                    $candidateRoot = Join-Path $configFolder $candidateRoot
                }

                $baselineRoot = $candidateRoot
                break
            }
        }
        catch {
            $baselineRoot = $null
        }
    }

    if (-not [string]::IsNullOrWhiteSpace($baselineRoot)) {
        return (Join-Path $baselineRoot $expandedValue)
    }

    return (Join-Path $configFolder $expandedValue)
}
function Resolve-PAWSetting {
    <#
    .SYNOPSIS
        Resolves a deployment setting without treating false or zero as missing.
    .DESCRIPTION
        Selects command-line, template, config or default values using the
        deployment engine's existing conversion and fallback rules. DiskMode
        defaults immediately for a nonempty invalid candidate. String settings
        preserve the config string even when empty; downstream validation remains.
    .PARAMETER Name
        Setting name used in diagnostic messages.
    .PARAMETER Kind
        Conversion and validation rule.
    .PARAMETER TemplateValue
        Candidate from the template.
    .PARAMETER ConfigValue
        Candidate from config.
    .PARAMETER DefaultValue
        Fallback for typed settings.
    .PARAMETER CommandLineValue
        Optional explicitly bound command-line candidate.
    .PARAMETER LogPath
        Optional log destination. Defaults are reported as warnings without it.
    .PARAMETER DefaultOutputMode
        Console or warning-stream reporting of typed defaults.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)]
        [ValidateSet('DiskMode', 'VMGen', 'PositiveInt', 'Boolean', 'DomainOrWorkGroup', 'String')]
        [string]$Kind,
        [AllowNull()]$TemplateValue,
        [AllowNull()]$ConfigValue,
        [AllowNull()]$DefaultValue,
        [AllowNull()]$CommandLineValue,
        [string]$LogPath,
        [ValidateSet('Console', 'Warning')][string]$DefaultOutputMode = 'Warning'
    )
    $candidates = @()
    if ($PSBoundParameters.ContainsKey('CommandLineValue')) {
        $candidates += @{ Source = 'CommandLine'; Value = $CommandLineValue }
    }
    $candidates += @{ Source = 'Template'; Value = $TemplateValue }
    $candidates += @{ Source = 'Config'; Value = $ConfigValue }
    $source = 'Default'
    $resolved = $DefaultValue
    foreach ($candidate in $candidates) {
        $value = $candidate.Value
        $valid = $false
        switch ($Kind) {
            'DiskMode' {
                $value = [string]$value
                if ([string]::IsNullOrWhiteSpace($value)) { continue }
                $valid = $value -in @('Diff', 'Copy')
            }
            'VMGen' {
                $value = ConvertTo-PAWIntOrNull -Value $value
                $valid = $value -in @(1, 2)
            }
            'PositiveInt' {
                $value = ConvertTo-PAWIntOrNull -Value $value
                $valid = $null -ne $value -and $value -gt 0
            }
            'Boolean' {
                $value = ConvertTo-PAWBoolOrNull -Value $value
                $valid = $null -ne $value
            }
            'DomainOrWorkGroup' {
                $value = ([string]$value).Trim().ToLowerInvariant()
                $valid = $value -in @('domain', 'workgroup')
                if ($valid) { $value = if ($value -eq 'domain') { 'Domain' } else { 'Workgroup' } }
            }
            'String' {
                $value = [string]$value
                $valid = $candidate.Source -eq 'Config' -or -not [string]::IsNullOrWhiteSpace($value)
            }
        }
        if ($valid) {
            $resolved = $value
            $source = $candidate.Source
            break
        }
        if ($Kind -eq 'DiskMode' -and -not [string]::IsNullOrWhiteSpace([string]$value)) { break }
    }
    $message = "$Name resolved from ${source}: $resolved"
    if ($source -eq 'Default') {
        $message = "$Name not provided/invalid; defaulting to $resolved"
        if ($LogPath) {
            Write-PAWLog -Message $message -Level WARN -LogPath $LogPath -OutputMode $DefaultOutputMode
        }
        else { Write-Warning $message }
    }
    elseif ($Kind -ne 'String' -or $source -ne 'Template') {
        if ($LogPath) { Write-PAWLog -Message $message -LogPath $LogPath -OutputMode Verbose }
        else { Write-Verbose $message }
    }
    [pscustomobject]@{ Value = $resolved; Source = $source }
}
<#

.SYNOPSIS
    Resolves a configured VHD file location to a path.

.DESCRIPTION
    Resolves a template's VHDFile value to a full path. Rooted values are
    returned as-is; relative subpaths are resolved against the Config.json
    folder; filename-only values are resolved against the configured
    VHDFolder (or its legacy aliases) in Config.json.

.PARAMETER ConfigPath
    Path to the configuration file, used to resolve relative paths.

.PARAMETER VHDFileValue
    Configured VHD file path or location value.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Resolve-PAWVHDFilePath {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$ConfigPath,

        [Parameter(Mandatory = $true)]
        [string]$VHDFileValue
    )

    $rawValue = [string]$VHDFileValue
    if ([string]::IsNullOrWhiteSpace($rawValue)) {
        return $null
    }

    $expandedValue = [Environment]::ExpandEnvironmentVariables($rawValue.Trim())
    if ([System.IO.Path]::IsPathRooted($expandedValue)) {
        return $expandedValue
    }

    $configFolder = Split-Path -Parent $ConfigPath

    # When a relative subpath is provided, resolve it relative to Config.json folder.
    if ($expandedValue -match '[\\/]') {
        return (Join-Path $configFolder $expandedValue)
    }

    # For filename-only values, resolve against VHDFolder in Config.json.
    $vhdFolder = $null
    if (Test-Path -LiteralPath $ConfigPath -PathType Leaf) {
        try {
            $vhdConfig = Get-Content -LiteralPath $ConfigPath -Raw | ConvertFrom-Json
            foreach ($nodeName in @('VHDFolder', 'VHDXFolder', 'VHDFileFolder')) {
                $candidateFolder = [string]$vhdConfig.Settings.Configuration.$nodeName
                if ([string]::IsNullOrWhiteSpace($candidateFolder)) {
                    continue
                }

                $candidateFolder = [Environment]::ExpandEnvironmentVariables($candidateFolder.Trim())
                if (-not [System.IO.Path]::IsPathRooted($candidateFolder)) {
                    $candidateFolder = Join-Path $configFolder $candidateFolder
                }

                $vhdFolder = $candidateFolder
                break
            }
        }
        catch {
            $vhdFolder = $null
        }
    }

    if (-not [string]::IsNullOrWhiteSpace($vhdFolder)) {
        return (Join-Path $vhdFolder $expandedValue)
    }

    return (Join-Path $configFolder $expandedValue)
}
<#

.SYNOPSIS
    Normalizes the configured Hyper-V virtual-switch name.

.DESCRIPTION
    Normalizes a Hyper-V VM switch value (string, enumerable, or object with a
    Name/SwitchName/VMSwitchName property) down to a single switch name string.

.PARAMETER SwitchValue
    Configured virtual-switch name or value to normalize.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Resolve-PAWVMSwitchName {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $false)]
        $SwitchValue
    )

    if ($null -eq $SwitchValue) {
        return $null
    }

    if ($SwitchValue -is [string]) {
        $resolved = ([string]$SwitchValue).Trim()
        if ([string]::IsNullOrWhiteSpace($resolved)) {
            return $null
        }
        return $resolved
    }

    if ($SwitchValue -is [System.Collections.IEnumerable] -and -not ($SwitchValue -is [string])) {
        foreach ($item in $SwitchValue) {
            $resolvedFromItem = Resolve-PAWVMSwitchName -SwitchValue $item
            if (-not [string]::IsNullOrWhiteSpace($resolvedFromItem)) {
                return $resolvedFromItem
            }
        }
    }

    foreach ($propertyName in @('Name', 'SwitchName', 'VMSwitchName')) {
        if ($SwitchValue.PSObject -and $null -ne $SwitchValue.PSObject.Properties[$propertyName]) {
            $resolvedFromProperty = Resolve-PAWVMSwitchName -SwitchValue $SwitchValue.PSObject.Properties[$propertyName].Value
            if (-not [string]::IsNullOrWhiteSpace($resolvedFromProperty)) {
                return $resolvedFromProperty
            }
        }
    }

    $fallback = ([string]$SwitchValue).Trim()
    if ([string]::IsNullOrWhiteSpace($fallback) -or $fallback -like '@{*') {
        return $null
    }

    return $fallback
}
<#

.SYNOPSIS
    Restarts one or more Hyper-V virtual machines.

.DESCRIPTION
    Restarts one or more Hyper-V virtual machines.

.PARAMETER VMname
    Name or names of the virtual machines to restart.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
Function Restart-PAWVM {
    param(
        $VMname
    )

    Foreach ($VM in $VMname) {
        #Check if VM exists
        if ((Test-PAWVMExists -VMname $VMName) -eq $false) { Write-Warning "Could find $VMName"; break }

        Get-VM -VMName $VM | Stop-VM
        Get-VM -VMName $VM | Start-VM
    }
}
Function Restart-PAWVMIfRebootPending {
    <#
    .SYNOPSIS
        Restarts a VM in a controlled way while Windows in the guest reports a pending restart.

    .DESCRIPTION
        Checks the guest for pending restarts from Component Based Servicing (feature and
        package installation) and Windows Update. If one is pending, the VM is shut down
        gracefully, started and waited for, then checked again. This replaces an
        unexpected restart initiated by the guest later in the deployment with a
        controlled one. PendingFileRenameOperations is not checked because ordinary file
        operations set it and it would cause needless restarts.
        Stops after MaxRestarts restarts and writes a warning if a restart is still pending.

    .PARAMETER VMName
        Name of the virtual machine.

    .PARAMETER Credential
        Credentials used for PowerShell Direct.

    .PARAMETER MaxRestarts
        Maximum number of extra restarts. Defaults to 2.

    .OUTPUTS
        System.Int32. The number of restarts performed.

    .EXAMPLE
        Restart-PAWVMIfRebootPending -VMName 'PAW-01' -Credential $cred

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    [OutputType([int])]
    param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]
        $VMName,

        [Parameter(Mandatory = $true)]
        [System.Management.Automation.PSCredential]
        $Credential,

        [Parameter()]
        [ValidateRange(1, 5)]
        [int]
        $MaxRestarts = 2
    )

    $pendingCheck = {
        $reasons = @()
        $cbs = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing'
        if (Test-Path -LiteralPath "$cbs\RebootPending") { $reasons += 'Component Based Servicing' }
        if (Test-Path -LiteralPath "$cbs\PackagesPending") { $reasons += 'Component Based Servicing packages' }
        if (Test-Path -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired') { $reasons += 'Windows Update' }
        $reasons
    }

    $restarts = 0
    while ($true) {
        $reasons = @(Invoke-PAWPSDirect -VMName $VMName -Credential $Credential -ScriptBlock $pendingCheck)
        if ($reasons.Count -eq 0) {
            Write-PAWConsoleLog -Message "No pending restart reported by {0}" -Type Info -Value $VMName
            return $restarts
        }
        if ($restarts -ge $MaxRestarts) {
            Write-Warning "'$VMName' still reports a pending restart ($($reasons -join ', ')) after $restarts extra restart(s); continuing."
            return $restarts
        }

        $restarts++
        Write-PAWConsoleLog -Message "{0} reports a pending restart ({1}); restarting ({2} of {3})" -Type Change -Value $VMName, ($reasons -join ', '), $restarts, $MaxRestarts
        Stop-PAWVM -VMName $VMName
        Start-VM -Name $VMName -ErrorAction Stop
        Write-PAWConsoleLog -Message "Wait for the VM to have IC loaded" -Type Wait
        Wait-PAWVMHaveICLoaded -VMname $VMName
        Write-PAWConsoleLog -Message "Wait for the VM to have an IP address" -Type Wait
        Wait-PAWVMHaveIP -VMname $VMName
        Write-PAWConsoleLog -Message "Wait for the VM accept PowerShell Direct" -Type Wait
        Wait-PAWVMHavePSDirect -VMname $VMName -Credentials $Credential
        Write-PAWConsoleLog -Message "Wait for the VM to complete OOBE" -Type Wait
        Wait-PAWVMCompleteOOBE -VMname $VMName -Credentials $Credential
    }
}
function Restore-PAWInterruptedDeployment {
    <#
    .SYNOPSIS
        Removes leftovers from earlier deployments, automatically when safe and otherwise after asking.
    .DESCRIPTION
        Processes every recovery journal in JournalFolder, regardless of which installation wrote it.
        Active deployments are skipped. VMs and files in VM directories are never removed, because
        a partly deployed VM may already be in use. Host leftovers whose ownership is verified are
        removed without prompting: the staging folder, the credential file, recorded offline setup
        files on a still-mounted disk, and the mount itself.
        When the staging folder's ownership cannot be verified, the user is asked whether to remove
        the leftovers anyway. When the recorded mounted disk is outside the VM directory or the
        staging folder is redirected, nothing is removed and the user is asked whether to forget
        the record. Unreadable journals are offered for deletion.
        Afterwards, orphaned staging folders (PAWDeploy-<guid> with an ownership marker) and
        credential files (PAWDeploy-<VM>.dat older than one hour, not for CurrentVMName) under
        StagingRoot that no remaining journal references are removed.
        Declined or failed removals are kept and logged, and do not stop a new deployment.
    .PARAMETER JournalFolder
        Folder containing recovery journals.
    .PARAMETER InstallRoot
        Installation root of the calling deployment. Retained for compatibility and logging.
    .PARAMETER LogPath
        Deployment log.
    .PARAMETER StagingRoot
        Folder containing deployment staging folders and credential files. Defaults to TEMP.
    .PARAMETER CurrentVMName
        VM name of the deployment that is starting; its credential file is never removed.
    .NOTES
        Version : 2.0.0.4
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    param(
        [Parameter(Mandatory)][string]$JournalFolder,
        [Parameter(Mandatory)][string]$InstallRoot,
        [Parameter(Mandatory)][string]$LogPath,
        [string]$StagingRoot = $env:TEMP,
        [string]$CurrentVMName
    )
    if (-not (Test-Path -LiteralPath $JournalFolder -PathType Container -ErrorAction Stop)) {
        $null = New-Item -Path $JournalFolder -ItemType Directory -Force -ErrorAction Stop
    }
    if ($WhatIfPreference) {
        $null = $PSCmdlet.ShouldProcess($JournalFolder, 'Remove leftovers from earlier deployments')
        return
    }
    $confirm = {
        param([string]$Prompt)
        (Read-Host -Prompt "$Prompt [y/N]") -in @('y', 'yes', 'j', 'ja')
    }
    $isUnder = {
        param([string]$Path, [string]$Folder)
        $Path -and $Folder -and ([IO.Path]::GetFullPath($Path)).StartsWith(
            ([IO.Path]::GetFullPath($Folder)).TrimEnd('\') + '\', [StringComparison]::OrdinalIgnoreCase)
    }
    $referenced = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    $keep = {
        param([hashtable]$State)
        foreach ($path in @($State.TempFolder, $State.CredentialFile)) {
            if ($path) { $null = $referenced.Add([IO.Path]::GetFullPath([string]$path)) }
        }
    }

    $recoveryLock = [IO.File]::Open((Join-Path $JournalFolder '.recovery.lock'),
        [IO.FileMode]::OpenOrCreate, [IO.FileAccess]::ReadWrite, [IO.FileShare]::None)
    try {
        foreach ($file in Get-ChildItem -LiteralPath $JournalFolder -Filter '*.clixml' -File -ErrorAction Stop) {
            $state = $null
            try { $state = Import-Clixml -LiteralPath $file.FullName -ErrorAction Stop } catch { $state = $null }
            # The journal may record an 8.3 short path (for example from %TEMP%); compare normalized long paths.
            if ($state -isnot [hashtable] -or -not $state.RunId -or -not $state.JournalPath -or
                $file.BaseName -ne [string]$state.RunId -or
                -not [string]::Equals([IO.Path]::GetFullPath([string]$state.JournalPath), $file.FullName, [StringComparison]::OrdinalIgnoreCase)) {
                Write-PAWLog -Level WARN -Message "Invalid deployment recovery journal: $($file.FullName)" -LogPath $LogPath -OutputMode Warning
                if (& $confirm "The recovery journal '$($file.Name)' is unreadable or invalid, so its leftovers cannot be identified. Delete the journal file?") {
                    Remove-Item -LiteralPath $file.FullName -Force -ErrorAction Stop
                    Write-PAWLog -Message "Invalid recovery journal deleted: $($file.FullName)" -LogPath $LogPath
                }
                else { Write-PAWLog -Message "Invalid recovery journal kept: $($file.FullName)" -LogPath $LogPath }
                continue
            }

            $process = @(Get-Process -Id $state.ProcessId -ErrorAction SilentlyContinue)
            $sameRunspace = $state.ProcessId -eq $PID -and
                [string]$state.RunspaceId -eq [string][runspace]::DefaultRunspace.InstanceId
            if (-not $state.Inactive -and -not $sameRunspace -and $process.Count -and
                $process[0].StartTime.ToUniversalTime().Ticks -eq $state.ProcessStartTicks) {
                Write-PAWLog -Message "Recovery skipped active deployment $($state.RunId)." -LogPath $LogPath
                & $keep $state
                continue
            }

            $unverified = New-Object 'System.Collections.Generic.List[string]'
            $blocked = New-Object 'System.Collections.Generic.List[string]'
            if ($state.TempFolder -and (Test-Path -LiteralPath $state.TempFolder -ErrorAction Stop)) {
                $item = Get-Item -LiteralPath $state.TempFolder -Force -ErrorAction Stop
                if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {
                    $blocked.Add("redirected staging directory '$($state.TempFolder)'")
                }
                else {
                    $marker = Join-Path $state.TempFolder '.pawdeploy-owner'
                    if (-not (Test-Path -LiteralPath $marker -PathType Leaf -ErrorAction Stop) -or
                        (Get-Content -LiteralPath $marker -Raw -ErrorAction Stop).Trim() -ne [string]$state.RunId) {
                        $unverified.Add("ownership marker missing or different in '$($state.TempFolder)'")
                    }
                }
            }
            if ($state.MountedVHD -and -not (& $isUnder $state.MountedVHD $state.VMFolder)) {
                $blocked.Add("the mounted disk '$($state.MountedVHD)' is outside the recorded VM directory")
            }
            $description = "build $($state.RunId) (VM '$($state.VMName)', directory '$($state.VMFolder)')"
            if ($blocked.Count) {
                Write-PAWLog -Level WARN -Message "Leftovers from $description cannot be removed safely: $($blocked -join '; ')." -LogPath $LogPath -OutputMode Warning
                if (& $confirm "Nothing will be deleted. Forget this recovery record and keep its resources for manual handling?") {
                    Remove-Item -LiteralPath $file.FullName -Force -ErrorAction Stop
                    Write-PAWLog -Message "Recovery record for $($state.RunId) removed; resources kept." -LogPath $LogPath
                }
                else {
                    Write-PAWLog -Message "Recovery record for $($state.RunId) kept." -LogPath $LogPath
                    & $keep $state
                }
                continue
            }
            if ($unverified.Count) {
                Write-PAWLog -Level WARN -Message "Ownership of leftovers from $description cannot be verified: $($unverified -join '; ')." -LogPath $LogPath -OutputMode Warning
                if (-not (& $confirm "Remove these leftovers anyway?")) {
                    Write-PAWLog -Message "Leftovers from $($state.RunId) kept at the user's request." -LogPath $LogPath
                    & $keep $state
                    continue
                }
            }

            Write-PAWLog -Message "Removing host leftovers from $description; the VM and its directory are kept." -LogPath $LogPath -OutputMode Console -ConsoleType Info
            try {
                Invoke-PAWDeploymentCleanup -State $state -LogPath $LogPath -Confirm:$false -ErrorAction Stop
                Remove-Item -LiteralPath $file.FullName -Force -ErrorAction Stop
                Write-PAWLog -Message "Leftovers from $($state.RunId) removed." -LogPath $LogPath
            }
            catch {
                Save-PAWDeploymentState -State $state
                Write-PAWLog -Level ERROR -Message "Leftovers from $($state.RunId) could not be fully removed and will be retried next time: $($_.Exception.Message)" -LogPath $LogPath -OutputMode Warning
                & $keep $state
            }
        }

        if ($StagingRoot -and (Test-Path -LiteralPath $StagingRoot -PathType Container)) {
            foreach ($folder in @(Get-ChildItem -LiteralPath $StagingRoot -Directory -Filter 'PAWDeploy-*' -Force -ErrorAction Stop |
                Where-Object { $_.Name -match '^PAWDeploy-[0-9a-f]{32}$' -and -not $referenced.Contains($_.FullName) })) {
                $marker = Join-Path $folder.FullName '.pawdeploy-owner'
                if (-not (Test-Path -LiteralPath $marker -PathType Leaf) -and
                    -not (& $confirm "The staging folder '$($folder.FullName)' has no ownership marker. Delete it?")) {
                    Write-PAWLog -Message "Unmarked staging folder kept: $($folder.FullName)" -LogPath $LogPath
                    continue
                }
                try {
                    Remove-PAWDeploymentDirectory -Path $folder.FullName -Confirm:$false -ErrorAction Stop
                    Write-PAWLog -Message "Removed orphaned staging folder $($folder.FullName)" -LogPath $LogPath -OutputMode Console -ConsoleType Info
                }
                catch { Write-PAWLog -Level WARN -Message "Orphaned staging folder kept: $($folder.FullName). $($_.Exception.Message)" -LogPath $LogPath -OutputMode Warning }
            }
            $current = if ($CurrentVMName) { "PAWDeploy-$CurrentVMName.dat" } else { $null }
            # The UI writes the credential file just before starting a deployment; recent files may belong to one.
            $cutoff = (Get-Date).AddHours(-1)
            foreach ($credentialFile in @(Get-ChildItem -LiteralPath $StagingRoot -File -Filter 'PAWDeploy-*.dat' -Force -ErrorAction Stop |
                Where-Object { $_.Name -ne $current -and $_.LastWriteTime -lt $cutoff -and -not $referenced.Contains($_.FullName) })) {
                try {
                    Remove-Item -LiteralPath $credentialFile.FullName -Force -ErrorAction Stop
                    Write-PAWLog -Message "Removed orphaned credential file $($credentialFile.FullName)" -LogPath $LogPath -OutputMode Console -ConsoleType Info
                }
                catch { Write-PAWLog -Level WARN -Message "Orphaned credential file kept: $($credentialFile.FullName). $($_.Exception.Message)" -LogPath $LogPath -OutputMode Warning }
            }
        }
    }
    finally { $recoveryLock.Dispose() }
}
<#

.SYNOPSIS
    Validates and saves the application list to Applications.json.

.DESCRIPTION
    Writes the Applications array of Applications.json in the standard format:
    every application with exactly Name, Source, Id,
    InstallEnabled, Architecture, Scope and InstallerType, in that order and
    in their standard casing, with InstallEnabled as JSON
    true or false.

    Every application is validated with ConvertTo-PAWApplicationDefinition and
    names must be unique (case-insensitive). Nothing is written when an
    application is invalid.

    Other top-level properties in an existing file are kept. The file is
    written as UTF-8 without BOM, and only when its content changes. The
    folder is created when it does not exist. Returns $true when the file was
    written and $false when it was already up to date.

.PARAMETER Path
    Path to Applications.json.

.PARAMETER Application
    The applications to save, in order (objects or dictionaries). Use an
    empty array to save an empty list.

.EXAMPLE
    $applications = @(Get-PAWApplicationDefinitions -Path $path) | Where-Object Name -ne 'KeePass'
    Save-PAWApplicationDefinitions -Path $path -Application $applications

    Removes KeePass from the list.

.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team

#>
function Save-PAWApplicationDefinitions {
    [CmdletBinding()]
    [OutputType([bool])]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Path,

        [Parameter(Mandatory = $true)]
        [AllowEmptyCollection()]
        [object[]]$Application
    )

    $seenNames = @{}
    $index = 0
    $entries = New-Object System.Collections.Generic.List[object]
    foreach ($item in $Application) {
        $index++
        $definition = ConvertTo-PAWApplicationDefinition -Application $item -Index $index -Context "in '$Path'"
        if ($seenNames.ContainsKey($definition.Name)) {
            throw "Application name '$($definition.Name)' is defined more than once in '$Path'."
        }
        $seenNames[$definition.Name] = $true
        $entry = [ordered]@{}
        foreach ($property in $definition.PSObject.Properties) {
            $entry[$property.Name] = $property.Value
        }
        $entries.Add($entry)
    }

    $document = [ordered]@{}
    $originalText = $null
    if (Test-Path -LiteralPath $Path -PathType Leaf) {
        $originalText = [System.IO.File]::ReadAllText($Path)
        try {
            $existing = $originalText | ConvertFrom-Json -ErrorAction Stop
        }
        catch {
            throw "Applications file '$Path' is not valid JSON. $($_.Exception.Message)"
        }
        if ($null -ne $existing) {
            foreach ($property in $existing.PSObject.Properties) {
                $document[$property.Name] = $property.Value
            }
        }
    }
    $document['Applications'] = $entries.ToArray()

    $json = (ConvertTo-PAWIndentedJson -InputObject $document) + "`r`n"
    if ($null -ne $originalText -and $originalText.Trim() -ceq $json.Trim()) {
        return $false
    }

    $folder = Split-Path -Parent $Path
    if (-not [string]::IsNullOrWhiteSpace($folder) -and -not (Test-Path -LiteralPath $folder -PathType Container)) {
        New-Item -Path $folder -ItemType Directory -Force | Out-Null
    }
    [System.IO.File]::WriteAllText($Path, $json, (New-Object System.Text.UTF8Encoding($false)))
    return $true
}
function Save-PAWDeploymentState {
    <#
    .SYNOPSIS
        Atomically saves non-secret deployment ownership for interrupted-build recovery.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable]$State)
    if (-not $State.JournalPath) { return }
    $record = @{}
    foreach ($key in @('JournalPath', 'RunId', 'ProcessId', 'ProcessStartTicks', 'RunspaceId', 'Inactive', 'InstallRoot',
        'VMName', 'VMId', 'VMFolder', 'TempFolder', 'MountedVHD', 'CredentialFile',
        'SourceVHD', 'InstallationComplete')) {
        if ($State.ContainsKey($key)) { $record[$key] = $State[$key] }
    }
    $temporary = $State.JournalPath + '.' + [guid]::NewGuid().ToString('N') + '.tmp'
    try {
        $record | Export-Clixml -LiteralPath $temporary -Depth 4 -ErrorAction Stop
        if ([IO.File]::Exists($State.JournalPath)) {
            [IO.File]::Replace($temporary, $State.JournalPath, [System.Management.Automation.Language.NullString]::Value)
        }
        else { [IO.File]::Move($temporary, $State.JournalPath) }
    }
    finally {
        if ([IO.File]::Exists($temporary)) { [IO.File]::Delete($temporary) }
    }
}
<#
.SYNOPSIS
    Sets the console title and returns the script filename, declared version and folder.
.PARAMETER ScriptPath
    Path to the executing script.
.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team
#>
function Set-PAWScriptTitle {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$ScriptPath
    )

    $scriptFile = Get-Item -LiteralPath $ScriptPath -ErrorAction Stop
    $tokens = $null
    $errors = $null
    [void][System.Management.Automation.Language.Parser]::ParseFile($scriptFile.FullName, [ref]$tokens, [ref]$errors)
    if ($errors.Count -gt 0) {
        throw "Cannot read script metadata from '$ScriptPath': $($errors[0].Message)"
    }
    $version = $null
    foreach ($token in $tokens) {
        if ($token.Kind -eq 'Comment' -and $token.Text -match '(?m)^\s*Version\s*:\s*(\d+(?:\.\d+){1,3})\s*$') {
            $version = $Matches[1]
            break
        }
    }
    if ([string]::IsNullOrWhiteSpace($version)) {
        throw "Script version metadata is missing: $ScriptPath"
    }
    $title = 'PAWDeploy Toolkit - {0} - {1} - {2}' -f $version, $scriptFile.Name, $scriptFile.DirectoryName
    try {
        $Host.UI.RawUI.WindowTitle = $title
    }
    catch [System.NotImplementedException] {
        Write-Warning "This PowerShell host does not support window titles: $($_.Exception.Message)"
    }
    catch [System.Management.Automation.PSNotSupportedException] {
        Write-Warning "This PowerShell host does not support window titles: $($_.Exception.Message)"
    }
    return $title
}
<#

.SYNOPSIS
    Starts virtual machines and waits for PowerShell Direct access.

.DESCRIPTION
    Starts virtual machines and waits for PowerShell Direct access.

.PARAMETER VMname
    Name or names of the virtual machines to start.

.PARAMETER domainCred
    Credentials used to establish PowerShell Direct access after startup.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
Function Start-PAWVM {
    param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]
        $VMname,

        [Parameter(Mandatory = $true)]
        [System.Management.Automation.PSCredential]
        $domainCred
    )

    Foreach ($VM in $VMname) {
        #Check if VM exists
        if ((Test-PAWVMExists -VMname $VMName) -eq $false) { Write-Warning "Could find $VMName"; break }

        Get-VM -VMName $VM | Start-VM
        Wait-PAWVMIsRunning -VMname $VMname
        Wait-PAWVMHaveICLoaded -VMname $VMname
        Wait-PAWVMHaveIP -VMname $VMname
        Wait-PAWVMHavePSDirect -VMname $VMname -Credentials $domainCred
    }
}
<#
.SYNOPSIS
    Requests a graceful VM shutdown and waits until Hyper-V reports Off.
.DESCRIPTION
    Accepts shutdown-in-progress errors (0x8007045B) and an unavailable shutdown
    service while the guest restarts (0x800706B5), but propagates other errors.
    While the VM still reports Running, the graceful shutdown request is repeated
    because the guest can reject or cancel an earlier request.
    Never forces a power-off. Throws if the VM does not reach Off before timeout.
.PARAMETER VMName
    Name of the virtual machine.
.PARAMETER TimeoutSeconds
    Maximum shutdown wait in seconds. Defaults to 600.
.PARAMETER PollIntervalSeconds
    Seconds between state checks. Defaults to 5.
.PARAMETER RetryIntervalSeconds
    Seconds between repeated graceful shutdown requests while the VM is Running. Defaults to 30.
.NOTES
    Version : 2.0.0.3
    Author  : The Fantastic PAWDeploy Team
#>
function Stop-PAWVM {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory = $true)][ValidateNotNullOrEmpty()][string]$VMName,
        [ValidateRange(1, 86400)][int]$TimeoutSeconds = 600,
        [ValidateRange(1, 300)][int]$PollIntervalSeconds = 5,
        [ValidateRange(1, 3600)][int]$RetryIntervalSeconds = 30
    )

    $vm = Get-VM -Name $VMName -ErrorAction Stop
    if ([string]$vm.State -eq 'Off') { return }
    if (-not $PSCmdlet.ShouldProcess($VMName, 'Gracefully shut down and wait for Off')) { return }
    $deadline = (Get-Date).AddSeconds($TimeoutSeconds)

    # Returns Requested, InProgress (0x8007045B) or Unavailable (0x800706B5: shutdown service unreachable while the guest restarts).
    $requestShutdown = {
        try {
            Stop-VM -Name $VMName -ErrorAction Stop
            return 'Requested'
        }
        catch {
            $text = $_.ToString()
            $shutdownInProgress = $text -match '0x8007045B|A system shutdown is in progress'
            $serviceUnavailable = $text -match '0x800706B5'
            $exception = $_.Exception
            while ($null -ne $exception) {
                if ($exception.HResult -eq -2147023781 -or
                    ($exception -is [System.ComponentModel.Win32Exception] -and $exception.NativeErrorCode -eq 1115)) {
                    $shutdownInProgress = $true
                }
                if ($exception.HResult -eq -2147023179 -or
                    ($exception -is [System.ComponentModel.Win32Exception] -and $exception.NativeErrorCode -eq 1717)) {
                    $serviceUnavailable = $true
                }
                $exception = $exception.InnerException
            }
            if ($shutdownInProgress) {
                Write-PAWConsoleLog -Message "Shutdown is already in progress for '$VMName'; waiting for Off." -Type Wait
                return 'InProgress'
            }
            if ($serviceUnavailable) {
                Write-PAWConsoleLog -Message "The shutdown service in '$VMName' is not available (guest may be restarting); retrying." -Type Wait
                return 'Unavailable'
            }
            throw
        }
    }

    if ([string]$vm.State -ne 'Stopping') {
        $null = & $requestShutdown
    }
    $nextRequest = (Get-Date).AddSeconds($RetryIntervalSeconds)

    Write-PAWConsoleLog -Message "Waiting for '$VMName' to shut down (timeout: $TimeoutSeconds seconds)." -Type Wait
    while ($true) {
        $vm = Get-VM -Name $VMName -ErrorAction Stop
        if ([string]$vm.State -eq 'Off') { return }
        $now = Get-Date
        $remaining = ($deadline - $now).TotalSeconds
        if ($remaining -le 0) {
            throw "Timed out after $TimeoutSeconds seconds waiting for '$VMName' to reach Off. Last state: $($vm.State). No forced shutdown was performed."
        }
        if ([string]$vm.State -eq 'Running' -and $now -ge $nextRequest) {
            Write-PAWConsoleLog -Message "'$VMName' is still Running; requesting graceful shutdown again." -Type Wait
            try {
                $null = & $requestShutdown
            }
            catch {
                # The VM may have reached Off between the state check and the repeated request.
                if ([string](Get-VM -Name $VMName -ErrorAction Stop).State -eq 'Off') { return }
                throw
            }
            $nextRequest = (Get-Date).AddSeconds($RetryIntervalSeconds)
            continue
        }
        Start-Sleep -Seconds ([int][Math]::Min($PollIntervalSeconds, [Math]::Ceiling($remaining)))
    }
}
<#

.SYNOPSIS
    Displays a prompt and waits for a key press.

.DESCRIPTION
    Displays a prompt and waits for a key press.

.PARAMETER Message
    Prompt displayed before waiting for a key press. Defaults to "Press any key to continue . . . ".

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
Function Suspend-PAWScript {
    [CmdletBinding(SupportsShouldProcess = $true)]

    Param(
        $Message = "Press any key to continue . . . "
    )

    If ($psISE) {
        # The "ReadKey" functionality is not supported in Windows PowerShell ISE.
        $Shell = New-Object -ComObject "WScript.Shell"
        $Button = $Shell.Popup("Click OK to continue.", 0, "Script Paused", 0)
        Return
    }

    Write-Host -NoNewline $Message
    $Ignore =
    16, # Shift (left or right)
    17, # Ctrl (left or right)
    18, # Alt (left or right)
    20, # Caps lock
    91, # Windows key (left)
    92, # Windows key (right)
    93, # Menu key
    144, # Num lock
    145, # Scroll lock
    166, # Back
    167, # Forward
    168, # Refresh
    169, # Stop
    170, # Search
    171, # Favorites
    172, # Start/Home
    173, # Mute
    174, # Volume Down
    175, # Volume Up
    176, # Next Track
    177, # Previous Track
    178, # Stop Media
    179, # Play
    180, # Mail
    181, # Select Media
    182, # Application 1
    183  # Application 2

    While ($Null -Eq $KeyInfo.VirtualKeyCode -Or $Ignore -Contains $KeyInfo.VirtualKeyCode) {
        $KeyInfo = $Host.UI.RawUI.ReadKey("NoEcho, IncludeKeyDown")
    }

    Write-Host
}
function Test-PAWApplicationResources {
    <#
    .SYNOPSIS
        Validates staged resources for typed PAW applications.
    .NOTES
        Version : 2.0.0.6
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)][psobject]$Application,
        [Parameter(Mandatory = $true)][string]$AppInstallRoot,
        [switch]$AllowPendingDownloads
    )

    $applicationId = [string]$Application.ApplicationId
    $guid = [guid]::Empty
    if (-not [guid]::TryParseExact($applicationId, 'D', [ref]$guid) -or $guid -eq [guid]::Empty) {
        throw "Typed application '$($Application.Name)' has an invalid ApplicationId."
    }
    $packageRoot = Join-Path (Join-Path $AppInstallRoot 'Applications\Packages') $applicationId
    $options = $Application.Options

    switch ($Application.Source) {
        'PSGallery' {
            if ($null -eq $options) { return $null }
            $moduleName = [string]$Application.Id
            $version = [string]$options.Version
            $origin = [string]$options.Origin
            if ($origin -notin @('Local', 'PSGallery')) { throw "Unsupported PSGallery origin '$origin' for '$($Application.Name)'." }
            if ([string]$options.Runtime -notin @('WindowsPowerShell', 'PowerShell7')) {
                throw "Unsupported PowerShell runtime '$($options.Runtime)' for '$($Application.Name)'."
            }
            if ($origin -eq 'PSGallery' -and -not (Get-Command Save-Module -ErrorAction SilentlyContinue)) {
                throw 'PowerShellGet Save-Module is required to prepare PSGallery modules.'
            }
            if (-not (Test-Path -LiteralPath $packageRoot -PathType Container)) {
                if ($origin -eq 'PSGallery' -and $AllowPendingDownloads) {
                    return [pscustomobject]@{ Ready = $false; Pending = $true; PackageRoot = $packageRoot; Message = 'Module download pending.' }
                }
                throw "Module package not found at '$packageRoot'."
            }
            $queue = New-Object 'System.Collections.Generic.Queue[object]'
            $queue.Enqueue([pscustomobject]@{ Name = $moduleName; Version = $version; Exact = ($version -and $version -ne 'Latest') })
            $resolved = @{}
            while ($queue.Count -gt 0) {
                $required = $queue.Dequeue()
                $moduleFolder = Join-Path $packageRoot $required.Name
                $versionFolders = @(Get-ChildItem -LiteralPath $moduleFolder -Directory -ErrorAction SilentlyContinue |
                    Where-Object { $_.Name -as [version] })
                $discoveredNames = @(Get-ChildItem -LiteralPath $moduleFolder -Directory -ErrorAction SilentlyContinue | ForEach-Object Name)
                if ($required.Version -and $required.Exact) {
                    $versionFolders = @($versionFolders | Where-Object { [string]$_.Name -eq [string]$required.Version })
                }
                $moduleVersionFolder = $versionFolders | Sort-Object { [version]$_.Name } -Descending | Select-Object -First 1
                if ($null -eq $moduleVersionFolder) {
                    $availableVersions = @($versionFolders | ForEach-Object Name)
                    if ($origin -eq 'PSGallery' -and $AllowPendingDownloads) {
                        return [pscustomobject]@{
                            Ready = $false; Pending = $true; PackageRoot = $packageRoot
                            Message = "Module '$($required.Name)' download is pending; cached version '$($required.Version)' is not available."
                        }
                    }
                    throw "Module '$($required.Name)' version '$($required.Version)' is missing from '$moduleFolder'. Available versions: $($availableVersions -join ', '). Child folders: $($discoveredNames -join ', ')."
                }
                if ($required.Version -and $required.Version -ne 'Latest' -and -not $required.Exact -and
                    ([version]$moduleVersionFolder.Name -lt [version]$required.Version)) {
                    if ($origin -eq 'PSGallery' -and $AllowPendingDownloads) {
                        return [pscustomobject]@{
                            Ready = $false; Pending = $true; PackageRoot = $packageRoot
                            Message = "Module '$($required.Name)' download is pending; cached version '$($moduleVersionFolder.Name)' does not meet minimum '$($required.Version)'."
                        }
                    }
                    throw "Module '$($required.Name)' version '$($required.Version)' or later is missing from '$moduleFolder'."
                }
                $key = "$($required.Name)|$($moduleVersionFolder.Name)"
                if ($resolved.ContainsKey($key)) { continue }
                $manifestPath = Join-Path $moduleVersionFolder.FullName "$($required.Name).psd1"
                if (-not (Test-Path -LiteralPath $manifestPath -PathType Leaf)) {
                    if ($origin -eq 'PSGallery' -and $AllowPendingDownloads) {
                        return [pscustomobject]@{
                            Ready = $false; Pending = $true; PackageRoot = $packageRoot
                            Message = "Module '$($required.Name)' download is pending; cached manifest '$manifestPath' is missing."
                        }
                    }
                    throw "Module manifest is missing: '$manifestPath'."
                }
                try { $manifest = Import-PowerShellDataFile -LiteralPath $manifestPath -ErrorAction Stop }
                catch {
                    if ($origin -eq 'PSGallery' -and $AllowPendingDownloads) {
                        return [pscustomobject]@{
                            Ready = $false; Pending = $true; PackageRoot = $packageRoot
                            Message = "Module '$($required.Name)' download is pending; cached manifest '$manifestPath' is invalid."
                        }
                    }
                    throw "Module manifest is invalid: '$manifestPath'. $($_.Exception.Message)"
                }
                $resolved[$key] = $moduleVersionFolder
                foreach ($dependency in @($manifest.RequiredModules)) {
                    $dependencyName = if ($dependency -is [System.Collections.IDictionary]) { [string]$dependency.ModuleName } else { [string]$dependency }
                    if (-not $dependencyName) { continue }
                    $dependencyVersion = ''
                    $dependencyExact = $false
                    if ($dependency -is [System.Collections.IDictionary]) {
                        if ($dependency.RequiredVersion) { $dependencyVersion = [string]$dependency.RequiredVersion; $dependencyExact = $true }
                        elseif ($dependency.ModuleVersion) { $dependencyVersion = [string]$dependency.ModuleVersion }
                    }
                    $queue.Enqueue([pscustomobject]@{ Name = $dependencyName; Version = $dependencyVersion; Exact = $dependencyExact })
                }
            }
            return [pscustomobject]@{ Ready = $true; Pending = $false; PackageRoot = $packageRoot; Modules = @($resolved.Values) }
        }
        'Classic' {
            if ($null -eq $options) { throw "Classic application '$($Application.Name)' requires Options." }
            if ($null -ne $options.PSObject.Properties['FolderPath']) {
                $null = ConvertTo-PAWTypedApplicationDefinition -Definition @{
                    Name = $Application.Name; Type = 'Classic'; InstallEnabled = $true; Configuration = $options
                }
                $folder = Resolve-PAWApplicationPayloadPath -PackageRoot $packageRoot -RelativePath $options.FolderPath
                if (-not (Test-Path -LiteralPath $folder -PathType Container)) { throw "Classic payload folder was not found: '$folder'." }
                $workingPath = Resolve-PAWApplicationPayloadPath -PackageRoot $folder -RelativePath $options.WorkingDirectory
                if (-not (Test-Path -LiteralPath $workingPath -PathType Container)) { throw "Classic working directory was not found: '$workingPath'." }
                if ($null -ne $options.Detection -and $null -ne $options.Detection.PSObject.Properties['ScriptPath']) {
                    $scriptPath = Resolve-PAWApplicationPayloadPath -PackageRoot $folder -RelativePath $options.Detection.ScriptPath.Substring(6)
                    if (-not (Test-Path -LiteralPath $scriptPath -PathType Leaf)) { throw "Detection script was not found: '$scriptPath'." }
                }
                return [pscustomobject]@{ Ready = $true; Pending = $false; PackageRoot = $packageRoot }
            }
            $detection = $options.Detection
            if ($null -eq $detection -or $detection.Kind -ne 'Path' -or [string]::IsNullOrWhiteSpace([string]$detection.Path)) {
                throw "Classic application '$($Application.Name)' requires a Path detection rule."
            }
            if ([string]::IsNullOrWhiteSpace([string]$options.FilePath)) { throw "Classic application '$($Application.Name)' requires FilePath." }
            $allowedExecutables = @('powershell.exe', 'pwsh.exe', 'cmd.exe', 'msiexec.exe', 'dism.exe')
            if ([IO.Path]::IsPathRooted([string]$options.FilePath)) {
                if ($allowedExecutables -notcontains [IO.Path]::GetFileName([string]$options.FilePath)) {
                    throw "Classic FilePath must be relative or an allowed system executable."
                }
                if (-not (Get-Command -Name ([IO.Path]::GetFileName([string]$options.FilePath)) -CommandType Application -ErrorAction SilentlyContinue)) {
                    throw "Allowed system executable '$($options.FilePath)' is unavailable in the guest."
                }
            }
            elseif ([IO.Path]::GetFileName([string]$options.FilePath) -eq [string]$options.FilePath -and
                $allowedExecutables -contains [string]$options.FilePath) {
                if (-not (Get-Command -Name ([string]$options.FilePath) -CommandType Application -ErrorAction SilentlyContinue)) {
                    throw "Allowed system executable '$($options.FilePath)' is unavailable in the guest."
                }
            }
            else {
                $filePath = Resolve-PAWApplicationPayloadPath -PackageRoot $packageRoot -RelativePath ([string]$options.FilePath)
                if (-not (Test-Path -LiteralPath $filePath -PathType Leaf)) { throw "Classic installer payload was not found: '$filePath'." }
            }
            if (-not [string]::IsNullOrWhiteSpace([string]$options.WorkingDirectory)) {
                $workingPath = Resolve-PAWApplicationPayloadPath -PackageRoot $packageRoot -RelativePath ([string]$options.WorkingDirectory)
                if (-not (Test-Path -LiteralPath $workingPath -PathType Container) -and
                    ([string]$options.WorkingDirectory -ne '.' -or (Test-Path -LiteralPath $packageRoot))) {
                    throw "Classic working directory was not found: '$workingPath'."
                }
            }
            return [pscustomobject]@{ Ready = $true; Pending = $false; PackageRoot = $packageRoot }
        }
        'WindowsComponent' {
            if ($null -eq $options) { throw "WindowsComponent application '$($Application.Name)' requires Options." }
            if ([string]$options.Kind -notin @('Capability', 'OptionalFeature', 'ServerFeature')) {
                throw "Unsupported Windows component kind '$($options.Kind)'."
            }
            if (@($options.Names).Count -eq 0 -or @($options.Names | Where-Object { [string]::IsNullOrWhiteSpace([string]$_) }).Count) {
                throw "WindowsComponent application '$($Application.Name)' requires one or more Names."
            }
            if ($options.LimitAccess -and [string]::IsNullOrWhiteSpace([string]$options.Source)) {
                throw "WindowsComponent '$($Application.Name)' sets LimitAccess but has no offline Source payload."
            }
            if ($options.Kind -eq 'ServerFeature' -and $options.LimitAccess) {
                throw "ServerFeature '$($Application.Name)' cannot guarantee offline operation because Install-WindowsFeature does not support LimitAccess."
            }
            if (-not [string]::IsNullOrWhiteSpace([string]$options.Source)) {
                $sourcePath = Resolve-PAWApplicationPayloadPath -PackageRoot $packageRoot -RelativePath ([string]$options.Source)
                if (-not (Test-Path -LiteralPath $sourcePath -PathType Container)) {
                    throw "Windows component payload folder not found: '$sourcePath'."
                }
            }
            return [pscustomobject]@{ Ready = $true; Pending = $false; PackageRoot = $packageRoot; PendingGuestOperation = [string]::IsNullOrWhiteSpace([string]$options.Source) }
        }
        default { return $null }
    }
}
function Test-PAWDeployment {
    <#
    .SYNOPSIS
        Checks host capacity and resources before a PAW deployment.
    .DESCRIPTION
        Read-only resource preflight, not template-format validation. Resolves
        resource settings using the engine's precedence and returns all checks.
        RAM requires VM startup memory plus 1GB overhead and 4GB host reserve.
        Copy disk requires source file length plus 5GB build allowance and 5GB
        reserve; Diff requires 5GB build allowance plus 5GB reserve.
        Checks cannot guarantee future guest execution or reserve capacity.
    .PARAMETER ConfigPath
        Deployment configuration under the installation root.
    .PARAMETER TemplateData
        Already loaded deployment template.
    .PARAMETER Overrides
        Bound engine parameters or UI choices. Credentials are never returned.
    .PARAMETER AllowPendingDownloads
        Allows enabled WinGet/PSGallery downloads to prepare missing cache before
        a second full preflight. Local installers are always required.
    .PARAMETER ApplicationPlan
        Initial resolved bundle plan reused by the engine's final resource gate.
    .NOTES
        Version : 2.0.0.9
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$ConfigPath,
        [Parameter(Mandatory)][psobject]$TemplateData,
        [ValidateNotNull()][System.Collections.IDictionary]$Overrides = @{},
        [switch]$AllowPendingDownloads,
        [psobject]$ApplicationPlan
    )
    $boundOverrides = $Overrides
    $Overrides = @{}
    foreach ($key in $boundOverrides.Keys) { $Overrides[$key] = $boundOverrides[$key] }
    $checks = New-Object 'System.Collections.Generic.List[object]'
    $settings = [ordered]@{}
    $steps = [ordered]@{}
    $pending = New-Object 'System.Collections.Generic.List[string]'
    $addCheck = {
        param($Name, $Passed, $Message, $AvailableBytes = $null, $RequiredBytes = $null)
        $checks.Add([pscustomobject]@{
            Name = $Name; Passed = [bool]$Passed; Message = $Message
            AvailableBytes = $AvailableBytes; RequiredBytes = $RequiredBytes
        })
    }
    $checkPath = {
        param($Name, $Path, $Type = 'Leaf')
        try {
            if (-not $Path -or -not (Test-Path -LiteralPath $Path -PathType $Type -ErrorAction Stop)) { throw "Required $Type not found: '$Path'." }
            if ($Type -eq 'Leaf') {
                $stream = [IO.File]::OpenRead($Path)
                $stream.Dispose()
            }
            & $addCheck $Name $true "Available: '$Path'."
        }
        catch { & $addCheck $Name $false $_.Exception.Message }
    }
    try {
        $ConfigPath = (Get-Item -LiteralPath $ConfigPath -ErrorAction Stop).FullName
        $config = Get-Content -LiteralPath $ConfigPath -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
        $root = Split-Path -Parent (Split-Path -Parent $ConfigPath)
        $hyperV = $config.Settings.HyperV
        foreach ($definition in @(
            @{ Name = 'Memory'; Kind = 'PositiveInt'; Default = 3072 },
            @{ Name = 'DiskMode'; Kind = 'DiskMode'; Default = 'Diff' },
            @{ Name = 'VMGen'; Kind = 'VMGen'; Default = 2 },
            @{ Name = 'NoCPU'; Kind = 'PositiveInt'; Default = 2 }
        )) {
            $parameters = @{
                Name = $definition.Name; Kind = $definition.Kind; DefaultValue = $definition.Default
                TemplateValue = $TemplateData.($definition.Name); ConfigValue = $hyperV.($definition.Name)
            }
            if ($definition.Name -eq 'DiskMode' -and $Overrides.Contains('DiskMode')) { $parameters.CommandLineValue = $Overrides['DiskMode'] }
            $settings[$definition.Name] = Resolve-PAWSetting @parameters
        }
        $vmLocation = [string]$hyperV.VMFolder
        $locationSource = 'Config'
        if (-not $vmLocation) { $vmLocation = [string]$hyperV.VMLocation }
        if (-not $vmLocation) { $vmLocation = 'C:\VMs'; $locationSource = 'Default' }
        if ($Overrides.Contains('VMLocation')) { $vmLocation = [string]$Overrides['VMLocation']; $locationSource = 'CommandLine' }
        $settings.VMLocation = [pscustomobject]@{ Value = $vmLocation; Source = $locationSource }
        $vhdValue = [string]$TemplateData.VHDFile
        $vhdSource = 'Template'
        if ($Overrides.Contains('VHDX')) { $vhdValue = [string]$Overrides['VHDX']; $vhdSource = 'CommandLine' }
        $vhdPath = Resolve-PAWVHDFilePath -ConfigPath $ConfigPath -VHDFileValue $vhdValue
        $settings.VHDX = [pscustomobject]@{ Value = $vhdPath; Source = $vhdSource }
        $switchName = Resolve-PAWVMSwitchName -SwitchValue $TemplateData.VMSwitch
        $switchSource = 'Template'
        if ($Overrides.Contains('VMSwitchName')) { $switchName = Resolve-PAWVMSwitchName -SwitchValue $Overrides['VMSwitchName']; $switchSource = 'CommandLine' }
        $settings.VMSwitchName = [pscustomobject]@{ Value = $switchName; Source = $switchSource }
        & $checkPath 'Source VHDX' $vhdPath
        try {
            $diskPath = $vhdPath
            $parents = @{}
            while ($diskPath) {
                if ($parents.ContainsKey($diskPath)) { throw "Circular VHD parent chain at '$diskPath'." }
                $parents[$diskPath] = $true
                $vhd = Get-VHD -Path $diskPath -ErrorAction Stop
                $diskPath = [string]$vhd.ParentPath
                if ($diskPath) { & $checkPath 'Parent VHD' $diskPath }
            }
            & $addCheck 'VHD chain' $true 'Source disk and its parent chain are readable.'
        }
        catch { & $addCheck 'VHD chain' $false $_.Exception.Message }
        if ($locationSource -ne 'Default' -or (Test-Path -LiteralPath $vmLocation)) { & $checkPath 'VM location' $vmLocation 'Container' }
        else { & $addCheck 'VM location' $true "Default '$vmLocation' will be created only after successful preflight." }

        try {
            $null = Get-VMHost -ErrorAction Stop
            $switches = @(Get-VMSwitch -ErrorAction Stop)
            & $addCheck 'Hyper-V switch' ($switches.Name -contains $switchName) "Requested switch '$switchName'; available: $($switches.Name -join ', ')."
            if ($Overrides.Contains('VMName') -and $Overrides['VMName']) {
                $vmName = [string]$Overrides['VMName']
                $existing = @(Get-VM -ErrorAction Stop | Where-Object { $_.Name -eq $vmName })
                & $addCheck 'VM name' ($existing.Count -eq 0) "VM '$vmName' must not already exist."
                & $addCheck 'VM directory' (-not (Test-Path -LiteralPath (Join-Path $vmLocation $vmName) -ErrorAction Stop)) "VM directory '$vmLocation\$vmName' must not already exist."
            }
        }
        catch { & $addCheck 'Hyper-V access' $false $_.Exception.Message }
        try {
            $os = Get-CimInstance -ClassName Win32_OperatingSystem -ErrorAction Stop
            if ($null -eq $os.FreePhysicalMemory) { throw 'Available physical memory could not be determined.' }
            $availableMemory = [long]$os.FreePhysicalMemory * 1KB
            $requiredMemory = [long]$settings.Memory.Value * 1MB + 1GB + 4GB
            & $addCheck 'Host RAM' ($availableMemory -ge $requiredMemory) "Free RAM must cover $($settings.Memory.Value) MB VM startup memory + 1 GB overhead + 4 GB host reserve." $availableMemory $requiredMemory
        }
        catch { & $addCheck 'Host RAM' $false $_.Exception.Message }
        try {
            $diskBytes = if ($settings.DiskMode.Value -eq 'Copy') { (Get-Item -LiteralPath $vhdPath -ErrorAction Stop).Length } else { 0 }
            $requiredDisk = [long]$diskBytes + 5GB + 5GB
            $volumeRequirements = @{}
            foreach ($target in @(
                @{ Name = 'VM disk'; Path = $vmLocation; Required = $requiredDisk },
                @{ Name = 'Host temporary disk'; Path = $env:TEMP; Required = 5GB },
                @{ Name = 'Host system disk'; Path = $env:SystemRoot; Required = 5GB },
                @{ Name = 'Resource/cache disk'; Path = (Join-Path $root 'Resources'); Required = 5GB }
            )) {
                if (-not $target.Path) { continue }
                $ancestor = $target.Path
                while (-not (Test-Path -LiteralPath $ancestor -ErrorAction Stop)) {
                    $ancestor = Split-Path -Parent $ancestor
                    if (-not $ancestor) { throw "Cannot resolve volume for '$($target.Path)'." }
                }
                $volumes = @(Get-Volume -FilePath ((Get-Item -LiteralPath $ancestor -ErrorAction Stop).FullName) -ErrorAction Stop)
                if ($volumes.Count -ne 1 -or $null -eq $volumes[0].SizeRemaining) { throw "Cannot determine free disk space for '$($target.Path)'." }
                $volume = $volumes[0]
                $key = [string]$volume.UniqueId
                if (-not $key) { throw "Cannot identify volume for '$($target.Path)'." }
                if (-not $volumeRequirements.ContainsKey($key)) {
                    $volumeRequirements[$key] = @{ Available = [long]$volume.SizeRemaining; Required = [long]$target.Required; Paths = @($target.Path) }
                }
                else {
                    $volumeRequirements[$key].Required = [Math]::Max($volumeRequirements[$key].Required, [long]$target.Required)
                    $volumeRequirements[$key].Paths += $target.Path
                }
            }
            foreach ($volume in $volumeRequirements.Values) {
                & $addCheck 'Host disk' ($volume.Available -ge $volume.Required) "Disk space for $($volume.Paths -join ', '): $($settings.DiskMode.Value) source copy allowance plus build/host reserves." $volume.Available $volume.Required
            }
        }
        catch { & $addCheck 'Host disk' $false $_.Exception.Message }

        $resourcesFolder = Join-Path $root 'Resources'
        $applicationDownloadsFolder = Join-Path $resourcesFolder 'ApplicationDownloads'
        $extraFolder = $null
        $extraSource = 'NotConfigured'
        if ($Overrides.Contains('ExtraFolder') -and $Overrides['ExtraFolder']) { $extraFolder = [string]$Overrides['ExtraFolder']; $extraSource = 'CommandLine' }
        $settings.ExtraFolder = [pscustomobject]@{ Value = $extraFolder; Source = $extraSource }
        if ($extraFolder) { & $checkPath 'Copy Folder' $extraFolder 'Container' }
        else { & $addCheck 'Copy Folder' $true 'No additional folder configured.' }
        & $checkPath 'PAWUtility manifest' (Join-Path $root 'Functions\PAWUtility\PAWUtility.psd1')
        $runScript = [string]$TemplateData.RunScript
        if ($Overrides.Contains('RunScript')) { $runScript = [string]$Overrides['RunScript'] }
        $steps.RunScript = -not $Overrides['SkipRunScript'] -and $runScript -and $runScript.Trim() -ne 'NA'
        $settings.RunScript = [pscustomobject]@{ Value = $runScript; Source = $(if ($Overrides.Contains('RunScript')) { 'CommandLine' } else { 'Template' }) }
        if ($steps.RunScript) {
            $customScripts = Resolve-PAWCustomScriptsFolder -InstallFolderPath $root
            & $checkPath 'RunScript' (Join-Path $customScripts $runScript)
        }
        $steps.Application = -not $Overrides['SkipApplication'] -and $TemplateData.Application -ne 'False' -and
            ([string]$(if ($Overrides.Contains('ApplicationBundle')) { $Overrides['ApplicationBundle'] } else { $TemplateData.ApplicationBundle })).Trim() -ne 'NA'
        if ($steps.Application) {
            $appRoot = $resourcesFolder
            & $checkPath 'Application download tool' (Join-Path $root 'Tools\Invoke-PAWApplicationDownload.ps1')
            & $checkPath 'Application install script' (Join-Path $resourcesFolder 'Applications\Invoke-PAWInstallApplications.ps1')
            try {
                if ($null -eq $ApplicationPlan) {
                    $ApplicationPlan = Resolve-PAWDeploymentApplications -ConfigPath $ConfigPath -TemplateData $TemplateData -Overrides $Overrides
                }
                $settings.ApplicationBundle = [pscustomobject]@{
                    Value = $ApplicationPlan.BundleId
                    Source = $(if ($Overrides.Contains('ApplicationBundle')) { 'CommandLine' } else { 'Template' })
                }
                & $addCheck 'Application bundle' $true "Bundle '$($ApplicationPlan.BundleId)' resolved. Disabled applications: $($ApplicationPlan.DisabledApplications -join ', ')."
                $apps = @($ApplicationPlan.Applications)
                foreach ($app in $apps) {
                    if ($app.Source -eq 'WinGet') {
                        & $addCheck "WinGet $($app.Name)" ([bool](Get-Command winget -CommandType Application -ErrorAction SilentlyContinue)) 'WinGet is required to prepare this application.'
                    }
                    if ($app.Source -eq 'PSGallery' -and ($null -eq $app.Options -or $app.Options.Origin -eq 'PSGallery')) {
                        & $addCheck "PSGallery $($app.Name)" ([bool](Get-Command Save-Module -ErrorAction SilentlyContinue)) 'PowerShellGet Save-Module is required to prepare this module.'
                    }
                    $typedRuntime = $app.Source -in @('Classic', 'WindowsComponent') -or
                        ($app.Source -eq 'PSGallery' -and $null -ne $app.Options)
                    if ($typedRuntime) {
                        try {
                            $resource = Test-PAWApplicationResources -Application $app -AppInstallRoot $appRoot -AllowPendingDownloads:$AllowPendingDownloads
                            if ($resource.Pending) {
                                $pending.Add($app.Name)
                                & $addCheck "Application $($app.Name)" $true $resource.Message
                            }
                            else {
                                $message = 'Typed application package is available.'
                                if ($resource.PendingGuestOperation) {
                                    $message = 'No host download. Component availability and installation will be checked against the guest OS.'
                                }
                                & $addCheck "Application $($app.Name)" $true $message
                            }
                        }
                        catch { & $addCheck "Application $($app.Name)" $false $_.Exception.Message }
                        continue
                    }
                    if ($AllowPendingDownloads -and $app.Source -ne 'Local') {
                        $pending.Add($app.Name)
                        continue
                    }
                    if (-not $app.InstallEnabled -and $app.Source -ne 'Local') { continue }
                    try {
                        if ($AllowPendingDownloads -and $app.Source -eq 'Local') {
                            $localFolder = Get-PAWLocalApplicationFolder -LocalRoot (Join-Path $applicationDownloadsFolder 'Local') -Name $app.Name
                            $localFiles = @(Get-ChildItem -LiteralPath $localFolder -File -ErrorAction Stop)
                            if ($localFiles.Count -ne 1) { throw "Local application '$($app.Name)' requires exactly one installer in '$localFolder'." }
                            $pending.Add($app.Name)
                        }
                        elseif ($app.Source -eq 'PSGallery') {
                            $moduleCache = Join-Path $applicationDownloadsFolder 'Modules'
                            $queue = New-Object 'System.Collections.Generic.Queue[string]'
                            $queue.Enqueue($app.Id)
                            $visited = @{}
                            while ($queue.Count) {
                                $moduleName = $queue.Dequeue()
                                if ($visited.ContainsKey($moduleName)) { continue }
                                $visited[$moduleName] = $true
                                $moduleRoot = Join-Path $moduleCache $moduleName
                                $latest = Get-ChildItem -LiteralPath $moduleRoot -Directory -ErrorAction Stop |
                                    Where-Object { $_.Name -as [version] } | Sort-Object { [version]$_.Name } -Descending | Select-Object -First 1
                                if (-not $latest) { throw "Module cache missing for '$moduleName' at '$moduleRoot'." }
                                $manifest = Import-PowerShellDataFile -LiteralPath (Join-Path $latest.FullName "$moduleName.psd1") -ErrorAction Stop
                                foreach ($dependency in @($manifest.RequiredModules)) {
                                    $dependencyName = if ($dependency -is [hashtable]) { [string]$dependency.ModuleName } else { [string]$dependency }
                                    if ($dependencyName) { $queue.Enqueue($dependencyName) }
                                }
                            }
                        }
                        else {
                            $definition = Get-PAWApplicationInstallFile -Path (Get-PAWApplicationInstallFilePath -InstallRoot (Join-Path $resourcesFolder 'Applications\InstallFiles') -Name $app.Name)
                            $cache = if ($app.Source -eq 'Local') { Get-PAWLocalApplicationFolder -LocalRoot (Join-Path $applicationDownloadsFolder 'Local') -Name $app.Name }
                                else { Get-PAWWinGetCacheFolder -CacheRoot $applicationDownloadsFolder -Name $app.Name }
                            $installer = Join-Path $cache $definition.Installer.InstallerFile
                            if ($app.Source -eq 'WinGet') {
                                $summary = Get-Content -LiteralPath (Join-Path $cache 'PAWApplication.json') -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
                                if ($summary.InstallerFile -ne $definition.Installer.InstallerFile) { throw "Installer metadata mismatch for '$($app.Name)'." }
                                Assert-PAWInstallerHash -Path $installer -ExpectedHash $summary.InstallerSha256 -ApplicationName $app.Name
                            }
                            else {
                                if (-not (Test-Path -LiteralPath $installer -PathType Leaf -ErrorAction Stop)) { throw "Local installer missing: '$installer'." }
                            }
                        }
                        & $addCheck "Application $($app.Name)" $true 'Installation resources available.'
                    }
                    catch { & $addCheck "Application $($app.Name)" $false $_.Exception.Message }
                }
            }
            catch { & $addCheck 'Applications' $false $_.Exception.Message }
        }
        $baseline = [string]$TemplateData.SecurityBaselineLocation
        $steps.SecurityBaseline = -not $Overrides['SkipSecurityBaseLine'] -and $baseline -and $baseline.Trim() -ne 'NA'
        if ($steps.SecurityBaseline) {
            try {
                $baselinePath = Resolve-PAWSecurityBaselinePath -ConfigPath $ConfigPath -SecurityBaselineLocationValue $baseline
                & $checkPath 'Security baseline folder' $baselinePath 'Container'
                if ($TemplateData.ApplySecurityBaseline -eq 'True') {
                    foreach ($kind in @('OS', 'Edge')) {
                        & $checkPath "$kind baseline script" (Join-Path $baselinePath "$kind\Scripts\Baseline-LocalInstall.ps1")
                        & $checkPath "$kind LGPO" (Join-Path $baselinePath "$kind\Scripts\Tools\LGPO.exe")
                    }
                }
            }
            catch { & $addCheck 'Security baseline' $false $_.Exception.Message }
        }
        $policyName = [string]$TemplateData.WDACPolicyFile
        if ($Overrides.Contains('WDACPolicy')) { $policyName = [string]$Overrides['WDACPolicy'] }
        $steps.WDAC = -not $Overrides['SkipWDAC'] -and $policyName -and $policyName.Trim() -ne 'NA'
        $settings.WDACPolicy = [pscustomobject]@{ Value = $policyName; Source = $(if ($Overrides.Contains('WDACPolicy')) { 'CommandLine' } else { 'Template' }) }
        if ($steps.WDAC) {
            try {
                if ([IO.Path]::GetFileName($policyName) -ne $policyName) { throw 'WDAC policy must be a filename in Resources\WDACPolicies.' }
                $policy = Get-PAWWDACPolicy -Path (Join-Path (Join-Path $root 'Resources\WDACPolicies') $policyName)
                if (-not $policy.Unsigned) { throw 'WDAC XML requires signing; unsigned compilation cannot deploy it.' }
                & $addCheck 'WDAC policy' $true "Policy '$policyName' available ($($policy.Mode)); guest support/activation requires later verification."
            }
            catch { & $addCheck 'WDAC policy' $false $_.Exception.Message }
        }
        $steps.ASR = -not $Overrides['SkipASR'] -and ([string]$TemplateData.ASR).Trim() -ne 'False'
        $shielding = if ([string]::IsNullOrWhiteSpace([string]$TemplateData.Shielding)) { $TemplateData.Shielded } else { $TemplateData.Shielding }
        $steps.Shielding = -not $Overrides['SkipShielding'] -and ([string]$shielding).Trim() -ne 'False'
        $steps.DiskEncryption = -not $Overrides['SkipDiskEncryption'] -and ([string]$TemplateData.BitLocker).Trim() -ne 'False'
        $steps.Link = -not $Overrides['SkipLink']
        foreach ($definition in @(
            @{ Step = 'ASR'; Setting = 'ASR'; Skip = 'SkipASR' },
            @{ Step = 'Shielding'; Setting = 'Shielded'; Skip = 'SkipShielding' },
            @{ Step = 'DiskEncryption'; Setting = 'BitLocker'; Skip = 'SkipDiskEncryption' },
            @{ Step = 'Application'; Setting = 'Application'; Skip = 'SkipApplication' },
            @{ Step = 'SecurityBaseline'; Setting = 'SecurityBaselineLocation'; Skip = 'SkipSecurityBaseLine' }
        )) {
            $sourceName = if ($Overrides[$definition.Skip]) { 'CommandLine' }
                elseif ($null -ne $TemplateData.PSObject.Properties[$definition.Setting]) { 'Template' } else { 'Default' }
            $settings[$definition.Step] = [pscustomobject]@{ Value = [bool]$steps[$definition.Step]; Source = $sourceName }
        }
    }
    catch { & $addCheck 'Resource resolution' $false $_.Exception.Message }
    $errors = @($checks | Where-Object { -not $_.Passed })
    [pscustomobject]@{
        CanPrepare = $errors.Count -eq 0
        CanDeploy = $errors.Count -eq 0 -and $pending.Count -eq 0
        Settings = [pscustomobject]$settings; Steps = [pscustomobject]$steps
        Checks = $checks.ToArray(); Errors = $errors; PendingDownloads = $pending.ToArray()
        ApplicationPlan = $ApplicationPlan
        Warnings = @('Capacity is checked, not reserved. Guest compatibility, domain access and future downloads/operations cannot be guaranteed.')
    }
}
<#

.SYNOPSIS
    Returns whether the current Windows process is running as administrator.

.DESCRIPTION
    Returns whether the current Windows process is running as administrator.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Test-PAWIsElevated {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = [Security.Principal.WindowsPrincipal]::new($identity)
    return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}
<#

.SYNOPSIS
    Checks for a template value and assigns the fallback value when the parameter is not set.

.DESCRIPTION
   Check if parameter is used, if not, set the value from the template

.PARAMETER ParameterName
    Name of the template parameter whose value is checked.

.PARAMETER FallbackValue
    Value assigned in script scope when the template has no value for ParameterName.

.EXAMPLE
   Test-PAWParameter -ParameterName "VMName" -FallbackValue "NA"

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Test-PAWParameter {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$ParameterName,

        [Parameter(Mandatory = $true)]
        [string]$FallbackValue
    )

    # Use data from template if not overrided by command line
    if ($TemplateData.$ParameterName -ne "") {
        Write-Host -ForegroundColor Green "$ParameterName is loaded from Template [$($TemplateData.$ParameterName)]"
        if ($PSBoundParameters.ContainsKey("$ParameterName") -eq $True) {
            Write-Host -ForegroundColor Yellow "$ParameterName has been overridden [$($PSBoundParameters["$ParameterName"])]"
        }
        else {
            New-Variable -Name $ParameterName -Value $TemplateData.$ParameterName -Scope Script -Force
        }
    }
    else {
        Write-Host -ForegroundColor Yellow "$ParameterName is not set in Template"
        if ($PSBoundParameters.ContainsKey("$ParameterName") -eq $True) {
            Write-Host -ForegroundColor Yellow "$ParameterName has been overridden [$($PSBoundParameters["$ParameterName"])]"
        }
        else {
            New-Variable -Name $ParameterName -Value $FallbackValue -Scope Script -Force
            Write-Host -ForegroundColor Green "$ParameterName is not set" -Scope Script -Force
        }
    }
}
<#

.SYNOPSIS
    Checks configured template references and warns when referenced resources are unavailable.

.DESCRIPTION
    Checks that a file, folder, or Hyper-V switch referenced by a template
    setting exists, and writes a warning when it does not. Nothing is thrown,
    so a template can be prepared before the referenced item exists.

    Checked settings:
    - VHDFile: the VHDX file (resolved with Resolve-PAWVHDFilePath)
    - RunScript: the script relative to Resources, or a bare name in Resources\CustomScripts
      (NA or empty is skipped)
    - SecurityBaselineLocation: the baseline folder (empty is skipped)
    - VMSwitch: the Hyper-V switch (Get-VMSwitch requires an elevated session)

    Other settings are ignored.

.PARAMETER ConfigPath
    Path to Config.json, used to resolve the configured folders.

.PARAMETER SettingName
    The template setting name.

.PARAMETER Value
    The setting value.

.EXAMPLE
    Test-PAWTemplateReference -ConfigPath 'C:\PAWDeploy\Config\Config.json' -SettingName 'VHDFile' -Value 'W11.vhdx'

.NOTES
    Version : 2.0.0.3
    Author  : The Fantastic PAWDeploy Team

#>
function Test-PAWTemplateReference {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$ConfigPath,

        [Parameter(Mandatory = $true)]
        [string]$SettingName,

        [Parameter(Mandatory = $true)]
        [AllowEmptyString()]
        [string]$Value
    )

    switch ($SettingName) {
        'ApplicationBundle' {
            try {
                $null = Resolve-PAWDeploymentApplications -ConfigPath $ConfigPath -TemplateData ([pscustomobject]@{
                    Application = 'True'; ApplicationBundle = $Value
                })
            }
            catch { Write-Warning "ApplicationBundle '$Value': $($_.Exception.Message)" }
        }
        'VHDFile' {
            $vhdPath = Resolve-PAWVHDFilePath -ConfigPath $ConfigPath -VHDFileValue $Value
            if ([string]::IsNullOrEmpty($vhdPath) -or -not (Test-Path -LiteralPath $vhdPath -PathType Leaf)) {
                Write-Warning "VHDFile not found: $vhdPath"
            }
        }
        'RunScript' {
            if (-not [string]::IsNullOrEmpty($Value) -and $Value -ne 'NA') {
                $resourcesFolder = Join-Path (Split-Path -Parent (Split-Path -Parent $ConfigPath)) 'Resources'
                $scriptPath = Join-Path $resourcesFolder $Value
                if (-not (Test-Path -LiteralPath $scriptPath -PathType Leaf)) {
                    $scriptPath = Join-Path (Join-Path $resourcesFolder 'CustomScripts') $Value
                }
                if (-not (Test-Path -LiteralPath $scriptPath -PathType Leaf)) {
                    Write-Warning "RunScript not found: $scriptPath"
                }
            }
        }
        'SecurityBaselineLocation' {
            if (-not [string]::IsNullOrEmpty($Value)) {
                $baselinePath = Resolve-PAWSecurityBaselinePath -ConfigPath $ConfigPath -SecurityBaselineLocationValue $Value
                if (-not (Test-Path -LiteralPath $baselinePath -PathType Container)) {
                    Write-Warning "SecurityBaselineLocation not found: $baselinePath"
                }
            }
        }
        'VMSwitch' {
            if (Get-Command -Name 'Get-VMSwitch' -ErrorAction SilentlyContinue) {
                try {
                    $null = Get-VMSwitch -Name $Value -ErrorAction Stop
                }
                catch {
                    Write-Warning "Hyper-V switch '$Value' was not found or could not be queried (Get-VMSwitch requires an elevated session)."
                }
            }
        }
    }
}
Function Test-PAWVMDeployment {
    <#
    .SYNOPSIS
        Tests whether VM deployment has completed.

    .DESCRIPTION
        Reads Hyper-V KVP data and returns True when OSDeployment is set to Done.

    .PARAMETER VMname
        Name of the virtual machine to query.

    .EXAMPLE
        Test-PAWVMDeployment -VMname "PAW-01"
        Returns True when OSDeployment=Done; otherwise False.

    .EXAMPLE
        if (Test-PAWVMDeployment -VMname "PAW-01") { "Ready" }
        Performs a deployment readiness check.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [cmdletbinding()]
    [OutputType([bool])]

    Param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]
        $VMname
    )
    #Check if VM exists
    if ((Test-PAWVMExists -VMname $VMname) -eq $false) {
        Write-Warning "Could not find $VMname"
        return $false
    }

    $deploymentState = Get-PAWKVPData -VMName $VMname -ErrorAction SilentlyContinue |
    Where-Object -Property Name -EQ -Value OSDeployment |
    Select-Object -First 1 -ExpandProperty Data

    if ($deploymentState -eq "Done") {
        return $true
    }
    else {
        return $false
    }
}
