<#

.SYNOPSIS
    Adds DataGridView dropdown cells for a key/value editor.

.DESCRIPTION
    Adds DataGridView dropdown cells for a key/value editor.

.PARAMETER Grid
    DataGridView whose setting-value rows receive dropdown cells.

.PARAMETER AllowedValuesProvider
    Optional script block returning strings or objects with Name and Value.
    Object names are displayed while their values are stored in the grid.

.PARAMETER KeyColumnName
    Name of the grid column containing setting keys. Defaults to 'Setting'.

.PARAMETER ValueColumnName
    Name of the grid column containing setting values. Defaults to 'Value'.

.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team

#>
function Add-PAWTemplateSettingsEditorDropDowns {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [System.Windows.Forms.DataGridView]$Grid,

        [Parameter(Mandatory = $false)]
        [scriptblock]$AllowedValuesProvider = $null,

        [Parameter(Mandatory = $false)]
        [string]$KeyColumnName = 'Setting',

        [Parameter(Mandatory = $false)]
        [string]$ValueColumnName = 'Value'
    )

    if ($null -eq $Grid -or -not $Grid.Columns.Contains($KeyColumnName) -or -not $Grid.Columns.Contains($ValueColumnName)) {
        return
    }

    foreach ($row in @($Grid.Rows)) {
        if ($row.IsNewRow) {
            continue
        }

        $settingName = [string]$row.Cells[$KeyColumnName].Value
        if ([string]::IsNullOrWhiteSpace($settingName)) {
            continue
        }

        if ([string]::Equals($settingName, 'Name', [System.StringComparison]::OrdinalIgnoreCase)) {
            $row.Cells[$ValueColumnName].ReadOnly = $true
            continue
        }

        $row.Cells[$ValueColumnName].ReadOnly = $false

        $allowedValues = @()
        if ($null -ne $AllowedValuesProvider) {
            $allowedValues = @(& $AllowedValuesProvider $settingName | Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) })
        }

        if ($allowedValues.Count -eq 0) {
            continue
        }

        $currentValue = [string]$row.Cells[$ValueColumnName].Value
        $comboCell = New-Object System.Windows.Forms.DataGridViewComboBoxCell
        $comboCell.FlatStyle = [System.Windows.Forms.FlatStyle]::Flat
        $comboCell.DisplayStyle = [System.Windows.Forms.DataGridViewComboBoxDisplayStyle]::ComboBox
        $comboCell.DisplayStyleForCurrentCellOnly = $false

        $options = New-Object System.Data.DataTable
        [void]$options.Columns.Add('Name', [string])
        [void]$options.Columns.Add('Value', [string])
        foreach ($allowedValue in $allowedValues) {
            if ($allowedValue -is [string]) {
                [void]$options.Rows.Add($allowedValue, $allowedValue)
            }
            else {
                if ($null -eq $allowedValue.PSObject.Properties['Name'] -or
                    $null -eq $allowedValue.PSObject.Properties['Value']) {
                    throw "Dropdown options for '$settingName' must provide Name and Value."
                }
                [void]$options.Rows.Add([string]$allowedValue.Name, [string]$allowedValue.Value)
            }
        }
        if (-not [string]::IsNullOrWhiteSpace($currentValue) -and
            $currentValue -notin @($options.Rows | ForEach-Object { [string]$_['Value'] })) {
            [void]$options.Rows.Add($currentValue, $currentValue)
        }
        if (@($allowedValues | Where-Object { $_ -isnot [string] }).Count -gt 0) {
            $comboCell.DisplayMember = 'Name'
            $comboCell.ValueMember = 'Value'
            $comboCell.DataSource = $options
        }
        else {
            foreach ($option in $options.Rows) { [void]$comboCell.Items.Add([string]$option['Value']) }
        }

        if ([string]::IsNullOrWhiteSpace($currentValue)) {
            $comboCell.Value = [string]$options.Rows[0]['Value']
        }
        else {
            $comboCell.Value = $currentValue
        }

        $row.Cells[$ValueColumnName] = $comboCell
    }
}
function Add-PAWUiRibbon {
    <#
