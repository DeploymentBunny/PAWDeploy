function Get-PAWVMDetails {
    <#
    .SYNOPSIS
        Returns VM state, underlying disk mode, location and Hyper-V creation time.
    .DESCRIPTION
        Ignores checkpoint AVHD/AVHDX layers when identifying the underlying
        differencing or standalone disk. A standalone disk is displayed as Copy
        disk; this describes its current structure, not its deployment history.
        Unavailable metadata is reported with a warning and Unknown, not guessed.
    .PARAMETER VM
        Hyper-V virtual machine to inspect.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param([Parameter(Mandatory, ValueFromPipeline)][psobject]$VM)
    process {
        $diskMode = 'Unknown'
        try {
            $drives = @(Get-VMHardDiskDrive -VM $VM -ErrorAction Stop)
            $modes = @(
                foreach ($drive in $drives) {
                    if (-not $drive.Path) { throw 'Attached disk has no VHD path.' }
                    $path = [string]$drive.Path
                    $visited = @{}
                    while ($true) {
                        if ($visited.ContainsKey($path)) { throw "Circular disk chain at '$path'." }
                        $visited[$path] = $true
                        $disk = Get-VHD -Path $path -ErrorAction Stop
                        if ([IO.Path]::GetExtension($path) -in @('.avhd', '.avhdx')) {
                            if (-not $disk.ParentPath) { throw "Checkpoint disk has no parent: '$path'." }
                            $path = [string]$disk.ParentPath
                            continue
                        }
                        switch ([string]$disk.VhdType) {
                            'Differencing' { 'Diff disk' }
                            'Dynamic' { 'Copy disk' }
                            'Fixed' { 'Copy disk' }
                            default { throw "Unknown disk type '$($disk.VhdType)' at '$path'." }
                        }
                        break
                    }
                }
            )
            $distinct = @($modes | Sort-Object -Unique)
            $diskMode = if ($drives.Count -eq 0) { 'No disk' }
                elseif ($distinct.Count -eq 1) { $distinct[0] } else { 'Mixed (Diff/Copy)' }
        }
        catch { Write-Warning "Cannot determine disk mode for VM '$($VM.Name)': $($_.Exception.Message)" }
        $creationTime = $VM.CreationTime
        if ($null -eq $creationTime) { Write-Warning "Hyper-V creation time is unavailable for VM '$($VM.Name)'." }
        $location = [string]$VM.ConfigurationLocation
        if (-not $location) {
            Write-Warning "Configuration location is unavailable for VM '$($VM.Name)'."
            $location = 'Unknown'
        }
        [pscustomobject]@{
            Name = [string]$VM.Name
            State = [string]$VM.State
            DiskMode = $diskMode
            Location = $location
            CreationTime = $creationTime
        }
    }
}
