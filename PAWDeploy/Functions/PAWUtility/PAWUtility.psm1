Function Get-PAWActiveDiffDisk {
    <#
    .SYNOPSIS
        Returns unique parent disk paths currently referenced by differencing VHDs.

    .DESCRIPTION
        Get-PAWActiveDiffDisk inspects virtual hard disks attached to Hyper-V VMs,
        identifies differencing disks, and returns the unique parent VHD/VHDX paths
        in use.

        By default, all VMs on the host are inspected. Use -VMName to scope the
        query to specific VMs.

    .PARAMETER VMName
        Optional one or more VM names to inspect. If omitted, all VMs are checked.
        Accepts pipeline input.

    .EXAMPLE
        Get-PAWActiveDiffDisk

        Returns all unique parent disk paths referenced by differencing disks on
        the host.

    .EXAMPLE
        Get-PAWActiveDiffDisk -VMName "PAW-01","PAW-02"

        Returns active differencing parent paths only for PAW-01 and PAW-02.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>

    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(ValueFromPipeline = $true, ValueFromPipelineByPropertyName = $true)]
        [Alias('Name')]
        [ValidateNotNullOrEmpty()]
        [string[]]$VMName
    )

    process {
        $vms = if ($PSBoundParameters.ContainsKey('VMName')) {
            Get-VM -Name $VMName -ErrorAction Stop
        }
        else {
            Get-VM
        }

        $vmHardDiskDrives = Get-VMHardDiskDrive -VM $vms -ErrorAction Stop
        $activeDisks = foreach ($vmHardDiskDrive in $vmHardDiskDrives) {
            try {
                $vhd = Get-VHD -Path $vmHardDiskDrive.Path -ErrorAction Stop
                if ($vhd.VhdType -eq 'Differencing' -and -not [string]::IsNullOrWhiteSpace($vhd.ParentPath)) {
                    $vhd.ParentPath
                }
            }
            catch {
                Write-Verbose "Skipping disk path '$($vmHardDiskDrive.Path)': $($_.Exception.Message)"
            }
        }

        $activeDisks | Sort-Object -Unique
    }
}
<#

.SYNOPSIS
    Returns tab-completion candidates for application parameters.

.DESCRIPTION
    Returns tab-completion results for the application parameters of
    Invoke-PAWApplicationSettings.ps1 and Invoke-PAWApplicationDownload.ps1:

    - Name: application names in the catalog. With -New, the folders
      in ApplicationDownloads\Local that are not in the catalog yet (a Local
      application uses the folder with its name).
    - Id: WinGet package identifiers and PSGallery module names already used
      in Applications.json.
    - Source, Architecture, Scope, InstallerType and
      InstallEnabled: the allowed values.
    - ApplicationBundle: bundle names, or IDs for ambiguous/reserved names, and NA.

    Definitions are read from Resources\ApplicationCatalog below the script
    folder. Local installer names are read from Resources\ApplicationDownloads\Local.

    Values that start with the typed text are returned first; when there are
    none, values that contain the typed text are returned. Values that need
    quoting are quoted.

    ApplicationBundle completion loads PAWApplicationManager to validate bundles.

.PARAMETER ParameterName
    Name of the parameter being completed.

.PARAMETER WordToComplete
    The text typed so far.

.PARAMETER ScriptFolder
    Folder of the calling script.

.PARAMETER BoundParameters
    The parameters already typed on the command line (fakeBoundParameters).

.EXAMPLE
    Get-PAWApplicationArgumentCompletion -ParameterName Name -WordToComplete '7' -ScriptFolder 'C:\PAWDeploy'

.NOTES
    Version : 2.0.0.7
    Author  : The Fantastic PAWDeploy Team

#>
function Get-PAWApplicationArgumentCompletion {
    [CmdletBinding()]
    [OutputType([System.Management.Automation.CompletionResult])]
    param(
        [Parameter(Mandatory = $true)]
        [string]$ParameterName,

        [Parameter(Mandatory = $false)]
        [AllowEmptyString()]
        [AllowNull()]
        [string]$WordToComplete = '',

        [Parameter(Mandatory = $true)]
        [string]$ScriptFolder,

        [Parameter(Mandatory = $false)]
        [AllowNull()]
        [System.Collections.IDictionary]$BoundParameters
    )

    if ($null -eq $BoundParameters) {
        $BoundParameters = @{}
    }

    if ($ParameterName -eq 'ApplicationBundle') {
        $bundles = @()
        try {
            $manifest = Join-Path $ScriptFolder 'Functions\PAWApplicationManager\PAWApplicationManager.psd1'
            Import-Module -Global $manifest -ErrorAction Stop
            $bundles = @(Get-PAWApplicationBundle -Root (Join-Path $ScriptFolder 'Resources') -ErrorAction Stop |
                Sort-Object Name, BundleId)
        }
        catch {
            Write-Warning "Unable to complete application bundles: $($_.Exception.Message)"
        }

        $nameCounts = @{}
        foreach ($bundle in $bundles) {
            if (-not $nameCounts.ContainsKey($bundle.Name)) { $nameCounts[$bundle.Name] = 0 }
            $nameCounts[$bundle.Name]++
        }
        $choices = @()
        foreach ($bundle in $bundles) {
            $parsedId = [guid]::Empty
            $ambiguous = $nameCounts[$bundle.Name] -gt 1
            $reserved = $bundle.Name -eq 'NA' -or [guid]::TryParse($bundle.Name, [ref]$parsedId)
            $value = if ($ambiguous -or $reserved) { $bundle.BundleId } else { $bundle.Name }
            $choices += [pscustomobject]@{ Name = $bundle.Name; Value = $value; Id = $bundle.BundleId }
        }
        $choices += [pscustomobject]@{ Name = 'NA'; Value = 'NA'; Id = $null }
        $typedText = ([string]$WordToComplete).Trim([char[]]"'`"").Replace("''", "'")
        $escapedText = [System.Management.Automation.WildcardPattern]::Escape($typedText)
        $matched = @($choices | Where-Object { $_.Name -like "$escapedText*" -or $_.Value -like "$escapedText*" -or $_.Id -like "$escapedText*" })
        if ($matched.Count -eq 0 -and $typedText.Length -gt 0) {
            $matched = @($choices | Where-Object { $_.Name -like "*$escapedText*" -or $_.Value -like "*$escapedText*" -or $_.Id -like "*$escapedText*" })
        }
        foreach ($choice in $matched) {
            $completionText = [string]$choice.Value
            if ($choice.Id -and $choice.Value -eq $choice.Name) {
                $completionText = "'" + $completionText.Replace("'", "''") + "'"
            }
            $label = if ($choice.Id) { "$($choice.Name) [$($choice.Id)]" } else { 'NA' }
            [System.Management.Automation.CompletionResult]::new($completionText, $label, 'ParameterValue', $label)
        }
        return
    }

    $allowedValues = @{
        Source          = @('WinGet', 'PSGallery', 'Local')
        Architecture    = @('x86', 'x64', 'arm64', 'NA')
        Scope           = @('Machine', 'User', 'NA')
        InstallerType   = @('msi', 'wix', 'msix', 'appx', 'exe', 'burn', 'inno', 'nullsoft', 'zip', 'portable', 'NA')
        InstallEnabled  = @('True', 'False')
    }

    $getResourcesFolder = { Join-Path $ScriptFolder 'Resources' }

    $getApplications = {
        param([string]$ResourcesFolder)
        $catalogPath = Join-Path $ResourcesFolder 'ApplicationCatalog'
        if (-not (Test-Path -LiteralPath $catalogPath -PathType Container)) {
            return
        }
        @(Get-ChildItem -LiteralPath $catalogPath -Filter '*.json' -File -ErrorAction Stop | ForEach-Object {
            $app = Get-Content -LiteralPath $_.FullName -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
            if ($app.SchemaVersion -eq 2) {
                [pscustomobject]@{
                    Name = $app.Definition.Name
                    Source = $app.Type
                    Id = $app.Definition.Configuration.Id
                }
            }
            else { $app.Definition }
        }) |
            Where-Object { $null -ne $_ -and -not [string]::IsNullOrWhiteSpace([string]$_.Name) }
    }

    $candidates = @()
    $descriptions = @{}
    try {
        switch ($ParameterName) {
            'Name' {
                $resourcesFolder = & $getResourcesFolder
                $applications = @(& $getApplications $resourcesFolder)
                if ($BoundParameters.Contains('New')) {
                    $localFolder = Join-Path $resourcesFolder 'ApplicationDownloads\Local'
                    if (Test-Path -LiteralPath $localFolder -PathType Container) {
                        $listedNames = @($applications | ForEach-Object { ([string]$_.Name).Trim() })
                        $candidates = @(Get-ChildItem -LiteralPath $localFolder -Directory | Where-Object { $listedNames -notcontains $_.Name } | Sort-Object Name | ForEach-Object { $_.Name })
                        foreach ($candidate in $candidates) {
                            $descriptions[$candidate] = "Local folder: $candidate"
                        }
                    }
                }
                else {
                    foreach ($application in $applications) {
                        $applicationName = ([string]$application.Name).Trim()
                        $candidates += $applicationName
                        $descriptions[$applicationName] = "$($application.Source): $($application.Id)"
                    }
                }
            }
            'Id' {
                $applications = @(& $getApplications (& $getResourcesFolder))
                $candidates = @($applications | ForEach-Object { ([string]$_.Id).Trim() } | Where-Object { -not [string]::IsNullOrWhiteSpace($_) -and $_ -ne 'NA' } | Sort-Object -Unique)
            }
            default {
                if (-not $allowedValues.ContainsKey($ParameterName)) {
                    return
                }
                $candidates = $allowedValues[$ParameterName]
            }
        }
    }
    catch {
        return
    }

    $typedText = ''
    if ($null -ne $WordToComplete) {
        $typedText = ([string]$WordToComplete).Trim([char[]]"'`"")
    }
    $escapedText = [System.Management.Automation.WildcardPattern]::Escape($typedText)

    $matchedValues = @($candidates | Where-Object { -not [string]::IsNullOrWhiteSpace($_) -and $_ -like "$escapedText*" })
    if ($matchedValues.Count -eq 0 -and $typedText.Length -gt 0) {
        $matchedValues = @($candidates | Where-Object { -not [string]::IsNullOrWhiteSpace($_) -and $_ -like "*$escapedText*" })
    }

    foreach ($value in @($matchedValues | Select-Object -Unique)) {
        $completionText = $value
        if ($completionText -match "[\s'`"`$``;,(){}|&<>@#]") {
            $completionText = "'" + $completionText.Replace("'", "''") + "'"
        }
        $toolTip = if ($descriptions.ContainsKey($value)) { $descriptions[$value] } else { $value }
        [System.Management.Automation.CompletionResult]::new($completionText, $value, 'ParameterValue', $toolTip)
    }
}
<#

.SYNOPSIS
    Loads and validates the application definitions in Applications.json.

.DESCRIPTION
    Reads the Applications array from Applications.json and returns one
    normalized object per application, in file order.

    Applications.json is standardized. Every application must have exactly
    these properties; use NA (not applicable) when a value is not needed:

      Name            - unique display name
      Source          - WinGet, PSGallery or Local
      Id              - WinGet package identifier or PSGallery module name.
                        NA for Local.
      InstallEnabled  - true or false
      Architecture    - x86, x64, arm64 or NA
      Scope           - Machine, User or NA
      InstallerType   - msi, wix, msix, appx, exe, burn, inno, nullsoft, zip,
                        portable or NA

    PSGallery applications must use NA for Architecture, Scope and
    InstallerType. Local applications must set InstallerType. For WinGet
    applications, NA means that WinGet selects the installer.

    Missing properties, unknown properties and invalid values throw an error.
    Values are returned in their standard casing, for example Machine, x64,
    wix and NA.

    Each application is validated with ConvertTo-PAWApplicationDefinition.
    Schema 2 guest snapshots additionally carry ApplicationId and typed Options
    for PowerShell modules, Classic applications and Windows components.

    Install settings are not part of Applications.json. They are kept in one
    install file per application (see Update-PAWApplicationInstallFile).

.PARAMETER Path
    Path to Applications.json.

.EXAMPLE
    Get-PAWApplicationDefinitions -Path 'C:\PAWFiles\AppInstall\Applications.json' | Where-Object InstallEnabled

.NOTES
    Version : 2.0.0.3
    Author  : The Fantastic PAWDeploy Team

#>
function Get-PAWApplicationDefinitions {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Path
    )

    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
        throw "Applications file not found: $Path"
    }

    try {
        $applicationsJson = Get-Content -LiteralPath $Path -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
    }
    catch {
        throw "Applications file '$Path' is not valid JSON. $($_.Exception.Message)"
    }

    if ($null -eq $applicationsJson.PSObject.Properties['Applications']) {
        throw "Applications file '$Path' does not contain an 'Applications' array."
    }

    $seenNames = @{}
    $index = 0
    foreach ($application in @($applicationsJson.Applications)) {
        $index++
        $definition = ConvertTo-PAWApplicationDefinition -Application $application -Index $index -Context "in '$Path'"
        if ($seenNames.ContainsKey($definition.Name)) {
            throw "Application name '$($definition.Name)' is defined more than once in '$Path'."
        }
        $seenNames[$definition.Name] = $true
        $definition
    }
}
<#

.SYNOPSIS
    Loads and validates the install file of an application.

.DESCRIPTION
    Reads an install file written by Update-PAWApplicationInstallFile and
    returns an object with Name, Id, Path, Settings and Installer.

    Settings are normalized: InstallCheckPaths, MsiProperties and
    PostInstallKillProcess are string arrays; SilentArguments,
    CustomArguments and DestinationPath are strings. Paths are returned
    unexpanded so that environment variables are expanded on the machine that
    installs.

    Throws when the file is missing or has no Installer section, which means
    that the application has not been downloaded with
    Invoke-PAWApplicationDownload.ps1.

.PARAMETER Path
    Path of the install file (see Get-PAWApplicationInstallFilePath).

.EXAMPLE
    Get-PAWApplicationInstallFile -Path 'C:\PAWFiles\AppInstall\Applications\7-Zip.json'

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Get-PAWApplicationInstallFile {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Path
    )

    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
        throw "Install file not found: $Path. Run Invoke-PAWApplicationDownload.ps1 on the host to create it."
    }

    try {
        $content = Get-Content -LiteralPath $Path -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
    }
    catch {
        throw "Install file '$Path' is not valid JSON. $($_.Exception.Message)"
    }

    $installer = $content.Installer
    if ($null -eq $installer -or [string]::IsNullOrWhiteSpace([string]$installer.InstallerFile)) {
        throw "Install file '$Path' has no Installer information. Run Invoke-PAWApplicationDownload.ps1 on the host to update it."
    }

    $settings = $content.Settings

    [PSCustomObject]@{
        Name      = [string]$content.Name
        Id        = [string]$content.Id
        Path      = $Path
        Settings  = [PSCustomObject]@{
            InstallCheckPaths      = @(ConvertTo-PAWAppInstallStringArray -Value $settings.InstallCheckPaths)
            SilentArguments        = (@(ConvertTo-PAWAppInstallStringArray -Value $settings.SilentArguments) -join ' ').Trim()
            CustomArguments        = (@(ConvertTo-PAWAppInstallStringArray -Value $settings.CustomArguments) -join ' ').Trim()
            MsiProperties          = @(ConvertTo-PAWAppInstallStringArray -Value $settings.MsiProperties)
            PostInstallKillProcess = @(ConvertTo-PAWAppInstallStringArray -Value $settings.PostInstallKillProcess)
            DestinationPath        = ([string]$settings.DestinationPath).Trim()
        }
        Installer = [PSCustomObject]@{
            Version              = [string]$installer.Version
            InstallerType        = ([string]$installer.InstallerType).Trim().ToLowerInvariant()
            NestedInstallerType  = ([string]$installer.NestedInstallerType).Trim().ToLowerInvariant()
            NestedInstallerFiles = @(ConvertTo-PAWAppInstallStringArray -Value $installer.NestedInstallerFiles)
            InstallerFile        = [string]$installer.InstallerFile
            ManifestFile         = [string]$installer.ManifestFile
            ProductCode          = [string]$installer.ProductCode
            SilentArguments      = ([string]$installer.SilentArguments).Trim()
            SilentSource         = [string]$installer.SilentSource
            CustomArguments      = ([string]$installer.CustomArguments).Trim()
            SuccessExitCodes     = [long[]]@($installer.SuccessExitCodes | Where-Object { $null -ne $_ })
            RebootExitCodes      = [long[]]@($installer.RebootExitCodes | Where-Object { $null -ne $_ })
        }
    }
}
