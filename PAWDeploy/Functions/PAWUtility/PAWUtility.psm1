<#

.SYNOPSIS
    Finds a template by name and reports missing or duplicate matches.

.DESCRIPTION
    Returns the single template with the given name (case-insensitive) from the
    objects returned by Get-PAWTemplateFile. Throws when no template or more than
    one template has that name, because deployments select templates by name.

.PARAMETER Templates
    Template objects from Get-PAWTemplateFile.

.PARAMETER TemplateName
    The template name to find.

.PARAMETER TemplateFolder
    Optional folder name shown in the error message when the template is not found.

.EXAMPLE
    $templates = @(Get-PAWTemplateFile -TemplateFolder $folder)
    Find-PAWTemplate -Templates $templates -TemplateName 'Windows 11 PAW' -TemplateFolder $folder

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Find-PAWTemplate {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [AllowEmptyCollection()]
        [object[]]$Templates,

        [Parameter(Mandatory = $true)]
        [string]$TemplateName,

        [Parameter(Mandatory = $false)]
        [string]$TemplateFolder
    )

    $found = @($Templates | Where-Object { $_.Name -eq $TemplateName })
    if ($found.Count -eq 0) {
        $available = ($Templates | ForEach-Object { "'$($_.Name)'" }) -join ', '
        if ([string]::IsNullOrEmpty($available)) {
            $available = '(none)'
        }
        $location = ''
        if (-not [string]::IsNullOrWhiteSpace($TemplateFolder)) {
            $location = " in '$TemplateFolder'"
        }
        throw "Template '$TemplateName' not found$location. Available templates: $available"
    }
    if ($found.Count -gt 1) {
        throw "Template name '$TemplateName' is used by more than one file: $(($found | ForEach-Object { $_.FilePath }) -join ', '). Rename or remove the duplicates."
    }

    return $found[0]
}
