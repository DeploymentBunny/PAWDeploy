        'PAWMenuCommunity' { 'PAW Menu' }
        'PAWDeployUI' { 'PAW Deploy' }
        'PAWApplicationManagerUI' { 'PAW Application Manager' }
        'PAWASREditorUI' { 'Edit ASR Rules' }
        'PAWConfigEditorUI' { 'PAW Configuration Editor' }
        'PAWRemoveVMUI' { 'PAW Remove' }
        'PAWWIM2VHDUI' { 'PAW WIM-2-VHDx' }
        default { $scriptName }
    }
    $heading.ForeColor = (Get-PAWUiPalette).Heading
    $heading.Font = New-Object System.Drawing.Font('Segoe UI', 18, [System.Drawing.FontStyle]::Bold)
    $heading.TextAlign = 'MiddleLeft'
    $heading.Location = New-Object System.Drawing.Point($(if ($Menu) { 20 } else { $picture.Right + 19 }), $(if ($Menu) { 8 } else { $picture.Top }))
    $headingWidth = if ($Menu) { $picture.Left - $heading.Left - 20 } else { $ribbon.Width - $heading.Left - 240 }
    $heading.Size = New-Object System.Drawing.Size($headingWidth, $(if ($Menu) { 48 } else { $picture.Height }))
    $heading.Anchor = 'Top, Left, Right'
    $heading.Add_Disposed({ param($sender, $eventArgs) $sender.Font.Dispose() })
    $ribbon.Controls.AddRange(@($picture, $heading))
    if ($StatusLabel) {
        $inset = [int][Math]::Floor($ribbon.Width / 3)
        $height = 40
        $StatusLabel.Name = 'PAWRibbonStatus'
        $StatusLabel.AutoSize = $false
        $StatusLabel.Size = [System.Drawing.Size]::new(($ribbon.Width - 2 * $inset), $height)
        $StatusLabel.Location = [System.Drawing.Point]::new($inset, [int](($ribbon.Height - $height) / 2))
        $StatusLabel.Anchor = 'Top, Left, Right'
        $StatusLabel.TextAlign = 'MiddleCenter'
        $StatusLabel.Font = [System.Drawing.Font]::new('Segoe UI', 16, [System.Drawing.FontStyle]::Bold)
        $StatusLabel.Add_Disposed({ param($sender, $eventArgs) $sender.Font.Dispose() })
        $heading.Width = $StatusLabel.Left - $heading.Left - 16
        $heading.Anchor = 'Top, Left'
        if ($Menu) { $Form.Controls.Add($StatusLabel) }
        else { $ribbon.Controls.Add($StatusLabel) }
    }
    if (-not $Menu) {
        $CloseButton.Name = 'PAWRibbonClose'
        $CloseButton.Size = New-Object System.Drawing.Size(90, 32)
        $CloseButton.Location = New-Object System.Drawing.Point(($ribbon.Width - 106), 16)
        $CloseButton.Anchor = 'Top, Right'
        Set-PAWThemedButton -Button $CloseButton
        $help = New-PAWUiButton -Text 'Help' -X ($ribbon.Width - 208) -Y 16 -Width 90 -Height 32
        $help.Name = 'PAWRibbonHelp'
        $help.Anchor = 'Top, Right'
        if ($HelpAction) { $help.Add_Click($HelpAction) }
        else {
            $root = Split-Path -Parent (Split-Path -Parent $ScriptPath)
            $document = [IO.Path]::GetFileNameWithoutExtension($ScriptPath) + '.md'
            if ($document -eq 'PAWApplicationManagerUI.md') { $document = 'ApplicationManager.md' }
            $help.Tag = @{ Root = $root; Document = $document; Form = $Form }
            $help.Add_Click({
                param($sender, $eventArgs)
                try {
                    $data = $sender.Tag
                    $reader = Join-Path $data.Root 'Tools\PAWHelpUI.ps1'
                    $guide = Join-Path $data.Root "Docs\$($data.Document)"
                    if (-not (Test-Path -LiteralPath $reader -PathType Leaf)) { throw "Help reader not found: $reader" }
                    if (-not (Test-Path -LiteralPath $guide -PathType Leaf)) { throw "Guide not found: $guide" }
