<#

.SYNOPSIS
    Returns tab-completion candidates for supported PAW template parameters.

.DESCRIPTION
    Returns tab-completion results for the template parameters of
    Invoke-PAWTemplateSettings.ps1. The suggested values match the dropdown
    lists in the PAWTemplateEditorUI.ps1 template grid:

    - Name: template names in the template folder (not offered with -New)
    - NoCPU and Memory: the same steps as the editor
    - TimeZoneName: Windows time zone IDs
    - InputLocale, SystemLocale, UILanguage, UserLocale: specific culture names
    - VHDFile: .vhdx files in the configured VHDFolder
    - RunScript: NA and .ps1 files in Resources\CustomScripts
    - SecurityBaselineLocation: folders in the configured SecurityBaseLineFolder
    - VMSwitch: Hyper-V virtual switches (when Get-VMSwitch is allowed)

    Values that start with the typed text are returned first; when there are
    none, values that contain the typed text are returned. Values that need
    quoting are quoted.

    The function reads Config.json directly and does not call other PAWUtility
    functions, so argument completers can dot-source this file without
    importing the whole module.

.PARAMETER ParameterName
    Name of the parameter being completed.

.PARAMETER WordToComplete
    The text typed so far.

.PARAMETER ScriptFolder
    Folder of the calling script. Config\Config.json and the default Config
folder are resolved from here unless -ConfigPath was typed.

.PARAMETER BoundParameters
    The parameters already typed on the command line (fakeBoundParameters).

.EXAMPLE
    Get-PAWTemplateArgumentCompletion -ParameterName UILanguage -WordToComplete 'sv' -ScriptFolder 'C:\PAWDeploy'

.NOTES
    Version : 2.0.0.3
    Author  : The Fantastic PAWDeploy Team

#>
function Get-PAWTemplateArgumentCompletion {
    [CmdletBinding()]
    [OutputType([System.Management.Automation.CompletionResult])]
    param(
        [Parameter(Mandatory = $true)]
        [string]$ParameterName,

        [Parameter(Mandatory = $false)]
        [AllowEmptyString()]
        [AllowNull()]
        [string]$WordToComplete = '',

        [Parameter(Mandatory = $true)]
        [string]$ScriptFolder,

        [Parameter(Mandatory = $false)]
        [AllowNull()]
        [System.Collections.IDictionary]$BoundParameters
    )

    if ($null -eq $BoundParameters) {
        $BoundParameters = @{}
    }
    $pathResolver = $ExecutionContext.SessionState.Path

    if ($BoundParameters.Contains('ConfigPath')) {
        $configPath = $pathResolver.GetUnresolvedProviderPathFromPSPath([string]$BoundParameters['ConfigPath'])
    }
    else {
        $configPath = Join-Path $ScriptFolder 'Config\Config.json'
    }
    $configFolder = Split-Path -Parent $configPath

    $configuration = $null
    if (Test-Path -LiteralPath $configPath -PathType Leaf) {
        try {
            $configuration = (Get-Content -LiteralPath $configPath -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop).Settings.Configuration
        }
        catch {
            $configuration = $null
        }
    }

    # Returns the first configured folder (expanded and rooted against Config.json), or $null.
    $getConfiguredFolder = {
        param([string[]]$NodeNames)
        if ($null -eq $configuration) {
            return $null
        }
        foreach ($nodeName in $NodeNames) {
            $folderValue = [string]$configuration.$nodeName
            if ([string]::IsNullOrWhiteSpace($folderValue)) {
                continue
            }
            $folderValue = [Environment]::ExpandEnvironmentVariables($folderValue.Trim())
            if (-not [System.IO.Path]::IsPathRooted($folderValue)) {
                $folderValue = Join-Path $configFolder $folderValue
            }
            return $folderValue
        }
        return $null
    }

    $candidates = @()
    try {
        switch ($ParameterName) {
            'Name' {
                if ($BoundParameters.Contains('New')) {
                    return
                }
                $templateFolder = $configFolder
                if (Test-Path -LiteralPath $templateFolder -PathType Container) {
                    $candidates = foreach ($file in @(Get-ChildItem -LiteralPath $templateFolder -Filter '*.json' -File | Where-Object Name -ne 'Config.json' | Sort-Object Name)) {
                        try {
                            $templateName = [string](Get-Content -LiteralPath $file.FullName -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop).Name
                        }
                        catch {
                            continue
                        }
                        if ([string]::IsNullOrWhiteSpace($templateName)) {
                            $templateName = $file.BaseName
                        }
                        $templateName
                    }
                    $candidates = @($candidates | Sort-Object)
                }
            }
            'NoCPU' {
                $candidates = @(2..8 | ForEach-Object { [string]$_ })
            }
            'Memory' {
                $candidates = @(2048..65535 | Where-Object { ($_ - 2048) % 1024 -eq 0 } | ForEach-Object { [string]$_ }) + @('65535')
            }
            'TimeZoneName' {
                $candidates = @([System.TimeZoneInfo]::GetSystemTimeZones() | Sort-Object Id | ForEach-Object { [string]$_.Id })
            }
            { @('InputLocale', 'SystemLocale', 'UILanguage', 'UserLocale') -contains $_ } {
                $candidates = @([System.Globalization.CultureInfo]::GetCultures([System.Globalization.CultureTypes]::SpecificCultures) |
                        Where-Object { -not [string]::IsNullOrWhiteSpace($_.Name) } |
                        Sort-Object Name -Unique |
                        ForEach-Object { [string]$_.Name })
            }
            'VHDFile' {
                $vhdFolder = & $getConfiguredFolder @('VHDFolder', 'VHDXFolder', 'VHDFileFolder')
                if (-not [string]::IsNullOrWhiteSpace($vhdFolder) -and (Test-Path -LiteralPath $vhdFolder -PathType Container)) {
                    $candidates = @(Get-ChildItem -LiteralPath $vhdFolder -Filter '*.vhdx' -File | Sort-Object Name | ForEach-Object { $_.Name })
                }
            }
            'RunScript' {
                $candidates = @('NA')
                $customScriptsFolder = Join-Path $ScriptFolder 'Resources\CustomScripts'
                if (Test-Path -LiteralPath $customScriptsFolder -PathType Container) {
                    $candidates += @(Get-ChildItem -LiteralPath $customScriptsFolder -Filter '*.ps1' -File | Sort-Object Name | ForEach-Object { $_.Name })
                }
            }
            'WDACPolicyFile' {
                $policyFolder = Join-Path $ScriptFolder 'Resources\WDACPolicies'
                $candidates = @('NA')
                if (Test-Path -LiteralPath $policyFolder -PathType Container) {
                    $candidates += @(Get-ChildItem -LiteralPath $policyFolder -Filter '*.xml' -File | Sort-Object Name | ForEach-Object { $_.Name })
                }
            }
            'SecurityBaselineLocation' {
                $baselineFolder = & $getConfiguredFolder @('SecurityBaseLineFolder', 'SecurityBaselineFolder')
                if (-not [string]::IsNullOrWhiteSpace($baselineFolder) -and (Test-Path -LiteralPath $baselineFolder -PathType Container)) {
                    $candidates = @(Get-ChildItem -LiteralPath $baselineFolder -Directory | Sort-Object Name | ForEach-Object { $_.Name })
                }
            }
            'VMSwitch' {
                # Get-VMSwitch needs Hyper-V and an elevated session (or Hyper-V Administrators membership).
                if (Get-Command -Name 'Get-VMSwitch' -ErrorAction SilentlyContinue) {
                    $candidates = @(Get-VMSwitch -ErrorAction Stop | ForEach-Object { [string]$_.Name } | Sort-Object -Unique)
                }
            }
            default {
                return
            }
        }
    }
    catch {
        return
    }

    $typedText = ''
    if ($null -ne $WordToComplete) {
        $typedText = ([string]$WordToComplete).Trim([char[]]"'`"")
    }
    $escapedText = [System.Management.Automation.WildcardPattern]::Escape($typedText)

    $matchedValues = @($candidates | Where-Object { -not [string]::IsNullOrWhiteSpace($_) -and $_ -like "$escapedText*" })
    if ($matchedValues.Count -eq 0 -and $typedText.Length -gt 0) {
        $matchedValues = @($candidates | Where-Object { -not [string]::IsNullOrWhiteSpace($_) -and $_ -like "*$escapedText*" })
    }

    foreach ($value in @($matchedValues | Select-Object -Unique)) {
        $completionText = $value
        if ($completionText -match "[\s'`"`$``;,(){}|&<>@#]") {
            $completionText = "'" + $completionText.Replace("'", "''") + "'"
        }
        [System.Management.Automation.CompletionResult]::new($completionText, $value, 'ParameterValue', $value)
    }
}
<#

.SYNOPSIS
    Loads templates from a template folder.

.DESCRIPTION
    Reads every *.json template file in TemplateFolder and returns them as a
    collection of template objects, skipping (with a warning) any file that
    fails to parse as JSON.

.PARAMETER TemplateFolder
    Folder containing the template files to load.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Get-PAWTemplateCollection {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$TemplateFolder
    )

    if (-not (Test-Path -LiteralPath $TemplateFolder -PathType Container)) {
        throw "Template folder not found: $TemplateFolder"
    }

    $templateFiles = @(Read-PAWTemplateFile -TemplateFolder $TemplateFolder)
    if ($templateFiles.Count -eq 0) {
        throw "No template files found in: $TemplateFolder"
    }

    $templates = @()
    foreach ($templateFile in $templateFiles) {
        if ($templateFile.ParseState -ne 'OK') {
            Write-Warning "Skipping invalid template file '$($templateFile.FullPath)': $($templateFile.ErrorRecord.Exception.Message)"
            continue
        }
        $templateData = $templateFile.Data

        if ([string]::IsNullOrWhiteSpace([string]$templateData.Name)) {
            $templateData | Add-Member -NotePropertyName Name -NotePropertyValue $templateFile.Name -Force
        }

        $templates += $templateData
    }

    if ($templates.Count -eq 0) {
        throw "No valid template files found in: $TemplateFolder"
    }

    return ,$templates
}
<#

.SYNOPSIS
    Builds the template table columns from the supplied template objects.

.DESCRIPTION
    Builds the template table columns from the supplied template objects.

.PARAMETER TemplateObjects
    Template objects whose setting names are combined into the returned column list.

.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team

#>
function Get-PAWTemplateColumns {
    param(
        [Parameter(Mandatory = $false)]
        [AllowNull()]
        [object[]]$TemplateObjects
    )

    $columns = New-Object System.Collections.Generic.List[string]
    $preferredColumns = @(
        'Name',
        'VMGen',
        'Memory',
        'NoCPU',
        'DynamicMem',
        'VMNotes',
        'DiskMode',
        'Shielded',
        'BitLocker',
        'Application',
        'ApplicationBundle',
        'VHDFile',
        'ExtraFolder',
        'RunScript',
        'OSClass',
        'SecurityBaselineLocation',
        'ApplySecurityBaseline',
        'TimeZoneName',
        'InputLocale',
        'SystemLocale',
        'UILanguage',
        'UserLocale',
        'DomainOrWorkGroup',
        'DNSDomain',
        'MachineObjectOU',
        'NamePrefix',
        'NameSuffix',
        'VLanID',
        'VMSwitch',
        'ProductKey'
    )

    foreach ($preferredColumn in $preferredColumns) {
        if (-not $columns.Contains($preferredColumn)) {
            [void]$columns.Add($preferredColumn)
        }
    }

    foreach ($template in @($TemplateObjects)) {
        if ($null -eq $template) {
            continue
        }

        foreach ($property in @($template.PSObject.Properties)) {
            if ($property.MemberType -ne [System.Management.Automation.PSMemberTypes]::NoteProperty -and $property.MemberType -ne [System.Management.Automation.PSMemberTypes]::Property) {
                continue
            }

            if (-not $columns.Contains($property.Name)) {
                [void]$columns.Add($property.Name)
            }
        }
    }

    return $columns.ToArray()
}
<#

.SYNOPSIS
    Loads valid JSON templates and returns their names, paths, and data.

.DESCRIPTION
    Reads every *.json template file in a template folder and returns one
    object per valid file with these properties:
    - Name: the template Name, or the file name without extension when Name is empty
    - FilePath: full path to the template file
    - Data: the parsed template object

    Invalid JSON files are skipped with a warning. Returns an empty collection
    when the folder does not exist or contains no templates.

.PARAMETER TemplateFolder
    The template folder to read.

.EXAMPLE
    Get-PAWTemplateFile -TemplateFolder 'C:\PAWDeploy\Config'

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Get-PAWTemplateFile {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [Alias('Folder')]
        [string]$TemplateFolder
    )

    if (-not (Test-Path -LiteralPath $TemplateFolder -PathType Container)) {
        return
    }

    foreach ($file in Read-PAWTemplateFile -TemplateFolder $TemplateFolder) {
        if ($file.ParseState -ne 'OK') {
            Write-Warning "Skipping invalid template file '$($file.FullPath)': $($file.ErrorRecord.Exception.Message)"
            continue
        }
        [PSCustomObject]@{
            Name     = $file.Name
            FilePath = $file.FullPath
            Data     = $file.Data
        }
    }
}
