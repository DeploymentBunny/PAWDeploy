        $picture.Image = $sourceLogo.Clone($area, $sourceLogo.PixelFormat)
    }
    finally { $sourceLogo.Dispose() }
    if ($Menu) {
        $picture.Size = New-Object System.Drawing.Size(240, 80)
        $picture.Location = New-Object System.Drawing.Point(($ribbon.Width - 260), 20)
        $picture.Anchor = 'Top, Right'
        $brandLeft = 20
        if ($Edition -eq 'Community') {
