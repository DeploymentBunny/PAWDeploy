function Get-PAWWindowIcon {
    <#
    .SYNOPSIS
        Returns the PAWDeploy toolkit window icon.

    .DESCRIPTION
        Converts the toolkit App-Icon PNG to an owned 32-pixel System.Drawing.Icon.
        Assign the result to Form.Icon and dispose it when the form closes.

    .EXAMPLE
        $Form.Icon = Get-PAWWindowIcon

    .OUTPUTS
        System.Drawing.Icon

    .NOTES
        Version : 2.0.0.3
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    [OutputType([System.Drawing.Icon])]
    param()

    if (-not ('PAWDeploy.UI.NativeIconMethods' -as [type])) {
        Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
namespace PAWDeploy.UI {
    public static class NativeIconMethods {
        [DllImport("user32.dll", SetLastError = true)]
        [return: MarshalAs(UnmanagedType.Bool)]
        public static extern bool DestroyIcon(IntPtr handle);
    }
}
'@ -ErrorAction Stop
    }
    $image = Get-PAWImage -Name ToolkitAppIcon
    $bitmap = New-Object System.Drawing.Bitmap(32, 32)
    $graphics = [System.Drawing.Graphics]::FromImage($bitmap)
    $handle = [IntPtr]::Zero
    try {
        $graphics.InterpolationMode = [System.Drawing.Drawing2D.InterpolationMode]::HighQualityBicubic
        $height = [int][Math]::Round(32 * $image.Height / $image.Width)
        $graphics.DrawImage($image, 0, [int]((32 - $height) / 2), 32, $height)
        $handle = $bitmap.GetHicon()
        $borrowedIcon = [System.Drawing.Icon]::FromHandle($handle)
        try { $borrowedIcon.Clone() }
        finally { $borrowedIcon.Dispose() }
    }
    finally {
        $graphics.Dispose()
        $bitmap.Dispose()
        $image.Dispose()
        if ($handle -ne [IntPtr]::Zero -and -not [PAWDeploy.UI.NativeIconMethods]::DestroyIcon($handle)) {
            Write-Error "Unable to release toolkit icon handle: $([Runtime.InteropServices.Marshal]::GetLastWin32Error())"
        }
    }
}
