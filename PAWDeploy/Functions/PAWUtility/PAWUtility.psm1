    Add-Content $unattendFile '        </component>'
    Add-Content $unattendFile '    </settings>'
    Add-Content $unattendFile '</unattend>'
    return $unattendFile
}
Function New-PAWVHD{
    <#
    .SYNOPSIS
        Creates a new VHD file by using DiskPart.

    .DESCRIPTION
        Generates a temporary DiskPart command file and uses DiskPart.exe to create
        a virtual hard disk at the specified path, size, and type.

    .PARAMETER VHDFile
        Full path to the VHD file that should be created.

    .PARAMETER VHDSizeinMB
        Size of the VHD in megabytes.

    .PARAMETER VHDType
        VHD allocation type. Valid values are EXPANDABLE and FIXED.

    .EXAMPLE
        New-PAWVHD -VHDFile 'C:\VMs\PAW01\PAW01.vhd' -VHDSizeinMB 65536 -VHDType EXPANDABLE

        Creates a 64 GB expandable VHD file.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [CmdletBinding()]

    Param(
    [Parameter(Position=0)]
    [ValidateNotNullOrEmpty()]
    [string]
    $VHDFile,

    [Parameter(Position=1)]
    [ValidateNotNullOrEmpty()]
    [string]
    $VHDSizeinMB,

    [Parameter(Position=2)]
    [ValidateNotNullOrEmpty()]
    [ValidateSet('EXPANDABLE','FIXED')]
    [string]
    $VHDType
    )

    if(!(Test-Path -Path ($VHDFile | Split-Path -Parent))){
        throw "Folder does not exists..."
    }

    #Check if file exists
    if(Test-Path -Path $VHDFile){
        throw "File exists..."
    }

    $diskpartcmd = New-Item -Path "$env:TEMP\diskpartcmd.txt" -ItemType File -Force
    $null = Set-Content -Path $diskpartcmd -Value "CREATE VDISK FILE=$VHDFile MAXIMUM=$VHDSizeinMB TYPE=$VHDType"
    $Exe = "DiskPart.exe"
    $Arguments = "/s `"$($diskpartcmd.FullName)`""
    $null = Invoke-PAWExe -Executable $Exe -Arguments $Arguments -SuccessfulReturnCode 0
    $null = Remove-Item $diskpartcmd -Force -ErrorAction SilentlyContinue
}
<#

.SYNOPSIS
    Creates and attaches the requested number of data disks to a virtual machine.

.DESCRIPTION
    Creates and attaches the requested number of data disks to a virtual machine.

.PARAMETER VMname
    Name of the virtual machine receiving the data disks.

.PARAMETER NoOfDisks
    Number of data disks to create and attach.

.PARAMETER DiskSize
    Size of each new data disk in bytes.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
Function New-PAWVMHarddrive {
    [cmdletbinding()]
    Param
    (
        [parameter(position = 0, mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        #[ValidateRange(20GB-500GB)]
        $VMname,

        [parameter(position = 1, mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        #[ValidateRange(1-10)]
        $NoOfDisks,

        [parameter(position = 2, mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        #[ValidateRange(20GB-500GB)]
        $DiskSize
    )

    Foreach ($DataDiskNo in (1..$NoOfDisks)) {
        $DataDiskPath = (Get-VM -Name $VMname).path + "\Virtual Hard Disks"
        $DataDiskName = "$VMname-DataDisk_$DataDiskNo" + ".vhdx"
        Write-Verbose "Add Datadisk if needed"
        Write-Verbose "Check if the darn disk already exist..."
        $DiskCheck = Test-Path ($DataDiskPath + "\" + $DataDiskName)
        if ($DiskCheck -eq $false) {
            Write-Verbose ($DataDiskPath + "\" + $DataDiskName)
            $DataDiskToAdd = New-VHD -Path ($DataDiskPath + "\" + $DataDiskName) -Dynamic -SizeBytes $DiskSize -ErrorAction Stop
            Add-VMHardDiskDrive -Path $DataDiskToAdd.Path -VMName $VMname -ErrorAction Stop
        }
        else {
            Write-warning "Woops, disk is already created"
        }
    }
}
Function New-PAWVMname {
    <#
    .SYNOPSIS
        Generates a random 7-character uppercase VM name.

    .DESCRIPTION
        The New-PAWVMname function creates a random string consisting of 7 uppercase alphabetic characters (A-Z). This can be used to assign unique names to virtual machines.

    .EXAMPLE
        New-PAWVMname

        Outputs a random 7-character uppercase string, such as 'QWERTYU'.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

        No parameters are required. The function uses the Get-Random cmdlet to select random ASCII codes corresponding to uppercase letters.

    #>
    "$(-join ((65..90) | Get-Random -Count 7 | ForEach-Object {[char]$_}))"
}
Function New-PAWVMNamePrefix {
    <#
    .SYNOPSIS
        Generates a default VM name prefix.

    .DESCRIPTION
        Creates a random prefix using the supplied character set.

    .PARAMETER Length
        Number of characters to return. Default is 3.

    .PARAMETER AllowedCharacters
        Characters that may be used when generating the prefix.
        Defaults to 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.

    .EXAMPLE
        New-PAWVMNamePrefix

        Returns a short uppercase prefix, for example 'PAW'.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>
    [CmdletBinding()]
    param(
        [ValidateRange(2, 8)]
        [int]$Length = 3,

        [ValidateNotNullOrEmpty()]
        [string]$AllowedCharacters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
    )

    $characters = @($AllowedCharacters.ToCharArray() | Select-Object -Unique)
    if ($characters.Count -eq 0) {
        throw 'AllowedCharacters must contain at least one usable character.'
    }

    $prefix = -join (1..$Length | ForEach-Object { $characters | Get-Random })
    return $prefix
}
