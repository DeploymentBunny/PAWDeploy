function Import-PAWRunScript {
    <#
    .SYNOPSIS
        Imports one or more PowerShell files into Resources\CustomScripts.
    .DESCRIPTION
        Imports only .ps1 files, keeping their filenames. Validates all sources
        and destination paths before writing. Existing files require Replace.
        Each file is staged and atomically published; scripts are never executed.
    .PARAMETER Path
        One or more existing .ps1 files.
    .PARAMETER InputObject
        Script file objects or path strings from the pipeline.
    .PARAMETER InstallFolderPath
        PAWDeploy installation root. Defaults to this module's installation.
    .PARAMETER Replace
        Explicit approval to replace existing scripts.
    .NOTES
        Version : 2.0.0.3
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess, DefaultParameterSetName = 'Path')]
    param(
        [Parameter(Mandatory, ParameterSetName = 'Path')][ValidateNotNullOrEmpty()][string[]]$Path,
        [Parameter(Mandatory, ValueFromPipeline, ParameterSetName = 'Input')][AllowNull()][object]$InputObject,
        [ValidateNotNullOrEmpty()][string]$InstallFolderPath = $script:scriptFolder,
        [switch]$Replace
    )
    begin { $sourcePaths = New-Object 'System.Collections.Generic.List[string]' }
    process {
        if ($PSCmdlet.ParameterSetName -eq 'Input') { $sourcePaths.Add((Get-PAWImportSource -InputObject $InputObject)) }
        else { foreach ($sourcePath in $Path) { $sourcePaths.Add($sourcePath) } }
    }
    end {
        if ($sourcePaths.Count -eq 0) { return }
        $Path = $sourcePaths.ToArray()
        $folder = Resolve-PAWCustomScriptsFolder -InstallFolderPath $InstallFolderPath
        Assert-PAWBaselineDestination -Path $folder -AllowContent
        $sources = New-Object 'System.Collections.Generic.List[object]'
        $names = @{}
        $published = New-Object 'System.Collections.Generic.List[string]'
        foreach ($sourcePath in $Path) {
            $source = Get-Item -LiteralPath $sourcePath -Force -ErrorAction Stop
            if ($source.PSIsContainer -or $source.Extension -ne '.ps1' -or
                ($source.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
                throw "Import source must be a regular .ps1 file: '$sourcePath'."
            }
            if ($names.ContainsKey($source.Name)) { throw "Duplicate script filename: '$($source.Name)'." }
            $names[$source.Name] = $true
            $target = Join-Path $folder $source.Name
            if (Test-Path -LiteralPath $target -ErrorAction Stop) {
                if ((Get-Item -LiteralPath $target -Force -ErrorAction Stop).PSIsContainer) {
                    throw "Script destination is a directory: '$target'."
                }
                if (-not $Replace) { throw "Script exists: '$target'. Use -Replace." }
                if ($source.FullName -eq $target) { throw "Source is already the installed script: '$target'." }
            }
            $sources.Add([pscustomobject]@{ Source = $source.FullName; Destination = $target })
        }
        if (-not $PSCmdlet.ShouldProcess($folder, "Import $($sources.Count) PowerShell script(s) (Replace=$Replace)")) { return }
        $null = New-Item -Path $folder -ItemType Directory -Force -ErrorAction Stop
        foreach ($source in $sources) {
            $temporary = Join-Path $folder ('.script-' + [guid]::NewGuid().ToString('N'))
            try {
                Assert-PAWBaselineDestination -Path $folder -AllowContent
                Copy-Item -LiteralPath $source.Source -Destination $temporary -ErrorAction Stop
                Assert-PAWBaselineDestination -Path $folder -AllowContent
                if (Test-Path -LiteralPath $source.Destination -ErrorAction Stop) {
                    if (-not $Replace) { throw "Script appeared at '$($source.Destination)'; replacement is not approved." }
                    [IO.File]::Replace($temporary, $source.Destination, [Management.Automation.Language.NullString]::Value)
                }
                else { [IO.File]::Move($temporary, $source.Destination) }
                $published.Add($source.Destination)
                $source
            }
            catch {
                throw "Script import failed for '$($source.Destination)': $($_.Exception.Message). Already imported (not rolled back): $($published -join ', ')."
            }
            finally {
                try {
                    if (Test-Path -LiteralPath $temporary -ErrorAction Stop) {
                        Remove-Item -LiteralPath $temporary -Force -ErrorAction Stop
                    }
                }
                catch { Write-Warning "Script temporary file cleanup failed at '$temporary': $($_.Exception.Message)" }
            }
        }
    }
}
function Import-PAWTemplate {
    <#
    .SYNOPSIS
        Imports validated JSON templates beside Config.json.
    .DESCRIPTION
        Preflights all files and case-insensitive names before writing. Same-name
        templates require Replace. Config.json is excluded. No deployment runs.
        Invalid scalar values are retained with correction warnings; malformed
        template structure still fails. Results include a Warnings array.
    .PARAMETER Path
        One or more template JSON files.
    .PARAMETER InputObject
        Template file objects or path strings from the pipeline.
    .PARAMETER ConfigPath
        Existing configuration file whose parent stores templates. Defaults to
        this module's installation.
    .PARAMETER Replace
        Explicit permission to replace templates with matching names.
    .NOTES
        Version : 2.0.0.5
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess, DefaultParameterSetName = 'Path')]
    param(
        [Parameter(Mandatory, ParameterSetName = 'Path')][ValidateNotNullOrEmpty()][string[]]$Path,
        [Parameter(Mandatory, ValueFromPipeline, ParameterSetName = 'Input')][AllowNull()][object]$InputObject,
        [string]$ConfigPath = (Join-Path $script:scriptFolder 'Config\Config.json'),
        [switch]$Replace
    )
    begin { $sourcePaths = New-Object 'System.Collections.Generic.List[string]' }
    process {
        if ($PSCmdlet.ParameterSetName -eq 'Input') { $sourcePaths.Add((Get-PAWImportSource -InputObject $InputObject)) }
        else { foreach ($sourcePath in $Path) { $sourcePaths.Add($sourcePath) } }
    }
    end {
        if ($sourcePaths.Count -eq 0) { return }
        $Path = $sourcePaths.ToArray()
        $folder = Split-Path -Parent (Get-Item -LiteralPath $ConfigPath -ErrorAction Stop).FullName
        Assert-PAWBaselineDestination -Path $folder -AllowContent
        $existing = Get-PAWTemplateFileCollection -TemplateFolder $folder
        if (@($existing | Where-Object ParseState -ne 'OK').Count) {
            throw 'Existing template JSON is invalid; correct it before importing.'
        }
        $names = @{}
        $destinations = @{}
        $items = @(
            foreach ($source in $Path) {
                $template = Get-PAWValidatedTemplate -Path $source
                if ($names.ContainsKey($template.Name)) { throw "Duplicate import template name: '$($template.Name)'." }
                $names[$template.Name] = $true
                $matchingTemplates = @($existing | Where-Object Name -eq $template.Name)
                if ($matchingTemplates.Count -gt 1) { throw "Multiple existing templates named '$($template.Name)'." }
                if ($matchingTemplates.Count) {
                    if (-not $Replace) { throw "Template '$($template.Name)' already exists. Use -Replace." }
                    $destination = $matchingTemplates[0].FullPath
                }
                else {
                    $destination = Get-PAWUniqueTemplateFilePath -TemplateFolder $folder -TemplateName $template.Name
                    if ($destinations.ContainsKey($destination)) { throw "Import filenames collide: '$destination'." }
                }
                if ($template.Source -eq $destination) { throw "Source is already the installed template: '$destination'." }
                Assert-PAWBaselineDirectoryName -Name ([IO.Path]::GetFileName($destination))
                $destinations[$destination] = $true
                [pscustomobject]@{ Name = $template.Name; Source = $template.Source; Data = $template.Data; Destination = $destination; Warnings = $template.Warnings }
            }
        )
        if ($PSCmdlet.ShouldProcess($folder, "Import $($items.Count) validated template(s) (Replace=$Replace)")) {
            Write-PAWTemplateTransfer -Items $items -Replace:$Replace | ForEach-Object {
                $result = $_
                $warnings = ($items | Where-Object Destination -eq $result.Destination).Warnings
                $result | Add-Member -NotePropertyName Warnings -NotePropertyValue @($warnings)
                $result
            }
        }
    }
}
function Import-PAWVHDX {
    <#
    .SYNOPSIS
        Imports VHD and VHDX files into the configured virtual hard disk folder.
    .DESCRIPTION
        Validates all sources and destination names before copying. Each image is
        staged in the destination folder and published only after the copy succeeds.
    .PARAMETER Path
        One or more source .vhd or .vhdx files.
    .PARAMETER InputObject
        VHDX file objects or path strings from the pipeline.
    .PARAMETER ConfigPath
        Config.json containing Settings.Configuration.VHDFolder. Defaults to
        this module's installation.
    .PARAMETER Replace
        Allows replacement of existing filenames.
    .NOTES
        Version : 2.0.0.4
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'Medium', DefaultParameterSetName = 'Path')]
    param(
        [Parameter(Mandatory, ParameterSetName = 'Path')][ValidateNotNullOrEmpty()][string[]]$Path,
        [Parameter(Mandatory, ValueFromPipeline, ParameterSetName = 'Input')][AllowNull()][object]$InputObject,
        [ValidateNotNullOrEmpty()][string]$ConfigPath = (Join-Path $script:scriptFolder 'Config\Config.json'),
        [switch]$Replace
    )
    begin { $sourcePaths = New-Object 'System.Collections.Generic.List[string]' }
    process {
        if ($PSCmdlet.ParameterSetName -eq 'Input') { $sourcePaths.Add((Get-PAWImportSource -InputObject $InputObject)) }
        else { foreach ($sourcePath in $Path) { $sourcePaths.Add($sourcePath) } }
    }
    end {
        if ($sourcePaths.Count -eq 0) { return }
        $Path = $sourcePaths.ToArray()
        $ConfigPath = [IO.Path]::GetFullPath($ConfigPath)
        if (-not (Test-Path -LiteralPath $ConfigPath -PathType Leaf)) {
            throw "Config file not found: $ConfigPath"
        }
        $config = Get-Content -LiteralPath $ConfigPath -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
        $folderValue = [string]$config.Settings.Configuration.VHDFolder
        if ([string]::IsNullOrWhiteSpace($folderValue)) {
            throw "Settings.Configuration.VHDFolder is missing or empty in '$ConfigPath'."
        }
        $folderValue = [Environment]::ExpandEnvironmentVariables($folderValue.Trim())
        if (-not [IO.Path]::IsPathRooted($folderValue)) {
            $folderValue = Join-Path (Split-Path -Parent $ConfigPath) $folderValue
        }
        $folder = [IO.Path]::GetFullPath($folderValue)

        $sources = New-Object 'System.Collections.Generic.List[object]'
        $names = @{}
        foreach ($sourcePath in $Path) {
            if (-not (Test-Path -LiteralPath $sourcePath -PathType Leaf)) {
                throw "VHDX source file not found: $sourcePath"
            }
            $source = (Resolve-Path -LiteralPath $sourcePath -ErrorAction Stop).Path
            if ([IO.Path]::GetExtension($source) -notin '.vhd', '.vhdx') {
                throw "Only .vhd and .vhdx files can be imported: $source"
            }
            $name = [IO.Path]::GetFileName($source)
            if ($names.ContainsKey($name)) {
                if ($names[$name] -eq $source) { continue }
                throw "Multiple selected VHDX files have the same filename: $name"
            }
            $names[$name] = $source
            $target = Join-Path $folder $name
            if ($source -eq $target) { throw "Source is already the installed VHDX: '$target'." }
            if (Test-Path -LiteralPath $target) {
                if ((Get-Item -LiteralPath $target -Force -ErrorAction Stop).PSIsContainer) {
                    throw "VHDX destination is a directory: '$target'."
                }
                if (-not $Replace) {
                    throw "VHDX file already exists in '$folder': $target. Use -Replace to overwrite it."
                }
            }
            $sources.Add([pscustomobject]@{ Source = $source; Destination = $target })
        }

        $targets = $sources.Destination -join ', '
        if (-not $PSCmdlet.ShouldProcess($folder, "Import VHDX file(s) to $targets (Replace=$Replace)")) { return }
        $null = New-Item -Path $folder -ItemType Directory -Force -ErrorAction Stop
        $published = New-Object 'System.Collections.Generic.List[string]'
        $index = 0
        try {
            foreach ($item in $sources) {
                $index++
                Write-Progress -Activity 'Importing VHDX files' -Status ("Copying {0} ({1} of {2})" -f [IO.Path]::GetFileName($item.Source), $index, $sources.Count) -PercentComplete -1
                $temporary = Join-Path $folder ('.vhdx-' + [guid]::NewGuid().ToString('N') + '.tmp')
                try {
                    Copy-Item -LiteralPath $item.Source -Destination $temporary -ErrorAction Stop
                    if (Test-Path -LiteralPath $item.Destination) {
                        if (-not $Replace) { throw "VHDX appeared at '$($item.Destination)'; replacement is not approved." }
                        [IO.File]::Replace($temporary, $item.Destination, [Management.Automation.Language.NullString]::Value)
                    }
                    else { [IO.File]::Move($temporary, $item.Destination) }
                    $published.Add($item.Destination)
                    $item
                }
                catch {
                    throw "VHDX import failed for '$($item.Destination)': $($_.Exception.Message). Already imported (not rolled back): $($published -join ', ')."
                }
                finally {
                    try {
                        if (Test-Path -LiteralPath $temporary -ErrorAction Stop) {
                            Remove-Item -LiteralPath $temporary -Force -ErrorAction Stop
                        }
                    }
                    catch { Write-Warning "VHDX temporary file cleanup failed at '$temporary': $($_.Exception.Message)" }
                }
            }
        }
        finally { Write-Progress -Activity 'Importing VHDX files' -Completed }
    }
}
function Import-PAWWDACPolicy {
    <#
    .SYNOPSIS
        Imports schema-validated WDAC XML files into Resources\WDACPolicies.
    .DESCRIPTION
        Preflights all files and names, requires Replace for existing filenames,
        and publishes each file atomically without installing a policy. XML is
        retained exactly, including its Audit/Enforced options.
    .PARAMETER Path
        One or more WDAC policy XML files.
    .PARAMETER InputObject
        Policy file objects or path strings from the pipeline.
    .PARAMETER InstallFolderPath
        PAWDeploy installation root. Defaults to this module's installation.
    .PARAMETER Replace
        Explicit permission to replace existing policy files.
    .NOTES
        Version : 2.0.0.2
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess, DefaultParameterSetName = 'Path')]
    param(
        [Parameter(Mandatory, ParameterSetName = 'Path')][ValidateNotNullOrEmpty()][string[]]$Path,
        [Parameter(Mandatory, ValueFromPipeline, ParameterSetName = 'Input')][AllowNull()][object]$InputObject,
        [string]$InstallFolderPath = $script:scriptFolder,
        [switch]$Replace
    )
    begin { $sourcePaths = New-Object 'System.Collections.Generic.List[string]' }
    process {
        if ($PSCmdlet.ParameterSetName -eq 'Input') { $sourcePaths.Add((Get-PAWImportSource -InputObject $InputObject)) }
        else { foreach ($sourcePath in $Path) { $sourcePaths.Add($sourcePath) } }
    }
    end {
        if ($sourcePaths.Count -eq 0) { return }
        $Path = $sourcePaths.ToArray()
        $folder = Join-Path (Get-Item -LiteralPath $InstallFolderPath -ErrorAction Stop).FullName 'Resources\WDACPolicies'
        Assert-PAWBaselineDestination -Path $folder -AllowContent
        $names = @{}
        $items = @(
            foreach ($file in $Path) {
                $policy = Get-PAWWDACPolicy -Path $file
                $name = Split-Path -Leaf $policy.Source
                Assert-PAWBaselineDirectoryName -Name $name
                if ($names.ContainsKey($name)) { throw "Duplicate WDAC policy filename: '$name'." }
                $names[$name] = $true
                $destination = Join-Path $folder $name
                if ($destination -eq $policy.Source) { throw "WDAC policy is already installed in the import folder: '$destination'." }
                if (Test-Path -LiteralPath $destination -ErrorAction Stop) {
                    if ((Get-Item -LiteralPath $destination -Force -ErrorAction Stop).PSIsContainer) { throw "WDAC destination is a directory: '$destination'." }
                    if (-not $Replace) { throw "WDAC policy exists; use -Replace: '$destination'." }
                }
                [pscustomobject]@{ Source = $policy.Source; Destination = $destination; Mode = $policy.Mode; Xml = $policy.Xml }
            }
        )
        if (-not $PSCmdlet.ShouldProcess($folder, "Import $($items.Count) WDAC XML policies (Replace=$Replace)")) { return }
        $null = New-Item -Path $folder -ItemType Directory -Force -ErrorAction Stop
        $published = New-Object 'System.Collections.Generic.List[string]'
        foreach ($item in $items) {
            $temporary = Join-Path $folder ('.wdac-' + [guid]::NewGuid().ToString('N') + '.xml')
            try {
                Assert-PAWBaselineDestination -Path $folder -AllowContent
                Copy-Item -LiteralPath $item.Source -Destination $temporary -ErrorAction Stop
                if ((Get-PAWWDACPolicy -Path $temporary).Xml -cne $item.Xml) {
                    throw "WDAC policy source changed after validation: '$($item.Source)'. Retry import."
                }
                Assert-PAWBaselineDestination -Path $folder -AllowContent
                if (Test-Path -LiteralPath $item.Destination -ErrorAction Stop) {
                    if (-not $Replace) { throw "WDAC policy appeared; replacement is not approved: '$($item.Destination)'." }
                    [IO.File]::Replace($temporary, $item.Destination, [Management.Automation.Language.NullString]::Value)
                }
                else { [IO.File]::Move($temporary, $item.Destination) }
                $published.Add($item.Destination)
                [pscustomobject]@{ Source = $item.Source; Destination = $item.Destination; Mode = $item.Mode }
            }
            catch { throw "WDAC import failed: $($_.Exception.Message). Already imported (not rolled back): $($published -join ', ')." }
            finally {
                try {
                    if (Test-Path -LiteralPath $temporary -ErrorAction Stop) { Remove-Item -LiteralPath $temporary -Force -ErrorAction Stop }
                }
                catch { Write-Warning "WDAC temporary file retained at '$temporary': $($_.Exception.Message)" }
            }
        }
    }
}
<#

.SYNOPSIS
    Returns an existing XML child element or creates it when missing.

.DESCRIPTION
    Returns an existing XML child element or creates it when missing.

.PARAMETER Parent
    XML element in which to find or create the child element.

.PARAMETER Name
    Name of the child XML element to find or create.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Initialize-PAWChildElement {
    param(
        [Parameter(Mandatory = $true)]
        [System.Xml.XmlElement]$Parent,
        [Parameter(Mandatory = $true)]
        [string]$Name
    )

    $child = $Parent.SelectSingleNode($Name)
    if ($null -eq $child) {
        $child = $Parent.OwnerDocument.CreateElement($Name)
        [void]$Parent.AppendChild($child)
    }

    return [System.Xml.XmlElement]$child
}

function Install-PAWWDACPolicy {
    <#
    .SYNOPSIS
        Compiles and stages a WDAC policy inside the guest for its next boot.
    .DESCRIPTION
        Preserves XML Audit/Enforced settings. Does not activate the policy during
        deployment, sign it, alter boot options or replace an existing policy.
        Verifies the deployed binary hash. Requires Get-PAWWDACPolicy in the guest.
    .PARAMETER XmlContent
        Validated source policy XML.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess)]
    param([Parameter(Mandatory)][string]$XmlContent)
    $policy = Get-PAWWDACPolicy -XmlContent $XmlContent
    if (-not $policy.Unsigned) {
        throw 'XML requires a signed WDAC policy. This XML deployment cannot sign binaries; use an unsigned policy with option 6 or deploy a properly signed binary separately.'
    }
    $os = Get-CimInstance -ClassName Win32_OperatingSystem -ErrorAction Stop
    if ($policy.PolicyId -and [int]$os.BuildNumber -lt 18362) { throw 'Multiple-policy WDAC XML requires Windows 10 1903 or later.' }
    $target = if ($policy.PolicyId) {
        Join-Path $env:windir "System32\CodeIntegrity\CIPolicies\Active\$($policy.PolicyId).cip"
    } else { Join-Path $env:windir 'System32\CodeIntegrity\SiPolicy.p7b' }
    $ancestor = Split-Path -Parent $target
    while ($ancestor) {
        if (Test-Path -LiteralPath $ancestor -ErrorAction Stop) {
            $directory = Get-Item -LiteralPath $ancestor -Force -ErrorAction Stop
            if (-not $directory.PSIsContainer -or ($directory.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
                throw "Unsafe WDAC destination ancestor: '$ancestor'."
            }
        }
        $ancestor = Split-Path -Parent $ancestor
    }
    if ($policy.PolicyId -and $policy.BasePolicyId -and $policy.PolicyId -ne $policy.BasePolicyId) {
        $basePath = Join-Path (Split-Path -Parent $target) "$($policy.BasePolicyId).cip"
        if (-not (Test-Path -LiteralPath $basePath -PathType Leaf -ErrorAction Stop)) {
            throw "Supplemental WDAC policy requires its base policy to be installed first: '$basePath'."
        }
    }
    if (Test-Path -LiteralPath $target -ErrorAction Stop) { throw "WDAC policy already exists; refusing to replace it: '$target'." }
    if (-not $PSCmdlet.ShouldProcess($target, "Compile and stage $($policy.Mode) WDAC policy for next boot")) { return }
    $temporary = Join-Path $env:TEMP ('PAWDeploy-WDAC-' + [guid]::NewGuid().ToString('N'))
    $null = New-Item -Path $temporary -ItemType Directory -ErrorAction Stop
    $pending = Join-Path (Split-Path -Parent $target) ('.PAWDeploy-' + [guid]::NewGuid().ToString('N') + '.pending')
    $installed = $false
    try {
        $xml = Join-Path $temporary 'Policy.xml'
        $binary = Join-Path $temporary 'Policy.cip'
        $compileDocument = New-Object Xml.XmlDocument
        $compileDocument.XmlResolver = $null
        $compileDocument.PreserveWhitespace = $true
        $compileDocument.LoadXml($policy.Xml)
        if ($compileDocument.FirstChild -is [Xml.XmlDeclaration]) { $compileDocument.FirstChild.Encoding = 'utf-8' }
        [IO.File]::WriteAllText($xml, $compileDocument.OuterXml, (New-Object Text.UTF8Encoding($true)))
        $null = ConvertFrom-CIPolicy -XmlFilePath $xml -BinaryFilePath $binary -ErrorAction Stop
        if (-not (Test-Path -LiteralPath $binary -PathType Leaf -ErrorAction Stop) -or (Get-Item $binary -ErrorAction Stop).Length -eq 0) {
            throw 'WDAC compiler did not create a nonempty policy binary.'
        }
        $hash = (Get-FileHash -LiteralPath $binary -Algorithm SHA256 -ErrorAction Stop).Hash
        $null = New-Item -Path (Split-Path -Parent $target) -ItemType Directory -Force -ErrorAction Stop
        Copy-Item -LiteralPath $binary -Destination $pending -ErrorAction Stop
        if ((Get-FileHash -LiteralPath $pending -Algorithm SHA256 -ErrorAction Stop).Hash -ne $hash) { throw 'WDAC staging binary hash mismatch.' }
        [IO.File]::Move($pending, $target)
        $installed = $true
        if ((Get-FileHash -LiteralPath $target -Algorithm SHA256 -ErrorAction Stop).Hash -ne $hash) { throw "WDAC installed binary hash mismatch: '$target'." }
        [pscustomobject]@{ Destination = $target; Mode = $policy.Mode; PolicyId = $policy.PolicyId; RebootRequired = $true; Verified = $true }
    }
    catch {
        $failure = $_
        if ($installed) {
            try { Remove-Item -LiteralPath $target -Force -ErrorAction Stop }
            catch { Write-Warning "Unverified WDAC policy retained at '$target': $($_.Exception.Message). Remove it before reboot." }
        }
        throw $failure
    }
    finally {
        try {
            if (Test-Path -LiteralPath $pending -ErrorAction Stop) { Remove-Item -LiteralPath $pending -Force -ErrorAction Stop }
        }
        catch { Write-Warning "WDAC pending binary retained at '$pending': $($_.Exception.Message)" }
        try { Remove-Item -LiteralPath $temporary -Recurse -Force -ErrorAction Stop }
        catch { Write-Warning "WDAC temporary folder retained at '$temporary': $($_.Exception.Message)" }
    }
}
function Invoke-PAWDeploymentCleanup {
    <#
    .SYNOPSIS
        Cleans the resources recorded by a PAW deployment.

    .DESCRIPTION
        Removes autologon and staged setup files through PowerShell Direct when
        CleanupGuest is specified. Always cleans recorded host artifacts.
        Never stops or removes a VM and never deletes files in the VM directory,
        because a partly deployed VM may already be in use. Removes recorded
        offline setup files while an owned disk is still mounted, before detaching it.
        Independent cleanup steps continue after errors; any
        errors are reported and then raised together. Never mounts an offline
        disk or starts a VM to obtain guest access.

    .PARAMETER State
        Mutable ownership record populated by New-PAWHyperVVM and the deployment engine.
        Only record resources created or mounted by the current deployment.

    .PARAMETER Credential
        Local administrator credential for guest cleanup.

    .PARAMETER CleanupGuest
        Remove and verify guest autologon and setup artifacts.

    .PARAMETER SkipGuestFolderCleanup
        Preserve C:\SECBL and C:\PAWFiles, not autologon or setup files.
        Folder cleanup can subsequently be completed by calling again without
        this switch; verified secret removal remains tracked in State.


    .PARAMETER LogPath
        Optional deployment log receiving progress and cleanup errors.

    .EXAMPLE
        Invoke-PAWDeploymentCleanup -State $cleanupState -Credential $Cred -CleanupGuest
        Cleans the completed installation before final shutdown.

    .NOTES
        Version : 2.0.0.5
        Author  : The Fantastic PAWDeploy Team

    #>
    [CmdletBinding(SupportsShouldProcess = $true, ConfirmImpact = 'High')]
    param(
        [Parameter(Mandatory = $true)]
        [hashtable]$State,
        [System.Management.Automation.PSCredential]$Credential,
        [switch]$CleanupGuest,
        [switch]$SkipGuestFolderCleanup,
        [string]$LogPath
    )

    $failures = New-Object 'System.Collections.Generic.List[string]'
    $cleanupLogPath = $LogPath
    function Write-PAWCleanupMessage {
        param([string]$Message, [switch]$Failed)
        if ($Failed) {
            $failures.Add($Message)
            Write-Warning $Message
        }
        else { Write-Verbose $Message }
        if ($cleanupLogPath) {
            $level = 'INFO'
            if ($Failed) { $level = 'ERROR' }
            Write-PAWLog -Message $Message -Level $level -LogPath $cleanupLogPath
        }
    }

    if ($CleanupGuest -and $State.VMId -and
        (-not $State.GuestCleaned -or ($State.GuestFolderCleanupDeferred -and -not $SkipGuestFolderCleanup))) {
        try {
            if ($null -eq $Credential) { throw 'No guest credential is available.' }
            $vm = Get-VM -Id $State.VMId -ErrorAction Stop
            if ($vm.Name -ne $State.VMName) { throw 'Recorded VM identity has changed.' }
            if ($PSCmdlet.ShouldProcess($State.VMName, 'Remove guest autologon and deployment artifacts')) {
                $result = @(Invoke-PAWPSDirect -VMName $vm.Name -Credential $Credential `
                    -ScriptBlock ${function:Remove-PAWGuestDeploymentArtifact} `
                    -ArgumentList ([bool]$SkipGuestFolderCleanup) -MaxAttempts 1 -ErrorAction Stop)
                if ($result.Count -ne 1 -or $result[0].AutologonRemoved -ne $true -or
                    $result[0].DeploymentFilesRemoved -ne $true) {
                    throw 'Guest cleanup did not return verified completion.'
                }
                $State.GuestCleaned = $true
                $State.GuestFolderCleanupDeferred = [bool]$SkipGuestFolderCleanup
                Write-PAWCleanupMessage "Verified autologon and setup artifact removal in '$($State.VMName)'."
            }
        }
        catch {
            Write-PAWCleanupMessage -Failed "Guest cleanup not verified for '$($State.VMName)'; autologon/setup secrets may remain if the disk is retained. $($_.Exception.Message)"
        }
    }

    $mountSafe = -not $State.MountedVHD
    if ($State.MountedVHD) {
        try {
            $image = Get-DiskImage -ImagePath $State.MountedVHD -ErrorAction Stop
            if ($image.Attached) {
                foreach ($setupFile in @($State.OfflineSetupFiles)) {
                    if ($setupFile) {
                        try {
                            if ((Test-Path -LiteralPath $setupFile -ErrorAction Stop) -and
                                $PSCmdlet.ShouldProcess($setupFile, 'Remove deployment-owned offline setup file')) {
                                Remove-Item -LiteralPath $setupFile -Force -ErrorAction Stop
                                if (Test-Path -LiteralPath $setupFile -ErrorAction Stop) {
                                    throw "Offline setup file remains: $setupFile"
                                }
                            }
                        }
                        catch { Write-PAWCleanupMessage -Failed "Offline setup cleanup failed. $($_.Exception.Message)" }
                    }
                }
                if ($PSCmdlet.ShouldProcess($State.MountedVHD, 'Dismount deployment-owned offline image')) {
                    Dismount-DiskImage -ImagePath $State.MountedVHD -ErrorAction Stop
                    if ((Get-DiskImage -ImagePath $State.MountedVHD -ErrorAction Stop).Attached) {
                        throw 'The offline disk is still attached.'
                    }
                    $mountSafe = $true
                }
            }
            else { $mountSafe = $true }
            if ($mountSafe) {
                $State.MountedVHD = $null
                $State.OfflineSetupFiles = $null
                Write-PAWCleanupMessage 'Deployment-owned offline image is detached.'
            }
        }
        catch { Write-PAWCleanupMessage -Failed "Offline disk cleanup failed; mount directory retained. $($_.Exception.Message)" }
    }

    if ($State.CredentialFile) {
        try {
            if ((Test-Path -LiteralPath $State.CredentialFile -ErrorAction Stop) -and
                $PSCmdlet.ShouldProcess($State.CredentialFile, 'Remove deployment credential file')) {
                Remove-Item -LiteralPath $State.CredentialFile -Force -ErrorAction Stop
            }
            if (-not (Test-Path -LiteralPath $State.CredentialFile -ErrorAction Stop)) {
                $State.CredentialFile = $null
            }
            elseif (-not $WhatIfPreference) { throw 'Credential file remains.' }
        }
        catch { Write-PAWCleanupMessage -Failed "Credential file cleanup failed. $($_.Exception.Message)" }
    }
    if ($State.TempFolder -and $mountSafe) {
        try {
            if ($PSCmdlet.ShouldProcess($State.TempFolder, 'Remove host staging artifacts')) {
                Remove-PAWDeploymentDirectory -Path $State.TempFolder -Confirm:$false -ErrorAction Stop
            }
            if (-not (Test-Path -LiteralPath $State.TempFolder -ErrorAction Stop)) {
                Write-PAWCleanupMessage "Removed deployment staging directory '$($State.TempFolder)'."
                $State.TempFolder = $null
            }
        }
        catch { Write-PAWCleanupMessage -Failed "Host staging cleanup failed. $($_.Exception.Message)" }
    }
    if ($failures.Count -gt 0) { throw ($failures -join [Environment]::NewLine) }
}
Function Invoke-PAWExe {
    <#
    .SYNOPSIS
        Runs an executable and validates its exit code.

    .DESCRIPTION
        Invoke-PAWExe starts a process using Start-Process, waits for completion,
        and throws an exception when the returned exit code is not in the list of
        expected success codes.

        This wrapper is useful for deployment scripts that require deterministic
        error handling from external installers or command-line tools.

    .PARAMETER Executable
        Path to an executable file or command name resolvable by Get-Command.

    .PARAMETER Arguments
        Command-line arguments passed to the executable.

    .PARAMETER SuccessfulReturnCode
        One or more exit codes considered successful. Defaults to 0.

    .EXAMPLE
        Invoke-PAWExe -Executable msiexec.exe -Arguments '/i "C:\Temp\Tool.msi" /qn' -SuccessfulReturnCode 0,3010

        Installs an MSI silently and treats both 0 (success) and 3010
        (success with reboot required) as successful outcomes.

    .EXAMPLE
        Invoke-PAWExe -Executable dism.exe -Arguments '/Online /Cleanup-Image /ScanHealth'

        Runs DISM and throws if the command returns anything other than 0.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>

    [CmdletBinding()]
    param(
        [parameter(mandatory = $true, position = 0)]
        [ValidateNotNullOrEmpty()]
        [string]
        $Executable,

        [parameter(mandatory = $true, position = 1)]
        [ValidateNotNullOrEmpty()]
        [string]
        $Arguments,

        [parameter(mandatory = $false, position = 2)]
        [ValidateNotNullOrEmpty()]
        [int[]]
        $SuccessfulReturnCode = @(0)
    )

    $null = Get-Command -Name $Executable -ErrorAction Stop

    Write-Verbose "Running executable '$Executable' with arguments '$Arguments'"
    $ReturnFromEXE = Start-Process -FilePath $Executable -ArgumentList $Arguments -NoNewWindow -Wait -PassThru -ErrorAction Stop

    Write-Verbose "Exit code is $($ReturnFromEXE.ExitCode)"

    if ($SuccessfulReturnCode -notcontains $ReturnFromEXE.ExitCode) {
        throw "'$Executable' failed with exit code $($ReturnFromEXE.ExitCode). Expected: $($SuccessfulReturnCode -join ', ')."
    }

    $ReturnFromEXE
}
<#

.SYNOPSIS
    Plays an audible notification when the deployment reaches its final phase.

.DESCRIPTION
    Plays a notification sound to signal that a deployment has entered its
    final phase, falling back to console beeps when SystemSounds is
    unavailable.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function Invoke-PAWFinalPhaseNotification {
    [CmdletBinding()]
    param()

    try {
        Add-Type -AssemblyName System -ErrorAction Stop
        [System.Media.SystemSounds]::Exclamation.Play()
    }
    catch {
        try {
            [console]::Beep(1200, 400)
            [console]::Beep(1600, 400)
        }
        catch {
            Write-Verbose "Could not play final phase notification: $($_.Exception.Message)"
        }
    }
}
Function Invoke-PAWPSDirect {
    <#
    .SYNOPSIS
        Runs a PowerShell Direct command with session validation and reconnect logic.

    .DESCRIPTION
        Creates or reuses a PowerShell Direct session to the target VM, validates that the
        session is usable, and runs the provided script block through that session.
        If the session cannot be established, the function retries with exponential
        backoff. If the session breaks during command execution, the command is only
        re-run automatically when RetryCommand is specified.

    .PARAMETER VMName
        Name of the target virtual machine.

    .PARAMETER Credential
        Credentials used for PowerShell Direct.

    .PARAMETER ScriptBlock
        Script block to run inside the guest.

    .PARAMETER ArgumentList
        Optional argument list passed to the script block.
        Defaults to @().

    .PARAMETER MaxAttempts
        Maximum number of connection or reconnect attempts.
        Defaults to 8.

    .PARAMETER InitialDelaySec
        Initial backoff delay in seconds.
        Defaults to 1.

    .PARAMETER MaxDelaySec
        Maximum backoff delay in seconds.
        Defaults to 20.

    .PARAMETER RetryCommand
        Re-runs the command after reconnect only for safe, idempotent operations.

    .PARAMETER SessionContext
        Optional deployment-owned hashtable. Reuses a validated session for the
        same VM ID and credential object. Not safe for concurrent use. The owner
        must close it before shutdown and in finally. Omit for isolated commands.

    .PARAMETER GuestRestartTimeoutSec
        Seconds to keep reconnecting when the guest rejects logon with "The credential
        is invalid" while creating a session. PowerShell Direct reports this while the
        guest restarts, so it does not consume connection attempts. Defaults to 300.

    .NOTES
        Version : 2.0.0.2
        Author  : The Fantastic PAWDeploy Team

    #>
    [CmdletBinding()]
    Param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]
        $VMName,

        [Parameter(Mandatory = $true)]
        [ValidateNotNull()]
        [System.Management.Automation.PSCredential]
        $Credential,

        [Parameter(Mandatory = $true)]
        [ValidateNotNull()]
        [scriptblock]
        $ScriptBlock,

        [Parameter()]
        [object[]]
        $ArgumentList = @(),

        [Parameter()]
        [ValidateRange(1, 100)]
        [int]
        $MaxAttempts = 8,

        [Parameter()]
        [ValidateRange(1, 300)]
        [int]
        $InitialDelaySec = 1,

        [Parameter()]
        [ValidateRange(1, 600)]
        [int]
        $MaxDelaySec = 20,

        [Parameter()]
        [switch]
        $RetryCommand,

        [Parameter()]
        [AllowEmptyCollection()]
        [hashtable]$SessionContext,

        [Parameter()]
        [ValidateRange(0, 3600)]
        [int]
        $GuestRestartTimeoutSec = 300
    )

    function Test-PAWIsBrokenPSDirectError {
        Param(
            [Parameter(Mandatory = $true)]
            [System.Management.Automation.ErrorRecord]
            $ErrorRecord
        )

        $message = $ErrorRecord.Exception.Message
        return (
            ($ErrorRecord.FullyQualifiedErrorId -match 'PSSessionStateBroken') -or
            ($message -match 'Hyper-V socket target process has ended') -or
            ($message -match 'The I/O operation has been aborted') -or
            ($message -match 'PSRemotingTransportException') -or
            ($message -match 'The WSMan provider host process did not return a proper response') -or
            ($message -match 'A system shutdown is in progress') -or
            ($message -match 'HRESULT\s*0x8007045b') -or
            ($message -match 'A remote session might have ended') -or
            ($message -match 'Windows PowerShell cannot handle')
        )
    }

    $delay = [Math]::Max(1, $InitialDelaySec)
    $session = $null
    $lastObservedVmState = $null
    $reusable = $PSBoundParameters.ContainsKey('SessionContext')
    $completed = $false
    $guestRestartDeadline = $null
    if ($reusable) {
        if ($null -eq $SessionContext) { throw 'SessionContext cannot be null.' }
        if ($SessionContext.Busy) { throw 'PowerShell Direct context is already in use.' }
        if ($SessionContext.ContainsKey('VMId')) {
            $contextVM = Get-VM -Name $VMName -ErrorAction Stop
            if ($SessionContext.VMId -ne $contextVM.Id -or
                -not [object]::ReferenceEquals($SessionContext.Credential, $Credential)) {
                throw 'PowerShell Direct context belongs to a different VM or credential. Close it before reuse.'
            }
        }
        $SessionContext.Busy = $true
        $session = $SessionContext.Session
    }

    try {
        for ($attempt = 1; $attempt -le $MaxAttempts; $attempt++) {
            $commandFailed = $false
            $sessionValidationFailed = $false
            $connecting = $false
            Write-Verbose "[$VMName] PowerShell Direct attempt $attempt of $MaxAttempts"

            $vm = Get-VM -Name $VMName -ErrorAction Stop
            if ($reusable) {
                if ($SessionContext.ContainsKey('VMId') -and
                    ($SessionContext.VMId -ne $vm.Id -or
                    -not [object]::ReferenceEquals($SessionContext.Credential, $Credential))) {
                    throw 'PowerShell Direct context belongs to a different VM or credential. Close it before reuse.'
                }
                if ($null -eq $vm.Id) { throw 'VM ID is required for reusable PowerShell Direct sessions.' }
                $SessionContext.VMId = $vm.Id
                $SessionContext.Credential = $Credential
            }
            $lastObservedVmState = [string]$vm.State
            if ($lastObservedVmState -ne 'Running') {
                Write-Verbose "[$VMName] Hyper-V reported VM state '$lastObservedVmState'; verifying before attempting PowerShell Direct"
                Start-Sleep -Seconds 1

                $vm = Get-VM -Name $VMName -ErrorAction Stop
                if ($reusable -and $SessionContext.VMId -ne $vm.Id) {
                    throw 'VM identity changed while waiting for PowerShell Direct.'
                }
                $lastObservedVmState = [string]$vm.State
                if ($lastObservedVmState -ne 'Running') {
                    if ($attempt -ge $MaxAttempts) {
                        throw "VM '$VMName' did not reach the Running state after $MaxAttempts attempt(s). Last observed state: $lastObservedVmState."
                    }

                    Write-Verbose "[$VMName] VM state is still '$lastObservedVmState'; waiting $delay second(s) before retrying"
                    Start-Sleep -Seconds $delay
                    $delay = [Math]::Min($MaxDelaySec, $delay * 2)
                    continue
                }

                Write-Verbose "[$VMName] VM state re-check now reports Running; continuing with PowerShell Direct"
            }

            if ($null -ne $session -and
                ($attempt -gt 1 -or -not (Test-PAWPSDirectSession -Session $session))) {
                Write-Verbose "[$VMName] Removing previous PowerShell Direct session before reconnect"
                Remove-PSSession -Session $session -ErrorAction Stop
                $session = $null
                if ($reusable) { $SessionContext.Session = $null }
            }

            try {
                if ($null -eq $session) {
                    Write-Verbose "[$VMName] Creating new PowerShell Direct session"
                    $connecting = $true
                    $session = New-PSSession -VMName $VMName -Credential $Credential -ErrorAction Stop
                    $connecting = $false
                    if ($reusable) { $SessionContext.Session = $session }
                    Write-Verbose "[$VMName] Validating PowerShell Direct session"
                    if (-not (Test-PAWPSDirectSession -Session $session)) {
                        $sessionValidationFailed = $true
                        throw "PowerShell Direct session validation failed for '$VMName'."
                    }
                }
                Write-Verbose "[$VMName] PowerShell Direct session validated successfully"

                try {
                    Write-Verbose "[$VMName] Running command through PowerShell Direct"
                    $result = Invoke-Command -Session $session -ScriptBlock $ScriptBlock -ArgumentList $ArgumentList -ErrorAction Stop
                    Write-Verbose "[$VMName] PowerShell Direct command completed successfully"
                    $completed = $true
                    return $result
                }
                catch {
                    $isTransientPSDirectError = Test-PAWIsBrokenPSDirectError -ErrorRecord $_
                    if ((-not $isTransientPSDirectError) -or (-not $RetryCommand)) {
                        $commandFailed = $true
                        if ($isTransientPSDirectError) {
                            Write-Verbose "[$VMName] PowerShell Direct session broke during command execution and automatic command retry is disabled"
                            throw "PowerShell Direct session to '$VMName' broke while running the command. Command outcome is unknown, so it was not retried automatically. Original error: $($_.Exception.Message)"
                        }

                        throw
                    }

                    Write-Verbose "[$VMName] Classified as transient PowerShell Direct/guest-state error and will retry because -RetryCommand is enabled. Original error: $($_.Exception.Message)"
                    Write-Verbose "[$VMName] PowerShell Direct session broke during command execution; reconnecting and retrying command after $delay second(s)"
                    if ($attempt -lt $MaxAttempts) {
                        Start-Sleep -Seconds $delay
                        $delay = [Math]::Min($MaxDelaySec, $delay * 2)
                    }
                }
            }
            catch {
                Write-Verbose "[$VMName] PowerShell Direct attempt $attempt failed: $($_.Exception.Message)"
                if ($commandFailed) { throw }
                # PowerShell Direct rejects logon with "credential is invalid" while the guest restarts.
                if ($connecting -and $GuestRestartTimeoutSec -gt 0 -and $_.Exception.Message -match 'The credential is invalid') {
                    if ($null -eq $guestRestartDeadline) {
                        $guestRestartDeadline = (Get-Date).AddSeconds($GuestRestartTimeoutSec)
                        Write-PAWConsoleLog -Message "'{0}' is not accepting logons (guest may be restarting); waiting up to {1} seconds" -Type Wait -Value $VMName, $GuestRestartTimeoutSec
                    }
                    if ((Get-Date) -lt $guestRestartDeadline) {
                        Start-Sleep -Seconds 5
                        $attempt--
                        continue
                    }
                    Write-Verbose "[$VMName] Guest did not accept logons within $GuestRestartTimeoutSec second(s)"
                    throw
                }
                if (-not $sessionValidationFailed -and -not (Test-PAWIsBrokenPSDirectError -ErrorRecord $_)) {
                    Write-Verbose "[$VMName] Failure is not a PowerShell Direct transport/session error; stopping retries"
                    throw
                }

                if ($attempt -ge $MaxAttempts) {
                    throw
                }

                Write-Verbose "[$VMName] Waiting $delay second(s) before next reconnect attempt"
                Start-Sleep -Seconds $delay
                $delay = [Math]::Min($MaxDelaySec, $delay * 2)
                continue
            }
        }

        throw "Failed to run PowerShell Direct command against '$VMName' after $MaxAttempts attempts."
    }
    finally {
        if ($reusable) { $SessionContext.Busy = $false }
        if (-not $reusable -or -not $completed) {
            try {
                if ($reusable) {
                    Close-PAWPSDirectSessionContext -SessionContext $SessionContext
                }
                elseif ($null -ne $session) {
                    Write-Verbose "[$VMName] Closing PowerShell Direct session"
                    Remove-PSSession -Session $session -ErrorAction Stop
                }
            }
            catch {
                Write-Warning "PowerShell Direct session cleanup failed for '$VMName': $($_.Exception.Message)"
                if ($completed) { throw }
            }
        }
    }
}
function Invoke-PAWTypedApplication {
    <#
    .SYNOPSIS
        Installs a typed application in the guest without evaluating command text.
    .NOTES
        Version : 2.0.0.6
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)][psobject]$Application,
        [Parameter(Mandatory = $true)][string]$PackageRoot
    )

    $resource = Test-PAWApplicationResources -Application $Application -AppInstallRoot (Split-Path -Parent (Split-Path -Parent (Split-Path -Parent $PackageRoot)))
    switch ($Application.Source) {
        'PSGallery' {
            $runtime = [string]$Application.Options.Runtime
            if ($runtime -notin @('WindowsPowerShell', 'PowerShell7')) { throw "Unsupported PowerShell runtime '$runtime'." }
            if ($runtime -eq 'PowerShell7') {
                $pwsh = Get-Command pwsh.exe -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
                $pwshPath = if ($pwsh) { $pwsh.Source } else { Join-Path $env:ProgramFiles 'PowerShell\7\pwsh.exe' }
                if (-not (Test-Path -LiteralPath $pwshPath -PathType Leaf)) {
                    throw "PowerShell 7 is required to install '$($Application.Name)', but pwsh.exe was not found in the guest."
                }
                $destination = Join-Path $env:ProgramFiles 'PowerShell\Modules'
            }
            else {
                $destination = Join-Path $env:ProgramFiles 'WindowsPowerShell\Modules'
            }
            if (-not (Test-Path -LiteralPath $destination -PathType Container)) {
                $null = New-Item -Path $destination -ItemType Directory -Force
            }
            foreach ($moduleFolder in @($resource.Modules)) {
                $moduleName = $moduleFolder.Parent.Name
                $moduleRoot = Join-Path $destination $moduleName
                if (-not (Test-Path -LiteralPath $moduleRoot -PathType Container)) {
                    $null = New-Item -Path $moduleRoot -ItemType Directory -Force
                }
                $target = Join-Path $moduleRoot $moduleFolder.Name
                $targetManifest = Join-Path $target "$moduleName.psd1"
                if (-not (Test-Path -LiteralPath $targetManifest -PathType Leaf)) {
                    if (Test-Path -LiteralPath $target -PathType Container) {
                        Remove-Item -LiteralPath $target -Recurse -Force
                    }
                    Copy-Item -LiteralPath $moduleFolder.FullName -Destination $moduleRoot -Recurse -Force -ErrorAction Stop
                }
                if (-not (Test-Path -LiteralPath $targetManifest -PathType Leaf)) {
                    throw "Module '$moduleName' version '$($moduleFolder.Name)' was not available at '$targetManifest' after copying."
                }
            }
            Write-Output "Installed module '$($Application.Id)' for $runtime."
            return [pscustomobject]@{ Status = 'Success'; Detail = 'Installed' }
        }
        'Classic' {
            $options = $Application.Options
            $legacy = $null -ne $options.PSObject.Properties['FilePath']
            $appFolder = if ($legacy) { $PackageRoot } else {
                Resolve-PAWApplicationPayloadPath -PackageRoot $PackageRoot -RelativePath $options.FolderPath
            }
            $expandAppPath = {
                param([string]$Text)
                [Environment]::ExpandEnvironmentVariables(($Text -split '(?i)%App%') -join $appFolder)
            }
            $detection = if ($null -ne $options.PSObject.Properties['Detection']) { $options.Detection } else { $null }
            $detectionScriptPath = if ($null -ne $detection -and $null -ne $detection.PSObject.Properties['ScriptPath']) {
                Resolve-PAWApplicationPayloadPath -PackageRoot $appFolder -RelativePath $detection.ScriptPath.Substring(6)
            } else { $null }
            $detect = {
                if ($legacy) {
                    $detectionPath = Expand-PAWAppInstallPath -Path ([string]$detection.Path)
                    return (Test-Path -LiteralPath $detectionPath)
                }
                $result = @(& {
                    param($App, $Detection, $ScriptPath)
                    $ErrorActionPreference = 'Stop'
                    if ($ScriptPath) { & $ScriptPath }
                    else { & ([scriptblock]::Create($Detection.Script)) }
                } $appFolder $detection $detectionScriptPath)
                if ($result.Count -ne 1 -or $result[0] -isnot [bool]) {
                    throw "Detection script for '$($Application.Name)' must return exactly one Boolean (`$true or `$false)."
                }
                return $result[0]
            }
            if ($null -ne $detection -and (& $detect)) {
                Write-Output "Skipped '$($Application.Name)': already installed."
                return [pscustomobject]@{ Status = 'Skipped'; Detail = 'AlreadyInstalled' }
            }
            if ($legacy) {
                $executable = [string]$options.FilePath
                $systemExecutables = @('powershell.exe', 'pwsh.exe', 'cmd.exe', 'msiexec.exe', 'dism.exe')
                $isSystemExecutable = $systemExecutables -contains [IO.Path]::GetFileName($executable) -and
                    ([IO.Path]::IsPathRooted($executable) -or [IO.Path]::GetFileName($executable) -eq $executable)
                if ($isSystemExecutable) {
                    $command = Get-Command -Name ([IO.Path]::GetFileName($executable)) -CommandType Application -ErrorAction Stop | Select-Object -First 1
                    $executable = $command.Source
                }
                else {
                    $executable = Resolve-PAWApplicationPayloadPath -PackageRoot $PackageRoot -RelativePath $executable
                }
            }
            else {
                $executable = & $expandAppPath $options.Executable
                if (-not [IO.Path]::IsPathRooted($executable)) {
                    $payloadExecutable = Resolve-PAWApplicationPayloadPath -PackageRoot $appFolder -RelativePath $executable
                    if (Test-Path -LiteralPath $payloadExecutable -PathType Leaf) { $executable = $payloadExecutable }
                    elseif ([IO.Path]::GetFileName($executable) -eq $executable) {
                        $executable = (Get-Command -Name $executable -CommandType Application -ErrorAction Stop | Select-Object -First 1).Source
                    }
                    else { throw "Classic installer payload was not found: '$payloadExecutable'." }
                }
                if (-not (Test-Path -LiteralPath $executable -PathType Leaf)) { throw "Classic executable was not found: '$executable'." }
            }
            $workingDirectory = [string]$Application.Options.WorkingDirectory
            if ([string]::IsNullOrWhiteSpace($workingDirectory)) { $workingDirectory = '.' }
            $workingDirectory = Resolve-PAWApplicationPayloadPath -PackageRoot $appFolder -RelativePath $workingDirectory
            if (-not (Test-Path -LiteralPath $workingDirectory -PathType Container)) { throw "Classic WorkingDirectory '$workingDirectory' does not exist." }
            $arguments = [string]$Application.Options.Arguments
            if (-not $legacy) { $arguments = & $expandAppPath $arguments }
            if ([IO.Path]::GetExtension($executable) -ieq '.ps1') {
                $arguments = '-NoProfile -File "' + $executable.Replace('"', '\"') + '"' + $(if ($arguments) { " $arguments" })
                $executable = (Get-Command powershell.exe -CommandType Application -ErrorAction Stop | Select-Object -First 1).Source
            }
            $start = @{ FilePath = $executable; WorkingDirectory = $workingDirectory; PassThru = $true; ErrorAction = 'Stop' }
            if (-not [string]::IsNullOrEmpty($arguments)) { $start.ArgumentList = $arguments }
            $process = Start-Process @start
            $timeout = [int]$Application.Options.TimeoutSeconds
            if ($timeout -le 0) { $timeout = 3600 }
            if (-not $process.WaitForExit($timeout * 1000)) {
                try { $process.Kill() }
                catch {
                    Write-Warning "Unable to terminate timed-out Classic installer '$($Application.Name)': $($_.Exception.Message)"
                }
                throw "Classic installer '$($Application.Name)' timed out after $timeout seconds."
            }
            $successCodes = @($Application.Options.SuccessExitCodes)
            if ($successCodes.Count -eq 0) { $successCodes = @(0, 3010) }
            if ($successCodes -notcontains [int]$process.ExitCode) {
                throw "Classic installer '$($Application.Name)' failed with exit code $($process.ExitCode)."
            }
            if ($null -ne $detection -and -not (& $detect)) {
                throw "Classic installer '$($Application.Name)' completed but detection did not confirm installation."
            }
            Write-Output "Installed '$($Application.Name)' (exit code $($process.ExitCode))."
            return [pscustomobject]@{ Status = 'Success'; Detail = 'Installed' }
        }
        'WindowsComponent' {
            $options = $Application.Options
            $source = ''
            if (-not [string]::IsNullOrWhiteSpace([string]$options.Source)) {
                $source = Resolve-PAWApplicationPayloadPath -PackageRoot $PackageRoot -RelativePath ([string]$options.Source)
            }
            $installedAny = $false
            $componentNames = @($options.Names)
            if ($options.Kind -eq 'Capability') {
                if (-not (Get-Command Get-WindowsCapability -ErrorAction SilentlyContinue) -or -not (Get-Command Add-WindowsCapability -ErrorAction SilentlyContinue)) {
                    throw 'Windows Capability installation is unsupported on this guest OS (DISM cmdlets are unavailable).'
                }
                $resolvedNames = New-Object 'System.Collections.Generic.List[string]'
                $seenNames = @{}
                foreach ($name in $componentNames) {
                    $names = @($name)
                    if ([System.Management.Automation.WildcardPattern]::ContainsWildcardCharacters($name)) {
                        $names = @(Get-WindowsCapability -Online -Name $name -ErrorAction Stop | Select-Object -ExpandProperty Name -ErrorAction Stop)
                        if (-not $names.Count) { throw "Capability pattern '$name' matched no capabilities on this guest OS." }
                    }
                    foreach ($resolvedName in $names) {
                        if (-not $seenNames.ContainsKey($resolvedName)) {
                            $seenNames[$resolvedName] = $true
                            $resolvedNames.Add($resolvedName)
                        }
                    }
                }
                $componentNames = @($resolvedNames)
            }
            foreach ($name in $componentNames) {
                switch ($options.Kind) {
                    'Capability' {
                        $current = Get-WindowsCapability -Online -Name $name -ErrorAction Stop
                        if ($current.State -eq 'Installed') { Write-Output "Skipped installed capability '$name'."; continue }
                        $installedAny = $true
                        $arguments = @{ Online = $true; Name = $name; ErrorAction = 'Stop' }
                        if ($source) { $arguments.Source = $source }
                        if ($options.LimitAccess) { $arguments.LimitAccess = $true }
                        Add-WindowsCapability @arguments | Out-Null
                        if ((Get-WindowsCapability -Online -Name $name -ErrorAction Stop).State -ne 'Installed') { throw "Capability '$name' was not installed." }
                    }
                    'OptionalFeature' {
                        if (-not (Get-Command Get-WindowsOptionalFeature -ErrorAction SilentlyContinue) -or -not (Get-Command Enable-WindowsOptionalFeature -ErrorAction SilentlyContinue)) {
                            throw 'Windows Optional Feature installation is unsupported on this guest OS (DISM cmdlets are unavailable).'
                        }
                        $current = Get-WindowsOptionalFeature -Online -FeatureName $name -ErrorAction Stop
                        if ($current.State -eq 'Enabled') { Write-Output "Skipped enabled optional feature '$name'."; continue }
                        $installedAny = $true
                        $arguments = @{ Online = $true; FeatureName = $name; NoRestart = $true; ErrorAction = 'Stop' }
                        if ($source) { $arguments.Source = $source }
                        if ($options.LimitAccess) { $arguments.LimitAccess = $true }
                        Enable-WindowsOptionalFeature @arguments | Out-Null
                        if ((Get-WindowsOptionalFeature -Online -FeatureName $name -ErrorAction Stop).State -ne 'Enabled') { throw "Optional feature '$name' was not enabled." }
                    }
                    'ServerFeature' {
                        if (-not (Get-Command Get-WindowsFeature -ErrorAction SilentlyContinue) -or -not (Get-Command Install-WindowsFeature -ErrorAction SilentlyContinue)) {
                            throw 'Server Feature installation is unsupported on this guest OS (ServerManager cmdlets are unavailable).'
                        }
                        $current = Get-WindowsFeature -Name $name -ErrorAction Stop
                        if ($current.Installed) { Write-Output "Skipped installed server feature '$name'."; continue }
                        $installedAny = $true
                        $arguments = @{ Name = $name; ErrorAction = 'Stop' }
                        if ($source) { $arguments.Source = $source }
                        $result = Install-WindowsFeature @arguments
                        if (-not $result.Success -or -not (Get-WindowsFeature -Name $name -ErrorAction Stop).Installed) { throw "Server feature '$name' was not installed." }
                    }
                    default { throw "Unsupported Windows component kind '$($options.Kind)'." }
                }
            }
            if (-not $installedAny) {
                return [pscustomobject]@{ Status = 'Skipped'; Detail = 'AlreadyInstalled' }
            }
            Write-Output "Windows component operation completed for '$($Application.Name)'. No restart was requested."
            return [pscustomobject]@{ Status = 'Success'; Detail = 'Installed' }
        }
        default { throw "Unsupported typed application source '$($Application.Source)'." }
    }
}
Function Mount-PAWVHDInFolder {
    <#
    .SYNOPSIS
        Mounts a VHD/VHDX without a drive letter and exposes its data partition through a folder path.

    .DESCRIPTION
        Mount-PAWVHDInFolder attaches a virtual disk image, identifies the expected
        data partition based on partition style, and assigns the provided folder as
        the partition access path.

        Partition selection rules:
        - MBR: partition type IFS
        - GPT: partition type Basic

        If no matching partition is found, or more than one matching partition is
        found, the function throws to avoid mounting an unexpected partition.

    .PARAMETER VHDfile
        Full path to the VHD/VHDX file to mount.

    .PARAMETER MountFolder
        Folder path to use as the partition access path.

    .EXAMPLE
        Mount-PAWVHDInFolder -VHDfile "C:\VMs\PAW01\Virtual Hard Disks\PAW01.vhdx" -MountFolder "C:\Temp\PAWDeploy\Mount"

        Mounts the VHDX and maps its primary data partition to C:\Temp\PAWDeploy\Mount.

    .EXAMPLE
        Mount-PAWVHDInFolder -VHDfile "C:\VMs\PAW01\Virtual Hard Disks\PAW01.vhdx" -MountFolder "C:\Temp\PAWDeploy\Mount" -WhatIf

        Shows what would be mounted and mapped without making changes.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>

    [cmdletbinding(SupportsShouldProcess = $true, ConfirmImpact = 'Medium')]
    Param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$VHDfile,

        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$MountFolder
    )

    if (-not (Test-Path -Path $VHDfile -PathType Leaf)) {
        throw "VHD file not found: $VHDfile"
    }

    $mountVHD = New-Item -Path $MountFolder -ItemType Directory -Force -ErrorAction Stop

    if ($PSCmdlet.ShouldProcess($VHDfile, 'Mount disk image without drive letter')) {
        $null = Mount-DiskImage -ImagePath $VHDfile -NoDriveLetter -PassThru -ErrorAction Stop
    }

    $disk = Get-DiskImage -ImagePath $VHDfile -ErrorAction Stop | Get-Disk -ErrorAction Stop
    $partitions = Get-Partition -DiskNumber $disk.Number -ErrorAction Stop

    $targetPartitions = switch ($disk.PartitionStyle) {
        'MBR' { $partitions | Where-Object { $_.Type -eq 'IFS' } }
        'GPT' { $partitions | Where-Object { $_.Type -eq 'Basic' } }
        default { throw "Unsupported partition style '$($disk.PartitionStyle)' for VHD '$VHDfile'." }
    }

    if ($null -eq $targetPartitions -or $targetPartitions.Count -eq 0) {
        throw "No matching data partition found on disk #$($disk.Number) for partition style '$($disk.PartitionStyle)'."
    }

    if ($targetPartitions.Count -gt 1) {
        throw "Multiple matching partitions found on disk #$($disk.Number). Refusing to continue to avoid incorrect mount mapping."
    }

    $targetPartition = $targetPartitions[0]
    $mountPath = $mountVHD.FullName

    if ($targetPartition.AccessPaths -contains $mountPath) {
        Write-Verbose "Partition access path already exists: $mountPath"
        return
    }

    if ($PSCmdlet.ShouldProcess("Disk #$($disk.Number), Partition #$($targetPartition.PartitionNumber)", "Add partition access path '$mountPath'")) {
        Add-PartitionAccessPath -DiskNumber $disk.Number -PartitionNumber $targetPartition.PartitionNumber -AccessPath $mountPath -ErrorAction Stop
        Write-Verbose "Mounted '$VHDfile' to '$mountPath'"
    }

}
Function New-PAWHyperVVM {
    <#
    .SYNOPSIS
        Creates a new Privileged Access Workstation (PAW) Virtual Machine.

    .DESCRIPTION
        Creates and configures the Hyper-V VM and its selected disk.
        Guest installation and hardening are handled by the New-PAWVM.ps1
        deployment engine, not by this function.

    .PARAMETER CleanupState
        Records the new VM ID and exclusively reserved VM directory, including
        partial failures. Existing directories are refused when this is supplied.

    .PARAMETER VMName
        Name for the new virtual machine.

    .PARAMETER VMMem
        Startup memory assigned to the virtual machine. Defaults to 1GB.

    .PARAMETER VMvCPU
        Number of virtual processors assigned to the virtual machine. Defaults to 1.

    .PARAMETER VMLocation
        Folder where the virtual machine and its files are created.

    .PARAMETER VHDFile
        Source or destination VHD path used according to DiskMode.

    .PARAMETER DiskMode
        Required disk selection or creation mode. Accepted values: Copy, Diff, Empty, Attached, None.

    .PARAMETER VMSwitchName
        Hyper-V virtual switch connected to the VM network adapter.

    .PARAMETER VlanID
        Optional VLAN identifier assigned to the VM network adapter.

    .PARAMETER VMGeneration
        Hyper-V generation for the new virtual machine. Accepted values: 1, 2.

    .PARAMETER ISO
        Optional ISO image attached to the virtual machine.

    .PARAMETER EmptyDiskSize
        Size of the empty dynamic virtual disk to create.

    .PARAMETER DynaMem
        Enable dynamic memory for the virtual machine.

    .EXAMPLE
        PS C:\> New-PAWHyperVVM -VMName "PAW-01" -VMLocation "C:\VMs" -VMMem 4GB -VMvCPU 2 -VMSwitchName "PAWSwitch" -DiskMode None
        Creates a new PAW VM named "PAW-01" with 4GB of memory, 2 virtual CPUs, and connects it to the "PAWSwitch".

    .NOTES
        Version : 2.0.0.3
        Author  : The Fantastic PAWDeploy Team

        File Name      : New-PAWHyperVVM.ps1
        Original author: Mikael Nyström
        Prerequisite   : Requires appropriate permissions to deploy VMs.
        Copyright      : (c) <Year> <Your Organization>. All rights reserved.

        This script is provided "AS IS" with no warranties, confers no rights and
        is not supported by the authors or Deployment Artist.

    #>

    [cmdletbinding()]
    Param(
        [Parameter(mandatory = $True)]
        [ValidateNotNullOrEmpty()]
        [String]
        $VMName,

        [Parameter(mandatory = $false)]
        [ValidateNotNullOrEmpty()]
        #[Int]
        $VMMem = 1GB,

        [Parameter(mandatory = $false)]
        [ValidateNotNullOrEmpty()]
        [int]
        $VMvCPU = 1,

        [parameter(mandatory = $True)]
        [ValidateNotNullOrEmpty()]
        [String]
        $VMLocation,

        [parameter(mandatory = $false)]
        [ValidateNotNullOrEmpty()]
        [String]
        $VHDFile,

        [parameter(mandatory = $True)]
        [ValidateSet("Copy", "Diff", "Empty", "Attached", "None")]
        [String]
        $DiskMode,

        [parameter(mandatory = $True)]
        [ValidateNotNullOrEmpty()]
        [String]
        $VMSwitchName,

        [parameter(mandatory = $False)]
        [ValidateNotNullOrEmpty()]
        [Int]
        $VlanID,

        [parameter(mandatory = $False)]
        [ValidateSet("1", "2")]
        [Int]
        $VMGeneration,

        [parameter(mandatory = $false)]
        [ValidateNotNullOrEmpty()]
        [String]
        $ISO,

        [parameter(mandatory = $false)]
        [ValidateNotNullOrEmpty()]
        $EmptyDiskSize,

        [parameter(mandatory = $false)]
        [ValidateNotNullOrEmpty()]
        [switch]
        $DynaMem,

        [Parameter()]
        [hashtable]$CleanupState
    )

    if ($null -ne $CleanupState) {
        if ($VMName -ne [System.IO.Path]::GetFileName($VMName) -or $VMName -in @('.', '..')) {
            throw 'VMName must be a single directory name for tracked deployment.'
        }
        $ownedFolder = Join-Path $VMLocation $VMName
        if (Test-Path -LiteralPath $ownedFolder -ErrorAction Stop) {
            throw "VM directory '$ownedFolder' already exists. Choose another VM name or inspect the existing directory before retrying."
        }
        $CleanupState.VMFolder = [System.IO.Path]::GetFullPath($ownedFolder)
        $CleanupState.VMName = $VMName
        Save-PAWDeploymentState -State $CleanupState
        $null = New-Item -Path $ownedFolder -ItemType Directory -ErrorAction Stop
        if ($CleanupState.RunId) {
            Set-Content -LiteralPath (Join-Path $ownedFolder '.pawdeploy-owner') -Value $CleanupState.RunId -Encoding ASCII -ErrorAction Stop
        }
    }
    #Create VM
    $VM = New-VM -Name $VMName -MemoryStartupBytes $VMMem -Path $VMLocation -NoVHD -Generation $VMGeneration -ErrorAction Stop
    if ($null -ne $CleanupState) {
        $CleanupState.VMId = $VM.Id
        Save-PAWDeploymentState -State $CleanupState
    }
    Remove-VMNetworkAdapter -VM $VM

    if ($DynaMem -eq $True) {
        Write-Verbose "Configure dynamic memory"
        Set-VMMemory -VM $VM -DynamicMemoryEnabled $True -MaximumBytes $VMMem -MinimumBytes $VMMem -StartupBytes $VMMem
    }
    else {
        Write-Verbose "Disable dynamic memory"
        Set-VMMemory -VM $VM -DynamicMemoryEnabled $false
    }

    #Add Networkadapter
    if ($VMNetWorkType -eq "Legacy" -and $VMGeneration -eq "1") {
        Add-VMNetworkAdapter -VM $VM -SwitchName $VMSwitchName -IsLegacy $true
    }
    else {
        Add-VMNetworkAdapter -VM $VM -SwitchName $VMSwitchName
    }

    #Set vCPU
    if ($VMvCPU -ne "1") {
        Set-VMProcessor -Count $VMvCPU -VM $VM
    }

    #Set VLAN
    If ($VlanID -ne $NULL) {
        Set-VMNetworkAdapterVlan -VlanId $VlanID -Access -VM $VM
    }

    #Add Virtual Disk
    if ($DiskMode -in @('Copy', 'Diff', 'Empty', 'Attached')) {
        $diskFolder = Join-Path (Join-Path $VMLocation $VMName) 'Virtual Hard Disks'
        $null = New-Item -Path $diskFolder -ItemType Directory -Force -ErrorAction Stop
    }
    switch ($DiskMode) {
        Copy {
            $VHD = $VHDFile | Split-Path -Leaf
            Copy-Item $VHDFile -Destination "$VMLocation\$VMName\Virtual Hard Disks\"
            Add-VMHardDiskDrive -VM $VM -Path "$VMLocation\$VMName\Virtual Hard Disks\$VHD"
        }
        Diff {
            $VHD = $VHDFile | Split-Path -Leaf
            New-VHD -Path "$VMLocation\$VMName\Virtual Hard Disks\$VHD" -ParentPath $VHDFile -Differencing
            Add-VMHardDiskDrive -VMName $VMName -Path "$VMLocation\$VMName\Virtual Hard Disks\$VHD"
        }
        Empty {
            $VHD = $VMName + ".vhdx"
            New-VHD -Path "$VMLocation\$VMName\Virtual Hard Disks\$VHD" -SizeBytes $EmptyDiskSize -Dynamic
            Add-VMHardDiskDrive -VMName $VMName -Path "$VMLocation\$VMName\Virtual Hard Disks\$VHD"
        }
        Attached {
            Add-VMHardDiskDrive -VM $VM -Path $VHDFile
        }
        None {
        }
        Default {
            Write-Error "Epic Failure"
            throw
        }
    }

    #Add DVD for Gen2
    if ($VMGeneration -ne "1") {
        Add-VMDvdDrive -VMName $VMName
    }

    #Mount ISO
    if ($ISO -ne '') {
        Set-VMDvdDrive -VMName $VMName -Path $ISO
    }

    #Set Correct Bootorder for Gen 2
    if ($VMGeneration -ne "1") {
        $VMDvdDrive = Get-VMDvdDrive -VMName $VMName
        $VMHardDiskDrive = Get-VMHardDiskDrive -VM $VM
        $VMNetworkAdapter = Get-VMNetworkAdapter -VMName $VMName
        Set-VMFirmware -VM $VM -BootOrder $VMDvdDrive, $VMHardDiskDrive, $VMNetworkAdapter
    }
    Return (Get-VM -Id $vm.id)
}
Function New-PAWSetupCompletecmd {
    <#
    .SYNOPSIS
        Creates a SetupComplete.cmd file containing a startup command.

    .DESCRIPTION
        New-PAWSetupCompletecmd creates or replaces SetupComplete.cmd in the
        specified folder and writes two lines:
          1. @Echo off
          2. The command provided via -Command

        The file is written as ASCII, which is the safest encoding choice for
        classic .cmd/batch processing in deployment scenarios.

    .PARAMETER Command
        Command line to execute from SetupComplete.cmd.

    .PARAMETER Path
        Folder where SetupComplete.cmd will be created.

    .EXAMPLE
        New-PAWSetupCompletecmd -Path "C:\Temp\PAWDeploy" -Command "cmd.exe /c echo Done"

        Creates C:\Temp\PAWDeploy\SetupComplete.cmd with @Echo off and the
        specified command.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>

    [cmdletbinding(SupportsShouldProcess = $true, ConfirmImpact = 'Low')]
    Param(
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$Command,

        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$Path
    )

    if (-not (Test-Path -Path $Path)) {
        New-Item -Path $Path -ItemType Directory -Force -ErrorAction Stop | Out-Null
    }

    $setupCompletePath = Join-Path -Path $Path -ChildPath 'SetupComplete.cmd'

    if (Test-Path -Path $setupCompletePath) {
        if ($PSCmdlet.ShouldProcess($setupCompletePath, 'Remove existing SetupComplete.cmd')) {
            Remove-Item -Path $setupCompletePath -Force -ErrorAction Stop
        }
    }

    if ($PSCmdlet.ShouldProcess($setupCompletePath, 'Create SetupComplete.cmd')) {
        Set-Content -Path $setupCompletePath -Value '@Echo off' -Encoding Ascii -ErrorAction Stop
        Add-Content -Path $setupCompletePath -Value $Command -Encoding Ascii -ErrorAction Stop
    }

    Get-Item -Path $setupCompletePath -ErrorAction Stop
}
Function New-PAWShortCut {
    <#
    .SYNOPSIS
        Creates a Windows shortcut (.lnk) file.

    .DESCRIPTION
        New-PAWShortCut creates a shortcut using the WScript.Shell COM object,
        sets target path, optional arguments, and optional icon location, then
        saves the .lnk file.

        When -RunAsAdmin is provided, the function sets the Run as administrator
        flag inside the .lnk binary metadata.

    .PARAMETER SoruceFile
        Backward-compatible parameter for shortcut target path.
        Kept for compatibility with existing callers.
        SourceFile is an alias for this parameter.

    .PARAMETER DestinationFile
        Full path to the shortcut file to create (typically ending with .lnk).

    .PARAMETER Arguments
        Optional command-line arguments passed to the target application.

    .PARAMETER IconDLL
        Optional icon location in standard shortcut format (e.g.
        "C:\Windows\System32\shell32.dll,3").

    .PARAMETER RunAsAdmin
        Sets the shortcut to run with elevated privileges.

    .EXAMPLE
        New-PAWShortCut -SourceFile "vmconnect.exe" -DestinationFile "C:\Users\Public\Desktop\PAW Links\Connect PAW.lnk" -Arguments "localhost PAW-01"

        Creates a VMConnect shortcut for PAW-01.

    .EXAMPLE
        New-PAWShortCut -SoruceFile "notepad.exe" -DestinationFile "C:\Temp\Notepad.lnk" -RunAsAdmin

        Creates a shortcut using the legacy parameter name and marks it to run
        as administrator.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>

    [CmdletBinding(SupportsShouldProcess = $true, ConfirmImpact = 'Low')]
    Param(
        [Parameter(Mandatory = $true)]
        [Alias('SourceFile')]
        [ValidateNotNullOrEmpty()]
        [string]$SoruceFile,

        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$DestinationFile,

        [Parameter(Mandatory = $false)]
        [string]$Arguments,

        [Parameter(Mandatory = $false)]
        [string]$IconDLL,

        [Parameter(Mandatory = $false)]
        [switch]$RunAsAdmin
    )

    $destinationDirectory = Split-Path -Path $DestinationFile -Parent
    if (-not [string]::IsNullOrWhiteSpace($destinationDirectory) -and -not (Test-Path -Path $destinationDirectory)) {
        New-Item -Path $destinationDirectory -ItemType Directory -Force -ErrorAction Stop | Out-Null
    }

    if ($PSCmdlet.ShouldProcess($DestinationFile, "Create shortcut to '$SoruceFile'")) {
        $wshShell = New-Object -ComObject WScript.Shell
        $shortCut = $wshShell.CreateShortcut($DestinationFile)
        $shortCut.TargetPath = $SoruceFile

        if (-not [string]::IsNullOrWhiteSpace($Arguments)) {
            $shortCut.Arguments = $Arguments
        }

        if (-not [string]::IsNullOrWhiteSpace($IconDLL)) {
            $shortCut.IconLocation = $IconDLL
        }

        $shortCut.Save()
    }

    if ($RunAsAdmin -and (Test-Path -Path $DestinationFile)) {
        if ($PSCmdlet.ShouldProcess($DestinationFile, 'Set RunAsAdmin flag')) {
            $bytes = [System.IO.File]::ReadAllBytes($DestinationFile)
            $bytes[0x15] = $bytes[0x15] -bor 0x20 # Set byte 21 bit 6 ON.
            [System.IO.File]::WriteAllBytes($DestinationFile, $bytes)
        }
    }

    Get-Item -Path $DestinationFile -ErrorAction Stop
}
<#

.SYNOPSIS
    Builds a DataTable from template objects using the specified columns.

.DESCRIPTION
    Builds a DataTable from template objects using the specified columns.

.PARAMETER TemplateObjects
    Template objects used to populate the table rows.

.PARAMETER Columns
    Column names and order for the resulting template table.

.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team

#>
function New-PAWTemplateTable {
    param(
        [Parameter(Mandatory = $true)]
        [object[]]$TemplateObjects,
        [Parameter(Mandatory = $true)]
        [string[]]$Columns
    )

    $table = New-Object System.Data.DataTable
    foreach ($col in $Columns) {
        [void]$table.Columns.Add($col, [string])
    }

    foreach ($template in @($TemplateObjects)) {
        if ($null -eq $template) {
            continue
        }

        $row = $table.NewRow()

        if ($table.Columns.Contains('Name')) {
            $null = ($row['Name'] = [string]$template.Name)
        }

        foreach ($property in @($template.PSObject.Properties)) {
            if ($property.MemberType -ne [System.Management.Automation.PSMemberTypes]::NoteProperty -and $property.MemberType -ne [System.Management.Automation.PSMemberTypes]::Property) {
                continue
            }

            if ($property.Name -eq 'Name') {
                continue
            }

            if ($table.Columns.Contains($property.Name)) {
                $null = ($row[$property.Name] = [string]$property.Value)
            }
        }

        [void]$table.Rows.Add($row)
    }

    Write-Output $table -NoEnumerate
}

Function New-PAWUnattendXMLClient {
    <#
    .SYNOPSIS
        Generates a Windows Unattend XML file for client deployment.

    .DESCRIPTION
        The New-PAWUnattendXMLClient function creates a customized unattend.xml file for automating Windows client installations.
        It supports both domain join and workgroup scenarios, static or DHCP IP configuration, and various localization and setup options.
        The generated XML can be used for unattended Windows deployments, including domain join, administrator password setup, and network configuration.

    .PARAMETER Path
        The file path where the unattend.xml will be created. Defaults to '.\unattend.xml'.

    .PARAMETER Computername
        The name of the computer to be set during Windows setup.

    .PARAMETER OSDAdapter0IPAddressList
        The list of IP addresses for the primary network adapter. Use "DHCP" for dynamic addressing.

    .PARAMETER DomainOrWorkGroup
        Specifies whether the machine should join a "Domain" or "Workgroup".

    .PARAMETER ProductKey
        The Windows product key to use. Defaults to 'NONE'.

    .PARAMETER AdminPassword
        The password for the local Administrator account. Defaults to 'P@ssw0rd'.

    .PARAMETER OrgName
        The organization name to register. Defaults to "TheFakeDomain".

    .PARAMETER Fullname
        The full name of the registered owner. Defaults to "TheFakeDomain".

    .PARAMETER TimeZoneName
        The time zone to set. Defaults to "Pacific Standard Time".

    .PARAMETER InputLocale
        The input locale (keyboard layout). Defaults to "en-US".

    .PARAMETER SystemLocale
        The system locale. Defaults to "en-US".

    .PARAMETER UILanguage
        The UI language. Defaults to "en-US".

    .PARAMETER UserLocale
        The user locale. Defaults to "en-US".

    .PARAMETER OSDAdapter0Gateways
        The gateway IP address for the primary network adapter. Defaults to "192.168.1.1".

    .PARAMETER OSDAdapter0DNS1
        The primary DNS server IP address. Defaults to "192.168.1.200".

    .PARAMETER OSDAdapter0DNS2
        The secondary DNS server IP address. Defaults to "192.168.1.201".

    .PARAMETER OSDAdapter0SubnetMaskPrefix
        The subnet mask prefix (e.g., "24" for 255.255.255.0). Defaults to "24".

    .PARAMETER DNSDomain
        The DNS domain name to join. Defaults to "corp.TheFakeDomain.com".

    .PARAMETER DomainNetBios
        The NetBIOS name of the domain. Defaults to "TheFakeDomain".

    .PARAMETER DomainJoinAccount
        The username of the domain administrator. Defaults to "Administrator".

    .PARAMETER DomainJoinAccountPassword
        The password for the domain administrator. Defaults to "P@ssw0rd".

    .PARAMETER DomainName
        Domain name used for the domain-join account. Defaults to "TheFakeDomain".

    .PARAMETER MachineObjectOU
        The distinguished name of the OU where the computer account will be created. Defaults to "NA" (not set).

    .PARAMETER JoinWorkgroup
        The name of the workgroup to join if not joining a domain. Defaults to "WORKGROUP".

    .PARAMETER ProtectYourPC
        Specifies the ProtectYourPC setting for OOBE. Accepts "1", "2", or "3". Defaults to "3".

    .OUTPUTS
        FileInfo object representing the created unattend.xml file.

    .EXAMPLE
        New-PAWUnattendXMLClient -Computername "PC01" -OSDAdapter0IPAddressList "192.168.1.10" -DomainOrWorkGroup "Domain"

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

        - This function will overwrite the file at the specified path if it already exists.
        - Passwords are stored in plain text in the generated XML as required by Windows Setup.
        - Use with caution and ensure proper security of the unattend.xml file.

    #>

    [cmdletbinding()]
    [OutputType([System.IO.FileInfo])]
    [System.Diagnostics.CodeAnalysis.SuppressMessageAttribute("PSAvoidUsingPlainTextForPassword", "", Justification = "Unnattend contains passwords")]
    [System.Diagnostics.CodeAnalysis.SuppressMessageAttribute("PSAvoidUsingUsernameAndPasswordParams", "", Justification = "Unnattend contains passwords")]
    Param(
        [parameter(mandatory = $False)]
        [ValidateNotNullOrEmpty()]
        [string]
        $Path = ".\unattend.xml",

        [parameter(mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]
        $Computername,

        [parameter(mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]
        $OSDAdapter0IPAddressList,

        [parameter(mandatory = $true)]
        [ValidateSet("Domain", "Workgroup")]
        [string]
        $DomainOrWorkGroup,

        [parameter(mandatory = $false)]
        $ProductKey,

        [parameter(mandatory = $false)]
        $AdminPassword = "P@ssw0rd",

        [parameter(mandatory = $false)]
        $OrgName = "TheFakeDomain",

        [parameter(mandatory = $false)]
        $Fullname = "TheFakeDomain",

        [parameter(mandatory = $false)]
        $TimeZoneName = "Pacific Standard Time",

        [parameter(mandatory = $false)]
        $InputLocale,

        [parameter(mandatory = $false)]
        $SystemLocale,

        [parameter(mandatory = $false)]
        $UILanguage,

        [parameter(mandatory = $false)]
        $UserLocale,

        [parameter(mandatory = $false)]
        $OSDAdapter0Gateways = "192.168.1.1",

        [parameter(mandatory = $false)]
        $OSDAdapter0DNS1 = "192.168.1.200",

        [parameter(mandatory = $false)]
        $OSDAdapter0DNS2 = "192.168.1.201",

        [parameter(mandatory = $false)]
        $OSDAdapter0SubnetMaskPrefix = "24",

        [parameter(mandatory = $false)]
        $DNSDomain = "corp.TheFakeDomain.com",

        [parameter(mandatory = $false)]
        $DomainNetBios = "TheFakeDomain",

        [parameter(mandatory = $false)]
        $DomainJoinAccount = "Administrator",

        [parameter(mandatory = $false)]
        $DomainJoinAccountPassword = "P@ssw0rd",

        [parameter(mandatory = $false)]
        $DomainName = "TheFakeDomain",

        [parameter(mandatory = $false)]
        $MachineObjectOU = "NA",

        [parameter(mandatory = $false)]
        $JoinWorkgroup = "WORKGROUP",

        [parameter(mandatory = $false)]
        [ValidateSet("1", "2", "3")]
        $ProtectYourPC = "3"
    )

    # Ensure text output uses UTF-8 consistently to match XML declaration.
    $PSDefaultParameterValues['Set-Content:Encoding'] = 'utf8'
    $PSDefaultParameterValues['Add-Content:Encoding'] = 'utf8'

    $parentPath = Split-Path -Path $Path -Parent
    if (-not [string]::IsNullOrWhiteSpace($parentPath) -and -not (Test-Path -Path $parentPath)) {
        New-Item -Path $parentPath -ItemType Directory -Force -ErrorAction Stop | Out-Null
    }

    if ((Test-Path -Path $Path) -eq $true) {
        Remove-Item -Path $Path -Force -ErrorAction Stop
    }

    Write-Verbose "IP is $OSDAdapter0IPAddressList"
    $unattendFile = New-Item -Path $Path -ItemType File -Force -ErrorAction Stop
    Set-Content $unattendFile '<?xml version="1.0" encoding="utf-8"?>'
    Add-Content $unattendFile '<unattend xmlns="urn:schemas-microsoft-com:unattend">'
    Add-Content $unattendFile '    <settings pass="specialize">'

    Switch ($DomainOrWorkGroup) {
        'Domain' {
            Write-Verbose "Configure for domain mode"
            Add-Content $unattendFile '        <component name="Microsoft-Windows-UnattendedJoin" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">'
            Add-Content $unattendFile '            <Identification>'
            Add-Content $unattendFile '                <Credentials>'
            Add-Content $unattendFile "                    <Username>$DomainJoinAccount</Username>"
            Add-Content $unattendFile "                    <Domain>$DomainName</Domain>"
            Add-Content $unattendFile "                    <Password>$DomainJoinAccountPassword</Password>"
            Add-Content $unattendFile '                </Credentials>'
            Add-Content $unattendFile "                <JoinDomain>$DNSDomain</JoinDomain>"
            If (!($MachineObjectOU -eq 'NA')) {
                Write-Verbose "OU is set to $MachineObjectOU"
                Add-Content $unattendFile "                <MachineObjectOU>$MachineObjectOU</MachineObjectOU>"
            }
            Add-Content $unattendFile '            </Identification>'
            Add-Content $unattendFile '        </component>'
        }
        'Workgroup' {
            Write-Verbose "Configure unattend.xml for workgroup mode"
            Add-Content $unattendFile '        <component name="Microsoft-Windows-UnattendedJoin" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">'
            Add-Content $unattendFile '            <Identification>'
            Add-Content $unattendFile "                <JoinWorkgroup>$JoinWorkgroup</JoinWorkgroup>"
            Add-Content $unattendFile '            </Identification>'
            Add-Content $unattendFile '        </component>'
        }
        Default {
            throw "Unsupported DomainOrWorkGroup value '$DomainOrWorkGroup'. Expected 'Domain' or 'Workgroup'."
        }
    }
    Add-Content $unattendFile '        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">'
    Add-Content $unattendFile "            <ComputerName>$ComputerName</ComputerName>"

    If ($null -eq $ProductKey) {
        Write-Verbose "No Productkey"
    }
    else {
        Write-Verbose "Adding Productkey $ProductKey"
        Add-Content $unattendFile "            <ProductKey>$ProductKey</ProductKey>"
    }
    Add-Content $unattendFile "            <RegisteredOrganization>$OrgName</RegisteredOrganization>"
    Add-Content $unattendFile "            <RegisteredOwner>$Fullname</RegisteredOwner>"
    Add-Content $unattendFile '            <DoNotCleanTaskBar>true</DoNotCleanTaskBar>'
    Add-Content $unattendFile "            <TimeZone>$TimeZoneName</TimeZone>"
    Add-Content $unattendFile '        </component>'
    Add-Content $unattendFile '        <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">'
    Add-Content $unattendFile '            <RunSynchronous>'
    Add-Content $unattendFile '                <RunSynchronousCommand wcm:action="add">'
    Add-Content $unattendFile '                    <Description>EnableAdmin</Description>'
    Add-Content $unattendFile '                    <Order>1</Order>'
    Add-Content $unattendFile '                    <Path>cmd /c net user Administrator /active:yes</Path>'
    Add-Content $unattendFile '                </RunSynchronousCommand>'
    Add-Content $unattendFile '                <RunSynchronousCommand wcm:action="add">'
    Add-Content $unattendFile '                    <Description>UnfilterAdministratorToken</Description>'
    Add-Content $unattendFile '                    <Order>2</Order>'
    Add-Content $unattendFile '                    <Path>cmd /c reg add HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System /v FilterAdministratorToken /t REG_DWORD /d 0 /f</Path>'
    Add-Content $unattendFile '                </RunSynchronousCommand>'
    Add-Content $unattendFile '                <RunSynchronousCommand wcm:action="add">'
    Add-Content $unattendFile '                    <Description>disable user account page</Description>'
    Add-Content $unattendFile '                    <Order>3</Order>'
    Add-Content $unattendFile '                    <Path>reg add HKLM\Software\Microsoft\Windows\CurrentVersion\Setup\OOBE /v UnattendCreatedUser /t REG_DWORD /d 1 /f</Path>'
    Add-Content $unattendFile '                </RunSynchronousCommand>'
    Add-Content $unattendFile '                <RunSynchronousCommand wcm:action="add">'
    Add-Content $unattendFile '                    <Description>disable async RunOnce</Description>'
    Add-Content $unattendFile '                    <Order>4</Order>'
    Add-Content $unattendFile '                    <Path>reg add HKLM\Software\Microsoft\Windows\CurrentVersion\Explorer /v AsyncRunOnce /t REG_DWORD /d 0 /f</Path>'
    Add-Content $unattendFile '                </RunSynchronousCommand>'
    Add-Content $unattendFile '            </RunSynchronous>'
    Add-Content $unattendFile '        </component>'
    Add-Content $unattendFile '        <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">'
    Add-Content $unattendFile "            <InputLocale>$InputLocale</InputLocale>"
    Add-Content $unattendFile "            <SystemLocale>$SystemLocale</SystemLocale>"
    Add-Content $unattendFile "            <UILanguage>$UILanguage</UILanguage>"
