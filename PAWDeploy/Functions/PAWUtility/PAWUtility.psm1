Function Get-PAWKVPData {
    <#
    .SYNOPSIS
        Retrieves Hyper-V KVP (Key-Value Pair) guest exchange data for a VM.

    .DESCRIPTION
        Get-PAWKVPData reads guest KVP exchange items exposed by Hyper-V integration
        services and returns them as PowerShell objects.

        The function queries classes in the root\virtualization\v2 namespace using
        CIM cmdlets (Get-CimInstance), then parses each KVP XML payload into an object
        containing the properties published by the guest OS.

    .PARAMETER VMName
        Name of the Hyper-V virtual machine.
        Accepts pipeline input.

    .EXAMPLE
        Get-PAWKVPData -VMName "PAW-01"
        Returns guest KVP data published by PAW-01.

    .EXAMPLE
        "PAW-01","PAW-02" | Get-PAWKVPData
        Retrieves KVP data for both VMs using pipeline input.

    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team

    #>

    [cmdletbinding()]
    [OutputType([pscustomobject])]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true, ValueFromPipelineByPropertyName = $true)]
        [Alias('Name')]
        [ValidateNotNullOrEmpty()]
        [string[]]$VMName
    )

    process {
        foreach ($vm in $VMName) {
            if ((Test-PAWVMExists -VMname $vm) -eq $false) {
                Write-Error "Could not find VM '$vm'."
                continue
            }

            $vmCim = Get-CimInstance -Namespace root\virtualization\v2 -ClassName Msvm_ComputerSystem -Filter "ElementName='$vm'" -ErrorAction Stop
            if ($null -eq $vmCim) {
                Write-Error "Unable to query virtualization data for VM '$vm'."
                continue
            }

            $kvpComponents = Get-CimAssociatedInstance -InputObject $vmCim -Association Msvm_SystemDevice -ResultClassName Msvm_KvpExchangeComponent -ErrorAction Stop
            foreach ($kvpComponent in $kvpComponents) {
                foreach ($item in $kvpComponent.GuestExchangeItems) {
                    try {
                        $cimXml = [xml]$item
                        $properties = @{}
                        foreach ($cimProperty in $cimXml.SelectNodes('/INSTANCE/PROPERTY')) {
                            $properties[$cimProperty.NAME] = $cimProperty.VALUE
                        }
                        [pscustomobject]$properties
                    }
                    catch {
                        Write-Verbose "Skipping invalid KVP XML item for '$vm': $($_.Exception.Message)"
                    }
                }
            }
        }
    }
}
