<#
.SYNOPSIS
    Exports portable definitions and owned Classic/offline payload files.
.NOTES
    Version : 2.0.0.3
    Author  : The Fantastic PAWDeploy Team
#>
function Export-PAWApplicationPackage {
    [CmdletBinding(SupportsShouldProcess)]
    param([string]$Root = $script:PAWApplicationResourcesRoot, [Parameter(Mandatory)][string]$Path,
        [string]$ApplicationId, [string]$BundleId, [switch]$Replace)
    if ([bool]$ApplicationId -eq [bool]$BundleId) { throw 'Specify either ApplicationId or BundleId.' }
    $all = @(Get-PAWApplicationCatalog -Root $Root)
    $bundle = $null
    if ($BundleId) {
        $bundle = Get-PAWApplicationBundle -Root $Root -BundleId $BundleId
        $apps = @($all | Where-Object { $bundle.Applications -contains $_.ApplicationId })
    }
    else {
        $apps = @($all | Where-Object ApplicationId -eq $ApplicationId)
        if ($apps.Count -ne 1) { throw "Application '$ApplicationId' not found." }
    }
    $Path = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($Path)
    Assert-PAWCachePath $Path
    if (Test-Path -LiteralPath $Path) {
        if ((Get-Item -LiteralPath $Path -Force -ErrorAction Stop).PSIsContainer) { throw "Export target is a directory: '$Path'." }
        if (-not $Replace) { throw "Export exists: $Path. Use Replace." }
    }
    $payloads = @(Export-PAWApplicationPayload -Root $Root -Applications $apps)
    $document = [ordered]@{ SchemaVersion = 2; Applications = $apps; Bundle = $bundle; Payloads = $payloads }
    if ($PSCmdlet.ShouldProcess($Path, 'Export portable application package')) {
        $folder = Split-Path -Parent $Path
        $null = New-Item -ItemType Directory -Path $folder -Force -ErrorAction Stop
        $temporary = Join-Path $folder ('.package-export-' + [guid]::NewGuid().ToString('N') + '.tmp')
        try {
            Write-PAWManagerJson $temporary $document
            Assert-PAWCachePath $Path
            if (Test-Path -LiteralPath $Path) {
                if (-not $Replace) { throw "Export appeared at '$Path'; replacement is not approved." }
                [IO.File]::Replace($temporary, $Path, [Management.Automation.Language.NullString]::Value)
            }
            else { [IO.File]::Move($temporary, $Path) }
        }
        finally {
            if (Test-Path -LiteralPath $temporary) { Remove-Item -LiteralPath $temporary -Force -ErrorAction Stop }
        }
        Write-PAWApplicationManagerLog "Exported application package to '$Path'."
        Get-Item -LiteralPath $Path
    }
}
function Export-PAWCachedApplication {
    <#
    .SYNOPSIS
        Exports one complete local cache folder as an importable ZIP.
    .DESCRIPTION
        Includes manually supplied and orphaned files, but no application definition.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(SupportsShouldProcess)]
    param(
        [Parameter(Mandatory, ValueFromPipeline, ParameterSetName = 'Input')][object]$InputObject,
        [Parameter(Mandatory, ParameterSetName = 'Name')][string]$Name,
        [Parameter(Mandatory)][string]$DestinationFolder,
        [string]$Root = $script:PAWApplicationResourcesRoot, [switch]$Replace
    )
    begin { $exportedPaths = @{} }
    process {
        $caches = @(Get-PAWCachedApplication -Root $Root)
        if ($PSCmdlet.ParameterSetName -eq 'Name') { $matches = @($caches | Where-Object Name -eq $Name) }
        elseif ($null -ne $InputObject.PSObject.Properties['Path']) { $matches = @($caches | Where-Object Path -eq $InputObject.Path) }
        else { throw 'Input object must have a Path from Get-PAWCachedApplication.' }
        $paths = @($matches | Select-Object -ExpandProperty Path -Unique)
        if ($paths.Count -ne 1) { throw "Expected one cached folder; found $($paths.Count)." }
        if ($exportedPaths.ContainsKey($paths[0])) { return }
        $exportedPaths[$paths[0]] = $true
        $cache = $matches[0]
        $source = (Get-Item -LiteralPath $paths[0] -Force -ErrorAction Stop).FullName.TrimEnd('\')
        Assert-PAWCachePath $source
        $null = @(Get-PAWApplicationPayloadFiles -Root $source)
        $folder = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($DestinationFolder)
        Assert-PAWCachePath $folder
        if ($folder -eq $source -or $folder.StartsWith($source + '\', [StringComparison]::OrdinalIgnoreCase)) {
            throw 'Export destination cannot be inside the cache folder.'
        }
        $target = Join-Path $folder ("Cache-{0}-{1}.zip" -f $cache.CacheType, (Split-Path -Leaf $source))
        if (Test-Path -LiteralPath $target) {
            $existing = Get-Item -LiteralPath $target -Force -ErrorAction Stop
            if ($existing.PSIsContainer -or ($existing.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw "Invalid export target: '$target'." }
            if (-not $Replace) { throw "Export exists; use -Replace: '$target'." }
        }
        if (-not $PSCmdlet.ShouldProcess($target, "Export cache folder (Replace=$Replace)")) { return }
        Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction Stop
        Add-Type -AssemblyName System.IO.Compression -ErrorAction Stop
        $null = New-Item -ItemType Directory -Path $folder -Force -ErrorAction Stop
        $temporary = Join-Path $folder ('.cache-export-' + [guid]::NewGuid().ToString('N') + '.tmp')
        try {
            $zip = [IO.Compression.ZipFile]::Open($temporary, [IO.Compression.ZipArchiveMode]::Create)
            try {
                $entry = $zip.CreateEntry('PAWCache.json')
                $writer = New-Object IO.StreamWriter($entry.Open(), (New-Object Text.UTF8Encoding($false)))
                try {
                    $writer.Write((@{ SchemaVersion = 1; CacheType = $cache.CacheType; FolderName = (Split-Path -Leaf $source) } | ConvertTo-Json))
                }
                finally { $writer.Dispose() }
                $queue = New-Object 'System.Collections.Generic.Queue[string]'
                $queue.Enqueue($source)
                while ($queue.Count) {
                    foreach ($item in @(Get-ChildItem -LiteralPath $queue.Dequeue() -Force -ErrorAction Stop)) {
                        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "Cache contains a reparse point: '$($item.FullName)'." }
                        $relative = $item.FullName.Substring($source.Length).TrimStart('\').Replace('\', '/')
                        if ($item.PSIsContainer) { $null = $zip.CreateEntry("Files/$relative/"); $queue.Enqueue($item.FullName) }
                        else { $null = [IO.Compression.ZipFileExtensions]::CreateEntryFromFile($zip, $item.FullName, "Files/$relative") }
                    }
                }
            }
            finally { $zip.Dispose() }
            Assert-PAWCachePath $folder
            if (Test-Path -LiteralPath $target) {
                if (-not $Replace) { throw "Export appeared at '$target'; replacement is not approved." }
                [IO.File]::Replace($temporary, $target, [Management.Automation.Language.NullString]::Value)
            }
            else { [IO.File]::Move($temporary, $target) }
            Get-Item -LiteralPath $target
        }
        finally {
            if (Test-Path -LiteralPath $temporary) { Remove-Item -LiteralPath $temporary -Force -ErrorAction Stop }
        }
    }
}
<#
.SYNOPSIS
    Uses the structured WinGet PowerShell client API to discover application identities.
.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team
#>
function Find-PAWWinGetApplication {
    [CmdletBinding()]
    param([string]$Query, [string]$Id)
    if ([bool]$Query -eq [bool]$Id) { throw 'Specify Query or an exact WinGet Id.' }
    Test-PAWApplicationManagerPrerequisite
    $parameters = @{ Source = 'winget'; ErrorAction = 'Stop' }
    if ($Id) { $parameters.Id = $Id; $parameters.MatchOption = 'Equals' }
    else { $parameters.Query = $Query }
    Find-WinGetPackage @parameters | Select-Object Name, Id, Version, Source
}
function Get-PAWApplication {
    <#
    .SYNOPSIS
        Lists readable application objects, optionally in bundle installation order.
    .PARAMETER Root
        Resources folder. Defaults to this module's installation.
    .PARAMETER Bundle
        Exact bundle name.
    .PARAMETER BundleId
        Bundle GUID, including when names are ambiguous.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding(DefaultParameterSetName = 'All')]
    param(
        [string]$Root = $script:PAWApplicationResourcesRoot,
        [Parameter(Mandatory, ParameterSetName = 'Name')][string]$Bundle,
        [Parameter(Mandatory, ParameterSetName = 'Id')][string]$BundleId
    )
    $applications = @(Get-PAWApplicationCatalog -Root $Root)
    if ($PSCmdlet.ParameterSetName -ne 'All') {
        $selector = if ($PSCmdlet.ParameterSetName -eq 'Id') { @{ BundleId = $BundleId } } else { @{ Name = $Bundle } }
        $bundleObject = Get-PAWApplicationBundle -Root $Root @selector
        $applications = @(foreach ($id in $bundleObject.Applications) {
            $applications | Where-Object ApplicationId -eq $id
        })
    }
    foreach ($application in $applications) {
        $result = [pscustomobject][ordered]@{
            Name = $application.Definition.Name
            Type = if ($application.SchemaVersion -eq 2) { $application.Type } else { $application.Definition.Source }
            Enabled = $application.Enabled
            ApplicationId = $application.ApplicationId
            RestartRequired = $application.RestartRequired
            Definition = $application.Definition
            Settings = $application.Settings
            Application = $application
        }
        $display = [System.Management.Automation.PSPropertySet]::new(
            'DefaultDisplayPropertySet', [string[]]@('Name', 'Type', 'Enabled', 'ApplicationId'))
        $result | Add-Member -MemberType MemberSet -Name PSStandardMembers -Value ([System.Management.Automation.PSMemberInfo[]]@($display))
        $result
    }
}
<#
.SYNOPSIS
    Returns application-to-bundle and bundle-to-template assignment names.
.NOTES
    Version : 2.0.0.1
    Author  : The Fantastic PAWDeploy Team
#>
function Get-PAWApplicationAssignment {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$Root, [Parameter(Mandatory)][string]$ConfigPath)
    $applications = @(Get-PAWApplicationCatalog -Root $Root)
    $bundles = @(Get-PAWApplicationBundle -Root $Root)
    $applicationAssignments = @{}
    $bundleAssignments = @{}
    foreach ($application in $applications) {
        $applicationAssignments[$application.ApplicationId] = @($bundles |
            Where-Object { $_.Applications -contains $application.ApplicationId } | Sort-Object Name | ForEach-Object Name)
    }
    $templates = @(Get-ChildItem -LiteralPath (Split-Path -Parent $ConfigPath) -Filter '*.json' -File -ErrorAction Stop |
        Where-Object Name -ne 'Config.json' | ForEach-Object {
            $template = Read-PAWManagerJson $_.FullName
            if ([string]::IsNullOrWhiteSpace([string]$template.Name)) {
                $template | Add-Member -NotePropertyName Name -NotePropertyValue $_.BaseName -Force
            }
            $template
        })
    foreach ($bundle in $bundles) {
        $bundleAssignments[$bundle.BundleId] = @($templates |
            Where-Object ApplicationBundle -eq $bundle.BundleId | Sort-Object Name | ForEach-Object Name)
    }
    [pscustomobject]@{ Applications = $applicationAssignments; Bundles = $bundleAssignments }
}
<#
.SYNOPSIS
    Reads, writes and removes managed applications and bundles.
.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team
#>
function Get-PAWApplicationBundle {
    [CmdletBinding()]
    param([string]$Root = $script:PAWApplicationResourcesRoot, [string]$BundleId, [string]$Name)
    if ($PSBoundParameters.ContainsKey('BundleId') -and $PSBoundParameters.ContainsKey('Name')) {
        throw 'Specify BundleId or Name, not both.'
    }
    $apps = @(Get-PAWApplicationCatalog -Root $Root)
    $folder = Join-Path $Root 'ApplicationBundles'
    if (-not (Test-Path -LiteralPath $folder -PathType Container)) { throw "Application bundles folder not found: $folder" }
    $bundles = @(foreach ($file in @(Get-ChildItem -LiteralPath $folder -Filter '*.json' -File -ErrorAction Stop | Sort-Object Name)) {
        $bundle = ConvertTo-PAWManagedBundle (Read-PAWManagerJson $file.FullName) $apps -SkipDuplicates
        if ($file.BaseName -ne $bundle.BundleId) { throw "Bundle ID must match filename: $($file.FullName)" }
        $display = [System.Management.Automation.PSPropertySet]::new(
            'DefaultDisplayPropertySet', [string[]]@('Name', 'BundleId', 'Applications'))
        $bundle | Add-Member -MemberType MemberSet -Name PSStandardMembers -Value ([System.Management.Automation.PSMemberInfo[]]@($display))
        $bundle
    })
    if ($PSBoundParameters.ContainsKey('BundleId')) {
        Test-PAWApplicationKey $BundleId
        $found = @($bundles | Where-Object BundleId -eq $BundleId)
        if ($found.Count -ne 1) { throw "Application bundle '$BundleId' not found." }
        return $found[0]
    }
    if ($PSBoundParameters.ContainsKey('Name')) {
        $found = @($bundles | Where-Object Name -eq $Name)
        if ($found.Count -ne 1) { throw "Expected one application bundle named '$Name'; found $($found.Count)." }
        return $found[0]
    }
    $bundles
}
<#
.SYNOPSIS
    Reads, writes and removes managed applications and bundles.
.NOTES
    Version : 2.0.0.2
    Author  : The Fantastic PAWDeploy Team
#>
function Get-PAWApplicationCatalog {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$Root)
    $folder = Join-Path $Root 'ApplicationCatalog'
    if (-not (Test-Path -LiteralPath $folder -PathType Container)) { throw "Application catalog not found: $folder" }
    $seenIds = @{}
    $seenNames = @{}
    $seenFiles = @{}
    foreach ($file in @(Get-ChildItem -LiteralPath $folder -Filter '*.json' -File -ErrorAction Stop | Sort-Object Name)) {
        $app = ConvertTo-PAWManagedApplication (Read-PAWManagerJson $file.FullName)
        $namedPath = Get-PAWApplicationCatalogPath -Root $Root -Application $app
        $legacyBaseName = $app.ApplicationId
        $namedBaseName = [IO.Path]::GetFileNameWithoutExtension($namedPath)
        if ($file.BaseName -ine $legacyBaseName -and $file.BaseName -ine $namedBaseName) {
            throw "Application catalog filename must be '<safe name>--<ApplicationId>.json' or the legacy '<ApplicationId>.json': $($file.FullName)"
        }
        $installFile = Get-PAWApplicationInstallFilePath -InstallRoot (Join-Path $Root 'Applications\InstallFiles') -Name $app.Definition.Name
        if ($seenIds.ContainsKey($app.ApplicationId) -or $seenNames.ContainsKey($app.Definition.Name) -or $seenFiles.ContainsKey($installFile)) { throw "Duplicate application ID/name or cache filename: $($app.ApplicationId) / $($app.Definition.Name)" }
        $seenIds[$app.ApplicationId] = $true
        $seenNames[$app.Definition.Name] = $true
        $seenFiles[$installFile] = $true
        $app
    }
}
function Get-PAWCachedApplication {
    <#
    .SYNOPSIS
        Lists local application cache and package folders containing files.
    .DESCRIPTION
        Includes orphaned folders. File presence does not verify completeness,
        integrity or readiness for installation.
    .PARAMETER Root
        Resources folder. Defaults to this module's installation.
    .NOTES
        Version : 2.0.0.1
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param([string]$Root = $script:PAWApplicationResourcesRoot)
    $Root = (Resolve-Path -LiteralPath $Root -ErrorAction Stop).Path
    $applications = @(Get-PAWApplicationCatalog -Root $Root)
    $cacheRoot = Join-Path $Root 'ApplicationDownloads'
    $locations = @(
        @{ Type = 'WinGet'; Path = (Join-Path $cacheRoot 'WinGet') }
        @{ Type = 'Local'; Path = (Join-Path $cacheRoot 'Local') }
        @{ Type = 'Module'; Path = (Join-Path $cacheRoot 'Modules') }
        @{ Type = 'Package'; Path = (Join-Path $Root 'Applications\Packages') }
    )
    foreach ($location in $locations) {
        if (-not (Test-Path -LiteralPath $location.Path -PathType Container)) { continue }
        foreach ($folder in @(Get-ChildItem -LiteralPath $location.Path -Directory -ErrorAction Stop | Where-Object { $_.Name -notlike '.staging-*' } | Sort-Object Name)) {
            if (-not (Get-ChildItem -LiteralPath $folder.FullName -Recurse -File -ErrorAction Stop | Select-Object -First 1)) { continue }
            $matches = @(foreach ($app in $applications) {
                $match = switch ($location.Type) {
                    'Package' { $app.ApplicationId -eq $folder.Name }
                    'WinGet' { (Get-PAWWinGetCacheFolder -CacheRoot $cacheRoot -Name $app.Definition.Name) -eq $folder.FullName }
                    'Local' { (Get-PAWLocalApplicationFolder -LocalRoot $location.Path -Name $app.Definition.Name) -eq $folder.FullName }
                    'Module' {
                        $id = if ($app.SchemaVersion -eq 2) { $app.Definition.Configuration.Id } else { $app.Definition.Id }
                        $id -eq $folder.Name
                    }
                }
                if ($match) { $app }
            })
            if ($matches.Count -eq 0) { $matches = @($null) }
            foreach ($app in $matches) {
                [pscustomobject][ordered]@{
                    Name = if ($null -ne $app) { $app.Definition.Name } else { $folder.Name }
                    CacheType = $location.Type
                    ApplicationId = if ($null -ne $app) { $app.ApplicationId } else { $null }
                    Path = $folder.FullName
                }
            }
        }
    }
}
