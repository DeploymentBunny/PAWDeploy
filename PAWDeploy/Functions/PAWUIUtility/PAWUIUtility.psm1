function Set-PAWUiTheme {
    <#
    .SYNOPSIS
        Applies the selected toolkit theme to a control tree.
    .DESCRIPTION
        Themes forms, layout containers, captions and content surfaces with the
        selected palette. Tool layout surfaces share the form background; menus
        retain their existing panel and ribbon colors.
        Windows-managed file pickers and message boxes retain the system theme.
    .PARAMETER Control
        Form or container whose existing control tree is themed.
    .PARAMETER Theme
        Optional theme name. System follows the Windows app appearance preference.
    .EXAMPLE
        Set-PAWUiTheme -Control $form
    .NOTES
        Version : 2.0.0.13
        Author  : The Fantastic PAWDeploy Team
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][System.Windows.Forms.Control]$Control,
        [string]$Theme
    )

    if ($PSBoundParameters.ContainsKey('Theme')) {
        $script:PAWUiThemeOverride = $Theme
    }
    elseif (-not [string]::IsNullOrWhiteSpace([string]$script:PAWUiThemeOverride)) {
        $Theme = [string]$script:PAWUiThemeOverride
    }
    $palette = Get-PAWUiPalette -Theme $Theme
    $background = $palette.Background
    $accent = $palette.Accent
    if ($Control -is [System.Windows.Forms.TabControl]) {
        $Control.Font = New-Object System.Drawing.Font('Segoe UI', 12, [System.Drawing.FontStyle]::Bold)
        $Control.SizeMode = 'Fixed'
        $Control.ItemSize = New-Object System.Drawing.Size(200, 40)
        Register-PAWUiChromeTheme -Control $Control -Color $background
        if ($Control.DrawMode -ne [System.Windows.Forms.TabDrawMode]::OwnerDrawFixed) {
            $Control.DrawMode = 'OwnerDrawFixed'
            $Control.Add_DrawItem({
                param($sender, $eventArgs)
                $colors = Get-PAWUiPalette
                $color = $colors.Background
                $brush = New-Object System.Drawing.SolidBrush($color)
                try {
                    $eventArgs.Graphics.FillRectangle($brush, $eventArgs.Bounds)
                    [System.Windows.Forms.TextRenderer]::DrawText($eventArgs.Graphics,
                        $sender.TabPages[$eventArgs.Index].Text, $sender.Font, $eventArgs.Bounds,
                        $colors.Text, $color,
                        ([System.Windows.Forms.TextFormatFlags]::HorizontalCenter -bor
                         [System.Windows.Forms.TextFormatFlags]::VerticalCenter))
                    $eventArgs.DrawFocusRectangle()
                }
                finally { $brush.Dispose() }
            })
        }
    }
    elseif ($Control -is [System.Windows.Forms.Button]) {
        $primary = $Control.BackColor.ToArgb() -eq $accent.ToArgb()
        Set-PAWThemedButton -Button $Control -Accent:$primary
    }
    elseif ($Control -is [System.Windows.Forms.TextBoxBase] -or
        $Control -is [System.Windows.Forms.ListControl] -or
        $Control -is [System.Windows.Forms.ListView] -or
        $Control -is [System.Windows.Forms.DataGridView] -or
        $Control -is [System.Windows.Forms.NumericUpDown]) {
        $Control.ForeColor = $palette.Text
        if ($Control.BackColor.ToArgb() -eq $accent.ToArgb()) {
            $Control.BackColor = $accent
            $Control.ForeColor = $palette.AccentText
        }
        else {
            $Control.BackColor = if ($Control -is [System.Windows.Forms.TextBoxBase] -and
                ($Control.ReadOnly -or -not $Control.Enabled)) { $palette.ReadOnly } else { $palette.Field }
        }
        if ($Control -is [System.Windows.Forms.ComboBox]) { $Control.FlatStyle = 'Flat' }
        if ($Control -is [System.Windows.Forms.DataGridView]) {
            $Control.EnableHeadersVisualStyles = $false
            $Control.BackgroundColor = $palette.ReadOnly
            $Control.GridColor = $palette.Border
            foreach ($style in @($Control.DefaultCellStyle, $Control.ColumnHeadersDefaultCellStyle,
                $Control.RowHeadersDefaultCellStyle, $Control.AlternatingRowsDefaultCellStyle)) {
                $style.BackColor = $palette.Field
                $style.ForeColor = $palette.Text
                $style.SelectionBackColor = $palette.Selection
                $style.SelectionForeColor = $palette.SelectionText
            }
        }
        if ($Control -is [System.Windows.Forms.ListView]) {
            Register-PAWUiChromeTheme -Control $Control -Color $palette.ReadOnly
        }
        if ($Control -is [System.Windows.Forms.ListView] -and -not $Control.OwnerDraw) {
            $Control.OwnerDraw = $true
            $Control.Add_DrawItem({
                param($sender, $eventArgs)
                if ($sender.View -eq [System.Windows.Forms.View]::Details) { return }
                $colors = Get-PAWUiPalette
                $back = if ($eventArgs.Item.Selected) { $colors.Selection } else { $sender.BackColor }
                $fore = if ($eventArgs.Item.Selected) { $colors.SelectionText } else { $colors.Text }
                $brush = New-Object System.Drawing.SolidBrush($back)
                try {
                    $eventArgs.Graphics.FillRectangle($brush, $eventArgs.Bounds)
                    [System.Windows.Forms.TextRenderer]::DrawText($eventArgs.Graphics,
                        $eventArgs.Item.Text, $sender.Font, $eventArgs.Bounds, $fore, $back,
                        [System.Windows.Forms.TextFormatFlags]::EndEllipsis)
                }
                finally { $brush.Dispose() }
            })
            $Control.Add_DrawSubItem({
                param($sender, $eventArgs)
                $colors = Get-PAWUiPalette
                $back = if ($eventArgs.Item.Selected) { $colors.Selection } else { $sender.BackColor }
                $fore = if ($eventArgs.Item.Selected) { $colors.SelectionText } else { $colors.Text }
                $brush = New-Object System.Drawing.SolidBrush($back)
                try {
                    $eventArgs.Graphics.FillRectangle($brush, $eventArgs.Bounds)
                    [System.Windows.Forms.TextRenderer]::DrawText($eventArgs.Graphics,
                        $eventArgs.SubItem.Text, $sender.Font, $eventArgs.Bounds, $fore, $back,
                        ([System.Windows.Forms.TextFormatFlags]::Left -bor
                         [System.Windows.Forms.TextFormatFlags]::VerticalCenter -bor
                         [System.Windows.Forms.TextFormatFlags]::EndEllipsis))
                }
                finally { $brush.Dispose() }
            })
            $Control.Add_DrawColumnHeader({
                param($sender, $eventArgs)
                $colors = Get-PAWUiPalette
                $brush = New-Object System.Drawing.SolidBrush($colors.ReadOnly)
                try {
                    $eventArgs.Graphics.FillRectangle($brush, $eventArgs.Bounds)
                    [System.Windows.Forms.TextRenderer]::DrawText($eventArgs.Graphics,
                        $eventArgs.Header.Text, $sender.Font, $eventArgs.Bounds,
                        $colors.Text, $colors.ReadOnly,
                        ([System.Windows.Forms.TextFormatFlags]::Left -bor
                         [System.Windows.Forms.TextFormatFlags]::VerticalCenter -bor
                         [System.Windows.Forms.TextFormatFlags]::EndEllipsis))
                }
                finally { $brush.Dispose() }
            })
        }
        Register-PAWUiInputTheme -Control $Control
    }
    elseif ($Control -is [System.Windows.Forms.Form] -or
        $Control -is [System.Windows.Forms.Panel] -or
        $Control -is [System.Windows.Forms.GroupBox] -or
        $Control -is [System.Windows.Forms.TabPage] -or
        $Control -is [System.Windows.Forms.SplitContainer] -or
        $Control -is [System.Windows.Forms.ToolStrip] -or
        $Control -is [System.Windows.Forms.Label] -or
        $Control -is [System.Windows.Forms.CheckBox] -or
        $Control -is [System.Windows.Forms.RadioButton]) {
        if ($Control -is [System.Windows.Forms.TabPage]) { $Control.UseVisualStyleBackColor = $false }
        $surface = if ($Control.Name -eq 'PAWRibbon' -and $null -ne $Control.Parent -and
            $Control.Parent.Controls.ContainsKey('PAWRibbonTruesec')) {
            $palette.MenuRibbon
        } elseif ($Control -is [System.Windows.Forms.Form] -or $Control.Name -eq 'PAWRibbon') {
            $background
        } elseif ($Control -is [System.Windows.Forms.Label] -or
                  $Control -is [System.Windows.Forms.CheckBox] -or
                  $Control -is [System.Windows.Forms.RadioButton]) {
            if ($null -ne $Control.Parent) { $Control.Parent.BackColor } else { $background }
        } else {
            $ownerForm = $Control.FindForm()
            if ($null -ne $ownerForm -and $ownerForm.Controls.ContainsKey('PAWRibbonTruesec')) {
                $palette.Panel
            } else { $background }
        }
        $Control.BackColor = if ($Control.Name -in @('PAWRibbonTitle', 'PAWRibbonStatus') -and
            $null -ne $Control.Parent -and $Control.Parent -is [System.Windows.Forms.Form] -and
            $Control.Parent.Controls.ContainsKey('PAWRibbonTruesec')) {
            [System.Drawing.Color]::Transparent
        } elseif ($Control.BackColor.ToArgb() -eq $accent.ToArgb()) {
            $accent
        } else { $surface }
        $Control.ForeColor = if ($Control.ForeColor.ToArgb() -eq $accent.ToArgb()) {
            $accent
        } else { $palette.Text }
        if ($Control -is [System.Windows.Forms.CheckBox] -or $Control -is [System.Windows.Forms.RadioButton]) {
            $Control.UseVisualStyleBackColor = $false
            $Control.FlatStyle = 'Flat'
            $Control.FlatAppearance.CheckedBackColor = $accent
            $Control.FlatAppearance.BorderColor = $palette.Border
            Register-PAWUiInputTheme -Control $Control
        }
        if ($Control -is [System.Windows.Forms.ToolStrip]) {
            foreach ($item in $Control.Items) { $item.ForeColor = $palette.Text }
        }
    }
    foreach ($child in $Control.Controls) {
        Set-PAWUiTheme -Control $child -Theme $Theme
    }
}
